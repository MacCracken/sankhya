# ---------------------------------------------------------------------------
# SagesTradition record
# ---------------------------------------------------------------------------
# { civilization, group_name: Str, sage_names: vec<Str>, source_texts: vec<Str>,
#   associated_stars: Str, catastrophe_narrative: Str } — 48 bytes.
enum SgtOff {
    SGT_CIV = 0; SGT_GROUP = 8; SGT_NAMES = 16; SGT_TEXTS = 24;
    SGT_STARS = 32; SGT_NARR = 40; SGT_SIZE = 48;
}

#must_use
fn sgt_new(civ, group, names, texts, stars, narr) {
    var p = alloc(SGT_SIZE);
    store64(p + SGT_CIV, civ);
    store64(p + SGT_GROUP, group);
    store64(p + SGT_NAMES, names);
    store64(p + SGT_TEXTS, texts);
    store64(p + SGT_STARS, stars);
    store64(p + SGT_NARR, narr);
    return p;
}
#must_use
fn sgt_civ(p) { return load64(p + SGT_CIV); }
#must_use
fn sgt_group(p) { return load64(p + SGT_GROUP); }
#must_use
fn sgt_names(p) { return load64(p + SGT_NAMES); }
#must_use
fn sgt_texts(p) { return load64(p + SGT_TEXTS); }
#must_use
fn sgt_stars(p) { return load64(p + SGT_STARS); }
#must_use
fn sgt_narr(p) { return load64(p + SGT_NARR); }

# ---------------------------------------------------------------------------
# Static data: Seven Sages traditions (one builder per civilization; each
# returns a fresh SagesTradition record with fresh string/vec data, matching
# the Rust seven_sages() which rebuilds a Vec on every call).
# ---------------------------------------------------------------------------

fn _st_vedic() {
    var names = vec_new();
    vec_push(names, str_from("Marichi"));
    vec_push(names, str_from("Atri"));
    vec_push(names, str_from("Angiras"));
    vec_push(names, str_from("Pulastya"));
    vec_push(names, str_from("Pulaha"));
    vec_push(names, str_from("Kratu"));
    vec_push(names, str_from("Vasishtha"));
    var texts = vec_new();
    vec_push(texts, str_from("Shatapatha Brahmana"));
    vec_push(texts, str_from("Matsya Purana"));
    vec_push(texts, str_from("Vishnu Purana"));
    return sgt_new(ECIV_VEDIC, str_from("Saptarishi"), names, texts,
        str_from("Ursa Major (Saptarishi Mandala)"),
        str_from("Survived the pralaya (great dissolution) guided by Matsya (fish avatar of Vishnu); restarted the Vedic tradition after the flood."));
}

fn _st_babylonian() {
    var names = vec_new();
    vec_push(names, str_from("Adapa (Uanna)"));
    vec_push(names, str_from("Uannedugga"));
    vec_push(names, str_from("Enmedugga"));
    vec_push(names, str_from("Enmegalamma"));
    vec_push(names, str_from("Enmebulugga"));
    vec_push(names, str_from("An-Enlilda"));
    vec_push(names, str_from("Utuabzu"));
    var texts = vec_new();
    vec_push(texts, str_from("Bit Meseri incantations"));
    vec_push(texts, str_from("Berossus Babyloniaca"));
    vec_push(texts, str_from("Eridu Genesis"));
    return sgt_new(ECIV_BABYLONIAN, str_from("Apkallu"), names, texts,
        str_from("Associated with Ea/Enki and the Abzu (cosmic waters)"),
        str_from("Seven antediluvian sages sent by Ea before the Great Flood; taught the arts of civilization to humanity."));
}

fn _st_egyptian() {
    var names = vec_new();
    vec_push(names, str_from("The Seven Builder Gods (individual names partially lost)"));
    var texts = vec_new();
    vec_push(texts, str_from("Edfu Building Texts"));
    vec_push(texts, str_from("Turin King List (Zep Tepi rulers)"));
