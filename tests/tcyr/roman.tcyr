# roman.tcyr — port of rust-old/src/roman.rs #[cfg(test)] suite.
# Serde round-trip test is intentionally skipped (JSON is a later module).
include "src/error.cyr"
include "src/util.cyr"
include "src/f64_util.cyr"
include "src/logging.cyr"
include "src/roman.cyr"

fn ok(v, name) { return assert_neq(v, 0, name); }

# assert to_roman_str(value) == cstr
fn check_roman(value, cstr, name) {
    var r = to_roman_str(value);
    var okr = is_ok(r);
    if (okr == 0) { return ok(0, name); }
    var s = result_unwrap(r);
    return ok(str_eq_cstr(s, cstr), name);
}

# assert from_roman(cstr) == expected value
fn check_parse(cstr, expected, name) {
    var r = from_roman(str_from(cstr));
    var okr = is_ok(r);
    if (okr == 0) { return ok(0, name); }
    return assert_eq(result_unwrap(r), expected, name);
}

fn main() {
    alloc_init();
    println("=== sankhya roman test suite ===");

    # ---- Conversion: basic_values ----
    check_roman(1, "I", "1 -> I");
    check_roman(4, "IV", "4 -> IV");
    check_roman(5, "V", "5 -> V");
    check_roman(9, "IX", "9 -> IX");
    check_roman(10, "X", "10 -> X");
    check_roman(40, "XL", "40 -> XL");
    check_roman(50, "L", "50 -> L");
    check_roman(90, "XC", "90 -> XC");
    check_roman(100, "C", "100 -> C");
    check_roman(400, "CD", "400 -> CD");
    check_roman(500, "D", "500 -> D");
    check_roman(900, "CM", "900 -> CM");
    check_roman(1000, "M", "1000 -> M");

    # ---- Conversion: compound_values ----
    check_roman(14, "XIV", "14 -> XIV");
    check_roman(42, "XLII", "42 -> XLII");
    check_roman(99, "XCIX", "99 -> XCIX");
    check_roman(399, "CCCXCIX", "399 -> CCCXCIX");
    check_roman(1776, "MDCCLXXVI", "1776 -> MDCCLXXVI");
    check_roman(1999, "MCMXCIX", "1999 -> MCMXCIX");
    check_roman(2024, "MMXXIV", "2024 -> MMXXIV");
    check_roman(3999, "MMMCMXCIX", "3999 -> MMMCMXCIX");

    # ---- parse_roundtrip: exhaustive 1..=3999 ----
    var rtfail = 0;
    var n = 1;
    while (n <= 3999) {
        var rs = to_roman_str(n);
        if (is_ok(rs) == 0) {
            rtfail = rtfail + 1;
        } else {
            var romanstr = result_unwrap(rs);
            var pr = from_roman(romanstr);
            if (is_ok(pr) == 0) {
                rtfail = rtfail + 1;
            } else {
                if (result_unwrap(pr) != n) { rtfail = rtfail + 1; }
            }
        }
        n = n + 1;
    }
    assert_eq(rtfail, 0, "exhaustive 1..=3999 roundtrip");

    # ---- parse_lowercase ----
    check_parse("xiv", 14, "xiv -> 14");
    check_parse("mcmxcix", 1999, "mcmxcix -> 1999");

    # ---- parse_invalid_chars ----
    var e1 = from_roman(str_from("ABC"));
    ok(is_err_result(e1), "ABC is error");
    var e2 = from_roman(str_from("IVX2"));
    ok(is_err_result(e2), "IVX2 is error");

    # ---- parse_non_canonical ----
    var e3 = from_roman(str_from("IIII"));
    ok(is_err_result(e3), "IIII is error");
    var e4 = from_roman(str_from("VV"));
    ok(is_err_result(e4), "VV is error");
    var e5 = from_roman(str_from("IC"));
    ok(is_err_result(e5), "IC is error");

    # ---- parse_empty ----
    var e6 = from_roman(str_from(""));
    ok(is_err_result(e6), "empty is error");
    assert_eq(sk_result_code(e6), SKE_INVALID_BASE, "empty -> InvalidBase");

    # ---- value_zero_errors ----
    var e7 = to_roman_str(0);
    ok(is_err_result(e7), "to_roman_str(0) error");
    assert_eq(sk_result_code(e7), SKE_INVALID_BASE, "0 -> InvalidBase");
    var e8 = romannum_from_value(0);
    ok(is_err_result(e8), "from_value(0) error");

    # ---- value_too_large_errors ----
    var e9 = to_roman_str(4000);
    ok(is_err_result(e9), "to_roman_str(4000) error");
    var e10 = romannum_from_value(4000);
    ok(is_err_result(e10), "from_value(4000) error");

    # ---- add_basic ----
    var ra = roman_add(10, 5);
    ok(is_ok(ra), "add(10,5) ok");
    var rav = result_unwrap(ra);
    assert_eq(romannum_value(rav), 15, "add value 15");
    ok(str_eq_cstr(romannum_text(rav), "XV"), "add text XV");

    # ---- add_overflow ----
    var rao = roman_add(3999, 1);
    ok(is_err_result(rao), "add(3999,1) overflow error");

    # ---- subtract_basic ----
    var rs2 = roman_subtract(10, 3);
    ok(is_ok(rs2), "sub(10,3) ok");
    var rsv = result_unwrap(rs2);
    assert_eq(romannum_value(rsv), 7, "sub value 7");
    ok(str_eq_cstr(romannum_text(rsv), "VII"), "sub text VII");

    # ---- subtract_to_zero_errors ----
    var rse1 = roman_subtract(5, 5);
    ok(is_err_result(rse1), "sub(5,5) error");
    assert_eq(sk_result_code(rse1), SKE_COMPUTATION, "sub(5,5) -> Computation");
    var rse2 = roman_subtract(3, 7);
    ok(is_err_result(rse2), "sub(3,7) error");

    # ---- multiply_basic ----
    var rm = roman_multiply(7, 8);
    ok(is_ok(rm), "mul(7,8) ok");
    var rmv = result_unwrap(rm);
    assert_eq(romannum_value(rmv), 56, "mul value 56");
    ok(str_eq_cstr(romannum_text(rmv), "LVI"), "mul text LVI");

    # ---- multiply_overflow ----
    var rmo = roman_multiply(100, 100);
    ok(is_err_result(rmo), "mul(100,100) overflow error");

    # ---- divide_exact ----
    var rd = roman_divide(10, 5);
    ok(is_ok(rd), "div(10,5) ok");
    var rdv = result_unwrap(rd);
    assert_eq(romannum_value(divresult_quotient(rdv)), 2, "div(10,5) quotient 2");
    assert_eq(divresult_remainder(rdv), 0, "div(10,5) remainder None");

    # ---- divide_with_remainder ----
    var rd2 = roman_divide(10, 3);
    ok(is_ok(rd2), "div(10,3) ok");
    var rd2v = result_unwrap(rd2);
    assert_eq(romannum_value(divresult_quotient(rd2v)), 3, "div(10,3) quotient 3");
    var rem = divresult_remainder(rd2v);
    ok(rem, "div(10,3) remainder Some");
    assert_eq(romannum_value(rem), 1, "div(10,3) remainder 1");

    # ---- divide_by_zero_errors ----
    var rdz = roman_divide(10, 0);
    ok(is_err_result(rdz), "div(10,0) error");
    assert_eq(sk_result_code(rdz), SKE_INVALID_FRACTION, "div by zero -> InvalidFraction");

    # ---- divide_zero_quotient_errors ----
    var rdq = roman_divide(3, 5);
    ok(is_err_result(rdq), "div(3,5) zero quotient error");
    assert_eq(sk_result_code(rdq), SKE_COMPUTATION, "div zero quotient -> Computation");

    # ---- numeral_methods ----
    var nmr = romannum_from_value(42);
    ok(is_ok(nmr), "from_value(42) ok");
    var x = result_unwrap(nmr);
    assert_eq(romannum_value(x), 42, "x.value == 42");
    ok(str_eq_cstr(romannum_text(x), "XLII"), "x.text == XLII");
    ok(str_eq_cstr(romannum_to_str(x), "XLII"), "x.to_string == XLII");
    var pyr = romannum_parse(str_from("XIV"));
    ok(is_ok(pyr), "parse(XIV) ok");
    var y = result_unwrap(pyr);
    assert_eq(romannum_value(y), 14, "y.value == 14");

    # ---- numeral_arithmetic ----
    var na = result_unwrap(romannum_from_value(100));
    var nb = result_unwrap(romannum_from_value(50));
    var naddr = romannum_add(na, nb);
    ok(is_ok(naddr), "100+50 ok");
    assert_eq(romannum_value(result_unwrap(naddr)), 150, "100+50 == 150");
    var nsubr = romannum_subtract(na, nb);
    ok(is_ok(nsubr), "100-50 ok");
    assert_eq(romannum_value(result_unwrap(nsubr)), 50, "100-50 == 50");
    var nmulr = romannum_multiply(na, nb);
    ok(is_err_result(nmulr), "100*50 overflow error");
    var ndivr = romannum_divide(na, nb);
    ok(is_ok(ndivr), "100/50 ok");
    var ndv = result_unwrap(ndivr);
    assert_eq(romannum_value(divresult_quotient(ndv)), 2, "100/50 quotient 2");
    assert_eq(divresult_remainder(ndv), 0, "100/50 remainder None");

    # ---- is_valid ----
    ok(is_valid_roman(str_from("XIV")), "XIV valid");
    ok(is_valid_roman(str_from("mcmxcix")), "mcmxcix valid");
    var v1 = is_valid_roman(str_from("IIII"));
    assert_eq(v1, 0, "IIII invalid");
    var v2 = is_valid_roman(str_from("ABC"));
    assert_eq(v2, 0, "ABC invalid");
    var v3 = is_valid_roman(str_from(""));
    assert_eq(v3, 0, "empty invalid");

    # ---- logging init doesn't crash ----
    sankhya_log_init();
    ok(1, "log init ok");

    return assert_summary();
}

var rc = main();
syscall(SYS_EXIT, rc);
