# --- serial_aztec.cyr ---

# serial_aztec.cyr — JSON (de)serialization for the aztec module, matching
# Rust serde_json EXACTLY for full round-trip parity.
#
# Types (from rust-old/src/aztec.rs, all #[derive(Serialize, Deserialize)]):
#   TonalpohualliSign  — unit enum → serde emits the variant-name string.
#   Tonalpohualli      — { number: u8, sign: TonalpohualliSign }.
#   XiuhpohuallMonth   — unit enum → serde emits the variant-name string.
#   Xiuhpohualli       — { day: u8, month: XiuhpohuallMonth }.
#
# serde format details:
#   * Unit enum variants serialize as a bare string of the variant identifier
#     (e.g. TonalpohualliSign::Coatl → "Coatl"). We use the module's
#     <Enum>_name(i) accessor (the serde identifier, NO spaces — distinct from
#     the Display string which inserts spaces in HueyTozoztli / HueyTecuilhuitl /
#     XocotlHuetzi). NOT <Enum>_display, NOT the integer discriminant.
#   * Struct fields serialize in declaration order with snake_case Rust names:
#     Tonalpohualli → {"number":N,"sign":"NAME"};
#     Xiuhpohualli  → {"day":D,"month":"NAME"}.
#   * serde_json compact output has no spaces after ':' or ',' — the sk_json_*
#     helpers already emit that shape.
#   * No f64 fields in this module — both structs are pure integer + enum, so
#     sk_json_int suffices and no bayan value-tree float path is needed.
#
# Self-contained: no include lines. Uses the shared sk_json_* helpers from
# serial_util.cyr and the bayan_json_v_* value-tree API (folded stdlib).

# ---------------------------------------------------------------------------
# Enum <-> name mapping (parse side). Scans the module's *_name(i) accessor.
# ---------------------------------------------------------------------------

# TonalpohualliSign discriminant for a serde identifier Str, or (0 - 1) if none.
#must_use
fn tonalpohualli_sign_from_name(name) {
    var i = 0;
    while (i < 20) {
        if (str_eq(tonalpohualli_sign_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# XiuhpohuallMonth discriminant for a serde identifier Str, or (0 - 1) if none.
#must_use
fn xiuh_month_from_name(name) {
    var mi = 0;
    while (mi < 19) {
        if (str_eq(xiuh_month_name(mi), name) == 1) { return mi; }
        mi = mi + 1;
    }
    return 0 - 1;
}

# ---------------------------------------------------------------------------
# Tonalpohualli — {"number":N,"sign":"NAME"}
# ---------------------------------------------------------------------------

#must_use
fn tonalpohualli_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "number", ton_number(p));
    sk_json_sep(sb);
    sk_json_str(sb, "sign", tonalpohualli_sign_name(ton_sign(p)));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# v is a bayan value tree node (from sk_json_parse). Reconstruct via *_new.
#must_use
fn tonalpohualli_from_json(v) {
    var number = bayan_json_v_int(bayan_json_v_obj_get(v, "number"));
    var sign_name = bayan_json_v_str(bayan_json_v_obj_get(v, "sign"));
    var sign = tonalpohualli_sign_from_name(sign_name);
    return tonalpohualli_new(number, sign);
}

# Field-by-field equality (Rust derives PartialEq).
#must_use
fn tonalpohualli_eq(a, b) {
    if (ton_number(a) != ton_number(b)) { return 0; }
    if (ton_sign(a) != ton_sign(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# Xiuhpohualli — {"day":D,"month":"NAME"}
# ---------------------------------------------------------------------------

#must_use
fn xiuhpohualli_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "day", xiu_day(p));
    sk_json_sep(sb);
    sk_json_str(sb, "month", xiuh_month_name(xiu_month(p)));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

#must_use
fn xiuhpohualli_from_json(v) {
    var day = bayan_json_v_int(bayan_json_v_obj_get(v, "day"));
    var month_name = bayan_json_v_str(bayan_json_v_obj_get(v, "month"));
    var month = xiuh_month_from_name(month_name);
    return xiuhpohualli_new(day, month);
}

#must_use
fn xiuhpohualli_eq(a, b) {
    if (xiu_day(a) != xiu_day(b)) { return 0; }
    if (xiu_month(a) != xiu_month(b)) { return 0; }
    return 1;
}

# --- serial_coptic.cyr ---

# serial_coptic.cyr — JSON (de)serialization for the coptic module, giving full
# serde round-trip parity with Rust's derived Serialize + Deserialize.
#
# Rust serde types in coptic.rs:
#   CopticMonth  enum — unit variants serialize as the variant-name string
#                (external tagging), e.g. CopticMonth::Thout -> "Thout".
#   CopticDate   struct { year: i64, month: CopticMonth, day: u8 }
#                -> {"year":Y,"month":"Thout","day":D}
#
# The month field is emitted as the serde identifier (variant name) via the
# module's coptic_month_name(idx) accessor — NOT the integer discriminant and
# NOT any spaced Display form (they are identical here, but name is authoritative).
# All fields are integer-valued, so no f64 JSON-number path is needed.
#
# Self-contained: no include lines (the distlib bundler resolves stdlib + the
# coptic module; the serial_util helpers are pulled in by the manifest order).

# ---------------------------------------------------------------------------
# CopticMonth enum <-> serde variant-name string.
# ---------------------------------------------------------------------------

# Map a variant-name cstr back to its 0-based month index (the discriminant).
# Scans the 13 CopticMonth names via coptic_month_name; returns (0 - 1) if none
# matches (mirrors str_index_of's not-found sentinel).
#must_use
fn coptic_month_from_name(cstr) {
    var i = 0;
    while (i < 13) {
        if (str_eq_cstr(coptic_month_name(i), cstr) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Serialize a CopticMonth as a bare JSON string, e.g. "Thout" (serde emits a
# unit enum variant as a quoted identifier).
#must_use
fn coptic_month_to_json(m) {
    var msb = str_builder_new();
    str_builder_add_json_str(msb, coptic_month_name(m));
    return str_builder_build(msb);
}

# Parse a CopticMonth from a bayan JSON string node. Returns the discriminant
# (or 0 - 1 if the variant name is unknown).
#must_use
fn coptic_month_from_json(v) {
    var mname = bayan_json_v_str(v);
    return coptic_month_from_name(str_data(mname));
}

# Field-by-field equality for the round-trip test (an enum is a plain i64).
#must_use
fn coptic_month_eq(a, b) {
    if (a == b) { return 1; }
    return 0;
}

# ---------------------------------------------------------------------------
# CopticDate struct <-> JSON object.
# ---------------------------------------------------------------------------

# Emit {"year":Y,"month":"NAME","day":D} matching serde_json exactly.
#must_use
fn coptic_date_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "year", coptic_date_year(p));
    sk_json_sep(sb);
    sk_json_str(sb, "month", coptic_month_name(coptic_date_month(p)));
    sk_json_sep(sb);
    sk_json_int(sb, "day", coptic_date_day(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Reconstruct a CopticDate from a bayan JSON object node (from sk_json_parse).
# year/day are read as integers; month is read as its variant name then mapped
# back to the discriminant via coptic_month_from_name.
#must_use
fn coptic_date_from_json(v) {
    var year = bayan_json_v_int(bayan_json_v_obj_get(v, "year"));
    var mnode = bayan_json_v_obj_get(v, "month");
    var mstr = bayan_json_v_str(mnode);
    var month = coptic_month_from_name(str_data(mstr));
    var day = bayan_json_v_int(bayan_json_v_obj_get(v, "day"));
    return coptic_date_new(year, month, day);
}

# Field-by-field equality (year, month, day) for the round-trip test.
#must_use
fn coptic_date_eq(a, b) {
    if (coptic_date_year(a) != coptic_date_year(b)) { return 0; }
    if (coptic_date_month(a) != coptic_date_month(b)) { return 0; }
    if (coptic_date_day(a) != coptic_date_day(b)) { return 0; }
    return 1;
}

# --- serial_egyptian.cyr ---

# serial_egyptian.cyr — JSON (de)serialization for the egyptian module, matching
# Rust serde_json exactly for full round-trip parity.
#
# Self-contained: no include lines. Uses the shared sk_json_* helpers from
# src/serial_util.cyr, the bayan value-tree API (folded stdlib), and the
# egyptian module's decan_new / decan_* accessors.
#
# Serde types in egyptian:
#   Decan — struct { number: u8, name: &'static str, ecliptic_longitude: f64 }
#     serde JSON: {"number":1,"name":"Kenmet","ecliptic_longitude":0.0}
#     number is a bare integer; name is a quoted string; ecliptic_longitude is a
#     JSON number that ALWAYS carries a decimal point (serde/ryu emits 0.0, 10.0,
#     190.0 — never a bare 0/10/190). The decan longitudes are whole numbers
#     (0.0..350.0 in 10-degree steps), but they are still f64 in Rust, so the
#     serialized form must match ryu's "N.0" shape — emitted here via the bayan
#     value-tree float path (bayan_json_v_float_new + bayan_json_v_build), whose
#     Grisu2 formatter produces the identical "N.0" text.
#
# No enums in egyptian, so no <Enum>_name / <Enum>_from_name are needed.

# ---------------------------------------------------------------------------
# Decan
# ---------------------------------------------------------------------------

# Serialize a Decan record to a JSON object string, byte-for-byte matching
# serde_json (compact, no spaces, Rust field names, f64 with a decimal point).
#must_use
fn decan_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "number", decan_number(p));
    sk_json_sep(sb);
    sk_json_str(sb, "name", decan_name(p));
    sk_json_sep(sb);
    # ecliptic_longitude is f64 → emit via the bayan value tree so the number
    # keeps its decimal point (0.0 / 10.0 / 190.0), matching serde_json/ryu.
    sk_json_key(sb, "ecliptic_longitude");
    var fv = bayan_json_v_float_new(decan_longitude(p));
    var fjs = bayan_json_v_build(fv);
    str_builder_add(sb, fjs);
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a bayan value-tree node (from sk_json_parse) back into a Decan
# record via decan_new. number via bayan_json_v_int, name via bayan_json_v_str,
# ecliptic_longitude via bayan_json_v_float (returns the f64 bit pattern).
#must_use
fn decan_from_json(v) {
    var number = bayan_json_v_int(bayan_json_v_obj_get(v, "number"));
    var name = bayan_json_v_str(bayan_json_v_obj_get(v, "name"));
    var lon = bayan_json_v_float(bayan_json_v_obj_get(v, "ecliptic_longitude"));
    return decan_new(number, name, lon);
}

# Field-by-field equality of two Decan records (for round-trip testing). number
# via ==, name via str_eq (content), ecliptic_longitude via f64_eq (value).
#must_use
fn decan_eq(a, b) {
    var same = 1;
    if (decan_number(a) != decan_number(b)) { same = 0; }
    var neq = str_eq(decan_name(a), decan_name(b));
    if (neq == 0) { same = 0; }
    var feq = f64_eq(decan_longitude(a), decan_longitude(b));
    if (feq == 0) { same = 0; }
    return same;
}

# --- serial_babylonian.cyr ---

# serial_babylonian.cyr — JSON (de)serialization for the babylonian module,
# matching Rust serde_json EXACTLY for full round-trip parity.
#
# Serde types (from rust-old/src/babylonian.rs, all #[derive(Serialize, Deserialize)]):
#   BabylonianNumeral — struct { tens: u8, units: u8 }.
#   BabylonianMonth   — unit enum (12 variants) → serde emits the variant-name string.
#   BabylonianDate    — struct { year: i64, month: BabylonianMonth, day: u8 }.
#
# serde format details:
#   * Unit enum variants serialize as a bare string of the variant identifier
#     (e.g. BabylonianMonth::Abu → "Abu"). We use the module's babmonth_name(i)
#     accessor (the serde identifier — for Babylonian months it equals the
#     Display string, all ASCII, no spaces). NOT the integer discriminant.
#   * Struct fields serialize in declaration order with the snake_case Rust
#     field names, compact (no spaces after ':' or ','):
#       BabylonianNumeral → {"tens":T,"units":U}
#       BabylonianDate    → {"year":Y,"month":"NAME","day":D}
#   * No f64 fields among these types — every field is an integer or the enum,
#     so sk_json_int + sk_json_str suffice (no bayan value-tree float path).
#
# Self-contained: no include lines. Uses the shared sk_json_* helpers from
# src/serial_util.cyr, the babylonian module's *_new / *_* accessors, and the
# bayan_json_v_* value-tree API (folded stdlib).

# ---------------------------------------------------------------------------
# Enum <-> name mapping (parse side). Scans the module's babmonth_name(i)
# accessor over the 12 variants; returns the discriminant, or (0 - 1) if none.
# ---------------------------------------------------------------------------

# BabylonianMonth discriminant for a serde identifier Str, or (0 - 1) if none.
#must_use
fn babmonth_from_name(name) {
    var i = 0;
    while (i < 12) {
        if (str_eq(babmonth_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# ---------------------------------------------------------------------------
# BabylonianMonth (standalone enum) — serde emits the bare variant-name string.
# ---------------------------------------------------------------------------

# BabylonianMonth i → "NAME" (a JSON string), matching serde external tagging
# of a unit variant.
#must_use
fn babmonth_to_json(i) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, babmonth_name(i));
    return str_builder_build(sb);
}

# Reconstruct a BabylonianMonth discriminant from a parsed bayan value-tree
# node `v` (a JTAG_STR). Returns (0 - 1) if the string is not a known variant.
#must_use
fn babmonth_from_json(v) {
    var name = bayan_json_v_str(v);
    return babmonth_from_name(name);
}

# Enum equality (Rust derives PartialEq / Eq on the discriminant).
#must_use
fn babmonth_eq(a, b) {
    if (a != b) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# BabylonianNumeral — {"tens":T,"units":U}
# ---------------------------------------------------------------------------

# Serialize a BabylonianNumeral to a JSON object string (Rust field order:
# tens, then units), byte-for-byte matching serde_json (compact).
#must_use
fn babnum_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "tens", babnum_tens(p));
    sk_json_sep(sb);
    sk_json_int(sb, "units", babnum_units(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Reconstruct a BabylonianNumeral from a parsed bayan value-tree node `v`.
#must_use
fn babnum_from_json(v) {
    var tens = bayan_json_v_int(bayan_json_v_obj_get(v, "tens"));
    var units = bayan_json_v_int(bayan_json_v_obj_get(v, "units"));
    return babnum_new(tens, units);
}

# Field-by-field equality (Rust derives PartialEq / Eq).
#must_use
fn babnum_eq(a, b) {
    if (babnum_tens(a) != babnum_tens(b)) { return 0; }
    if (babnum_units(a) != babnum_units(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# BabylonianDate — {"year":Y,"month":"NAME","day":D}
# ---------------------------------------------------------------------------

# Serialize a BabylonianDate to a JSON object string (Rust field order:
# year, month, day). The month is emitted as its variant-name string via
# babmonth_name; year and day as integers.
#must_use
fn babdate_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "year", babdate_year(p));
    sk_json_sep(sb);
    sk_json_str(sb, "month", babmonth_name(babdate_month(p)));
    sk_json_sep(sb);
    sk_json_int(sb, "day", babdate_day(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Reconstruct a BabylonianDate from a parsed bayan value-tree node `v`.
# The month field is read as its variant-name string, then mapped back to the
# discriminant via babmonth_from_name.
#must_use
fn babdate_from_json(v) {
    var year = bayan_json_v_int(bayan_json_v_obj_get(v, "year"));
    var mname = bayan_json_v_str(bayan_json_v_obj_get(v, "month"));
    var month = babmonth_from_name(mname);
    var day = bayan_json_v_int(bayan_json_v_obj_get(v, "day"));
    return babdate_new(year, month, day);
}

# Field-by-field equality (Rust derives PartialEq / Eq).
#must_use
fn babdate_eq(a, b) {
    if (babdate_year(a) != babdate_year(b)) { return 0; }
    if (babdate_month(a) != babdate_month(b)) { return 0; }
    if (babdate_day(a) != babdate_day(b)) { return 0; }
    return 1;
}

# --- serial_hebrew.cyr ---

# serial_hebrew.cyr — JSON (de)serialization for the hebrew module, for full
# serde round-trip parity with Rust's derived Serialize + Deserialize.
#
# Rust serde emits (see rust-old/src/hebrew.rs):
#   HebrewMonth  → the bare variant-name string, e.g. "Nisan" (unit variants,
#                  external tagging). NOTE the serde identifier has NO spaces:
#                  Adar I / Adar II Display as "Adar I"/"Adar II" but serialize
#                  as "AdarI"/"AdarII" (hebrewmonth_name, not hebrewmonth_display).
#   HebrewDate   → {"year":<i64>,"month":"<Variant>","day":<u8>}  (declaration order)
#
# SELF-CONTAINED: no include lines. Uses the shared sk_json_* helpers from
# serial_util.cyr, the hebrew module accessors (hebrewmonth_name, hebdate_year/
# month/day, hebrewdate_new), and bayan's value-tree API (folded stdlib).
#
# There are no f64, bool, nested, array, or option fields in this module — the
# only non-integer field is the month enum (emitted as its variant-name string)
# and the two integer fields (year, day). serde_json output is compact (no
# spaces), which the sk_json_* helpers reproduce exactly.

# ---------------------------------------------------------------------------
# HebrewMonth enum <-> serde variant-name string
# ---------------------------------------------------------------------------

# Map a variant-name Str back to the HebrewMonth discriminant (0..13). Scans
# hebrewmonth_name(i) for a match. Returns (0 - 1) if none matches.
#must_use
fn hebrewmonth_from_name(name) {
    var i = 0;
    while (i < 14) {
        if (str_eq(hebrewmonth_name(i), name) == 1) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Serialize a HebrewMonth discriminant to a bare JSON string ("Nisan").
#must_use
fn hebrewmonth_to_json(m) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, hebrewmonth_name(m));
    return str_builder_build(sb);
}

# Deserialize a bayan value node (a JSON string) to a HebrewMonth discriminant.
#must_use
fn hebrewmonth_from_json(v) {
    var name = bayan_json_v_str(v);
    return hebrewmonth_from_name(name);
}

# Equality of two HebrewMonth discriminants (0/1).
#must_use
fn hebrewmonth_eq(a, b) {
    if (a == b) {
        return 1;
    }
    return 0;
}

# ---------------------------------------------------------------------------
# HebrewDate struct <-> {"year":i64,"month":"<Variant>","day":u8}
# ---------------------------------------------------------------------------

# Serialize a HebrewDate pointer to serde-compact JSON. Field order matches the
# Rust struct declaration: year, month, day. The month enum is emitted as its
# serde variant-name string via hebrewmonth_name.
#must_use
fn hebrewdate_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "year", hebdate_year(p));
    sk_json_sep(sb);
    sk_json_str(sb, "month", hebrewmonth_name(hebdate_month(p)));
    sk_json_sep(sb);
    sk_json_int(sb, "day", hebdate_day(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a bayan value node (a JSON object) to a HebrewDate pointer. The
# month field is read as its variant-name string and mapped back to the
# discriminant via hebrewmonth_from_name.
#must_use
fn hebrewdate_from_json(v) {
    var y = bayan_json_v_int(bayan_json_v_obj_get(v, "year"));
    var mv = bayan_json_v_obj_get(v, "month");
    var mname = bayan_json_v_str(mv);
    var m = hebrewmonth_from_name(mname);
    var d = bayan_json_v_int(bayan_json_v_obj_get(v, "day"));
    return hebrewdate_new(y, m, d);
}

# Field-by-field equality of two HebrewDate pointers (0/1).
#must_use
fn hebrewdate_eq(a, b) {
    if (hebdate_year(a) != hebdate_year(b)) {
        return 0;
    }
    if (hebdate_month(a) != hebdate_month(b)) {
        return 0;
    }
    if (hebdate_day(a) != hebdate_day(b)) {
        return 0;
    }
    return 1;
}

# --- serial_islamic.cyr ---

# serial_islamic.cyr — JSON (de)serialization for the islamic module, matching
# Rust serde_json EXACTLY for full round-trip parity.
#
# Self-contained: no include lines. Uses the shared sk_json_* helpers from
# src/serial_util.cyr, the bayan value-tree API (folded stdlib), and the islamic
# module's constructors/getters + hijri_month_name accessor.
#
# Serde types in rust-old/src/islamic.rs (all #[derive(Serialize, Deserialize)]):
#   AlJabrForm         — unit enum → serde emits the variant-name string.
#   AlJabrSolution     — struct { form: AlJabrForm, roots: Vec<f64>,
#                                 coefficients: (f64, f64, f64) }.
#   KhayyamCubicType   — unit enum → serde emits the variant-name string.
#   HijriMonth         — unit enum → serde emits the variant-name string
#                        (islamic.cyr already exposes hijri_month_name(i)).
#   HijriDate          — struct { year: i64, month: HijriMonth, day: u8 }.
#
# serde format details worth noting:
#   * Unit enum variants serialize as a bare string of the variant identifier
#     (AlJabrForm::SquaresAndNumberEqualRoots → "SquaresAndNumberEqualRoots").
#     Emitted via <Enum>_name(i) — NOT the integer discriminant, NOT Display.
#   * Struct fields serialize in declaration order with the Rust snake_case names
#     (form/roots/coefficients ; year/month/day). Compact: no spaces.
#   * f64 fields (roots elements + coefficients) serialize as JSON numbers that
#     ALWAYS carry a decimal point (ryu emits 3.0, -5.0, 1.0 — never 3/-5/1).
#     We emit them via the bayan value-tree float path (bayan_json_v_float_new +
#     bayan_json_v_build), whose Grisu2 formatter produces the identical "N.0".
#   * Vec<f64> `roots` → JSON array [e0,e1,...] ; the (f64,f64,f64) tuple
#     `coefficients` → JSON array [a,b,c] (serde serializes tuples as arrays).

# ---------------------------------------------------------------------------
# AlJabrForm name table + name<->discriminant mapping.
# islamic.cyr does not expose an AlJabrForm name accessor, so build one here
# (lazy singleton, matching hijri_month_name's shape).
# ---------------------------------------------------------------------------

var _aljf_name_vec = 0;
var _aljf_name_done = 0;

fn _build_aljf_names() {
    var v = vec_new();
    vec_push(v, str_from("SquaresEqualRoots"));
    vec_push(v, str_from("SquaresEqualNumber"));
    vec_push(v, str_from("RootsEqualNumber"));
    vec_push(v, str_from("SquaresAndRootsEqualNumber"));
    vec_push(v, str_from("SquaresAndNumberEqualRoots"));
    vec_push(v, str_from("RootsAndNumberEqualSquares"));
    return v;
}

# AlJabrForm serde identifier for discriminant i.
#must_use
fn aljabr_form_name(i) {
    if (_aljf_name_done == 0) { _aljf_name_vec = _build_aljf_names(); _aljf_name_done = 1; }
    return vec_get(_aljf_name_vec, i);
}

# AlJabrForm discriminant for a serde identifier Str, or (0 - 1) if none.
#must_use
fn aljabr_form_from_name(name) {
    var i = 0;
    while (i < 6) {
        if (str_eq(aljabr_form_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# ---------------------------------------------------------------------------
# KhayyamCubicType name table + name<->discriminant mapping.
# ---------------------------------------------------------------------------

var _kct_name_vec = 0;
var _kct_name_done = 0;

fn _build_kct_names() {
    var v = vec_new();
    vec_push(v, str_from("CubeEqualNumber"));
    vec_push(v, str_from("CubeAndThingEqualNumber"));
    vec_push(v, str_from("CubeAndSquareEqualNumber"));
    vec_push(v, str_from("CubeEqualThingAndNumber"));
    vec_push(v, str_from("CubeThingNumberEqualSquare"));
    return v;
}

# KhayyamCubicType serde identifier for discriminant i.
#must_use
fn khayyam_type_name(i) {
    if (_kct_name_done == 0) { _kct_name_vec = _build_kct_names(); _kct_name_done = 1; }
    return vec_get(_kct_name_vec, i);
}

# KhayyamCubicType discriminant for a serde identifier Str, or (0 - 1) if none.
#must_use
fn khayyam_type_from_name(name) {
    var i = 0;
    while (i < 5) {
        if (str_eq(khayyam_type_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# ---------------------------------------------------------------------------
# HijriMonth discriminant for a serde identifier Str (islamic.cyr supplies the
# forward hijri_month_name(i); this is the parse-side inverse).
# ---------------------------------------------------------------------------

#must_use
fn hijri_month_from_name(name) {
    var mi = 0;
    while (mi < 12) {
        if (str_eq(hijri_month_name(mi), name) == 1) { return mi; }
        mi = mi + 1;
    }
    return 0 - 1;
}

# ---------------------------------------------------------------------------
# AlJabrSolution — {"form":"NAME","roots":[..],"coefficients":[a,b,c]}
# ---------------------------------------------------------------------------

# Serialize an AlJabrSolution to a JSON object string, byte-for-byte matching
# serde_json (compact, Rust field names, enum as variant-name string, f64s with
# a decimal point via the bayan value tree, tuple/vec as JSON arrays).
#must_use
fn aljabr_sol_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");

    # form → variant-name string
    sk_json_str(sb, "form", aljabr_form_name(aljabr_sol_form(p)));
    sk_json_sep(sb);

    # roots → JSON array of f64 numbers, built via the value tree so each keeps
    # its decimal point (e.g. [3.0,2.0]).
    sk_json_key(sb, "roots");
    var rarr = bayan_json_v_arr_new();
    var roots = aljabr_sol_roots(p);
    var rn = vec_len(roots);
    var ri = 0;
    while (ri < rn) {
        bayan_json_v_arr_push(rarr, bayan_json_v_float_new(vec_get(roots, ri)));
        ri = ri + 1;
    }
    str_builder_add(sb, bayan_json_v_build(rarr));
    sk_json_sep(sb);

    # coefficients (f64, f64, f64) → serde emits a tuple as a JSON array [a,b,c].
    sk_json_key(sb, "coefficients");
    var carr = bayan_json_v_arr_new();
    bayan_json_v_arr_push(carr, bayan_json_v_float_new(aljabr_sol_a(p)));
    bayan_json_v_arr_push(carr, bayan_json_v_float_new(aljabr_sol_b(p)));
    bayan_json_v_arr_push(carr, bayan_json_v_float_new(aljabr_sol_c(p)));
    str_builder_add(sb, bayan_json_v_build(carr));

    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a bayan value-tree node (from sk_json_parse) back into an
# AlJabrSolution via aljabr_sol_new.
#must_use
fn aljabr_sol_from_json(v) {
    var form_name = bayan_json_v_str(bayan_json_v_obj_get(v, "form"));
    var form = aljabr_form_from_name(form_name);

    # roots array → a fresh vec of f64 bit patterns.
    var rootsv = vec_new();
    var rarr = bayan_json_v_obj_get(v, "roots");
    var rn = bayan_json_v_arr_len(rarr);
    var ri = 0;
    while (ri < rn) {
        vec_push(rootsv, bayan_json_v_float(bayan_json_v_arr_get(rarr, ri)));
        ri = ri + 1;
    }

    # coefficients array → (a, b, c).
    var carr = bayan_json_v_obj_get(v, "coefficients");
    var a = bayan_json_v_float(bayan_json_v_arr_get(carr, 0));
    var b = bayan_json_v_float(bayan_json_v_arr_get(carr, 1));
    var c = bayan_json_v_float(bayan_json_v_arr_get(carr, 2));

    return aljabr_sol_new(form, rootsv, a, b, c);
}

# Field-by-field equality (Rust derives PartialEq). Enum via ==, f64 via f64_eq
# (value equality, mirroring Rust's f64 PartialEq), roots elementwise.
#must_use
fn aljabr_sol_eq(a, b) {
    var same = 1;
    if (aljabr_sol_form(a) != aljabr_sol_form(b)) { same = 0; }

    var ra = aljabr_sol_roots(a);
    var rb = aljabr_sol_roots(b);
    var na = vec_len(ra);
    var nb = vec_len(rb);
    if (na != nb) { same = 0; }
    if (na == nb) {
        var i = 0;
        while (i < na) {
            var fe = f64_eq(vec_get(ra, i), vec_get(rb, i));
            if (fe == 0) { same = 0; }
            i = i + 1;
        }
    }

    var ea = f64_eq(aljabr_sol_a(a), aljabr_sol_a(b));
    if (ea == 0) { same = 0; }
    var eb = f64_eq(aljabr_sol_b(a), aljabr_sol_b(b));
    if (eb == 0) { same = 0; }
    var ec = f64_eq(aljabr_sol_c(a), aljabr_sol_c(b));
    if (ec == 0) { same = 0; }

    return same;
}

# ---------------------------------------------------------------------------
# HijriDate — {"year":Y,"month":"NAME","day":D}
# ---------------------------------------------------------------------------

# Serialize a HijriDate. All fields are integer or enum → str_builder + sk_json_*
# suffice (no float path needed). month is the variant-name string.
#must_use
fn hijri_date_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "year", hijri_date_year(p));
    sk_json_sep(sb);
    sk_json_str(sb, "month", hijri_month_name(hijri_date_month(p)));
    sk_json_sep(sb);
    sk_json_int(sb, "day", hijri_date_day(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a bayan value-tree node back into a HijriDate via hijri_date_new.
#must_use
fn hijri_date_from_json(v) {
    var year = bayan_json_v_int(bayan_json_v_obj_get(v, "year"));
    var month_name = bayan_json_v_str(bayan_json_v_obj_get(v, "month"));
    var month = hijri_month_from_name(month_name);
    var day = bayan_json_v_int(bayan_json_v_obj_get(v, "day"));
    return hijri_date_new(year, month, day);
}

# Field-by-field equality (Rust derives PartialEq/Eq — all integer fields).
#must_use
fn hijri_date_eq(a, b) {
    if (hijri_date_year(a) != hijri_date_year(b)) { return 0; }
    if (hijri_date_month(a) != hijri_date_month(b)) { return 0; }
    if (hijri_date_day(a) != hijri_date_day(b)) { return 0; }
    return 1;
}

# --- serial_astro.cyr ---

# serial_astro.cyr — JSON (de)serialization for the astro module, matching
# Rust serde_json round-trip output EXACTLY (derived Serialize + Deserialize on
# CelestialCoord / EclipticCoord / HorizontalCoord / Star / StarName /
# HeliacalEvent / HeliacalEventType / AlignmentTarget / AlignmentResult).
#
# SELF-CONTAINED: no include lines. Uses the sk_json_* helpers (serial_util.cyr),
# the bayan value-tree API (folded stdlib), and the astro.cyr offset getters +
# <Enum>_name accessors. serde conventions reproduced:
#   struct → {"field":value,...} with the Rust snake_case field names.
#   enum unit variant → the variant-name JSON string via <Enum>_name(i).
#   AlignmentTarget::StarRising(StarName) → {"StarRising":"<starname>"} (serde
#     external tagging for a single-field tuple variant).
#   f64 → JSON number formatted by bayan (Grisu2, round-trip correct, matching
#     serde_json's shortest representation).

# ---------------------------------------------------------------------------
# Enum <-> variant-name mapping (deserialize side).
# ---------------------------------------------------------------------------

# Map a StarName variant name (cstr) back to its discriminant, or -1.
#must_use
fn starname_from_name(cstr) {
    var i = 0;
    while (i < 20) {
        if (str_eq_cstr(starname_name(i), cstr) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Map a HeliacalEventType variant name (cstr) back to its discriminant, or -1.
#must_use
fn heltype_from_name(cstr) {
    var j = 0;
    while (j < 2) {
        if (str_eq_cstr(heltype_name(j), cstr) == 1) { return j; }
        j = j + 1;
    }
    return 0 - 1;
}

# Map an AlignmentTarget variant name (cstr) back to its discriminant, or -1.
#must_use
fn alignmenttarget_from_name(cstr) {
    var k = 0;
    while (k < 7) {
        if (str_eq_cstr(alignmenttarget_name(k), cstr) == 1) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}

# ---------------------------------------------------------------------------
# Shared emit helpers.
# ---------------------------------------------------------------------------

# Append  "key":<number>  where bits is an f64 bit pattern. Formatted by bayan
# (Grisu2) so integer-valued and fractional f64 both match serde_json.
fn _astro_json_f64(sb, key, bits) {
    sk_json_key(sb, key);
    var fv = bayan_json_v_float_new(bits);
    str_builder_add(sb, bayan_json_v_build(fv));
    return 0;
}

# Emit an AlignmentTarget value into sb. Unit variants (target 0..5) emit the
# bare variant-name string; AT_STAR_RISING (6) emits {"StarRising":"<name>"}.
fn _at_emit(sb, target, starcode) {
    if (target == AT_STAR_RISING) {
        str_builder_add_cstr(sb, "{");
        sk_json_str(sb, "StarRising", starname_name(starcode));
        str_builder_add_cstr(sb, "}");
    } else {
        str_builder_add_json_str(sb, alignmenttarget_name(target));
    }
    return 0;
}

# ---------------------------------------------------------------------------
# CelestialCoord { ra_hours: f64, dec_degrees: f64 }
# ---------------------------------------------------------------------------

#must_use
fn celestial_coord_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    _astro_json_f64(sb, "ra_hours", cc_ra_hours(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "dec_degrees", cc_dec_degrees(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

#must_use
fn celestial_coord_from_json(v) {
    var ra = bayan_json_v_float(bayan_json_v_obj_get(v, "ra_hours"));
    var dec = bayan_json_v_float(bayan_json_v_obj_get(v, "dec_degrees"));
    return celestial_new(ra, dec);
}

#must_use
fn celestial_coord_eq(a, b) {
    if (f64_eq(cc_ra_hours(a), cc_ra_hours(b)) == 0) { return 0; }
    if (f64_eq(cc_dec_degrees(a), cc_dec_degrees(b)) == 0) { return 0; }
    return 1;
}

