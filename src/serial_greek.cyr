# serial_greek.cyr — JSON (de)serialization for the greek module, matching
# Rust serde_json exactly for full round-trip parity.
#
# Self-contained: no include lines. Uses the shared sk_json_* helpers from
# src/serial_util.cyr, the bayan value-tree API (folded stdlib), and the greek
# module's anti_new/anti_* accessors.
#
# Serde types in greek:
#   AntikytheraCycle  — struct { name: &str, period_years: &str,
#                                gear_teeth: u32, description: &str }
#     serde JSON: {"name":"Metonic","period_years":"19",
#                  "gear_teeth":235,"description":"..."}
#     name/period_years/description are STRINGS (period_years holds "19", a
#     quoted string, NOT the number 19). gear_teeth is an integer. No enums,
#     no f64, no nested/array/option fields in this module.
#
# Decoding (3.2.0) returns a Result as serde_json::from_str did: Ok(AntikytheraCycle)
# or Err(SKE_DESERIALIZE) with serde's message (the sk_de_* helpers in serial_util.cyr).
# The string fields are &'static str in Rust, so a non-string reads "expected a borrowed
# string" (serde's &str visitor) rather than String's "expected a string".

# ---------------------------------------------------------------------------
# AntikytheraCycle
# ---------------------------------------------------------------------------

# Serialize an AntikytheraCycle record to a JSON object string, byte-for-byte
# matching serde_json (compact, no spaces, Rust field names).
#must_use
fn anti_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_str(sb, "name", anti_name(p));
    sk_json_sep(sb);
    sk_json_str(sb, "period_years", anti_period_years(p));
    sk_json_sep(sb);
    sk_json_int(sb, "gear_teeth", anti_gear_teeth(p));
    sk_json_sep(sb);
    sk_json_str(sb, "description", anti_description(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# A Rust &'static str field key of object obj, as serde reads one: Ok(Str) for a JSON
# string, else Err "missing field" or "invalid type: ..., expected a borrowed string".
fn _acj_str_field(obj, key) {
    var n = sk_de_field(obj, key)?;
    var t, s = sk_de_str(n);
    if (is_ok(t) == 0) { return sk_de_invalid_type(n, "a borrowed string"); }
    return Ok(s);
}

# Deserialize an AntikytheraCycle from a bayan value node (an object, from sk_json_parse).
# Ok(AntikytheraCycle) or Err(SKE_DESERIALIZE), with serde's checks on the Rust field
# types: name, period_years and description &'static strs, gear_teeth a u32.
#must_use
fn anti_from_json(v) {
    var obj = sk_de_struct(v, "AntikytheraCycle")?;
    var name = _acj_str_field(obj, "name")?;
    var period = _acj_str_field(obj, "period_years")?;
    var teeth = sk_de_int_field(obj, "gear_teeth", 0, SK_U32_MAX, "u32")?;
    var desc = _acj_str_field(obj, "description")?;
    return Ok(anti_new(name, period, teeth, desc));
}

# Field-by-field equality of two AntikytheraCycle records (for round-trip
# testing). String fields compared with str_eq, the integer field with ==.
#must_use
fn anti_eq(a, b) {
    if (str_eq(anti_name(a), anti_name(b)) == 0) {
        return 0;
    }
    if (str_eq(anti_period_years(a), anti_period_years(b)) == 0) {
        return 0;
    }
    if (anti_gear_teeth(a) != anti_gear_teeth(b)) {
        return 0;
    }
    if (str_eq(anti_description(a), anti_description(b)) == 0) {
        return 0;
    }
    return 1;
}
