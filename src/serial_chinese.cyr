# serial_chinese.cyr — JSON (de)serialization for the chinese module.
#
# Full serde round-trip parity with the Rust derived Serialize + Deserialize on
# chinese.rs. Output matches serde_json::to_string EXACTLY (no spaces, Rust
# field names, unit enums as their variant-identifier string).
#
# serde types in chinese.rs:
#   RodNumeral      { value: i64 }
#   HeavenlyStem    (unit enum, 10 variants)   → JSON string "Jia" .. "Gui"
#   EarthlyBranch   (unit enum, 12 variants)   → JSON string "Zi"  .. "Hai"
#   SexagenaryYear  { stem, branch, cycle_position: u8 }
#
# The module exposes the serde variant identifiers via heavenly_stem_debug(i) /
# earthly_branch_debug(i) (the Rust {:?} identifier == the serde external tag for
# unit variants), so those are the "name" accessors used here. There is no f64
# field in this module — every numeric field is integer-valued, so sk_json_int is
# faithful and no bayan value-tree float path is needed.
#
# Decoding (3.2.0) returns a Result as serde_json::from_str did: Ok(value) or
# Err(SKE_DESERIALIZE) with serde's message (the sk_de_* helpers in serial_util.cyr).
#
# SELF-CONTAINED: no include lines. Relies on serial_util.cyr (sk_json_* / sk_de_*),
# chinese.cyr (constructors/getters/name accessors), bayan (folded stdlib parse
# tree), and str/vec stdlib — all resolved from the consumer's bundle.

# ---------------------------------------------------------------------------
# Enum name → discriminant reverse maps (module lacks *_from_name).
# The name is a Str, so compare with str_eq. Returns (0 - 1) when no variant
# matches. The decoders use sk_de_variant over the name vecs below instead.
# ---------------------------------------------------------------------------

# HeavenlyStem discriminant (0-9) for a serde identifier Str ("Jia" .. "Gui"), or (0 - 1)
# when none matches. name must be a non-null Str (str_eq dereferences it).
#must_use
fn heavenly_stem_from_name(name) {
    var i = 0;
    while (i < 10) {
        if (str_eq(heavenly_stem_debug(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# EarthlyBranch discriminant (0-11) for a serde identifier Str ("Zi" .. "Hai"), or (0 - 1)
# when none matches. name must be a non-null Str (str_eq dereferences it).
#must_use
fn earthly_branch_from_name(name) {
    var i = 0;
    while (i < 12) {
        if (str_eq(earthly_branch_debug(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Lazily built vecs of the serde identifiers, in discriminant order, for sk_de_variant.
# They share the Strs of heavenly_stem_debug / earthly_branch_debug. Do not mutate.
var _sxj_stem_names = 0;
var _sxj_branch_names = 0;

fn _sxj_stems() {
    if (_sxj_stem_names == 0) {
        var v = vec_new();
        var i = 0;
        while (i < 10) { vec_push(v, heavenly_stem_debug(i)); i = i + 1; }
        _sxj_stem_names = v;
    }
    return _sxj_stem_names;
}

fn _sxj_branches() {
    if (_sxj_branch_names == 0) {
        var v = vec_new();
        var i = 0;
        while (i < 12) { vec_push(v, earthly_branch_debug(i)); i = i + 1; }
        _sxj_branch_names = v;
    }
    return _sxj_branch_names;
}

# ---------------------------------------------------------------------------
# RodNumeral { value: i64 }  →  {"value":N}
# ---------------------------------------------------------------------------

# Serialize a RodNumeral to a JSON Str (bayan helpers), serde-exact: {"value":N}.
#must_use
fn rod_numeral_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "value", rod_value(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a RodNumeral from a bayan object node {"value":N}, as serde:
# Ok(RodNumeral) or Err(SKE_DESERIALIZE) — value must be present and a JSON integer (i64);
# a float such as 1.5 is "invalid type", as in serde.
#must_use
fn rod_numeral_from_json(v) {
    var obj = sk_de_struct(v, "RodNumeral")?;
    var val = sk_de_int_field(obj, "value", SK_I64_MIN, SK_I64_MAX, "i64")?;
    return Ok(rod_numeral_new(val));
}

# Structural equality of two RodNumerals (the value field): 1 if equal, else 0.
#must_use
fn rod_numeral_eq(a, b) {
    if (rod_value(a) != rod_value(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# HeavenlyStem (unit enum)  →  JSON string "Jia" .. "Gui"
# A standalone serde unit enum serializes to a bare JSON string.
# ---------------------------------------------------------------------------

# Serialize a HeavenlyStem discriminant to a bare JSON string Str ("Jia" .. "Gui"), matching
# serde's encoding of a unit variant.
#must_use
fn heavenly_stem_to_json(stem) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, heavenly_stem_debug(stem));
    return str_builder_build(sb);
}

# Deserialize a HeavenlyStem from a bayan value node holding a JSON string, as serde:
# Ok(discriminant 0-9), or Err(SKE_DESERIALIZE) "unknown variant" / "invalid type".
#must_use
fn heavenly_stem_from_json(v) {
    return sk_de_variant(v, _sxj_stems());
}

# HeavenlyStem equality on discriminants: 1 if a == b, else 0.
#must_use
fn heavenly_stem_eq(a, b) {
    if (a != b) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# EarthlyBranch (unit enum)  →  JSON string "Zi" .. "Hai"
# ---------------------------------------------------------------------------

# Serialize an EarthlyBranch discriminant to a bare JSON string Str ("Zi" .. "Hai"), matching
# serde's encoding of a unit variant.
#must_use
fn earthly_branch_to_json(branch) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, earthly_branch_debug(branch));
    return str_builder_build(sb);
}

# Deserialize an EarthlyBranch from a bayan value node holding a JSON string, as serde:
# Ok(discriminant 0-11), or Err(SKE_DESERIALIZE) "unknown variant" / "invalid type".
#must_use
fn earthly_branch_from_json(v) {
    return sk_de_variant(v, _sxj_branches());
}

# EarthlyBranch equality on discriminants: 1 if a == b, else 0.
#must_use
fn earthly_branch_eq(a, b) {
    if (a != b) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# SexagenaryYear { stem, branch, cycle_position }
#   →  {"stem":"Jia","branch":"Chen","cycle_position":41}
# Field order matches the Rust struct declaration (serde preserves it).
# ---------------------------------------------------------------------------

# Serialize a SexagenaryYear to a JSON Str in Rust field order, serde-exact, e.g.
# {"stem":"Jia","branch":"Chen","cycle_position":41}.
#must_use
fn sexagenary_year_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_str(sb, "stem", heavenly_stem_debug(sex_stem(p)));
    sk_json_sep(sb);
    sk_json_str(sb, "branch", earthly_branch_debug(sex_branch(p)));
    sk_json_sep(sb);
    sk_json_int(sb, "cycle_position", sex_cycle_position(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a SexagenaryYear from a bayan value node (an object).
# Ok(SexagenaryYear) or Err(SKE_DESERIALIZE), with serde's checks on the Rust field types:
# stem a HeavenlyStem variant, branch an EarthlyBranch variant, cycle_position a u8. No
# validation that the pair or the position is consistent (serde's derive does none).
#must_use
fn sexagenary_year_from_json(v) {
    var obj = sk_de_struct(v, "SexagenaryYear")?;
    var stem = sk_de_variant_field(obj, "stem", _sxj_stems())?;
    var branch = sk_de_variant_field(obj, "branch", _sxj_branches())?;
    var pos = sk_de_int_field(obj, "cycle_position", 0, SK_U8_MAX, "u8")?;
    return Ok(sexagenary_year_new(stem, branch, pos));
}

# Structural equality of two SexagenaryYears (stem, branch, cycle_position): 1 or 0.
#must_use
fn sexagenary_year_eq(a, b) {
    if (sex_stem(a) != sex_stem(b)) { return 0; }
    if (sex_branch(a) != sex_branch(b)) { return 0; }
    if (sex_cycle_position(a) != sex_cycle_position(b)) { return 0; }
    return 1;
}
