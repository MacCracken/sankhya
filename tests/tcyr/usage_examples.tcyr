# usage_examples.tcyr — every code sample in docs/guides/usage.md, compiled and checked.
#
# The guide's samples drifted from the API (the pre-6.6 one-value Result, names that do
# not exist, a month index of 12); that went unnoticed because nothing compiled them.
# Each block below is the guide's sample verbatim, followed by assertions on the values
# the guide states in its comments. Edit the two together.
include "src/lib.cyr"

# Assert that v is non-zero (truthy), labelled name in the failure report.
fn ok(v, name) { return assert_neq(v, 0, name); }

# Mayan Long Count, Tzolkin / Haab / Venus, vigesimal, Calendar Round search.
fn ex_mayan() {
    # Long Count for December 21, 2012 (JDN 2456283)
    var r_t, r_v = long_count_from_julian_day(2456283);
    if (is_ok(r_t) == 1) {
        var lc = result_unwrap(r_t, r_v);
        var s = longcount_to_str(lc);        # "13.0.0.0.0"
        var bak = lc_baktun(lc);             # 13
        var kin = lc_kin(lc);                # 0
        ok(str_eq_cstr(s, "13.0.0.0.0"), "usage: Long Count 13.0.0.0.0");
        assert_eq(bak, 13, "usage: baktun 13");
        assert_eq(kin, 0, "usage: kin 0");
    }
    ok(is_ok(r_t), "usage: long_count_from_julian_day ok");

    # Tzolkin / Haab / Venus for a later date (JDN 2461031)
    var days = 2461031 - EPOCH_JDN;          # EPOCH_JDN = 584283
    var tzolkin = tzolkin_from_days(days);   # tzolkin_to_str(tzolkin)
    var haab = haab_from_days(days);         # haab_to_str(haab)
    var phase = venus_phase(days);           # VenusPhase code -> venusphase_name(phase)
    ok(str_len(tzolkin_to_str(tzolkin)) > 0, "usage: tzolkin_to_str");
    ok(str_len(haab_to_str(haab)) > 0, "usage: haab_to_str");
    ok(str_len(venusphase_name(phase)) > 0, "usage: venusphase_name");

    # Vigesimal (base-20)
    var vig = to_vigesimal(8000);            # vec [1, 0, 0, 0]
    assert_eq(vec_len(vig), 4, "usage: 8000 has 4 vigesimal digits");
    assert_eq(vec_get(vig, 0), 1, "usage: 8000 = 1.0.0.0");

    # Calendar Round forward search: next 4 Ahau 8 Kumku after day 1
    var cr_t, cr_v = find_calendar_round(4, DS_AHAU, 8, HM_KUMKU, 1);   # Ok(18980)
    assert_eq(result_unwrap(cr_t, cr_v), 18980, "usage: next 4 Ahau 8 Kumku is day 18980");
    return 0;
}

# Babylonian sqrt, sexagesimal, Plimpton 322, Saros.
fn ex_babylonian() {
    var r_t, r_v = babylonian_sqrt(f64_from(2), 10);
    if (is_ok(r_t) == 1) {
        var sqrt2 = result_unwrap(r_t, r_v);   # f64 ~ 1.414213562373095
        ok(f64_approx_eq(sqrt2, f64_parse("1.414213562373095"), f64_parse("0.000000000000001")), "usage: sqrt2");
    }
    var sx = to_sexagesimal(3600);           # vec [1, 0, 0]
    assert_eq(vec_len(sx), 3, "usage: 3600 = 1;0;0");
    var triples = generate_plimpton_triples();   # vec of the 15 tablet rows
    assert_eq(vec_len(triples), 15, "usage: 15 Plimpton rows");
    var next = saros_cycle(f64_from(2451545));   # f64 JDN one Saros (6585.32 days) later
    ok(f64_gt(next, f64_from(2451545)), "usage: saros_cycle later");
    return 0;
}

# Greek: sieve, gcd/lcm, Archimedes' bounds, phi, Antikythera.
fn ex_greek() {
    var primes = sieve(100);                 # vec [2, 3, 5, 7, 11, ... , 97]
    var n = vec_len(primes);                 # 25
    assert_eq(n, 25, "usage: 25 primes below 100");
    var g = greek_gcd(48, 18);               # 6
    var l = greek_lcm(12, 18);               # 36
    assert_eq(g, 6, "usage: gcd 6");
    assert_eq(l, 36, "usage: lcm 36");
    # Archimedes' bounds on pi after 5 doublings (a register pair: inner, outer)
    var lo, hi = archimedes_pi(5);
    ok(f64_lt(lo, F64_PI) == 1 && f64_gt(hi, F64_PI) == 1, "usage: archimedes bounds bracket pi");
    var phi = greek_phi();                   # f64 ~ 1.618033988749895
    var ratio = fibonacci_ratio(40);         # f64 -> approaches phi
    ok(f64_approx_eq(phi, ratio, f64_parse("0.000000000001")), "usage: fibonacci ratio -> phi");
    var gears = antikythera_gear_ratios();   # vec of named cycles
    ok(vec_len(gears) > 0, "usage: antikythera gears");
    return 0;
}

# Roman numerals: conversion, parsing, arithmetic, validation.
fn ex_roman() {
    var r_t, r_v = to_roman_str(1776);
    var s = result_unwrap(r_t, r_v);         # "MDCCLXXVI"
    ok(str_eq_cstr(s, "MDCCLXXVI"), "usage: 1776 = MDCCLXXVI");
    var v_t, v_v = from_roman(str_from("MCMXCIX"));
    var n = result_unwrap(v_t, v_v);         # 1999
    assert_eq(n, 1999, "usage: MCMXCIX = 1999");
    # Arithmetic on values: each returns a Result of a RomanNumeral
    var sum_t, sum_v = roman_add(1776, 248);         # Ok(MMXXIV)
    assert_eq(romannum_value(result_unwrap(sum_t, sum_v)), 2024, "usage: 1776 + 248");
    var q_t, q_v = roman_divide(17, 5);              # Ok(quotient III, remainder II)
    ok(is_ok(q_t), "usage: roman_divide ok");
    # Validation (1/0, never panics)
    var good = is_valid_roman(str_from("XIV"));      # 1
    var bad = is_valid_roman(str_from("IIII"));      # 0
    assert_eq(good, 1, "usage: XIV valid");
    assert_eq(bad, 0, "usage: IIII invalid");
    return 0;
}

# Cross-calendar convert() and the epoch helpers.
fn ex_convert() {
    # Gregorian 2012-12-21 -> all systems (months are 0-based enum codes: GM_DECEMBER)
    var greg = gregorian_date_new(2012, GM_DECEMBER, 21);
    var r_t, r_v = convert(caldate_gregorian(greg));
    if (is_ok(r_t) == 1) {
        var mcd = result_unwrap(r_t, r_v);
        var jdn = mcd_jdn(mcd);              # f64 Julian Day Number (2456282.5)
        var lc = mcd_mayan_lc(mcd);          # Long Count record (0 before the epoch)
        var age = mcd_age(mcd);              # precessional AgePosition record
        ok(f64_eq(jdn, f64_parse("2456282.5")), "usage: 2012-12-21 = JD 2456282.5");
        ok(str_eq_cstr(longcount_to_str(lc), "13.0.0.0.0"), "usage: convert -> 13.0.0.0.0");
        assert_eq(ap_age(age), PA_PISCES, "usage: Age of Pisces");
    }
    ok(is_ok(r_t), "usage: convert ok");
    # Direct JDN correlation (no CalendarDate wrapper); no init call is needed
    var c_t, c_v = correlate(J2000_JDN);
    ok(is_ok(c_t), "usage: correlate(J2000) ok");
    var bp = bp_to_jdn(f64_from(12800));     # 12,800 years Before Present -> JDN
    ok(f64_lt(bp, f64_from(0)), "usage: 12,800 BP is before JD 0");
    var pos = precessional_age(J2000_JDN);   # AgePosition record
    assert_eq(ap_age(pos), PA_PISCES, "usage: J2000 is Pisces");
    var sages = seven_sages();               # vec of the six Seven Sages traditions
    assert_eq(vec_len(sages), 6, "usage: six traditions");
    return 0;
}

# JSON round trip through the serial layer.
fn ex_json() {
    var r_t, r_v = long_count_from_julian_day(2456283);
    var lc = result_unwrap(r_t, r_v);
    var js = longcount_to_json(lc);          # {"baktun":13,"katun":0,"tun":0,"uinal":0,"kin":0}
    var back = longcount_from_json(sk_json_parse(js));
    var same = longcount_eq(lc, back);       # 1
    assert_eq(same, 1, "usage: Long Count JSON round trip");
    ok(str_eq_cstr(js, "{\"baktun\":13,\"katun\":0,\"tun\":0,\"uinal\":0,\"kin\":0}"), "usage: Long Count JSON text");
    return 0;
}

# Run every usage-guide example and print the assert_summary; returns its exit code.
fn main() {
    alloc_init();
    ex_mayan();
    ex_babylonian();
    ex_greek();
    ex_roman();
    ex_convert();
    ex_json();
    return assert_summary();
}

var rc = main();
syscall(SYS_EXIT, rc);
