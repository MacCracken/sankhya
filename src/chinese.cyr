# chinese.cyr — Chinese mathematics (was src/chinese.rs).
#
# Counting-rod numerals (i64 wrapper with ASCII rod-art Display + wrapping
# add/sub/mul), the Chinese Remainder Theorem (Sun Tzu's algorithm via extended
# Euclid modular inverse), magic-square construction (hardcoded Lo Shu 3x3 +
# Siamese method for odd n) with a verifier, and the 60-year sexagenary cycle
# (10 Heavenly Stems x 12 Earthly Branches / zodiac animals) from a Gregorian
# year or a JDN.
#
# SELF-CONTAINED: no include lines (the distlib bundler strips them; stdlib +
# error/util/f64_util/logging/gregorian + varna symbols resolve from the
# consumer's bundle).
#
# Parity notes vs Rust:
#   * u64/u128/i128 all collapse to i64. The Rust CRT accumulates the product of
#     moduli in u128 (checked_mul) and does `r*p % product * inv % product` in
#     u128, with mod_inverse in i128. This port reduces every product modulo
#     `product` via a Russian-peasant _mulmod, so results are EXACT as long as
#     the product of all moduli fits below 2^62 (0x3FFFFFFFFFFFFFFF). For the
#     sexagenary moduli (10*12=120) and every historically meaningful CRT this
#     holds. Where the moduli product would exceed that bound, this port returns
#     0 (None) — matching Rust's checked_mul-None on u128 overflow, but at a
#     smaller threshold than Rust's ~3.4e38.
#   * unsigned_abs() on RodNumeral::MIN (i64::MIN) would be 2^63 in Rust; the
#     i64 int_abs here overflows to i64::MIN. Not exercised by any test.
#   * rem_euclid on (year - 4) reproduces the Rust Euclidean remainder so BCE /
#     negative years anchor correctly.

# ---------------------------------------------------------------------------
# Rod numerals — RodNumeral { value: i64 } (8 bytes)
# ---------------------------------------------------------------------------

enum RodNumOff { ROD_VALUE = 0; ROD_SIZE = 8; }

#must_use
fn rod_numeral_new(value) {
    var p = alloc(ROD_SIZE);
    store64(p + ROD_VALUE, value);
    return p;
}

#must_use
fn rod_value(p) { return load64(p + ROD_VALUE); }

# Add two rod numerals (2's-complement wrapping — matches Rust wrapping_add).
#must_use
fn rod_add(a, b) { return rod_numeral_new(rod_value(a) + rod_value(b)); }

# Subtract two rod numerals (wrapping_sub).
#must_use
fn rod_subtract(a, b) { return rod_numeral_new(rod_value(a) - rod_value(b)); }

# Multiply two rod numerals (wrapping_mul).
#must_use
fn rod_multiply(a, b) { return rod_numeral_new(rod_value(a) * rod_value(b)); }

# Display: ASCII rod-art. Zero -> "[ ]". Otherwise sign + "[" + per-digit rods
# ("|" in odd places-from-right, "-" in even; "+" prefix for digits > 5) + "]".
#must_use
fn rod_numeral_to_str(p) {
    var value = rod_value(p);
    if (value == 0) { return str_from("[ ]"); }

    var abs_val = value;
    if (value < 0) { abs_val = 0 - value; }

    var sb = str_builder_new();
    if (value < 0) { str_builder_add_cstr(sb, "-"); }
    str_builder_add_cstr(sb, "[");

    # Collect decimal digits least-significant-first.
    var digs = vec_new();
    var n = abs_val;
    while (n > 0) {
        vec_push(digs, n % 10);
        n = n / 10;
    }

    var dlen = vec_len(digs);
    var i = 0;
    while (i < dlen) {
        var digit = vec_get(digs, dlen - 1 - i);
        if (i > 0) { str_builder_add_cstr(sb, " "); }
        var pos_from_right = dlen - 1 - i;
        var rod_char = 124;
        if (pos_from_right % 2 != 0) { rod_char = 45; }
        if (digit == 0) {
            str_builder_add_cstr(sb, " ");
        }
        if (digit != 0) {
            var cnt = digit;
            if (cnt > 5) { cnt = 5; }
            var k = 0;
            while (k < cnt) { str_builder_add_byte(sb, rod_char); k = k + 1; }
            if (digit > 5) {
                str_builder_add_cstr(sb, "+");
                var extra = digit - 5;
                var e = 0;
                while (e < extra) { str_builder_add_byte(sb, rod_char); e = e + 1; }
            }
        }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return str_builder_build(sb);
}

# ---------------------------------------------------------------------------
# Chinese Remainder Theorem
# ---------------------------------------------------------------------------

# (a * b) mod m without i64 overflow, via Russian-peasant doubling. Exact for
# a, b >= 0 and m < 2^62 (so result+x and x+x stay below i64 max).
#must_use
fn _mulmod(a, b, m) {
    var result = 0;
    var x = a % m;
    var y = b;
    while (y > 0) {
        var bit = y & 1;
        if (bit == 1) { result = (result + x) % m; }
        x = (x + x) % m;
        y = y >> 1;
    }
    return result;
}

# Modular multiplicative inverse of a mod m via extended Euclid. Returns 1 and
# writes the inverse to *out if gcd(a,m)==1; returns 0 (no inverse) otherwise.
#must_use
fn mod_inverse(a, m, out) {
    if (m == 1) { store64(out, 0); return 1; }

    var old_r = a;
    var r = m;
    var old_s = 1;
    var s = 0;
    while (r != 0) {
        var quotient = old_r / r;
        var tr = r;
        r = old_r - quotient * r;
        old_r = tr;
        var ts = s;
        s = old_s - quotient * s;
        old_s = ts;
    }

    if (old_r != 1) { return 0; }

    # Ensure a non-negative representative (old_s may be negative; truncated %
    # matches Rust's i128 `((old_s % m) + m) % m`).
    var res = ((old_s % m) + m) % m;
    store64(out, res);
    return 1;
}

# Solve a system of congruences (Sun Tzu's algorithm).
# `pairs` is a vec of 16-byte records { remainder(offset 0), modulus(offset 8) }.
# Returns 1 and writes the smallest non-negative solution to *out when a unique
# solution mod (product of moduli) exists; returns 0 (None) if the input is
# empty, any modulus is 0, the moduli are not pairwise coprime, or the product
# overflows the safe _mulmod bound.
#must_use
fn chinese_remainder(pairs, out) {
    var count = vec_len(pairs);
    if (count == 0) { return 0; }

    var i = 0;
    while (i < count) {
        var pr = vec_get(pairs, i);
        if (load64(pr + 8) == 0) { return 0; }
        i = i + 1;
    }

    # Single congruence: x = r (mod m).
    if (count == 1) {
        var p0 = vec_get(pairs, 0);
        store64(out, load64(p0) % load64(p0 + 8));
        return 1;
    }

    # Product of all moduli (checked against the _mulmod safe bound).
    var product = 1;
    var MULMOD_LIMIT = 0x3FFFFFFFFFFFFFFF;
    i = 0;
    while (i < count) {
        var pm = load64(vec_get(pairs, i) + 8);
        if (product > MULMOD_LIMIT / pm) { return 0; }
        product = product * pm;
        i = i + 1;
    }

    var sum = 0;
    i = 0;
    while (i < count) {
        var pr2 = vec_get(pairs, i);
        var remainder = load64(pr2);
        var modulus = load64(pr2 + 8);
        var p = product / modulus;

        var inv = 0;
        var have_inv = mod_inverse(p % modulus, modulus, &inv);
        if (have_inv == 0) { return 0; }

        # sum = (sum + r*p % product * inv % product) % product
        var t1 = _mulmod(remainder, p, product);
        var t2 = _mulmod(t1, inv, product);
        sum = (sum + t2) % product;
        i = i + 1;
    }

    store64(out, sum);
    return 1;
}

# Convenience: build a { remainder, modulus } pair record.
#must_use
fn crt_pair(remainder, modulus) {
    var p = alloc(16);
    store64(p, remainder);
    store64(p + 8, modulus);
    return p;
}

# ---------------------------------------------------------------------------
# Magic squares (row-major vec of row-vecs of i64)
# ---------------------------------------------------------------------------

fn _magic_row3(a, b, c) {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    return v;
}

# Magic square of order n. Returns a vec of n row-vecs, or 0 (None) for n < 3 or
# even n. n==3 is the historical Lo Shu; odd n>3 uses the Siamese method.
#must_use
fn magic_square(n) {
    if (n < 3) { return 0; }
    if (n % 2 == 0) { return 0; }

    if (n == 3) {
        var lo = vec_new();
        vec_push(lo, _magic_row3(2, 7, 6));
        vec_push(lo, _magic_row3(9, 5, 1));
        vec_push(lo, _magic_row3(4, 3, 8));
        return lo;
    }

    # Allocate an n x n grid of zeros.
    var square = vec_new();
    var mri = 0;
    while (mri < n) {
        var row = vec_new();
        var mci = 0;
        while (mci < n) {
            vec_push(row, 0);
            mci = mci + 1;
        }
        vec_push(square, row);
        mri = mri + 1;
    }

    # Siamese method: start top-center, move up-right, drop down when occupied.
    var row_i = 0;
    var col_i = n / 2;
    var num = 1;
    var total = n * n;
    while (num <= total) {
        vec_set(vec_get(square, row_i), col_i, num);

        var new_row = n - 1;
        if (row_i != 0) { new_row = row_i - 1; }
        var new_col = (col_i + 1) % n;

        var occ = vec_get(vec_get(square, new_row), new_col);
        if (occ != 0) {
            row_i = (row_i + 1) % n;
        }
        if (occ == 0) {
            row_i = new_row;
            col_i = new_col;
        }
        num = num + 1;
    }

    return square;
}

# Verify a square (vec of row-vecs) is magic: square, and all rows / columns /
# both diagonals share one sum. Returns 1 (true) or 0 (false).
#must_use
fn is_magic_square(square) {
    var n = vec_len(square);
    if (n == 0) { return 0; }

    var ci = 0;
    while (ci < n) {
        var row = vec_get(square, ci);
        if (vec_len(row) != n) { return 0; }
        ci = ci + 1;
    }

    var magic_sum = 0;
    var row0 = vec_get(square, 0);
    var j = 0;
    while (j < n) {
        magic_sum = magic_sum + vec_get(row0, j);
        j = j + 1;
    }

    # Rows.
    var ri = 0;
    while (ri < n) {
        var r = vec_get(square, ri);
        var rs = 0;
        var k = 0;
        while (k < n) {
            rs = rs + vec_get(r, k);
            k = k + 1;
        }
        if (rs != magic_sum) { return 0; }
        ri = ri + 1;
    }

    # Columns.
    var col = 0;
    while (col < n) {
        var cs = 0;
        var rr = 0;
        while (rr < n) {
            cs = cs + vec_get(vec_get(square, rr), col);
            rr = rr + 1;
        }
        if (cs != magic_sum) { return 0; }
        col = col + 1;
    }

    # Main diagonal.
    var ds = 0;
    var di = 0;
    while (di < n) {
        ds = ds + vec_get(vec_get(square, di), di);
        di = di + 1;
    }
    if (ds != magic_sum) { return 0; }

    # Anti-diagonal.
    var anti_s = 0;
    var ai = 0;
    while (ai < n) {
        anti_s = anti_s + vec_get(vec_get(square, ai), n - 1 - ai);
        ai = ai + 1;
    }
    if (anti_s != magic_sum) { return 0; }

    return 1;
}

# ---------------------------------------------------------------------------
# Sexagenary cycle: Heavenly Stems (10) + Earthly Branches (12)
# ---------------------------------------------------------------------------

enum HeavenlyStem {
    HS_JIA; HS_YI; HS_BING; HS_DING; HS_WU;
    HS_JI; HS_GENG; HS_XIN; HS_REN; HS_GUI;
}

enum EarthlyBranch {
    EB_ZI; EB_CHOU; EB_YIN; EB_MAO; EB_CHEN; EB_SI;
    EB_WU; EB_WEI; EB_SHEN; EB_YOU; EB_XU; EB_HAI;
}

# Display names for the 10 stems: "pinyin (CJK)".
var _stem_disp = 0;
var _stem_disp_done = 0;
fn _build_stem_disp() {
    var v = vec_new();
    vec_push(v, str_from("Jiǎ (甲)"));
    vec_push(v, str_from("Yǐ (乙)"));
    vec_push(v, str_from("Bǐng (丙)"));
    vec_push(v, str_from("Dīng (丁)"));
    vec_push(v, str_from("Wù (戊)"));
    vec_push(v, str_from("Jǐ (己)"));
    vec_push(v, str_from("Gēng (庚)"));
    vec_push(v, str_from("Xīn (辛)"));
    vec_push(v, str_from("Rén (壬)"));
    vec_push(v, str_from("Guǐ (癸)"));
    return v;
}
fn _stem_disp_table() {
    if (_stem_disp_done == 0) {
        _stem_disp = _build_stem_disp();
        _stem_disp_done = 1;
    }
    return _stem_disp;
}

