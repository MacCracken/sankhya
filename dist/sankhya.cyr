}

# Deserialize a HeliacalEvent from a bayan value node (an object), as serde:
# Ok(fresh HeliacalEvent) or Err(SKE_DESERIALIZE). jdn is a required f64; star and
# event_type are required StarName / HeliacalEventType variant strings.
#must_use
fn heliacal_event_from_json(v) {
    var obj = sk_de_struct(v, "HeliacalEvent")?;
    var jdn = sk_de_f64_field(obj, "jdn")?;
    var sncode = sk_de_variant_field(obj, "star", _astro_starname_names())?;
    var etcode = sk_de_variant_field(obj, "event_type", _astro_heltype_names())?;
    return Ok(heliacal_event_new(jdn, sncode, etcode));
}

# Structural equality of two HeliacalEvents (jdn via f64_eq, codes via ==):
# 1 or 0.
#must_use
fn heliacal_event_eq(a, b) {
    if (f64_eq(he_jdn(a), he_jdn(b)) == 0) { return 0; }
    if (he_star(a) != he_star(b)) { return 0; }
    if (he_event_type(a) != he_event_type(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# AlignmentTarget (6 unit variants + StarRising(StarName)). Because the ported
# module stores the carried StarName alongside the target code, the serializer
# takes (target, starcode) and the decoder returns Ok(a 16-byte {target, star}
# record); starcode is -1 for unit variants.
# ---------------------------------------------------------------------------

# AlignmentTarget value record: { target: AT_* code, star: StarName code or -1 } — 16 bytes.
enum AtvOff { ATV_TARGET = 0; ATV_STAR = 8; ATV_SIZE = 16; }

# Allocate an AlignmentTarget value record: target (AT_* code) and star (the StarName
# code carried by AT_STAR_RISING, -1 for the unit variants). alignmenttarget_from_json's Ok.
#must_use
fn alignmenttarget_new(target, star) {
    var p = alloc(ATV_SIZE);
    store64(p + ATV_TARGET, target);
    store64(p + ATV_STAR, star);
    return p;
}
# AlignmentTarget value field: the AT_* code.
#must_use
fn atv_target(p) { return load64(p + ATV_TARGET); }
# AlignmentTarget value field: the StarName code for AT_STAR_RISING, -1 otherwise.
#must_use
fn atv_star(p) { return load64(p + ATV_STAR); }

# Serialize an AlignmentTarget (target code + starcode) to a JSON Str: unit
# variants as their name string, AT_STAR_RISING as {"StarRising":"<star>"}.
#must_use
fn alignmenttarget_to_json(target, starcode) {
    var sb = str_builder_new();
    _at_emit(sb, target, starcode);
    return str_builder_build(sb);
}

# Deserialize an AlignmentTarget, as serde's externally tagged enum: Ok(alignmenttarget_new
# record; read it with atv_target / atv_star) or Err(SKE_DESERIALIZE). Accepts what
# alignmenttarget_to_json writes: a unit variant as its name string ("EquinoxSunrise") and
# StarRising as {"StarRising":"<StarName>"}. Also, as serde_json, a unit variant in map form
# with a null value ({"EquinoxSunrise":null}). Errors: unknown variant (string or key), the
# string "StarRising" ("invalid type: unit variant, expected newtype variant"), a map without
# exactly one key, a bad StarName payload, a non-null unit payload ("expected unit"), and any
# other JSON type ("expected enum AlignmentTarget").
#must_use
fn alignmenttarget_from_json(v) {
    var names = _astro_target_names();
    var st, sv = sk_de_str(v);
    if (is_ok(st) == 1) {
        var ui = sk_de_variant(v, names)?;
        if (ui == AT_STAR_RISING) {
            return sk_de_fail(str_from("invalid type: unit variant, expected newtype variant"));
        }
        return Ok(alignmenttarget_new(ui, 0 - 1));
    }
    var ti = sk_de_tagged(v, names, "AlignmentTarget")?;
    var payload = bayan_json_v_obj_val(v, 0);
    if (ti == AT_STAR_RISING) {
        var sncode = starname_from_json(payload)?;
        return Ok(alignmenttarget_new(AT_STAR_RISING, sncode));
    }
    var unit = sk_de_opt_field(v, str_cstr(vec_get(names, ti)))?;
    if (unit != 0) { return sk_de_invalid_type(payload, "unit"); }
    return Ok(alignmenttarget_new(ti, 0 - 1));
}

# Equality of two (target, starcode) AlignmentTarget pairs: 1 or 0. The
# starcodes are compared only when the target is AT_STAR_RISING.
#must_use
fn alignmenttarget_eq(ta, sa, tb, sb) {
    if (ta != tb) { return 0; }
    if (ta == AT_STAR_RISING) {
        if (sa != sb) { return 0; }
    }
    return 1;
}

# ---------------------------------------------------------------------------
# AlignmentResult { target: AlignmentTarget, azimuth: f64, deviation: f64 }
# ---------------------------------------------------------------------------

# Serialize an AlignmentResult to a JSON Str: {"target":..,"azimuth":..,
# "deviation":..}, target encoded as in alignmenttarget_to_json.
#must_use
fn alignment_result_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_key(sb, "target");
    _at_emit(sb, ar_target(p), ar_star(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "azimuth", ar_azimuth(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "deviation", ar_deviation(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize an AlignmentResult from a bayan value node (an object), as serde:
# Ok(fresh AlignmentResult) or Err(SKE_DESERIALIZE). target is a required AlignmentTarget
# (decoded by alignmenttarget_from_json); azimuth and deviation are required f64.
#must_use
fn alignment_result_from_json(v) {
    var obj = sk_de_struct(v, "AlignmentResult")?;
    var tnode = sk_de_field(obj, "target")?;
    var at = alignmenttarget_from_json(tnode)?;
    var az = sk_de_f64_field(obj, "azimuth")?;
    var dev = sk_de_f64_field(obj, "deviation")?;
    return Ok(alignment_result_new(atv_target(at), atv_star(at), az, dev));
}

# Structural equality of two AlignmentResults (target pair via
# alignmenttarget_eq, azimuth and deviation via f64_eq): 1 or 0.
#must_use
fn alignment_result_eq(a, b) {
    if (alignmenttarget_eq(ar_target(a), ar_star(a), ar_target(b), ar_star(b)) == 0) { return 0; }
    if (f64_eq(ar_azimuth(a), ar_azimuth(b)) == 0) { return 0; }
    if (f64_eq(ar_deviation(a), ar_deviation(b)) == 0) { return 0; }
    return 1;
}

# --- serial_chinese.cyr ---

# serial_chinese.cyr — JSON (de)serialization for the chinese module.
#
# Full serde round-trip parity with the Rust derived Serialize + Deserialize on
# chinese.rs. Output matches serde_json::to_string EXACTLY (no spaces, Rust
# field names, unit enums as their variant-identifier string).
#
# serde types in chinese.rs:
#   RodNumeral      { value: i64 }
#   HeavenlyStem    (unit enum, 10 variants)   → JSON string "Jia" .. "Gui"
#   EarthlyBranch   (unit enum, 12 variants)   → JSON string "Zi"  .. "Hai"
#   SexagenaryYear  { stem, branch, cycle_position: u8 }
#
# The module exposes the serde variant identifiers via heavenly_stem_debug(i) /
# earthly_branch_debug(i) (the Rust {:?} identifier == the serde external tag for
# unit variants), so those are the "name" accessors used here. There is no f64
# field in this module — every numeric field is integer-valued, so sk_json_int is
# faithful and no bayan value-tree float path is needed.
#
# Decoding (3.2.0) returns a Result as serde_json::from_str did: Ok(value) or
# Err(SKE_DESERIALIZE) with serde's message (the sk_de_* helpers in serial_util.cyr).
#
# SELF-CONTAINED: no include lines. Relies on serial_util.cyr (sk_json_* / sk_de_*),
# chinese.cyr (constructors/getters/name accessors), bayan (folded stdlib parse
# tree), and str/vec stdlib — all resolved from the consumer's bundle.

# ---------------------------------------------------------------------------
# Enum name → discriminant reverse maps (module lacks *_from_name).
# The name is a Str, so compare with str_eq. Returns (0 - 1) when no variant
# matches. The decoders use sk_de_variant over the name vecs below instead.
# ---------------------------------------------------------------------------

# HeavenlyStem discriminant (0-9) for a serde identifier Str ("Jia" .. "Gui"), or (0 - 1)
# when none matches. name must be a non-null Str (str_eq dereferences it).
#must_use
fn heavenly_stem_from_name(name) {
    var i = 0;
    while (i < 10) {
        if (str_eq(heavenly_stem_debug(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# EarthlyBranch discriminant (0-11) for a serde identifier Str ("Zi" .. "Hai"), or (0 - 1)
# when none matches. name must be a non-null Str (str_eq dereferences it).
#must_use
fn earthly_branch_from_name(name) {
    var i = 0;
    while (i < 12) {
        if (str_eq(earthly_branch_debug(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Lazily built vecs of the serde identifiers, in discriminant order, for sk_de_variant.
# They share the Strs of heavenly_stem_debug / earthly_branch_debug. Do not mutate.
var _sxj_stem_names = 0;
var _sxj_branch_names = 0;

fn _sxj_stems() {
    if (_sxj_stem_names == 0) {
        var v = vec_new();
        var i = 0;
        while (i < 10) { vec_push(v, heavenly_stem_debug(i)); i = i + 1; }
        _sxj_stem_names = v;
    }
    return _sxj_stem_names;
}

fn _sxj_branches() {
    if (_sxj_branch_names == 0) {
        var v = vec_new();
        var i = 0;
        while (i < 12) { vec_push(v, earthly_branch_debug(i)); i = i + 1; }
        _sxj_branch_names = v;
    }
    return _sxj_branch_names;
}

# ---------------------------------------------------------------------------
# RodNumeral { value: i64 }  →  {"value":N}
# ---------------------------------------------------------------------------

# Serialize a RodNumeral to a JSON Str (bayan helpers), serde-exact: {"value":N}.
#must_use
fn rod_numeral_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "value", rod_value(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a RodNumeral from a bayan object node {"value":N}, as serde:
# Ok(RodNumeral) or Err(SKE_DESERIALIZE) — value must be present and a JSON integer (i64);
# a float such as 1.5 is "invalid type", as in serde.
#must_use
fn rod_numeral_from_json(v) {
    var obj = sk_de_struct(v, "RodNumeral")?;
    var val = sk_de_int_field(obj, "value", SK_I64_MIN, SK_I64_MAX, "i64")?;
    return Ok(rod_numeral_new(val));
}

# Structural equality of two RodNumerals (the value field): 1 if equal, else 0.
#must_use
fn rod_numeral_eq(a, b) {
    if (rod_value(a) != rod_value(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# HeavenlyStem (unit enum)  →  JSON string "Jia" .. "Gui"
# A standalone serde unit enum serializes to a bare JSON string.
# ---------------------------------------------------------------------------

# Serialize a HeavenlyStem discriminant to a bare JSON string Str ("Jia" .. "Gui"), matching
# serde's encoding of a unit variant.
#must_use
fn heavenly_stem_to_json(stem) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, heavenly_stem_debug(stem));
    return str_builder_build(sb);
}

# Deserialize a HeavenlyStem from a bayan value node holding a JSON string, as serde:
# Ok(discriminant 0-9), or Err(SKE_DESERIALIZE) "unknown variant" / "invalid type".
#must_use
fn heavenly_stem_from_json(v) {
    return sk_de_variant(v, _sxj_stems());
}

# HeavenlyStem equality on discriminants: 1 if a == b, else 0.
#must_use
fn heavenly_stem_eq(a, b) {
    if (a != b) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# EarthlyBranch (unit enum)  →  JSON string "Zi" .. "Hai"
# ---------------------------------------------------------------------------

# Serialize an EarthlyBranch discriminant to a bare JSON string Str ("Zi" .. "Hai"), matching
# serde's encoding of a unit variant.
#must_use
fn earthly_branch_to_json(branch) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, earthly_branch_debug(branch));
    return str_builder_build(sb);
}

# Deserialize an EarthlyBranch from a bayan value node holding a JSON string, as serde:
# Ok(discriminant 0-11), or Err(SKE_DESERIALIZE) "unknown variant" / "invalid type".
#must_use
fn earthly_branch_from_json(v) {
    return sk_de_variant(v, _sxj_branches());
}

# EarthlyBranch equality on discriminants: 1 if a == b, else 0.
#must_use
fn earthly_branch_eq(a, b) {
    if (a != b) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# SexagenaryYear { stem, branch, cycle_position }
#   →  {"stem":"Jia","branch":"Chen","cycle_position":41}
# Field order matches the Rust struct declaration (serde preserves it).
# ---------------------------------------------------------------------------

# Serialize a SexagenaryYear to a JSON Str in Rust field order, serde-exact, e.g.
# {"stem":"Jia","branch":"Chen","cycle_position":41}.
#must_use
fn sexagenary_year_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_str(sb, "stem", heavenly_stem_debug(sex_stem(p)));
    sk_json_sep(sb);
    sk_json_str(sb, "branch", earthly_branch_debug(sex_branch(p)));
    sk_json_sep(sb);
    sk_json_int(sb, "cycle_position", sex_cycle_position(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a SexagenaryYear from a bayan value node (an object).
# Ok(SexagenaryYear) or Err(SKE_DESERIALIZE), with serde's checks on the Rust field types:
# stem a HeavenlyStem variant, branch an EarthlyBranch variant, cycle_position a u8. No
# validation that the pair or the position is consistent (serde's derive does none).
#must_use
fn sexagenary_year_from_json(v) {
    var obj = sk_de_struct(v, "SexagenaryYear")?;
    var stem = sk_de_variant_field(obj, "stem", _sxj_stems())?;
    var branch = sk_de_variant_field(obj, "branch", _sxj_branches())?;
    var pos = sk_de_int_field(obj, "cycle_position", 0, SK_U8_MAX, "u8")?;
    return Ok(sexagenary_year_new(stem, branch, pos));
}

# Structural equality of two SexagenaryYears (stem, branch, cycle_position): 1 or 0.
#must_use
fn sexagenary_year_eq(a, b) {
    if (sex_stem(a) != sex_stem(b)) { return 0; }
    if (sex_branch(a) != sex_branch(b)) { return 0; }
    if (sex_cycle_position(a) != sex_cycle_position(b)) { return 0; }
    return 1;
}

# --- serial_persian.cyr ---

# serial_persian.cyr — JSON (de)serialization for the persian module, for full
# serde round-trip parity with Rust's derived Serialize + Deserialize.
#
# Rust serde emits:
#   PersianMonth  → the bare variant-name string, e.g. "Farvardin"
#   PersianDate   → {"year":<i64>,"month":"<Variant>","day":<u8>}  (declaration order)
#
# Decoding (3.2.0) returns a Result as serde_json::from_str did: Ok(value) or
# Err(SKE_DESERIALIZE) with serde's message (the sk_de_* helpers in serial_util.cyr).
#
# SELF-CONTAINED: no include lines. Uses the shared sk_json_* / sk_de_* helpers from
# serial_util.cyr and the persian module accessors (persian_month_names et al.).

# ---------------------------------------------------------------------------
# PersianMonth enum <-> serde variant-name string
# ---------------------------------------------------------------------------

# Map a variant-name Str back to the PersianMonth discriminant (0..11).
# Scans persian_month_name(i) for a match. Returns (0 - 1) if none matches.
#must_use
fn persian_month_from_name(name) {
    var i = 0;
    while (i < 12) {
        if (str_eq(persian_month_name(i), name) == 1) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Serialize a PersianMonth discriminant to a bare JSON string ("Farvardin").
#must_use
fn persian_month_to_json(m) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, persian_month_name(m));
    return str_builder_build(sb);
}

# Deserialize a PersianMonth from a bayan value node holding a JSON string, as serde:
# Ok(discriminant 0-11), or Err(SKE_DESERIALIZE) "unknown variant" / "invalid type".
#must_use
fn persian_month_from_json(v) {
    return sk_de_variant(v, persian_month_names());
}

# Equality of two PersianMonth discriminants (0/1).
#must_use
fn persian_month_eq(a, b) {
    if (a == b) {
        return 1;
    }
    return 0;
}

# ---------------------------------------------------------------------------
# PersianDate struct <-> {"year":i64,"month":"<Variant>","day":u8}
# ---------------------------------------------------------------------------

# Serialize a PersianDate pointer to serde-compact JSON. Field order matches
# the Rust struct declaration: year, month, day. The month enum is emitted as
# its serde variant-name string.
#must_use
fn persian_date_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "year", pd_year(p));
    sk_json_sep(sb);
    sk_json_str(sb, "month", persian_month_name(pd_month(p)));
    sk_json_sep(sb);
    sk_json_int(sb, "day", pd_day(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a PersianDate from a bayan value node (a JSON object).
# Ok(PersianDate) or Err(SKE_DESERIALIZE), with serde's checks on the Rust field types:
# year an i64, month a PersianMonth variant, day a u8. No calendar validation (a day of
# 40 decodes; persian_to_jdn rejects it).
#must_use
fn persian_date_from_json(v) {
    var obj = sk_de_struct(v, "PersianDate")?;
    var y = sk_de_int_field(obj, "year", SK_I64_MIN, SK_I64_MAX, "i64")?;
    var m = sk_de_variant_field(obj, "month", persian_month_names())?;
    var d = sk_de_int_field(obj, "day", 0, SK_U8_MAX, "u8")?;
    return Ok(persian_date_new(y, m, d));
}

# Field-by-field equality of two PersianDate pointers (0/1).
#must_use
fn persian_date_eq(a, b) {
    if (pd_year(a) != pd_year(b)) {
        return 0;
    }
    if (pd_month(a) != pd_month(b)) {
        return 0;
    }
    if (pd_day(a) != pd_day(b)) {
        return 0;
    }
    return 1;
}

# --- serial_epoch.cyr ---

# serial_epoch.cyr — JSON (de)serialization for the epoch module, the sankhya
# "Rosetta Stone" capstone, matching Rust serde_json for full round-trip parity.
#
# Serde types in rust-old/src/epoch.rs (all #[derive(Serialize, Deserialize)]):
#   PrecessionalAge  — unit enum   → serde emits the bare variant-name string.
#   Civilization     — unit enum   → bare variant-name string.
#   CycleName        — unit enum   → bare variant-name string.
#   SagesTradition   — struct { civilization, group_name, sage_names: Vec<str>,
#                               source_texts: Vec<str>, associated_stars,
#                               catastrophe_narrative }.
#   AgePosition      — struct { age: PrecessionalAge, years_into_age: f64,
#                               fraction: f64, vernal_point_longitude: f64 }.
#   CycleAlignment   — struct { jdn: f64, cycles: Vec<CycleName>,
#                               max_residual_days: f64 }.
#   MultiCalendarDate— the correlate() output: 18 fields incl. Option<> Mayan
#                      calendars, a (i32,u32,f64) sothic tuple, every nested
#                      calendar record, itihas eras/civilizations/events, and
#                      avatara saptarishi profiles.
#   CalendarDate     — #[non_exhaustive] data enum (externally tagged):
#                      {"Jdn":f64} / {"Gregorian":{..}} / ... / {"MayanLongCount":{..}}.
#
# serde format details handled here:
#   * Unit enum → bare JSON string via the module's <Enum>_name(i) accessor
#     (the serde identifier, NOT the integer, NOT the spaced Display string).
#   * Data enum → externally tagged single-key object {"Variant": value}.
#   * f64 → JSON number. Emitted through bayan's Grisu2 float formatter
#     (bayan_json_v_float_new(bits) + bayan_json_v_build) which is round-trip
#     correct: parsing the emitted text back with bayan_json_v_float reproduces
#     the exact bits, so f64 fields compare by bit-equality in *_eq.
#   * Option<T> None → null (JSON), Some(x) → the value.
#   * Vec<T> → JSON array. Tuple (i32,u32,f64) → JSON array [int,int,number].
#   * Nested struct → embedded object (this file carries private ep_* serializers
#     for every nested calendar record so the test needs only lib.cyr +
#     serial_util.cyr + serial_epoch.cyr — no other serial_<mod>.cyr).
#   * eras/civilizations/events → itihas's own era_to_json_into / civ_to_json_into /
#     event_to_json_into inside a JSON array, read back with itihas's era_from_json /
#     civ_from_json / event_from_json.
#   * saptarishi_profiles → Vec<(String, ArchetypeProfile)> as serde wrote it: an array
#     of [name, profile] tuples, the profile in avatara's profile_to_json_into shape
#     (the Rust avatara 1.0.1 serde shape plus its Cyrius-only "domain"), read back
#     with avatara's profile_from_json (dist/avatara-json.cyr).
#
# Decoding (3.2.0): every *_from_json returns a Result, as serde_json::from_str did:
# Ok(value) or Err(SKE_DESERIALIZE) with serde's wording (the sk_de_* helpers of
# serial_util.cyr). Each field is checked against its Rust type (u8/u32/i32/i64/f64,
# String, Vec<T>, Option<T>, unit and data enums, the (i32, u32, f64) tuple); a missing
# required field is an Err, an Option field missing or null is None (0), unknown keys
# are ignored and no domain validation happens (serde's derive does none).
#
# The itihas and avatara context arrays decode through those libraries' own decoders,
# so a MultiCalendarDate round-trips in full: decode then re-encode is byte-identical,
# and multi_calendar_date_eq compares every field of every record. Their Err messages
# (serde's wording too) are forwarded unchanged as SKE_DESERIALIZE.
#
# SELF-CONTAINED: no include lines. Uses the shared sk_json_* / sk_de_* helpers from
# serial_util.cyr, the epoch + calendar module accessors (via lib.cyr), the
# itihas/avatara bundle serializers/accessors, and bayan's value-tree API.

# ===========================================================================
# Shared local helpers
# ===========================================================================

# Append  "key":<number>  where <number> is the Grisu2 JSON rendering of the
# f64 bit pattern `bits`. Round-trip correct with bayan_json_v_float on parse.
fn _ep_json_f64(sb, key, bits) {
    sk_json_key(sb, key);
    str_builder_add(sb, bayan_json_v_build(bayan_json_v_float_new(bits)));
    return 0;
}

# The bare JSON number rendering of an f64 bit pattern (no key), as a Str.
#must_use
fn _ep_f64_str(bits) {
    return bayan_json_v_build(bayan_json_v_float_new(bits));
}

# Append  "key":["s0","s1",...]  from a vec of Str.
fn _ep_json_str_arr(sb, key, v) {
    sk_json_key(sb, key);
    str_builder_add_cstr(sb, "[");
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_json_str(sb, vec_get(v, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return 0;
}

# Decode the Vec<String> field key of object obj: Ok(a fresh vec of Str), or Err when the
# field is missing, not an array, or holds a non-string element.
#must_use
fn _ep_de_str_vec_field(obj, key) {
    var arr = sk_de_seq_field(obj, key)?;
    var v = vec_new();
    var n = bayan_json_v_arr_len(arr);
    var i = 0;
    while (i < n) {
        var s = sk_de_str(bayan_json_v_arr_get(arr, i))?;
        vec_push(v, s);
        i = i + 1;
    }
    return Ok(v);
}

# A fresh vec of the n serde identifiers that the name accessor at fp (a fn(i) -> Str)
# writes for discriminants 0..n-1, for sk_de_variant.
#must_use
fn _ep_build_names(fp, n) {
    var v = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(v, fncall1(fp, i));
        i = i + 1;
    }
    return v;
}

# Cached identifier vecs for the enums whose module keeps its name table private.
var _ep_coptic_names = 0;
var _ep_hebrew_names = 0;
var _ep_hijri_names = 0;
var _ep_stem_names = 0;
var _ep_branch_names = 0;
var _ep_caldate_names = 0;

# CopticMonth serde identifiers in discriminant order (the coptic_month_name table).
#must_use
fn _ep_coptic_month_names() {
    if (_ep_coptic_names == 0) { _ep_coptic_names = _ep_build_names(&coptic_month_name, 13); }
    return _ep_coptic_names;
}

# HebrewMonth serde identifiers in discriminant order (the hebrewmonth_name table).
#must_use
fn _ep_hebrew_month_names() {
    if (_ep_hebrew_names == 0) { _ep_hebrew_names = _ep_build_names(&hebrewmonth_name, 14); }
    return _ep_hebrew_names;
}

# HijriMonth serde identifiers in discriminant order (the hijri_month_name table).
#must_use
fn _ep_hijri_month_names() {
    if (_ep_hijri_names == 0) { _ep_hijri_names = _ep_build_names(&hijri_month_name, 12); }
    return _ep_hijri_names;
}

# HeavenlyStem serde identifiers in discriminant order (the heavenly_stem_debug table).
#must_use
fn _ep_stem_names_vec() {
    if (_ep_stem_names == 0) { _ep_stem_names = _ep_build_names(&heavenly_stem_debug, 10); }
    return _ep_stem_names;
}

# EarthlyBranch serde identifiers in discriminant order (the earthly_branch_debug table).
#must_use
fn _ep_branch_names_vec() {
    if (_ep_branch_names == 0) { _ep_branch_names = _ep_build_names(&earthly_branch_debug, 12); }
    return _ep_branch_names;
}

# CalendarDate variant names in CDT_* order (the keys calendar_date_to_json writes).
#must_use
fn _ep_caldate_variant_names() {
    if (_ep_caldate_names == 0) {
        var v = vec_new();
        vec_push(v, str_from("Jdn"));
        vec_push(v, str_from("Gregorian"));
        vec_push(v, str_from("Coptic"));
        vec_push(v, str_from("Persian"));
        vec_push(v, str_from("Hebrew"));
        vec_push(v, str_from("Hijri"));
        vec_push(v, str_from("MayanLongCount"));
        _ep_caldate_names = v;
    }
    return _ep_caldate_names;
}

# Element-wise equality of two vecs of Str (0/1).
#must_use
fn _ep_str_vec_eq(a, b) {
    var na = vec_len(a);
    var nb = vec_len(b);
    if (na != nb) { return 0; }
    var i = 0;
    while (i < na) {
        if (str_eq(vec_get(a, i), vec_get(b, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ===========================================================================
# Nested-calendar enum name -> discriminant reverse maps (ep_ prefixed so this
# file collides with no standalone serial_<mod>.cyr). Return (0 - 1) if unmatched.
# ===========================================================================

# Mayan Tzolkin day-sign name Str -> index 0..19 (daysign_name order), or -1 if unmatched.
#must_use
fn ep_daysign_from_name(name) {
    var i = 0;
    while (i < 20) {
        if (str_eq(daysign_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
