# ===========================================================================
# epoch enum reverse maps (module ships <Enum>_name but no <Enum>_from_name).
# ===========================================================================

# PrecessionalAge serde name Str ("Leo".."Virgo") -> PA_* discriminant, or -1 if unmatched.
#must_use
fn precessionalage_from_name(name) {
    var i = 0;
    while (i < 12) {
        if (str_eq(precessionalage_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# Civilization serde name Str ("Vedic".."Chinese") -> ECIV_* discriminant, or -1 if unmatched.
#must_use
fn civilization_from_name(name) {
    var i = 0;
    while (i < 6) {
        if (str_eq(civilization_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# CycleName serde name Str (e.g. "Metonic") -> CN_* discriminant, or -1 if unmatched.
#must_use
fn cyclename_from_name(name) {
    var i = 0;
    while (i < 7) {
        if (str_eq(cyclename_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

