# ===========================================================================
# Nested-calendar record serializers (ep_ prefixed).
# ===========================================================================

# --- Mayan LongCount { baktun, katun, tun, uinal, kin } (all integers) ---
#must_use
fn ep_lc_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "baktun", lc_baktun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "katun", lc_katun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "tun", lc_tun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "uinal", lc_uinal(p));
    sk_json_sep(sb);
    sk_json_int(sb, "kin", lc_kin(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
#must_use
fn ep_lc_from_json(v) {
    var b = bayan_json_v_int(bayan_json_v_obj_get(v, "baktun"));
    var k = bayan_json_v_int(bayan_json_v_obj_get(v, "katun"));
    var t = bayan_json_v_int(bayan_json_v_obj_get(v, "tun"));
    var u = bayan_json_v_int(bayan_json_v_obj_get(v, "uinal"));
    var n = bayan_json_v_int(bayan_json_v_obj_get(v, "kin"));
    return longcount_make(b, k, t, u, n);
}
#must_use
fn ep_lc_eq(a, b) {
    if (lc_baktun(a) != lc_baktun(b)) { return 0; }
    if (lc_katun(a) != lc_katun(b)) { return 0; }
    if (lc_tun(a) != lc_tun(b)) { return 0; }
    if (lc_uinal(a) != lc_uinal(b)) { return 0; }
    if (lc_kin(a) != lc_kin(b)) { return 0; }
    return 1;
}

