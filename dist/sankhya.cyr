# ===========================================================================
# SagesTradition
#   {"civilization":"Vedic","group_name":"Saptarishi","sage_names":[...],
#    "source_texts":[...],"associated_stars":"...","catastrophe_narrative":"..."}
# ===========================================================================

# Serialize a SagesTradition to a JSON object Str in serde field order (civilization as its
# serde name, sage_names/source_texts as string arrays).
#must_use
fn sages_tradition_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_str(sb, "civilization", civilization_name(sgt_civ(p)));
    sk_json_sep(sb);
    sk_json_str(sb, "group_name", sgt_group(p));
    sk_json_sep(sb);
    _ep_json_str_arr(sb, "sage_names", sgt_names(p));
    sk_json_sep(sb);
    _ep_json_str_arr(sb, "source_texts", sgt_texts(p));
    sk_json_sep(sb);
    sk_json_str(sb, "associated_stars", sgt_stars(p));
    sk_json_sep(sb);
    sk_json_str(sb, "catastrophe_narrative", sgt_narr(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Decode a SagesTradition from bayan node v (civilization a Civilization variant, the
# Cow<str> fields strings, sage_names/source_texts arrays of strings): Ok(SagesTradition) or
# Err(SKE_DESERIALIZE).
#must_use
fn sages_tradition_from_json(v) {
    var obj = sk_de_struct(v, "SagesTradition")?;
    var civ = sk_de_variant_field(obj, "civilization", civilization_names())?;
    var group = sk_de_str_field(obj, "group_name")?;
    var names = _ep_de_str_vec_field(obj, "sage_names")?;
    var texts = _ep_de_str_vec_field(obj, "source_texts")?;
    var stars = sk_de_str_field(obj, "associated_stars")?;
    var narr = sk_de_str_field(obj, "catastrophe_narrative")?;
    return Ok(sgt_new(civ, group, names, texts, stars, narr));
}
# Structural equality of two SagesTradition records (every field; Strs and vecs by content);
# 1/0.
#must_use
fn sages_tradition_eq(a, b) {
    if (sgt_civ(a) != sgt_civ(b)) { return 0; }
    if (str_eq(sgt_group(a), sgt_group(b)) == 0) { return 0; }
    if (_ep_str_vec_eq(sgt_names(a), sgt_names(b)) == 0) { return 0; }
    if (_ep_str_vec_eq(sgt_texts(a), sgt_texts(b)) == 0) { return 0; }
    if (str_eq(sgt_stars(a), sgt_stars(b)) == 0) { return 0; }
    if (str_eq(sgt_narr(a), sgt_narr(b)) == 0) { return 0; }
    return 1;
}

# ===========================================================================
# AgePosition
#   {"age":"Pisces","years_into_age":<f>,"fraction":<f>,"vernal_point_longitude":<f>}
# ===========================================================================

# Serialize an AgePosition to a JSON object Str {"age":"<name>", years_into_age, fraction,
# vernal_point_longitude}; f64s use bayan's round-trip Grisu2 formatter.
#must_use
fn age_position_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_str(sb, "age", precessionalage_name(ap_age(p)));
    sk_json_sep(sb);
    _ep_json_f64(sb, "years_into_age", ap_years(p));
    sk_json_sep(sb);
    _ep_json_f64(sb, "fraction", ap_fraction(p));
    sk_json_sep(sb);
    _ep_json_f64(sb, "vernal_point_longitude", ap_lon(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Decode an AgePosition {age: PrecessionalAge, years_into_age, fraction,
# vernal_point_longitude: f64} from bayan node v: Ok(AgePosition) or Err(SKE_DESERIALIZE).
#must_use
fn age_position_from_json(v) {
    var obj = sk_de_struct(v, "AgePosition")?;
    var age = sk_de_variant_field(obj, "age", precessionalage_names())?;
    var years = sk_de_f64_field(obj, "years_into_age")?;
    var fraction = sk_de_f64_field(obj, "fraction")?;
    var lon = sk_de_f64_field(obj, "vernal_point_longitude")?;
    return Ok(ap_new(age, years, fraction, lon));
}
# Structural equality of two AgePosition records (f64 fields by exact bit pattern); 1/0.
#must_use
fn age_position_eq(a, b) {
    if (ap_age(a) != ap_age(b)) { return 0; }
    if (ap_years(a) != ap_years(b)) { return 0; }
    if (ap_fraction(a) != ap_fraction(b)) { return 0; }
    if (ap_lon(a) != ap_lon(b)) { return 0; }
    return 1;
}

# ===========================================================================
# CycleAlignment
#   {"jdn":<f>,"cycles":["Metonic",...],"max_residual_days":<f>}
# ===========================================================================

# Serialize a CycleAlignment to a JSON object Str {"jdn":f64,"cycles":["<CycleName>",...],
# "max_residual_days":f64}.
#must_use
fn cycle_alignment_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    _ep_json_f64(sb, "jdn", calgn_jdn(p));
    sk_json_sep(sb);
    sk_json_key(sb, "cycles");
    str_builder_add_cstr(sb, "[");
    var cyc = calgn_cycles(p);
    var n = vec_len(cyc);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_json_str(sb, cyclename_name(vec_get(cyc, i)));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    sk_json_sep(sb);
    _ep_json_f64(sb, "max_residual_days", calgn_maxres(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Decode a CycleAlignment {jdn: f64, cycles: Vec<CycleName>, max_residual_days: f64} from
# bayan node v: Ok(CycleAlignment) or Err(SKE_DESERIALIZE) (every cycles element must be a
# CycleName identifier).
#must_use
fn cycle_alignment_from_json(v) {
    var obj = sk_de_struct(v, "CycleAlignment")?;
    var jdn = sk_de_f64_field(obj, "jdn")?;
    var arr = sk_de_seq_field(obj, "cycles")?;
    var cyc = vec_new();
    var n = bayan_json_v_arr_len(arr);
    var i = 0;
    while (i < n) {
        var c = sk_de_variant(bayan_json_v_arr_get(arr, i), cyclename_names())?;
        vec_push(cyc, c);
        i = i + 1;
    }
    var maxres = sk_de_f64_field(obj, "max_residual_days")?;
    return Ok(calgn_new(jdn, cyc, maxres));
}
# Structural equality of two CycleAlignment records (f64s by bit pattern, cycles element-wise);
# 1/0.
#must_use
fn cycle_alignment_eq(a, b) {
    if (calgn_jdn(a) != calgn_jdn(b)) { return 0; }
    if (calgn_maxres(a) != calgn_maxres(b)) { return 0; }
    var ca = calgn_cycles(a);
    var cb = calgn_cycles(b);
    var na = vec_len(ca);
    var nb = vec_len(cb);
    if (na != nb) { return 0; }
    var i = 0;
    while (i < na) {
        if (vec_get(ca, i) != vec_get(cb, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ===========================================================================
# MultiCalendarDate — the correlate() "Rosetta Stone" output.
# ===========================================================================

# Append the context vec v as a JSON array, each element written by kind: 0 Era, 1 Civilization
# and 2 Event (itihas's *_to_json_into, spacey sub-objects; JSON-legal), 3 a Saptarishi pair.
fn _ep_ctx_json(sb, v, kind) {
    str_builder_add_cstr(sb, "[");
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var x = vec_get(v, i);
        if (kind == 0) { era_to_json_into(sb, x); }
        if (kind == 1) { civ_to_json_into(sb, x); }
        if (kind == 2) { event_to_json_into(sb, x); }
        if (kind == 3) { _ep_sap_pair_into(sb, x); }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return 0;
}

# Append one Saptarishi pair as serde wrote the Rust (String, ArchetypeProfile) tuple:
# ["name",{profile}]. sap_name is a C string; a NULL one is written null. The profile is
# avatara's profile_to_json_into; one it refuses (NULL, or an enum field naming no variant)
# writes nothing there, so null is written in its place. Either null fails to decode.
fn _ep_sap_pair_into(sb, pair) {
    str_builder_add_cstr(sb, "[");
    var name = sap_name(pair);
    if (name == 0) { str_builder_add_cstr(sb, "null"); }
    else { str_builder_add_json_str(sb, str_from(name)); }
    str_builder_add_cstr(sb, ",");
    if (profile_to_json_into(sb, sap_profile(pair)) != 0) { str_builder_add_cstr(sb, "null"); }
    str_builder_add_cstr(sb, "]");
    return 0;
}

# Emit an Option<T> field: null when the pointer is 0, else the record's JSON.
# `kind` selects the nested serializer (0=LongCount 1=Tzolkin 2=Haab).
fn _ep_opt_json(sb, key, ptr, kind) {
    sk_json_key(sb, key);
    if (ptr == 0) {
        str_builder_add_cstr(sb, "null");
        return 0;
    }
    if (kind == 0) { str_builder_add(sb, ep_lc_to_json(ptr)); }
    if (kind == 1) { str_builder_add(sb, ep_tzolkin_to_json(ptr)); }
    if (kind == 2) { str_builder_add(sb, ep_haab_to_json(ptr)); }
    return 0;
}

# Serialize a MultiCalendarDate to a JSON object Str in serde field order: None Mayan fields
# as null, sothic_position as [cycle,year,drift], nested calendars as objects, itihas
# eras/civilizations/events via their own *_to_json_into, Saptarishi pairs as
# [name, profile] tuples.
#must_use
fn multi_calendar_date_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    _ep_json_f64(sb, "jdn", mcd_jdn(p));
    sk_json_sep(sb);
    _ep_opt_json(sb, "mayan_long_count", mcd_mayan_lc(p), 0);
    sk_json_sep(sb);
    _ep_opt_json(sb, "tzolkin", mcd_tzolkin(p), 1);
    sk_json_sep(sb);
    _ep_opt_json(sb, "haab", mcd_haab(p), 2);
    sk_json_sep(sb);

    # sothic_position tuple (i32, u32, f64) -> [cycle, year, drift].
    sk_json_key(sb, "sothic_position");
    str_builder_add_cstr(sb, "[");
    var sp = mcd_sothic(p);
    str_builder_add_int(sb, sothicpos_cycle(sp));
    str_builder_add_cstr(sb, ",");
    str_builder_add_int(sb, sothicpos_year(sp));
    str_builder_add_cstr(sb, ",");
    str_builder_add(sb, _ep_f64_str(sothicpos_drift(sp)));
    str_builder_add_cstr(sb, "]");
    sk_json_sep(sb);

    sk_json_key(sb, "precessional_age");
    str_builder_add(sb, age_position_to_json(mcd_age(p)));
    sk_json_sep(sb);
    _ep_json_f64(sb, "julian_year", mcd_julian_year(p));
    sk_json_sep(sb);
    sk_json_key(sb, "gregorian");
    str_builder_add(sb, ep_greg_to_json(mcd_gregorian(p)));
    sk_json_sep(sb);
    sk_json_key(sb, "coptic");
    str_builder_add(sb, ep_coptic_to_json(mcd_coptic(p)));
    sk_json_sep(sb);
    sk_json_key(sb, "persian");
    str_builder_add(sb, ep_persian_to_json(mcd_persian(p)));
    sk_json_sep(sb);
    sk_json_key(sb, "hebrew");
    str_builder_add(sb, ep_hebrew_to_json(mcd_hebrew(p)));
    sk_json_sep(sb);
    sk_json_key(sb, "chinese_sexagenary");
    str_builder_add(sb, ep_sex_to_json(mcd_chinese(p)));
    sk_json_sep(sb);
    sk_json_key(sb, "aztec_tonalpohualli");
    str_builder_add(sb, ep_tonal_to_json(mcd_tonalpohualli(p)));
    sk_json_sep(sb);
    sk_json_key(sb, "aztec_xiuhpohualli");
    str_builder_add(sb, ep_xiuh_to_json(mcd_xiuhpohualli(p)));
    sk_json_sep(sb);

    sk_json_key(sb, "eras");
    _ep_ctx_json(sb, mcd_eras(p), 0);
    sk_json_sep(sb);
    sk_json_key(sb, "civilizations");
    _ep_ctx_json(sb, mcd_civs(p), 1);
    sk_json_sep(sb);
    sk_json_key(sb, "events");
    _ep_ctx_json(sb, mcd_events(p), 2);
    sk_json_sep(sb);
    sk_json_key(sb, "saptarishi_profiles");
    _ep_ctx_json(sb, mcd_saptarishi(p), 3);

    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Err "invalid length n, expected a tuple of size k" (serde's tuple visitor wording).
fn _ep_tuple_short(n, k) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "invalid length ");
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, ", expected a tuple of size ");
    str_builder_add_int(sb, k);
    return sk_de_fail(str_builder_build(sb));
}

# 1 when Str s holds a U+0000 byte, else 0.
#must_use
fn _ep_has_nul(s) {
    var d = str_data(s);
    var n = str_len(s);
    var i = 0;
    while (i < n) {
        if (load8(d + i) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# One Saptarishi (String, ArchetypeProfile) tuple from JSON array node `node`: Ok(a sap pair)
# or Err, as serde_json::from_str. A non-array is "invalid type", the elements decode in
# order (the profile through avatara's profile_from_json, its message forwarded), too few is
# "invalid length", a third element is "trailing characters". sap_name is a C string, so a
# name holding U+0000 is refused, as avatara refuses one in a profile string: it would read
# back shorter.
#must_use
fn _ep_sap_from_json(node) {
    if (bayan_json_v_is_arr(node) != 1) { return sk_de_invalid_type(node, "a tuple of size 2"); }
    var n = bayan_json_v_arr_len(node);
    if (n < 1) { return _ep_tuple_short(n, 2); }
    var name = sk_de_str(bayan_json_v_arr_get(node, 0))?;
    if (_ep_has_nul(name) == 1) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "invalid value: string ");
        str_builder_add_json_str(sb, name);
        str_builder_add_cstr(sb, ", expected a string without U+0000");
        return sk_de_fail(str_builder_build(sb));
    }
    if (n < 2) { return _ep_tuple_short(n, 2); }
    var pt, pv = profile_from_json(bayan_json_v_arr_get(node, 1));
    if (is_err_result(pt) == 1) { return sk_de_fail(pv); }
    if (n > 2) { return sk_de_fail(str_from("trailing characters")); }
    return Ok(sap_new(str_cstr(name), pv));
}

# Decode one context element by kind (0 Era, 1 Civilization, 2 Event, 3 Saptarishi pair):
# the itihas decoders' own Result for 0..2 (Err payload an ItihasErr), sankhya's for 3.
#must_use
fn _ep_ctx_from_json(node, kind) {
    if (kind == 0) { return era_from_json(node); }
    if (kind == 1) { return civ_from_json(node); }
    if (kind == 2) { return event_from_json(node); }
    return _ep_sap_from_json(node);
}

# The context Vec field key of object obj, each element decoded by kind (as _ep_ctx_from_json):
# Ok(a fresh vec of records), or Err(SKE_DESERIALIZE) when the field is missing or not a JSON
# array, or for the first element refused, carrying itihas's or avatara's message unchanged.
#must_use
fn _ep_de_ctx_vec_field(obj, key, kind) {
    var arr = sk_de_seq_field(obj, key)?;
    var v = vec_new();
    var n = bayan_json_v_arr_len(arr);
    var i = 0;
    while (i < n) {
        var t, x = _ep_ctx_from_json(bayan_json_v_arr_get(arr, i), kind);
        if (is_err_result(t) == 1) {
            if (kind == 3) { return Err(x); }
            return sk_de_fail(itihas_err_msg(x));
        }
        vec_push(v, x);
        i = i + 1;
    }
    return Ok(v);
}

# An Option<> Mayan field key of object obj (kind 0=LongCount 1=Tzolkin 2=Haab): Ok(0) for
# None (missing or null, as serde's derive), Ok(record) for Some, or the record's Err.
#must_use
fn _ep_opt_from_json(obj, key, kind) {
    var node = sk_de_opt_field(obj, key)?;
    if (node == 0) { return Ok(0); }
    if (kind == 0) { return ep_lc_from_json(node); }
    if (kind == 1) { return ep_tzolkin_from_json(node); }
    return ep_haab_from_json(node);
}

# The sothic_position tuple (i32, u32, f64) from a JSON array node: Ok(SothicPos) or Err, as
# serde_json::from_str: a non-array is "invalid type", elements decode in order, too few is
# "invalid length", and a fourth element is "trailing characters".
#must_use
fn _ep_sothic_from_json(node) {
    if (bayan_json_v_is_arr(node) != 1) { return sk_de_invalid_type(node, "a tuple of size 3"); }
    var n = bayan_json_v_arr_len(node);
    if (n < 1) { return _ep_tuple_short(n, 3); }
    var cycle = sk_de_int(bayan_json_v_arr_get(node, 0), SK_I32_MIN, SK_I32_MAX, "i32")?;
    if (n < 2) { return _ep_tuple_short(n, 3); }
    var year = sk_de_int(bayan_json_v_arr_get(node, 1), 0, SK_U32_MAX, "u32")?;
    if (n < 3) { return _ep_tuple_short(n, 3); }
    var drift = sk_de_f64(bayan_json_v_arr_get(node, 2))?;
    if (n > 3) { return sk_de_fail(str_from("trailing characters")); }
    return Ok(sothicpos_new(cycle, year, drift));
}

# Decode a MultiCalendarDate from bayan node v: Ok(MultiCalendarDate) or Err(SKE_DESERIALIZE).
# Every field is required except the Option<> Mayan ones (missing or null -> 0, None) and is
# checked against its Rust type; nested calendars decode through their ep_* decoders.
# eras/civilizations/events decode through itihas's *_from_json and saptarishi_profiles as
# [name, profile] tuples through avatara's profile_from_json; their messages are forwarded.
#must_use
fn multi_calendar_date_from_json(v) {
    var obj = sk_de_struct(v, "MultiCalendarDate")?;
    var jdn = sk_de_f64_field(obj, "jdn")?;
    var lc = _ep_opt_from_json(obj, "mayan_long_count", 0)?;
    var tz = _ep_opt_from_json(obj, "tzolkin", 1)?;
    var hb = _ep_opt_from_json(obj, "haab", 2)?;
    var spn = sk_de_field(obj, "sothic_position")?;
    var sothic = _ep_sothic_from_json(spn)?;
    var apn = sk_de_field(obj, "precessional_age")?;
    var age = age_position_from_json(apn)?;
    var jy = sk_de_f64_field(obj, "julian_year")?;
    var gn = sk_de_field(obj, "gregorian")?;
    var greg = ep_greg_from_json(gn)?;
    var cn = sk_de_field(obj, "coptic")?;
    var coptic = ep_coptic_from_json(cn)?;
    var pn = sk_de_field(obj, "persian")?;
    var persian = ep_persian_from_json(pn)?;
    var hn = sk_de_field(obj, "hebrew")?;
    var hebrew = ep_hebrew_from_json(hn)?;
    var sn = sk_de_field(obj, "chinese_sexagenary")?;
    var sex = ep_sex_from_json(sn)?;
    var tn = sk_de_field(obj, "aztec_tonalpohualli")?;
    var tonal = ep_tonal_from_json(tn)?;
    var xn = sk_de_field(obj, "aztec_xiuhpohualli")?;
    var xiuh = ep_xiuh_from_json(xn)?;
    var eras = _ep_de_ctx_vec_field(obj, "eras", 0)?;
    var civs = _ep_de_ctx_vec_field(obj, "civilizations", 1)?;
    var events = _ep_de_ctx_vec_field(obj, "events", 2)?;
    var saps = _ep_de_ctx_vec_field(obj, "saptarishi_profiles", 3)?;

    var p = alloc(MCD_SIZE);
    store64(p + MCD_JDN, jdn);
    store64(p + MCD_MAYAN_LC, lc);
    store64(p + MCD_TZOLKIN, tz);
    store64(p + MCD_HAAB, hb);
    store64(p + MCD_SOTHIC, sothic);
    store64(p + MCD_AGE, age);
    store64(p + MCD_JULIAN_YEAR, jy);
    store64(p + MCD_GREGORIAN, greg);
    store64(p + MCD_COPTIC, coptic);
    store64(p + MCD_PERSIAN, persian);
    store64(p + MCD_HEBREW, hebrew);
    store64(p + MCD_CHINESE, sex);
    store64(p + MCD_TONAL, tonal);
    store64(p + MCD_XIUH, xiuh);
    store64(p + MCD_ERAS, eras);
    store64(p + MCD_CIVS, civs);
    store64(p + MCD_EVENTS, events);
    store64(p + MCD_SAPTARISHI, saps);
    return Ok(p);
}

# Option-pointer equality with a nested comparator selected by `kind`.
#must_use
fn _ep_opt_eq(a, b, kind) {
    if (a == 0) {
        if (b == 0) { return 1; }
        return 0;
    }
    if (b == 0) { return 0; }
    if (kind == 0) { return ep_lc_eq(a, b); }
    if (kind == 1) { return ep_tzolkin_eq(a, b); }
    return ep_haab_eq(a, b);
}

# Two context records of one kind (as _ep_ctx_json) holding the same value in every field:
# itihas Strs by content, years and enum codes by value, a Saptarishi pair by its name and
# avatara's profile_eq (f64 weights by bit pattern); 1/0.
#must_use
fn _ep_ctx_eq(a, b, kind) {
    if (kind == 0) {
        if (str_eq(era_name(a), era_name(b)) == 0) { return 0; }
        if (era_start(a) != era_start(b) || era_end(a) != era_end(b)) { return 0; }
        if (str_eq(era_region(a), era_region(b)) == 0) { return 0; }
        if (str_eq(era_desc(a), era_desc(b)) == 0) { return 0; }
        return era_cat(a) == era_cat(b) && era_scope(a) == era_scope(b);
    }
    if (kind == 1) {
        if (str_eq(civ_name(a), civ_name(b)) == 0) { return 0; }
        if (str_eq(civ_region(a), civ_region(b)) == 0) { return 0; }
        if (str_eq(civ_peak(a), civ_peak(b)) == 0) { return 0; }
        if (civ_found(a) != civ_found(b) || civ_end(a) != civ_end(b)) { return 0; }
        if (str_eq(civ_traits(a), civ_traits(b)) == 0) { return 0; }
        if (str_eq(civ_script(a), civ_script(b)) == 0) { return 0; }
        return str_eq(civ_lang(a), civ_lang(b));
    }
    if (kind == 2) {
        if (str_eq(evt_name(a), evt_name(b)) == 0) { return 0; }
        if (evt_year(a) != evt_year(b)) { return 0; }
        if (str_eq(evt_era(a), evt_era(b)) == 0) { return 0; }
        if (str_eq(evt_desc(a), evt_desc(b)) == 0) { return 0; }
        if (str_eq(evt_civs(a), evt_civs(b)) == 0) { return 0; }
        return evt_cat(a) == evt_cat(b) && evt_sig(a) == evt_sig(b);
    }
    if (safe_streq(sap_name(a), sap_name(b)) == 0) { return 0; }
    return profile_eq(sap_profile(a), sap_profile(b));
}

# Two context vecs of one kind with equal lengths and pairwise-equal records; 1/0.
#must_use
fn _ep_ctx_vec_eq(a, b, kind) {
    var n = vec_len(a);
    if (vec_len(b) != n) { return 0; }
    var i = 0;
    while (i < n) {
        if (_ep_ctx_eq(vec_get(a, i), vec_get(b, i), kind) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Structural equality of two MultiCalendarDate records: every field, f64s by bit pattern, the
# itihas and avatara context records field by field; 1/0.
#must_use
fn multi_calendar_date_eq(a, b) {
    if (mcd_jdn(a) != mcd_jdn(b)) { return 0; }
    if (_ep_opt_eq(mcd_mayan_lc(a), mcd_mayan_lc(b), 0) == 0) { return 0; }
    if (_ep_opt_eq(mcd_tzolkin(a), mcd_tzolkin(b), 1) == 0) { return 0; }
    if (_ep_opt_eq(mcd_haab(a), mcd_haab(b), 2) == 0) { return 0; }

    var sa = mcd_sothic(a);
    var sb2 = mcd_sothic(b);
    if (sothicpos_cycle(sa) != sothicpos_cycle(sb2)) { return 0; }
    if (sothicpos_year(sa) != sothicpos_year(sb2)) { return 0; }
    if (sothicpos_drift(sa) != sothicpos_drift(sb2)) { return 0; }

    if (age_position_eq(mcd_age(a), mcd_age(b)) == 0) { return 0; }
    if (mcd_julian_year(a) != mcd_julian_year(b)) { return 0; }
    if (ep_greg_eq(mcd_gregorian(a), mcd_gregorian(b)) == 0) { return 0; }
    if (ep_coptic_eq(mcd_coptic(a), mcd_coptic(b)) == 0) { return 0; }
    if (ep_persian_eq(mcd_persian(a), mcd_persian(b)) == 0) { return 0; }
    if (ep_hebrew_eq(mcd_hebrew(a), mcd_hebrew(b)) == 0) { return 0; }
    if (ep_sex_eq(mcd_chinese(a), mcd_chinese(b)) == 0) { return 0; }
    if (ep_tonal_eq(mcd_tonalpohualli(a), mcd_tonalpohualli(b)) == 0) { return 0; }
    if (ep_xiuh_eq(mcd_xiuhpohualli(a), mcd_xiuhpohualli(b)) == 0) { return 0; }

    if (_ep_ctx_vec_eq(mcd_eras(a), mcd_eras(b), 0) == 0) { return 0; }
    if (_ep_ctx_vec_eq(mcd_civs(a), mcd_civs(b), 1) == 0) { return 0; }
    if (_ep_ctx_vec_eq(mcd_events(a), mcd_events(b), 2) == 0) { return 0; }
    return _ep_ctx_vec_eq(mcd_saptarishi(a), mcd_saptarishi(b), 3);
}

# ===========================================================================
# CalendarDate — #[non_exhaustive] data enum, serde externally tagged:
#   {"Jdn":<f>} / {"Gregorian":{..}} / {"Coptic":{..}} / {"Persian":{..}} /
#   {"Hebrew":{..}} / {"Hijri":{..}} / {"MayanLongCount":{..}}
# ===========================================================================

# Serialize a CalendarDate as serde's externally tagged single-key object Str, e.g.
# {"Jdn":<f64>} or {"Gregorian":{...}}; an unknown tag yields "{}".
#must_use
fn calendar_date_to_json(p) {
    var tag = cdv_tag(p);
    var val = cdv_val(p);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    if (tag == CDT_JDN) {
        sk_json_key(sb, "Jdn");
        str_builder_add(sb, _ep_f64_str(val));
    }
    if (tag == CDT_GREGORIAN) {
        sk_json_key(sb, "Gregorian");
        str_builder_add(sb, ep_greg_to_json(val));
    }
    if (tag == CDT_COPTIC) {
        sk_json_key(sb, "Coptic");
        str_builder_add(sb, ep_coptic_to_json(val));
    }
    if (tag == CDT_PERSIAN) {
        sk_json_key(sb, "Persian");
        str_builder_add(sb, ep_persian_to_json(val));
    }
    if (tag == CDT_HEBREW) {
        sk_json_key(sb, "Hebrew");
        str_builder_add(sb, ep_hebrew_to_json(val));
    }
    if (tag == CDT_HIJRI) {
        sk_json_key(sb, "Hijri");
        str_builder_add(sb, ep_hijri_to_json(val));
    }
    if (tag == CDT_MAYAN_LC) {
        sk_json_key(sb, "MayanLongCount");
        str_builder_add(sb, ep_lc_to_json(val));
    }
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Decode a CalendarDate from serde's externally tagged single-key object, {"Jdn":<f64>} or
# {"<Variant>":{..}}: Ok(CalendarDate) or Err(SKE_DESERIALIZE) (not an object, zero or several
# keys, an unknown variant, or a payload that fails its own decoder).
#must_use
fn calendar_date_from_json(v) {
    var tag = sk_de_tagged(v, _ep_caldate_variant_names(), "CalendarDate")?;
    var pay = bayan_json_v_obj_val(v, 0);
    if (tag == CDT_JDN) {
        var jdn = sk_de_f64(pay)?;
        return Ok(caldate_jdn(jdn));
    }
    if (tag == CDT_GREGORIAN) {
        var g = ep_greg_from_json(pay)?;
        return Ok(caldate_gregorian(g));
    }
    if (tag == CDT_COPTIC) {
        var c = ep_coptic_from_json(pay)?;
        return Ok(caldate_coptic(c));
    }
    if (tag == CDT_PERSIAN) {
        var pd = ep_persian_from_json(pay)?;
        return Ok(caldate_persian(pd));
    }
    if (tag == CDT_HEBREW) {
        var h = ep_hebrew_from_json(pay)?;
        return Ok(caldate_hebrew(h));
    }
    if (tag == CDT_HIJRI) {
        var hj = ep_hijri_from_json(pay)?;
        return Ok(caldate_hijri(hj));
    }
    var lc = ep_lc_from_json(pay)?;
    return Ok(caldate_mayan_long_count(lc));
}

# Structural equality of two CalendarDate values: same tag and equal payload (Jdn by f64 bit
# pattern); 1/0. Matching unknown tags compare equal.
#must_use
fn calendar_date_eq(a, b) {
    if (cdv_tag(a) != cdv_tag(b)) { return 0; }
    var t = cdv_tag(a);
    if (t == CDT_JDN) {
        if (cdv_val(a) != cdv_val(b)) { return 0; }
        return 1;
    }
    if (t == CDT_GREGORIAN) { return ep_greg_eq(cdv_val(a), cdv_val(b)); }
    if (t == CDT_COPTIC) { return ep_coptic_eq(cdv_val(a), cdv_val(b)); }
    if (t == CDT_PERSIAN) { return ep_persian_eq(cdv_val(a), cdv_val(b)); }
    if (t == CDT_HEBREW) { return ep_hebrew_eq(cdv_val(a), cdv_val(b)); }
    if (t == CDT_HIJRI) { return ep_hijri_eq(cdv_val(a), cdv_val(b)); }
    if (t == CDT_MAYAN_LC) { return ep_lc_eq(cdv_val(a), cdv_val(b)); }
    return 1;
}

# --- lib.cyr ---

# lib.cyr — sankhya library public API (in-tree entry point).
#
# This is the ONLY src file that carries `include` lines. `cyrius distlib` strips
# them when building dist/sankhya.cyr (so the bundle stays a flat concatenation);
# in-tree builds/tests use these includes to pull the modules together in
# dependency order. Stdlib + sibling deps are auto-included via cyrius.cyml.
#
# The include list GROWS as modules are ported. Order = dependency order.

# --- foundation ---

# --- calendars / math / archaeoastronomy (wave 1: foundation-only leaves) ---

# --- wave 2 (depend on gregorian) ---

# --- capstone (depends on all calendar modules + itihas/avatara) ---

# --- serial (round-trip JSON for all types; serial_util first, epoch last) ---
