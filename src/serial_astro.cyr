# ---------------------------------------------------------------------------
# Star { name, bayer, constellation: &str; ra_j2000, dec_j2000,
#        visual_magnitude: f64 }
# ---------------------------------------------------------------------------

# Serialize a Star to a JSON Str: name, bayer, constellation (strings) then
# ra_j2000, dec_j2000, visual_magnitude (numbers), in Rust field order.
#must_use
fn star_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_str(sb, "name", star_name(p));
    sk_json_sep(sb);
    sk_json_str(sb, "bayer", star_bayer(p));
    sk_json_sep(sb);
    sk_json_str(sb, "constellation", star_constellation(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "ra_j2000", star_ra_j2000(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "dec_j2000", star_dec_j2000(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "visual_magnitude", star_visual_magnitude(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a Star from a bayan value node (an object), as serde: Ok(fresh Star) or
# Err(SKE_DESERIALIZE). name, bayer and constellation are required strings (the Rust
# fields are &'static str: a non-string is "expected a borrowed string"); ra_j2000,
# dec_j2000 and visual_magnitude are required f64.
#must_use
fn star_from_json(v) {
    var obj = sk_de_struct(v, "Star")?;
    var nm = _astro_de_borrowed_str_field(obj, "name")?;
    var by = _astro_de_borrowed_str_field(obj, "bayer")?;
    var co = _astro_de_borrowed_str_field(obj, "constellation")?;
    var ra = sk_de_f64_field(obj, "ra_j2000")?;
    var dec = sk_de_f64_field(obj, "dec_j2000")?;
    var mag = sk_de_f64_field(obj, "visual_magnitude")?;
    return Ok(star_rec_new(nm, by, co, ra, dec, mag));
}

# Structural equality of two Stars (str_eq on the Str fields, f64_eq on the
# f64 fields): 1 or 0.
#must_use
fn star_eq(a, b) {
    if (str_eq(star_name(a), star_name(b)) == 0) { return 0; }
    if (str_eq(star_bayer(a), star_bayer(b)) == 0) { return 0; }
    if (str_eq(star_constellation(a), star_constellation(b)) == 0) { return 0; }
    if (f64_eq(star_ra_j2000(a), star_ra_j2000(b)) == 0) { return 0; }
    if (f64_eq(star_dec_j2000(a), star_dec_j2000(b)) == 0) { return 0; }
    if (f64_eq(star_visual_magnitude(a), star_visual_magnitude(b)) == 0) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# StarName (unit-variant enum → JSON string).
# ---------------------------------------------------------------------------

# Serialize a StarName code as a JSON string Str (its serde name, "Vega").
#must_use
fn starname_to_json(sncode) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, starname_name(sncode));
    return str_builder_build(sb);
}

# Deserialize a StarName from a bayan value node holding a JSON string, as serde:
# Ok(SN_* code), or Err(SKE_DESERIALIZE) "unknown variant" / "invalid type".
#must_use
fn starname_from_json(v) {
    return sk_de_variant(v, _astro_starname_names());
}

# Equality of two StarName codes: 1 or 0.
#must_use
fn starname_eq(a, b) {
    if (a == b) { return 1; }
    return 0;
}

# ---------------------------------------------------------------------------
# HeliacalEventType (unit-variant enum → JSON string).
# ---------------------------------------------------------------------------

# Serialize a HeliacalEventType code as a JSON string Str ("Rising"/"Setting").
#must_use
fn heltype_to_json(etcode) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, heltype_name(etcode));
    return str_builder_build(sb);
}

# Deserialize a HeliacalEventType from a bayan value node holding a JSON string, as serde:
# Ok(HET_* code), or Err(SKE_DESERIALIZE) "unknown variant" / "invalid type".
#must_use
fn heltype_from_json(v) {
    return sk_de_variant(v, _astro_heltype_names());
}

# Equality of two HeliacalEventType codes: 1 or 0.
#must_use
fn heltype_eq(a, b) {
    if (a == b) { return 1; }
    return 0;
}

# ---------------------------------------------------------------------------
# HeliacalEvent { jdn: f64, star: StarName, event_type: HeliacalEventType }
# ---------------------------------------------------------------------------

# Serialize a HeliacalEvent to a JSON Str: {"jdn":..,"star":"..",
# "event_type":".."} with both enums as their serde names.
#must_use
fn heliacal_event_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    _astro_json_f64(sb, "jdn", he_jdn(p));
    sk_json_sep(sb);
    sk_json_str(sb, "star", starname_name(he_star(p)));
    sk_json_sep(sb);
    sk_json_str(sb, "event_type", heltype_name(he_event_type(p)));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a HeliacalEvent from a bayan value node (an object), as serde:
# Ok(fresh HeliacalEvent) or Err(SKE_DESERIALIZE). jdn is a required f64; star and
# event_type are required StarName / HeliacalEventType variant strings.
#must_use
fn heliacal_event_from_json(v) {
    var obj = sk_de_struct(v, "HeliacalEvent")?;
    var jdn = sk_de_f64_field(obj, "jdn")?;
    var sncode = sk_de_variant_field(obj, "star", _astro_starname_names())?;
    var etcode = sk_de_variant_field(obj, "event_type", _astro_heltype_names())?;
    return Ok(heliacal_event_new(jdn, sncode, etcode));
}

# Structural equality of two HeliacalEvents (jdn via f64_eq, codes via ==):
# 1 or 0.
#must_use
fn heliacal_event_eq(a, b) {
    if (f64_eq(he_jdn(a), he_jdn(b)) == 0) { return 0; }
    if (he_star(a) != he_star(b)) { return 0; }
    if (he_event_type(a) != he_event_type(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# AlignmentTarget (6 unit variants + StarRising(StarName)). Because the ported
# module stores the carried StarName alongside the target code, the serializer
# takes (target, starcode) and the decoder returns Ok(a 16-byte {target, star}
# record); starcode is -1 for unit variants.
# ---------------------------------------------------------------------------

# AlignmentTarget value record: { target: AT_* code, star: StarName code or -1 } — 16 bytes.
enum AtvOff { ATV_TARGET = 0; ATV_STAR = 8; ATV_SIZE = 16; }

# Allocate an AlignmentTarget value record: target (AT_* code) and star (the StarName
# code carried by AT_STAR_RISING, -1 for the unit variants). alignmenttarget_from_json's Ok.
#must_use
fn alignmenttarget_new(target, star) {
    var p = alloc(ATV_SIZE);
    store64(p + ATV_TARGET, target);
    store64(p + ATV_STAR, star);
    return p;
}
# AlignmentTarget value field: the AT_* code.
#must_use
fn atv_target(p) { return load64(p + ATV_TARGET); }
# AlignmentTarget value field: the StarName code for AT_STAR_RISING, -1 otherwise.
#must_use
fn atv_star(p) { return load64(p + ATV_STAR); }

# Serialize an AlignmentTarget (target code + starcode) to a JSON Str: unit
# variants as their name string, AT_STAR_RISING as {"StarRising":"<star>"}.
#must_use
fn alignmenttarget_to_json(target, starcode) {
    var sb = str_builder_new();
    _at_emit(sb, target, starcode);
    return str_builder_build(sb);
}

# Deserialize an AlignmentTarget, as serde's externally tagged enum: Ok(alignmenttarget_new
# record; read it with atv_target / atv_star) or Err(SKE_DESERIALIZE). Accepts what
# alignmenttarget_to_json writes: a unit variant as its name string ("EquinoxSunrise") and
# StarRising as {"StarRising":"<StarName>"}. Also, as serde_json, a unit variant in map form
# with a null value ({"EquinoxSunrise":null}). Errors: unknown variant (string or key), the
# string "StarRising" ("invalid type: unit variant, expected newtype variant"), a map without
# exactly one key, a bad StarName payload, a non-null unit payload ("expected unit"), and any
# other JSON type ("expected enum AlignmentTarget").
#must_use
fn alignmenttarget_from_json(v) {
    var names = _astro_target_names();
    var st, sv = sk_de_str(v);
    if (is_ok(st) == 1) {
        var ui = sk_de_variant(v, names)?;
        if (ui == AT_STAR_RISING) {
            return sk_de_fail(str_from("invalid type: unit variant, expected newtype variant"));
        }
        return Ok(alignmenttarget_new(ui, 0 - 1));
    }
    var ti = sk_de_tagged(v, names, "AlignmentTarget")?;
    var payload = bayan_json_v_obj_val(v, 0);
    if (ti == AT_STAR_RISING) {
        var sncode = starname_from_json(payload)?;
        return Ok(alignmenttarget_new(AT_STAR_RISING, sncode));
    }
    var unit = sk_de_opt_field(v, str_cstr(vec_get(names, ti)))?;
    if (unit != 0) { return sk_de_invalid_type(payload, "unit"); }
    return Ok(alignmenttarget_new(ti, 0 - 1));
}

# Equality of two (target, starcode) AlignmentTarget pairs: 1 or 0. The
# starcodes are compared only when the target is AT_STAR_RISING.
#must_use
fn alignmenttarget_eq(ta, sa, tb, sb) {
    if (ta != tb) { return 0; }
    if (ta == AT_STAR_RISING) {
        if (sa != sb) { return 0; }
    }
    return 1;
}

# ---------------------------------------------------------------------------
# AlignmentResult { target: AlignmentTarget, azimuth: f64, deviation: f64 }
# ---------------------------------------------------------------------------

# Serialize an AlignmentResult to a JSON Str: {"target":..,"azimuth":..,
# "deviation":..}, target encoded as in alignmenttarget_to_json.
#must_use
fn alignment_result_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_key(sb, "target");
    _at_emit(sb, ar_target(p), ar_star(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "azimuth", ar_azimuth(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "deviation", ar_deviation(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize an AlignmentResult from a bayan value node (an object), as serde:
# Ok(fresh AlignmentResult) or Err(SKE_DESERIALIZE). target is a required AlignmentTarget
# (decoded by alignmenttarget_from_json); azimuth and deviation are required f64.
#must_use
fn alignment_result_from_json(v) {
    var obj = sk_de_struct(v, "AlignmentResult")?;
    var tnode = sk_de_field(obj, "target")?;
    var at = alignmenttarget_from_json(tnode)?;
    var az = sk_de_f64_field(obj, "azimuth")?;
    var dev = sk_de_f64_field(obj, "deviation")?;
    return Ok(alignment_result_new(atv_target(at), atv_star(at), az, dev));
}

# Structural equality of two AlignmentResults (target pair via
# alignmenttarget_eq, azimuth and deviation via f64_eq): 1 or 0.
#must_use
fn alignment_result_eq(a, b) {
    if (alignmenttarget_eq(ar_target(a), ar_star(a), ar_target(b), ar_star(b)) == 0) { return 0; }
    if (f64_eq(ar_azimuth(a), ar_azimuth(b)) == 0) { return 0; }
    if (f64_eq(ar_deviation(a), ar_deviation(b)) == 0) { return 0; }
    return 1;
}
