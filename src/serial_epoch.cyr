# --- GregorianDate { year, month, day } ---
# Serialize a GregorianDate to a JSON object Str {"year":int,"month":"<name>","day":int}.
#must_use
fn ep_greg_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "year", gd_year(p));
    sk_json_sep(sb);
    sk_json_str(sb, "month", gregorian_month_name(gd_month(p)));
    sk_json_sep(sb);
    sk_json_int(sb, "day", gd_day(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Decode a GregorianDate {year: i64, month: GregorianMonth, day: u8} from bayan node v: Ok(GregorianDate) or
# Err(SKE_DESERIALIZE). No calendar validation (serde's derive does none).
#must_use
fn ep_greg_from_json(v) {
    var obj = sk_de_struct(v, "GregorianDate")?;
    var y = sk_de_int_field(obj, "year", SK_I64_MIN, SK_I64_MAX, "i64")?;
    var m = sk_de_variant_field(obj, "month", gregorian_month_names())?;
    var d = sk_de_int_field(obj, "day", 0, SK_U8_MAX, "u8")?;
    return Ok(gregorian_date_new(y, m, d));
}
# Structural equality of two GregorianDate records (year, month, day); 1/0.
#must_use
fn ep_greg_eq(a, b) {
    if (gd_year(a) != gd_year(b)) { return 0; }
    if (gd_month(a) != gd_month(b)) { return 0; }
    if (gd_day(a) != gd_day(b)) { return 0; }
    return 1;
}

