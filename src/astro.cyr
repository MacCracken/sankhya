# astro.cyr — archaeoastronomy computations (ported from rust-old/src/astro.rs).
#
# Coordinate systems (equatorial / ecliptic / horizontal) with pairwise
# conversions; mean obliquity of the ecliptic (IAU / Lieske 1977); approximate
# solar longitude / declination (Meeus ch.25); sidereal-time helpers; a 20-star
# catalog of archaeologically significant bright stars at J2000.0 (Hipparcos);
# IAU precession of equatorial coordinates (Lieske 1977, Meeus ch.21); heliacal
# rising search via the arcus-visionis model (Schaefer 1987); monument-alignment
# analysis against solstice/equinox sunrise-sunset and star-rising azimuths.
#
# SELF-CONTAINED: no include lines (the distlib bundler strips them; stdlib +
# ganita + sakshi are resolved from the consumer's [deps]). J2000_JDN and
# JULIAN_YEAR_DAYS live in f64_util (in Rust astro imported them from epoch).
#
# f64 note: every non-integer constant is parsed ONCE (f64_parse) into a global
# by astro_init(), which every public entry point calls (guarded, idempotent).
# Whole-number constants use f64_from directly. Angle wrapping is Rust's
# `((x % turn) + turn) % turn` with f64_rem, its exact truncating `%` (3.1.3). The
# floor-based f64_fmod used before rounded, and differed for many negative inputs.

# ---------------------------------------------------------------------------
# Enums
# ---------------------------------------------------------------------------

# StarName — discriminant order IS the STAR_CATALOG index (0=Sirius..19=Dubhe).
enum StarName {
    SN_SIRIUS = 0;
    SN_CANOPUS = 1;
    SN_VEGA = 2;
    SN_ARCTURUS = 3;
    SN_RIGEL = 4;
    SN_PROCYON = 5;
    SN_BETELGEUSE = 6;
    SN_ALDEBARAN = 7;
    SN_ANTARES = 8;
    SN_SPICA = 9;
    SN_POLLUX = 10;
    SN_FOMALHAUT = 11;
    SN_DENEB = 12;
    SN_REGULUS = 13;
    SN_POLARIS = 14;
    SN_THUBAN = 15;
    SN_KOCHAB = 16;
    SN_PLEIADES = 17;
    SN_ALCYONE = 18;
    SN_DUBHE = 19;
}

enum HeliacalEventType {
    HET_RISING = 0;
    HET_SETTING = 1;
}

# AlignmentTarget — the 6 fieldless variants plus StarRising(StarName). The
# data-carrying StarRising is represented by AT_STAR_RISING plus the star code
# stored alongside in AlignmentResult (AR_STAR).
enum AlignmentTarget {
    AT_SUMMER_SOLSTICE_SUNRISE = 0;
    AT_SUMMER_SOLSTICE_SUNSET = 1;
    AT_WINTER_SOLSTICE_SUNRISE = 2;
    AT_WINTER_SOLSTICE_SUNSET = 3;
    AT_EQUINOX_SUNRISE = 4;
    AT_EQUINOX_SUNSET = 5;
    AT_STAR_RISING = 6;
}

# ---------------------------------------------------------------------------
# Struct offsets + constructors + getters
# ---------------------------------------------------------------------------

# CelestialCoord { ra_hours: f64, dec_degrees: f64 }
enum CcOff { CC_RA = 0; CC_DEC = 8; CC_SIZE = 16; }
# Allocate a CelestialCoord (equatorial): ra_hours = right ascension in
# decimal hours (0-24), dec_degrees = declination in degrees (-90..+90); f64.
#must_use
fn celestial_new(ra_hours, dec_degrees) {
    var p = alloc(CC_SIZE);
    store64(p + CC_RA, ra_hours);
    store64(p + CC_DEC, dec_degrees);
    return p;
}
# CelestialCoord field: right ascension in decimal hours (f64).
#must_use
fn cc_ra_hours(p) { return load64(p + CC_RA); }
# CelestialCoord field: declination in degrees (f64).
#must_use
fn cc_dec_degrees(p) { return load64(p + CC_DEC); }

# EclipticCoord { longitude: f64, latitude: f64 }
enum EcOff { EC_LON = 0; EC_LAT = 8; EC_SIZE = 16; }
# Allocate an EclipticCoord: longitude (0-360) and latitude (-90..+90), both
# f64 degrees, referenced to the ecliptic plane and the vernal equinox.
#must_use
fn ecliptic_new(longitude, latitude) {
    var p = alloc(EC_SIZE);
    store64(p + EC_LON, longitude);
    store64(p + EC_LAT, latitude);
    return p;
}
# EclipticCoord field: ecliptic longitude in degrees (f64).
#must_use
fn ec_longitude(p) { return load64(p + EC_LON); }
# EclipticCoord field: ecliptic latitude in degrees (f64).
#must_use
fn ec_latitude(p) { return load64(p + EC_LAT); }

# HorizontalCoord { azimuth: f64, altitude: f64 }
enum HcOff { HC_AZ = 0; HC_ALT = 8; HC_SIZE = 16; }
# Allocate a HorizontalCoord: azimuth in degrees from north through east
# (0-360) and altitude in degrees above the horizon (-90..+90); both f64.
#must_use
fn horizontal_new(azimuth, altitude) {
    var p = alloc(HC_SIZE);
    store64(p + HC_AZ, azimuth);
    store64(p + HC_ALT, altitude);
    return p;
}
# HorizontalCoord field: azimuth in degrees from north, eastward (f64).
#must_use
fn hc_azimuth(p) { return load64(p + HC_AZ); }
# HorizontalCoord field: altitude above the horizon in degrees (f64).
#must_use
fn hc_altitude(p) { return load64(p + HC_ALT); }

# Star { name: Str, bayer: Str, constellation: Str, ra_j2000: f64,
#        dec_j2000: f64, visual_magnitude: f64 }
enum StOff { ST_NAME = 0; ST_BAYER = 8; ST_CONST = 16; ST_RA = 24; ST_DEC = 32; ST_MAG = 40; ST_SIZE = 48; }
# Allocate a Star catalog record: name, Bayer designation and constellation
# (Str), then J2000.0 right ascension (hours), declination (degrees) and
# apparent visual magnitude (all f64).
#must_use
fn star_rec_new(name, bayer, constellation, ra_j2000, dec_j2000, visual_magnitude) {
    var p = alloc(ST_SIZE);
    store64(p + ST_NAME, name);
    store64(p + ST_BAYER, bayer);
    store64(p + ST_CONST, constellation);
    store64(p + ST_RA, ra_j2000);
    store64(p + ST_DEC, dec_j2000);
    store64(p + ST_MAG, visual_magnitude);
    return p;
}
# Star field: common name (Str, e.g. "Sirius").
#must_use
fn star_name(p) { return load64(p + ST_NAME); }
# Star field: Bayer designation (Str; "M45" for the Pleiades cluster).
#must_use
fn star_bayer(p) { return load64(p + ST_BAYER); }
# Star field: constellation name (Str).
#must_use
fn star_constellation(p) { return load64(p + ST_CONST); }
# Star field: right ascension at J2000.0 in decimal hours (f64).
#must_use
fn star_ra_j2000(p) { return load64(p + ST_RA); }
# Star field: declination at J2000.0 in degrees (f64).
#must_use
fn star_dec_j2000(p) { return load64(p + ST_DEC); }
# Star field: apparent visual magnitude (f64; lower is brighter).
#must_use
fn star_visual_magnitude(p) { return load64(p + ST_MAG); }

# HeliacalEvent { jdn: f64, star: StarName, event_type: HeliacalEventType }
enum HeOff { HE_JDN = 0; HE_STAR = 8; HE_TYPE = 16; HE_SIZE = 24; }
# Allocate a HeliacalEvent: jdn (f64 Julian Day), star (StarName code) and
# event_type (HET_RISING / HET_SETTING).
#must_use
fn heliacal_event_new(jdn, star, event_type) {
    var p = alloc(HE_SIZE);
    store64(p + HE_JDN, jdn);
    store64(p + HE_STAR, star);
    store64(p + HE_TYPE, event_type);
    return p;
}
# HeliacalEvent field: Julian Day of the event (f64).
#must_use
fn he_jdn(p) { return load64(p + HE_JDN); }
# HeliacalEvent field: the star involved (StarName code).
#must_use
fn he_star(p) { return load64(p + HE_STAR); }
# HeliacalEvent field: HET_RISING or HET_SETTING.
#must_use
fn he_event_type(p) { return load64(p + HE_TYPE); }

# AlignmentResult { target: AlignmentTarget, star: StarName (or -1), azimuth: f64,
#                   deviation: f64 }
enum ArOff { AR_TARGET = 0; AR_STAR = 8; AR_AZ = 16; AR_DEV = 24; AR_SIZE = 32; }
# Allocate an AlignmentResult: target (AT_* code), star (StarName code for
# AT_STAR_RISING, else -1), the target's azimuth (f64 degrees from north) and
# its deviation from the monument bearing (f64 degrees).
#must_use
fn alignment_result_new(target, star, azimuth, deviation) {
    var p = alloc(AR_SIZE);
    store64(p + AR_TARGET, target);
    store64(p + AR_STAR, star);
    store64(p + AR_AZ, azimuth);
    store64(p + AR_DEV, deviation);
    return p;
}
# AlignmentResult field: the AlignmentTarget code (AT_*).
#must_use
fn ar_target(p) { return load64(p + AR_TARGET); }
# AlignmentResult field: StarName code for AT_STAR_RISING, -1 otherwise.
#must_use
fn ar_star(p) { return load64(p + AR_STAR); }
# AlignmentResult field: target azimuth in degrees from north (f64).
#must_use
fn ar_azimuth(p) { return load64(p + AR_AZ); }
# AlignmentResult field: deviation from the monument bearing, degrees (f64).
#must_use
fn ar_deviation(p) { return load64(p + AR_DEV); }

# ---------------------------------------------------------------------------
# Parsed constant globals (all set once by astro_init; 0 = not yet built)
# ---------------------------------------------------------------------------

var astro_init_done = 0;
var astro_star_vec = 0;
var astro_align_stars = 0;
var astro_starname_names = 0;
var astro_heltype_names = 0;
var astro_target_names = 0;

# Obliquity IAU/Lieske 1977 cubic (degrees)
var OBL_A = 0;   # 23.4392911
var OBL_B = 0;   # 0.0130042
var OBL_C = 0;   # 1.64e-7
var OBL_D = 0;   # 5.04e-7

# Solar position (Meeus ch.25)
var SL_L0A = 0;  # 280.46646
var SL_L0B = 0;  # 36000.76983
var SL_MA = 0;   # 357.52911 (Meeus 25.3; Rust had 357.52811, ADR-008)
var SL_MB = 0;   # 35999.05029
var SL_C1 = 0;   # 1.914602
var SL_C2 = 0;   # 0.019993

# Greenwich Mean Sidereal Time (Meeus ch.12)
var GMST_A = 0;  # 280.46061837
var GMST_B = 0;  # 360.98564736629
var GMST_C = 0;  # 0.000387933

# Precession Lieske 1977 (degrees/century coefficients)
# IAU 1976 precession angles (Lieske 1977), in arcseconds as Meeus prints them (eq. 21.2,
# Astronomical Algorithms 2nd ed., p. 134). The Rust oracle's degree constants had the
# T-coefficients, the t^2 terms and z's t^3 term mixed up (z t^3 0.0000073 deg for
# 0.018203" = 0.0000051 deg, ...), an error of ~0.27 deg by 3000 BCE (ADR-008).
var PR_ZZ_A = 0;    # 2306.2181   (zeta and z share this t bracket)
var PR_ZZ_B = 0;    # 1.39656     * T
var PR_ZZ_C = 0;    # 0.000139    * T^2 (subtracted)
var PR_ZETA_2 = 0;  # 0.30188     t^2
var PR_ZETA_2T = 0; # 0.000344    * T, t^2 (subtracted)
var PR_ZETA_3 = 0;  # 0.017998    t^3
var PR_Z_2 = 0;     # 1.09468     t^2
var PR_Z_2T = 0;    # 0.000066    * T, t^2
var PR_Z_3 = 0;     # 0.018203    t^3
var PR_TH_A = 0;    # 2004.3109   theta t bracket
var PR_TH_B = 0;    # 0.85330     * T (subtracted)
var PR_TH_C = 0;    # 0.000217    * T^2 (subtracted)
var PR_TH_2 = 0;    # 0.42665     t^2 (subtracted)
var PR_TH_2T = 0;   # 0.000217    * T, t^2
var PR_TH_3 = 0;    # 0.041833    t^3 (subtracted)
var PR_ARCSEC = 0;  # 3600

var AV_K = 0;       # arcus visionis slope 1.7
var SOL_DEC = 0;    # solstice declination 23.44

# One catalog row from C-string fields: name, Bayer designation, constellation,
# J2000 right ascension (hours), declination (degrees), visual magnitude.
fn _star_add(v, name, bayer, constellation, ra, dec, mag) {
    var rec = star_rec_new(str_from(name), str_from(bayer), str_from(constellation),
        f64_parse(ra), f64_parse(dec), f64_parse(mag));
    vec_push(v, rec);
    return 0;
}

# Build the 20-star catalog (J2000.0, Hipparcos 1997) as a fresh vec of Star
# records in StarName order. Called once by astro_init; use star_catalog().
fn build_star_catalog() {
    var v = vec_new();
    _star_add(v, "Sirius",     "α CMa", "Canis Major",      "6.752",  "-16.716", "-1.46");
    _star_add(v, "Canopus",    "α Car", "Carina",           "6.399",  "-52.696", "-0.74");
    _star_add(v, "Vega",       "α Lyr", "Lyra",             "18.616", "38.784",  "0.03");
    _star_add(v, "Arcturus",   "α Boo", "Boötes",           "14.261", "19.182",  "-0.05");
    _star_add(v, "Rigel",      "β Ori", "Orion",            "5.242",  "-8.202",  "0.13");
    _star_add(v, "Procyon",    "α CMi", "Canis Minor",      "7.655",  "5.225",   "0.34");
    _star_add(v, "Betelgeuse", "α Ori", "Orion",            "5.919",  "7.407",   "0.42");
    _star_add(v, "Aldebaran",  "α Tau", "Taurus",           "4.599",  "16.509",  "0.86");
    _star_add(v, "Antares",    "α Sco", "Scorpius",         "16.490", "-26.432", "0.96");
    _star_add(v, "Spica",      "α Vir", "Virgo",            "13.420", "-11.161", "0.97");
    _star_add(v, "Pollux",     "β Gem", "Gemini",           "7.755",  "28.026",  "1.14");
    _star_add(v, "Fomalhaut",  "α PsA", "Piscis Austrinus", "22.961", "-29.622", "1.16");
    _star_add(v, "Deneb",      "α Cyg", "Cygnus",           "20.690", "45.280",  "1.25");
    _star_add(v, "Regulus",    "α Leo", "Leo",              "10.139", "11.967",  "1.40");
    _star_add(v, "Polaris",    "α UMi", "Ursa Minor",       "2.530",  "89.264",  "1.98");
    _star_add(v, "Thuban",     "α Dra", "Draco",            "14.073", "64.376",  "3.65");
    _star_add(v, "Kochab",     "β UMi", "Ursa Minor",       "14.845", "74.156",  "2.08");
    _star_add(v, "Pleiades",   "M45",   "Taurus",           "3.787",  "24.105",  "1.60");
    _star_add(v, "Alcyone",    "η Tau", "Taurus",           "3.791",  "24.105",  "2.87");
    _star_add(v, "Dubhe",      "α UMa", "Ursa Major",       "11.062", "61.751",  "1.79");
    return v;
}

# Build the vec of StarName codes that monument_alignment tests for star
# rising: Sirius, Vega, Aldebaran, Antares, Regulus, Spica, Pleiades, Thuban,
# Polaris. Called once by astro_init.
fn build_align_stars() {
    var v = vec_new();
    vec_push(v, SN_SIRIUS);
    vec_push(v, SN_VEGA);
    vec_push(v, SN_ALDEBARAN);
    vec_push(v, SN_ANTARES);
    vec_push(v, SN_REGULUS);
    vec_push(v, SN_SPICA);
    vec_push(v, SN_PLEIADES);
    vec_push(v, SN_THUBAN);
    vec_push(v, SN_POLARIS);
    return v;
}

# Build the StarName serde-identifier table (vec of 20 Str, discriminant
# order). Called once by astro_init; use starname_name(i).
fn build_starname_names() {
    var v = vec_new();
    vec_push(v, str_from("Sirius"));    vec_push(v, str_from("Canopus"));
    vec_push(v, str_from("Vega"));      vec_push(v, str_from("Arcturus"));
    vec_push(v, str_from("Rigel"));     vec_push(v, str_from("Procyon"));
    vec_push(v, str_from("Betelgeuse"));vec_push(v, str_from("Aldebaran"));
    vec_push(v, str_from("Antares"));   vec_push(v, str_from("Spica"));
    vec_push(v, str_from("Pollux"));    vec_push(v, str_from("Fomalhaut"));
    vec_push(v, str_from("Deneb"));     vec_push(v, str_from("Regulus"));
    vec_push(v, str_from("Polaris"));   vec_push(v, str_from("Thuban"));
    vec_push(v, str_from("Kochab"));    vec_push(v, str_from("Pleiades"));
    vec_push(v, str_from("Alcyone"));   vec_push(v, str_from("Dubhe"));
    return v;
}

# Build the HeliacalEventType serde-identifier table ("Rising", "Setting").
# Called once by astro_init; use heltype_name(i).
fn build_heltype_names() {
    var v = vec_new();
    vec_push(v, str_from("Rising"));
    vec_push(v, str_from("Setting"));
    return v;
}

# Build the AlignmentTarget serde-identifier table (7 Str, AT_* order).
# Called once by astro_init; use alignmenttarget_name(i).
fn build_target_names() {
    var v = vec_new();
    vec_push(v, str_from("SummerSolsticeSunrise"));
    vec_push(v, str_from("SummerSolsticeSunset"));
    vec_push(v, str_from("WinterSolsticeSunrise"));
    vec_push(v, str_from("WinterSolsticeSunset"));
    vec_push(v, str_from("EquinoxSunrise"));
    vec_push(v, str_from("EquinoxSunset"));
    vec_push(v, str_from("StarRising"));
    return v;
}

# Idempotent lazy init: parse all constants and build all tables. Called at the
# top of every public entry point that reads a parsed constant or the catalog.
fn astro_init() {
    if (astro_init_done == 1) { return 0; }
    OBL_A = f64_parse("23.4392911");
    OBL_B = f64_parse("0.0130042");
    OBL_C = f64_parse("0.000000164");
    OBL_D = f64_parse("0.000000504");

    SL_L0A = f64_parse("280.46646");
    SL_L0B = f64_parse("36000.76983");
    SL_MA = f64_parse("357.52911");
    SL_MB = f64_parse("35999.05029");
    SL_C1 = f64_parse("1.914602");
    SL_C2 = f64_parse("0.019993");

    GMST_A = f64_parse("280.46061837");
    GMST_B = f64_parse("360.98564736629");
    GMST_C = f64_parse("0.000387933");

    PR_ZZ_A = f64_parse("2306.2181");
    PR_ZZ_B = f64_parse("1.39656");
    PR_ZZ_C = f64_parse("0.000139");
    PR_ZETA_2 = f64_parse("0.30188");
    PR_ZETA_2T = f64_parse("0.000344");
    PR_ZETA_3 = f64_parse("0.017998");
    PR_Z_2 = f64_parse("1.09468");
    PR_Z_2T = f64_parse("0.000066");
    PR_Z_3 = f64_parse("0.018203");
    PR_TH_A = f64_parse("2004.3109");
    PR_TH_B = f64_parse("0.85330");
    PR_TH_C = f64_parse("0.000217");
    PR_TH_2 = f64_parse("0.42665");
    PR_TH_2T = f64_parse("0.000217");
    PR_TH_3 = f64_parse("0.041833");
    PR_ARCSEC = f64_from(3600);

    AV_K = f64_parse("1.7");
    SOL_DEC = f64_parse("23.44");

    astro_star_vec = build_star_catalog();
    astro_align_stars = build_align_stars();
    astro_starname_names = build_starname_names();
    astro_heltype_names = build_heltype_names();
    astro_target_names = build_target_names();
    astro_init_done = 1;
    return 0;
}

# ---------------------------------------------------------------------------
# Angle conversion helpers
# ---------------------------------------------------------------------------

# Convert degrees to radians (f64).
#must_use
fn degrees_to_radians(deg) {
    return f64_div(f64_mul(deg, F64_PI), f64_from(180));
}
# Convert radians to degrees (f64).
#must_use
fn radians_to_degrees(rad) {
    return f64_div(f64_mul(rad, f64_from(180)), F64_PI);
}
# Convert hours of right ascension to degrees (x 15; f64).
#must_use
fn hours_to_degrees(hours) {
    return f64_mul(hours, f64_from(15));
}
# Convert degrees to hours of right ascension (/ 15; f64).
#must_use
fn degrees_to_hours(deg) {
    return f64_div(deg, f64_from(15));
}

# ---------------------------------------------------------------------------
# Obliquity of the ecliptic
# ---------------------------------------------------------------------------

# Mean obliquity of the ecliptic in degrees (f64) at Julian Day jdn (f64):
# IAU cubic in Julian centuries from J2000.0 (Lieske 1977). About 23.44 deg
# at J2000.0, decreasing ~0.013 deg per century.
#must_use
fn obliquity_of_ecliptic(jdn) {
    astro_init();
    var t = f64_div(f64_sub(jdn, J2000_JDN), f64_from(36525));
    # Rust's association: `1.64e-7 * t * t` is (c*t)*t and the cube ((d*t)*t)*t. Computing
    # c*(t*t) here instead differed by 1 ulp for some dates before ~1000 BCE.
    var r = f64_sub(OBL_A, f64_mul(OBL_B, t));
    r = f64_sub(r, f64_mul(f64_mul(OBL_C, t), t));
    r = f64_add(r, f64_mul(f64_mul(f64_mul(OBL_D, t), t), t));
    return r;
}

# ---------------------------------------------------------------------------
# Coordinate conversions
# ---------------------------------------------------------------------------

# Convert a CelestialCoord to a fresh EclipticCoord (degrees, longitude in
# [0, 360)) using the obliquity at jdn (f64). Meeus ch.13.
#must_use
fn equatorial_to_ecliptic(coord, jdn) {
    astro_init();
    var eps = degrees_to_radians(obliquity_of_ecliptic(jdn));
    var ra = degrees_to_radians(hours_to_degrees(load64(coord + CC_RA)));
    var dec = degrees_to_radians(load64(coord + CC_DEC));

    var sin_lon = f64_add(f64_mul(f64_sin(ra), f64_cos(eps)), f64_mul(f64_tan(dec), f64_sin(eps)));
    var cos_lon = f64_cos(ra);
    var lon = radians_to_degrees(ganita_f64_atan2(sin_lon, cos_lon));
    if (f64_lt(lon, f64_from(0)) == 1) { lon = f64_add(lon, f64_from(360)); }

    var lat_cos_term = f64_mul(f64_mul(f64_cos(dec), f64_sin(eps)), f64_sin(ra));
    var sin_lat = f64_sub(f64_mul(f64_sin(dec), f64_cos(eps)), lat_cos_term);
    var lat = radians_to_degrees(ganita_f64_asin(sin_lat));
    return ecliptic_new(lon, lat);
}

# Convert an EclipticCoord to a fresh CelestialCoord (RA in hours 0-24, Dec
# in degrees) using the obliquity at jdn (f64). Inverse of
# equatorial_to_ecliptic; Meeus ch.13.
#must_use
fn ecliptic_to_equatorial(coord, jdn) {
    astro_init();
    var eps = degrees_to_radians(obliquity_of_ecliptic(jdn));
    var lon = degrees_to_radians(load64(coord + EC_LON));
    var lat = degrees_to_radians(load64(coord + EC_LAT));

    var sin_ra = f64_sub(f64_mul(f64_sin(lon), f64_cos(eps)), f64_mul(f64_tan(lat), f64_sin(eps)));
    var cos_ra = f64_cos(lon);
    var ra_deg = radians_to_degrees(ganita_f64_atan2(sin_ra, cos_ra));
    if (f64_lt(ra_deg, f64_from(0)) == 1) { ra_deg = f64_add(ra_deg, f64_from(360)); }

    var dec_cos_term = f64_mul(f64_mul(f64_cos(lat), f64_sin(eps)), f64_sin(lon));
    var sin_dec = f64_add(f64_mul(f64_sin(lat), f64_cos(eps)), dec_cos_term);
    var dec = radians_to_degrees(ganita_f64_asin(sin_dec));
    return celestial_new(degrees_to_hours(ra_deg), dec);
}

# Convert a CelestialCoord to a fresh HorizontalCoord for an observer at
# observer_lat / observer_lon (f64 degrees, longitude east-positive) at jdn
# (f64). Azimuth from north through east in [0, 360), altitude in degrees.
# Simplified (Meeus ch.13): no refraction, aberration or nutation.
#must_use
fn equatorial_to_horizontal(coord, jdn, observer_lat, observer_lon) {
    astro_init();
    var lat = degrees_to_radians(observer_lat);
    var dec = degrees_to_radians(load64(coord + CC_DEC));

    var lst = local_sidereal_time(jdn, observer_lon);
    var ha = degrees_to_radians(f64_sub(f64_mul(lst, f64_from(15)), hours_to_degrees(load64(coord + CC_RA))));

    var alt_cos_term = f64_mul(f64_mul(f64_cos(dec), f64_cos(lat)), f64_cos(ha));
    var sin_alt = f64_add(f64_mul(f64_sin(dec), f64_sin(lat)), alt_cos_term);
    var alt = radians_to_degrees(ganita_f64_asin(sin_alt));

    # Azimuth from north, eastward: A = atan2(-cos(dec) sin(H), sin(dec) cos(lat) - cos(dec)
    # sin(lat) cos(H)) (Meeus 13.5, rotated to a north origin). The Rust divided only the
    # cosine term by cos(alt) cos(lat), so its azimuth was exact only on the horizon (23 deg
    # off at altitude 83 deg) (ADR-008). This form needs no division, so it also holds at
    # the poles, where the Rust fell back to an undivided atan2.
    var neg_num = f64_neg(f64_mul(f64_cos(dec), f64_sin(ha)));
    var cos_term = f64_mul(f64_mul(f64_cos(dec), f64_sin(lat)), f64_cos(ha));
    var az_den = f64_sub(f64_mul(f64_sin(dec), f64_cos(lat)), cos_term);
    var az = radians_to_degrees(ganita_f64_atan2(neg_num, az_den));
    if (f64_lt(az, f64_from(0)) == 1) { az = f64_add(az, f64_from(360)); }
    return horizontal_new(az, alt);
}

# Approximate Greenwich Mean Sidereal Time in hours (Meeus ch.12).
#must_use
fn greenwich_sidereal_time(jdn) {
    astro_init();
    var d = f64_sub(jdn, J2000_JDN);
    var t = f64_div(d, f64_from(36525));
    var tt = f64_mul(t, t);
    var ttt = f64_mul(tt, t);
    var gmst = f64_add(GMST_A, f64_mul(GMST_B, d));
    gmst = f64_add(gmst, f64_mul(GMST_C, tt));
    gmst = f64_sub(gmst, f64_div(ttt, f64_from(38710000)));
    var m1 = f64_rem(gmst, f64_from(360));
    var m2 = f64_rem(f64_add(m1, f64_from(360)), f64_from(360));
    return f64_div(m2, f64_from(15));
}

# Local Sidereal Time in hours.
#must_use
fn local_sidereal_time(jdn, observer_lon) {
    var gmst = greenwich_sidereal_time(jdn);
    var lst = f64_add(gmst, f64_div(observer_lon, f64_from(15)));
    var m1 = f64_rem(lst, f64_from(24));
    return f64_rem(f64_add(m1, f64_from(24)), f64_from(24));
}

# ---------------------------------------------------------------------------
# Approximate solar position
# ---------------------------------------------------------------------------

# Approximate ecliptic longitude of the Sun in degrees, [0, 360), at Julian
# Day jdn (f64): mean longitude plus a two-term equation of centre (Meeus
# ch.25). About 1 deg accuracy within a few thousand years of J2000.0.
#must_use
fn solar_longitude(jdn) {
    astro_init();
    var t = f64_div(f64_sub(jdn, J2000_JDN), f64_from(36525));
    var l0 = f64_add(SL_L0A, f64_mul(SL_L0B, t));
    var m = degrees_to_radians(f64_add(SL_MA, f64_mul(SL_MB, t)));
    var c = f64_add(f64_mul(SL_C1, f64_sin(m)), f64_mul(SL_C2, f64_sin(f64_mul(f64_from(2), m))));
    var lon = f64_add(l0, c);
    var m1 = f64_rem(lon, f64_from(360));
    return f64_rem(f64_add(m1, f64_from(360)), f64_from(360));
}

# Approximate solar declination in degrees (f64) at Julian Day jdn (f64):
# asin(sin(obliquity) * sin(solar_longitude)), solar latitude taken as 0.
#must_use
fn solar_declination(jdn) {
    astro_init();
    var lon = degrees_to_radians(solar_longitude(jdn));
    var eps = degrees_to_radians(obliquity_of_ecliptic(jdn));
    return radians_to_degrees(ganita_f64_asin(f64_mul(f64_sin(eps), f64_sin(lon))));
}

# ---------------------------------------------------------------------------
# Star catalog
# ---------------------------------------------------------------------------

# The shared 20-star catalog: a vec of Star records in StarName order, built
# once by astro_init and returned by reference (not a copy) on every call.
#must_use
fn star_catalog() {
    astro_init();
    return astro_star_vec;
}
# Number of stars in the catalog (20).
#must_use
fn star_catalog_len() {
    return vec_len(star_catalog());
}
# Catalog Star record for StarName code `name` (shared, not a copy). The code
# is a vec index: a value outside 0..19 aborts in vec_get.
#must_use
fn star(name) {
    astro_init();
    return vec_get(astro_star_vec, name);
}
# Fresh CelestialCoord with a star's J2000.0 RA (hours) and Dec (degrees).
#must_use
fn star_j2000(name) {
    var s = star(name);
    return celestial_new(load64(s + ST_RA), load64(s + ST_DEC));
}

# ---------------------------------------------------------------------------
# Precession
# ---------------------------------------------------------------------------

# Precess a CelestialCoord from epoch from_jdn to epoch to_jdn (f64 Julian
# Days); returns a fresh CelestialCoord with RA wrapped to [0, 24) hours.
# Simplified IAU angles zeta/z/theta after Lieske et al. (1977), Meeus ch.21.
#must_use
fn precess_coordinates(coord, from_jdn, to_jdn) {
    astro_init();
    sk_debug("precessing coordinates", strlen("precessing coordinates"));
    var t = f64_div(f64_sub(from_jdn, J2000_JDN), f64_from(36525));
    var dt = f64_div(f64_sub(to_jdn, from_jdn), f64_from(36525));
    var tt = f64_mul(t, t);
    var dtdt = f64_mul(dt, dt);
    var dtdtdt = f64_mul(dtdt, dt);

    # Meeus eq. 21.2 (T = centuries from J2000 to the start epoch, t = centuries to precess):
    #   zeta  = (2306.2181 + 1.39656 T - 0.000139 T^2) t + (0.30188 - 0.000344 T) t^2 + 0.017998 t^3
    #   z     = (2306.2181 + 1.39656 T - 0.000139 T^2) t + (1.09468 + 0.000066 T) t^2 + 0.018203 t^3
    #   theta = (2004.3109 - 0.85330 T - 0.000217 T^2) t - (0.42665 + 0.000217 T) t^2 - 0.041833 t^3
    # in arcseconds; each is converted to degrees once (ADR-008).
    var b1 = f64_sub(f64_add(PR_ZZ_A, f64_mul(PR_ZZ_B, t)), f64_mul(PR_ZZ_C, tt));
    var zeta_dt2 = f64_mul(f64_sub(PR_ZETA_2, f64_mul(PR_ZETA_2T, t)), dtdt);
    var zeta_s = f64_add(f64_add(f64_mul(b1, dt), zeta_dt2), f64_mul(PR_ZETA_3, dtdtdt));
    var z_dt2 = f64_mul(f64_add(PR_Z_2, f64_mul(PR_Z_2T, t)), dtdt);
    var z_s = f64_add(f64_add(f64_mul(b1, dt), z_dt2), f64_mul(PR_Z_3, dtdtdt));
    var tb1 = f64_sub(f64_sub(PR_TH_A, f64_mul(PR_TH_B, t)), f64_mul(PR_TH_C, tt));
    var theta_dt2 = f64_mul(f64_add(PR_TH_2, f64_mul(PR_TH_2T, t)), dtdt);
    var theta_s = f64_sub(f64_sub(f64_mul(tb1, dt), theta_dt2), f64_mul(PR_TH_3, dtdtdt));
    var zeta_a = f64_div(zeta_s, PR_ARCSEC);
    var z_a = f64_div(z_s, PR_ARCSEC);
    var theta_a = f64_div(theta_s, PR_ARCSEC);

    var zeta = degrees_to_radians(zeta_a);
    var z = degrees_to_radians(z_a);
    var theta = degrees_to_radians(theta_a);

    var ra0 = degrees_to_radians(hours_to_degrees(load64(coord + CC_RA)));
    var dec0 = degrees_to_radians(load64(coord + CC_DEC));
    var ra0z = f64_add(ra0, zeta);

    var ra_a = f64_mul(f64_cos(dec0), f64_sin(ra0z));
    # (trig(theta) * cos dec0) * cos ra0z: keep this association, so the bits match Rust.
    var ra_b_lhs = f64_mul(f64_mul(f64_cos(theta), f64_cos(dec0)), f64_cos(ra0z));
    var ra_b = f64_sub(ra_b_lhs, f64_mul(f64_sin(theta), f64_sin(dec0)));
    var ra_c_lhs = f64_mul(f64_mul(f64_sin(theta), f64_cos(dec0)), f64_cos(ra0z));
    var ra_c = f64_add(ra_c_lhs, f64_mul(f64_cos(theta), f64_sin(dec0)));

    var ra_new = f64_add(ganita_f64_atan2(ra_a, ra_b), z);
    var dec_new = ganita_f64_asin(ra_c);

    ra_new = radians_to_degrees(ra_new);
    if (f64_lt(ra_new, f64_from(0)) == 1) { ra_new = f64_add(ra_new, f64_from(360)); }
    ra_new = f64_rem(ra_new, f64_from(360));

    return celestial_new(degrees_to_hours(ra_new), radians_to_degrees(dec_new));
}

# A star's position at Julian Day jdn (f64): its J2000.0 catalog coordinates
# precessed to that date. Returns a fresh CelestialCoord.
#must_use
fn star_position_at(name, jdn) {
    var j2000 = star_j2000(name);
    return precess_coordinates(j2000, J2000_JDN, jdn);
}

# ---------------------------------------------------------------------------
# Heliacal rising
# ---------------------------------------------------------------------------

# Arcus visionis (minimum solar depression angle), degrees. Schoch/Purrington.
#must_use
fn arcus_visionis(visual_magnitude) {
    astro_init();
    return f64_add(f64_from(11), f64_mul(AV_K, visual_magnitude));
}

# Find the next heliacal rising after jdn_start. Returns Result:
#   Ok(HeliacalEvent) or Err(SkErr{SKE_COMPUTATION, msg}).
#must_use
fn heliacal_rising(name, jdn_start, observer_lat, _observer_lon) {
    astro_init();
    var s = star(name);
    sk_debug("computing heliacal rising", strlen("computing heliacal rising"));
    var min_depression = arcus_visionis(load64(s + ST_MAG));

    # The first morning of visibility: the first day the star is in the window west of
    # the Sun after a day it was not. Two repairs to the Rust search (ADR-008):
    #  - side: rising needs the star WEST of the Sun (star longitude < Sun's, so
    #    star - sun normalized to (180, 360)); the Rust accepted < 180, the evening side,
    #    near heliacal setting (Sirius from 30 N after J2000 came out on 6 June);
    #  - transition: a start date already inside the window returned day 0, a rising
    #    that had already happened; the previous day must be outside the window.
    var prev = _heliacal_morning_visible(name, f64_sub(jdn_start, f64_from(1)), observer_lat, min_depression);
    var day_offset = 0;
    while (day_offset < 400) {
        var jdn = f64_add(jdn_start, f64_from(day_offset));
        var vis = _heliacal_morning_visible(name, jdn, observer_lat, min_depression);
        if (vis == 1 && prev == 0) {
            return Ok(heliacal_event_new(jdn, name, HET_RISING));
        }
        prev = vis;
        day_offset = day_offset + 1;
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "no heliacal rising found for ");
    str_builder_add(sb, star_name(s));
    str_builder_add_cstr(sb, " within 400 days of JDN ");
    str_builder_add_int(sb, f64_to(jdn_start));
    return sk_fail(SKE_COMPUTATION, str_builder_build(sb));
}

# 1 when star `name` is in heliacal_rising's morning window on `jdn`: it rises at
# observer_lat, its ecliptic elongation from the Sun is between min_depression and
# min_depression + 20 degrees, and it lies west of the Sun (star - sun in (180, 360)).
fn _heliacal_morning_visible(name, jdn, observer_lat, min_depression) {
    var star_coord = star_position_at(name, jdn);
    var max_dec = f64_neg(f64_sub(f64_from(90), f64_abs(observer_lat)));
    var lat_ge0 = f64_ge(observer_lat, f64_from(0));
    var dec_lt = f64_lt(load64(star_coord + CC_DEC), max_dec);
    if (lat_ge0 == 1 && dec_lt == 1) { return 0; }   # never rises at this latitude
    var sun_lon = solar_longitude(jdn);
    var star_ecl = equatorial_to_ecliptic(star_coord, jdn);
    var sep = f64_sub(load64(star_ecl + EC_LON), sun_lon);
    if (f64_lt(sep, f64_from(0)) == 1) { sep = f64_add(sep, f64_from(360)); }
    if (f64_gt(sep, f64_from(180)) == 1) { sep = f64_sub(f64_from(360), sep); }
    if (f64_gt(sep, min_depression) == 0) { return 0; }
    if (f64_lt(sep, f64_add(min_depression, f64_from(20))) == 0) { return 0; }
    var star_minus_sun = f64_sub(load64(star_ecl + EC_LON), sun_lon);
    var nm1 = f64_rem(star_minus_sun, f64_from(360));
    var normalized = f64_rem(f64_add(nm1, f64_from(360)), f64_from(360));
    if (f64_gt(normalized, f64_from(180)) == 1) { return 1; }
    return 0;
}

# ---------------------------------------------------------------------------
# Monument alignment
# ---------------------------------------------------------------------------

# Azimuth (degrees from north) of solstice sunrise for a latitude. summer: 1/0.
#must_use
fn solstice_sunrise_azimuth(observer_lat, summer) {
    astro_init();
    var lat = degrees_to_radians(observer_lat);
    var decv = degrees_to_radians(SOL_DEC);
    if (summer == 0) { decv = degrees_to_radians(f64_neg(SOL_DEC)); }
    var cos_az = f64_div(f64_sin(decv), f64_cos(lat));
    # Beyond the polar circles (|lat| > ~66.56) the solstice Sun does not rise or set and
    # |cos_az| > 1, where acos gave NaN. Clamp to the horizon limit (0 or 180 degrees) so
    # the result is finite; monument_alignment skips these latitudes (ADR-007).
    if (f64_gt(cos_az, f64_from(1)) == 1) { cos_az = f64_from(1); }
    if (f64_lt(cos_az, f64_from(0 - 1)) == 1) { cos_az = f64_from(0 - 1); }
    return radians_to_degrees(ganita_f64_acos(cos_az));
}

# Azimuth where a star rises. Returns Result: Ok(f64 azimuth) or Err.
#must_use
fn star_rise_azimuth(name, observer_lat, jdn) {
    astro_init();
    var coord = star_position_at(name, jdn);
    var lat = degrees_to_radians(observer_lat);
    var dec = degrees_to_radians(load64(coord + CC_DEC));

    var cos_az = f64_div(f64_sin(dec), f64_cos(lat));
    var cos_abs = f64_abs(cos_az);
    # !(|cos_az| <= 1), so a NaN latitude or JDN is the Err too (it was Ok(NaN)).
    if (f64_le(cos_abs, f64_from(1)) == 0) {
        var sb = str_builder_new();
        str_builder_add(sb, star_name(star(name)));
        str_builder_add_cstr(sb, " does not rise at latitude ");
        sb_add_f64(sb, observer_lat, 1);
        str_builder_add_cstr(sb, "°");
        return sk_fail(SKE_COMPUTATION, str_builder_build(sb));
    }
    return Ok(radians_to_degrees(ganita_f64_acos(cos_az)));
}

# Internal: check one solstice/equinox target and push if within tolerance.
fn _ma_check(results, azimuth, target, star, target_az, tolerance) {
    var dev = angle_deviation(azimuth, target_az);
    if (f64_le(dev, tolerance) == 1) {
        vec_push(results, alignment_result_new(target, star, target_az, dev));
    }
    return 0;
}

# Analyze which celestial targets align with a monument's bearing.
#must_use
fn monument_alignment(observer_lat, azimuth, jdn, tolerance_degrees) {
    astro_init();
    sk_info("analyzing monument alignment", strlen("analyzing monument alignment"));
    var results = vec_new();
    var no_star = 0 - 1;

    var summer_az = solstice_sunrise_azimuth(observer_lat, 1);
    var winter_az = solstice_sunrise_azimuth(observer_lat, 0);

    var summer_set_az = f64_sub(f64_from(360), summer_az);
    var winter_set_az = f64_sub(f64_from(360), winter_az);

    # The solstice targets exist only where the solstice Sun rises and sets. Beyond the
    # polar circles solstice_sunrise_azimuth used to be NaN, which matched nothing; it is
    # clamped now, so they are skipped explicitly and the result is unchanged.
    var solst_lat = f64_cos(degrees_to_radians(observer_lat));
    var solst_cos = f64_div(f64_sin(degrees_to_radians(SOL_DEC)), solst_lat);
    if (f64_le(f64_abs(solst_cos), f64_from(1)) == 1) {
        _ma_check(results, azimuth, AT_SUMMER_SOLSTICE_SUNRISE, no_star, summer_az, tolerance_degrees);
        _ma_check(results, azimuth, AT_SUMMER_SOLSTICE_SUNSET, no_star, summer_set_az, tolerance_degrees);
        _ma_check(results, azimuth, AT_WINTER_SOLSTICE_SUNRISE, no_star, winter_az, tolerance_degrees);
        _ma_check(results, azimuth, AT_WINTER_SOLSTICE_SUNSET, no_star, winter_set_az, tolerance_degrees);
    }
    _ma_check(results, azimuth, AT_EQUINOX_SUNRISE, no_star, f64_from(90), tolerance_degrees);
    _ma_check(results, azimuth, AT_EQUINOX_SUNSET, no_star, f64_from(270), tolerance_degrees);

    var n = vec_len(astro_align_stars);
    var si = 0;
    while (si < n) {
        var sn = vec_get(astro_align_stars, si);
        var r_t, r_v = star_rise_azimuth(sn, observer_lat, jdn);
        if (is_ok(r_t) == 1) {
            var star_az = result_unwrap(r_t, r_v);
            var dev = angle_deviation(azimuth, star_az);
            if (f64_le(dev, tolerance_degrees) == 1) {
                vec_push(results, alignment_result_new(AT_STAR_RISING, sn, star_az, dev));
            }
        }
        si = si + 1;
    }
    return results;
}

# Angular deviation between two azimuths, accounting for wrap-around.
#must_use
fn angle_deviation(a, b) {
    var diff = f64_rem(f64_abs(f64_sub(a, b)), f64_from(360));
    if (f64_gt(diff, f64_from(180)) == 1) { return f64_sub(f64_from(360), diff); }
    return diff;
}

# ---------------------------------------------------------------------------
# Display impls (Rust core::fmt::Display) as *_to_str returning a Str.
# ---------------------------------------------------------------------------

# Append an f64 to a str_builder with `decimals` fixed decimal places.
fn sb_add_f64(sb, val, decimals) {
    var buf[64];
    var base = &buf;
    var n = fmt_float_buf(val, base, decimals);
    var i = 0;
    while (i < n) {
        str_builder_add_byte(sb, load8(base + i));
        i = i + 1;
    }
    return 0;
}

# Append an integer zero-padded to 2 digits (Rust {:02}) for small non-negatives.
fn sb_add_02(sb, n) {
    if (n >= 0 && n < 10) { str_builder_add_byte(sb, 48); }
    str_builder_add_int(sb, n);
    return 0;
}

# Display a CelestialCoord as a fresh Str in the Rust format
# "RA {:02}h {:02}m {:.1}s, Dec {+|-}{:02}d {:02}'".
#must_use
fn celestial_coord_to_str(p) {
    var ra = load64(p + CC_RA);
    var dec = load64(p + CC_DEC);
    var ra_h_f = f64_floor(ra);
    var ra_h = f64_to(ra_h_f);
    var ra_m_f = f64_floor(f64_mul(f64_sub(ra, ra_h_f), f64_from(60)));
    var ra_m = f64_to(ra_m_f);
    var ra_s = f64_abs(f64_sub(f64_mul(f64_sub(ra, ra_h_f), f64_from(3600)), f64_mul(ra_m_f, f64_from(60))));
    var dec_neg = f64_lt(dec, f64_from(0));
    var dec_abs = f64_abs(dec);
    var dec_d_f = f64_floor(dec_abs);
    var dec_d = f64_to(dec_d_f);
    var dec_m = f64_to(f64_floor(f64_mul(f64_sub(dec_abs, dec_d_f), f64_from(60))));

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "RA ");
    sb_add_02(sb, ra_h);
    str_builder_add_cstr(sb, "h ");
    sb_add_02(sb, ra_m);
    str_builder_add_cstr(sb, "m ");
    sb_add_f64(sb, ra_s, 1);
    str_builder_add_cstr(sb, "s, Dec ");
    if (dec_neg == 1) { str_builder_add_cstr(sb, "-"); } else { str_builder_add_cstr(sb, "+"); }
    sb_add_02(sb, dec_d);
    str_builder_add_cstr(sb, "d ");
    sb_add_02(sb, dec_m);
    str_builder_add_cstr(sb, "'");
    return str_builder_build(sb);
}

# Display an EclipticCoord as a fresh Str: "lon {:.4}°, lat {:.4}°".
#must_use
fn ecliptic_coord_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "lon ");
    sb_add_f64(sb, load64(p + EC_LON), 4);
    str_builder_add_cstr(sb, "°, lat ");
    sb_add_f64(sb, load64(p + EC_LAT), 4);
    str_builder_add_cstr(sb, "°");
    return str_builder_build(sb);
}

# Display a HorizontalCoord as a fresh Str: "az {:.2}°, alt {:.2}°".
#must_use
fn horizontal_coord_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "az ");
    sb_add_f64(sb, load64(p + HC_AZ), 2);
    str_builder_add_cstr(sb, "°, alt ");
    sb_add_f64(sb, load64(p + HC_ALT), 2);
    str_builder_add_cstr(sb, "°");
    return str_builder_build(sb);
}

# Display a HeliacalEventType as a fresh Str: "heliacal setting" for
# HET_SETTING, otherwise "heliacal rising" (unlike the serde name).
#must_use
fn heliacal_event_type_to_str(t) {
    if (t == HET_SETTING) { return str_from("heliacal setting"); }
    return str_from("heliacal rising");
}

# ---------------------------------------------------------------------------
# Enum name tables (serde identifiers). Display strings differ for
# HeliacalEventType (see heliacal_event_type_to_str).
# ---------------------------------------------------------------------------

# serde identifier Str (e.g. "Sirius") for StarName code i; i outside 0..19
# aborts in vec_get.
#must_use
fn starname_name(i) {
    astro_init();
    return sk_name_at(astro_starname_names, i);
}
# serde identifier Str ("Rising" / "Setting") for HeliacalEventType code i.
#must_use
fn heltype_name(i) {
    astro_init();
    return sk_name_at(astro_heltype_names, i);
}
# serde identifier Str for AlignmentTarget code i (e.g. "EquinoxSunrise",
# "StarRising"); i outside 0..6 aborts in vec_get.
#must_use
fn alignmenttarget_name(i) {
    astro_init();
    return sk_name_at(astro_target_names, i);
}
