# ===========================================================================
# Nested-calendar record serializers (ep_ prefixed).
# ===========================================================================

# --- Mayan LongCount { baktun, katun, tun, uinal, kin } (all integers) ---
# Serialize a Mayan LongCount to a JSON object Str {baktun, katun, tun, uinal, kin}.
#must_use
fn ep_lc_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "baktun", lc_baktun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "katun", lc_katun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "tun", lc_tun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "uinal", lc_uinal(p));
    sk_json_sep(sb);
    sk_json_int(sb, "kin", lc_kin(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Decode a Mayan LongCount (five u32 places) from bayan node v: Ok(LongCount) or
# Err(SKE_DESERIALIZE) (not an object, a missing place, a non-integer or one outside u32).
#must_use
fn ep_lc_from_json(v) {
    var obj = sk_de_struct(v, "LongCount")?;
    var b = sk_de_int_field(obj, "baktun", 0, SK_U32_MAX, "u32")?;
    var k = sk_de_int_field(obj, "katun", 0, SK_U32_MAX, "u32")?;
    var t = sk_de_int_field(obj, "tun", 0, SK_U32_MAX, "u32")?;
    var u = sk_de_int_field(obj, "uinal", 0, SK_U32_MAX, "u32")?;
    var n = sk_de_int_field(obj, "kin", 0, SK_U32_MAX, "u32")?;
    return Ok(longcount_make(b, k, t, u, n));
}
# Structural equality of two LongCount records (all five places); 1/0.
#must_use
fn ep_lc_eq(a, b) {
    if (lc_baktun(a) != lc_baktun(b)) { return 0; }
    if (lc_katun(a) != lc_katun(b)) { return 0; }
    if (lc_tun(a) != lc_tun(b)) { return 0; }
    if (lc_uinal(a) != lc_uinal(b)) { return 0; }
    if (lc_kin(a) != lc_kin(b)) { return 0; }
    return 1;
}

# --- Mayan Tzolkin { number, day_sign } ---
# Serialize a Mayan Tzolkin to a JSON object Str {"number":int,"day_sign":"<name>"}.
#must_use
fn ep_tzolkin_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "number", tz_number(p));
    sk_json_sep(sb);
    sk_json_str(sb, "day_sign", daysign_name(tz_daysign(p)));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Decode a Mayan Tzolkin {number: u8, day_sign: DaySign} from bayan node v: Ok(Tzolkin) or
# Err(SKE_DESERIALIZE).
#must_use
fn ep_tzolkin_from_json(v) {
    var obj = sk_de_struct(v, "Tzolkin")?;
    var num = sk_de_int_field(obj, "number", 0, SK_U8_MAX, "u8")?;
    var sign = sk_de_variant_field(obj, "day_sign", all_daysign_names())?;
    return Ok(tzolkin_make(num, sign));
}
# Structural equality of two Tzolkin records (number, day sign); 1/0.
#must_use
fn ep_tzolkin_eq(a, b) {
    if (tz_number(a) != tz_number(b)) { return 0; }
    if (tz_daysign(a) != tz_daysign(b)) { return 0; }
    return 1;
}

