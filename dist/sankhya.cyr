# SexagenaryYear { stem, branch, cycle_position } — 24 bytes.
enum SexOff { SX_STEM = 0; SX_BRANCH = 8; SX_POS = 16; SX_SIZE = 24; }

#must_use
fn sexagenary_year_new(stem, branch, cycle_position) {
    var p = alloc(SX_SIZE);
    store64(p + SX_STEM, stem);
    store64(p + SX_BRANCH, branch);
    store64(p + SX_POS, cycle_position);
    return p;
}
#must_use
fn sex_stem(p) { return load64(p + SX_STEM); }
#must_use
fn sex_branch(p) { return load64(p + SX_BRANCH); }
#must_use
fn sex_cycle_position(p) { return load64(p + SX_POS); }

# Display: "{stem:?}-{branch:?} ({animal}, {cycle_position})",
# e.g. "Jia-Chen (Dragon, 41)".
#must_use
fn sexagenary_year_to_str(p) {
    var sb = str_builder_new();
    str_builder_add(sb, heavenly_stem_debug(sex_stem(p)));
    str_builder_add_cstr(sb, "-");
    str_builder_add(sb, earthly_branch_debug(sex_branch(p)));
    str_builder_add_cstr(sb, " (");
    str_builder_add(sb, zodiac_animal(sex_branch(p)));
    str_builder_add_cstr(sb, ", ");
    str_builder_add_int(sb, sex_cycle_position(p));
    str_builder_add_cstr(sb, ")");
    return str_builder_build(sb);
}

# Sexagenary year for a Gregorian/Julian year. Anchored so 4 CE = Jiǎ-Zǐ
# (position 1). (year - 4) can be negative → Euclidean remainder is required.
#must_use
fn sexagenary_from_year(year) {
    var offset = rem_euclid(year - 4, 60);
    var stem_idx = rem_euclid(offset, 10);
    var branch_idx = rem_euclid(offset, 12);
    var cycle_position = offset % 60 + 1;
    return sexagenary_year_new(stem_idx, branch_idx, cycle_position);
}

# Sexagenary year for a Julian Day Number (via the proleptic Gregorian year).
#must_use
fn sexagenary_from_jdn(jdn) {
    var greg = jdn_to_gregorian(jdn);
    return sexagenary_from_year(gd_year(greg));
}

# ---------------------------------------------------------------------------
# Unicode rod numeral display (varna)
# ---------------------------------------------------------------------------

# Render a positive n using Unicode counting-rod numerals (U+1D360–U+1D371, the
# vertical forms 𝍠=1 .. 𝍨=9) via varna. Zero positions render as a space.
# Returns Ok(Str) or Err(InvalidBase) when n == 0 (rod numerals have no zero
# glyph — an empty space on the counting board).
#must_use
fn to_unicode_rods(n) {
    if (n == 0) {
        return sk_fail(SKE_INVALID_BASE, str_from("zero has no rod numeral representation"));
    }

    var system = numerals_chinese_rod_numerals();
    var digits = vec_new();
    var remaining = n;
    while (remaining > 0) {
        var d = remaining % 10;
        if (d == 0) {
            vec_push(digits, " ");
        }
        if (d != 0) {
            var ch = numerals_char_for(system, d);
            if (ch != 0) { vec_push(digits, ch); }
        }
        remaining = remaining / 10;
    }

    # digits were pushed least-significant-first; emit reversed and join.
    var sb = str_builder_new();
    var m = vec_len(digits);
    var k = m - 1;
    while (k >= 0) {
        str_builder_add_cstr(sb, vec_get(digits, k));
        k = k - 1;
    }
    return Ok(str_builder_build(sb));
}

# --- persian.cyr ---

# persian.cyr — Persian (Solar Hijri / Jalaali) arithmetic calendar
# (was src/persian.rs).
#
# Solar Hijri calendar with Julian Day Number conversions, using the arithmetic
# Jalaali algorithm (jalaali-js breaks-array, 2820-year grand cycle). Delegates
# Gregorian JDN math to the ported gregorian module. Sources: Dershowitz &
# Reingold, Calendrical Calculations (4th ed., 2018) ch.15; Birashk; jalaali-js.
#
# MODULO NOTE: the 2820-year leap cycle uses TRUNCATED modulo/division
# INTENTIONALLY (Rust/JS `%` and `/`). Cyrius `%` and `/` are likewise truncated
# toward zero, so bare `%`/`/` match Rust exactly. Do NOT substitute
# rem_euclid/div_euclid here — that would shift Nowruz.
#
# SELF-CONTAINED: no include lines (the distlib bundler strips them; stdlib +
# error/util/f64_util/logging/gregorian symbols resolve from the bundle).

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

# JDN of the Persian (Solar Hijri) epoch: 1 Farvardin, Year 1 AP = 22 Mar 622 CE
# Julian (vernal equinox). = 1_948_320.5 (half-integer, load-bearing). Set by
# persian_init() (an f64 bit pattern; not a literal).
var PERSIAN_EPOCH_JDN = 0;

# Public accessor — init-independent (functions never depend on the global).
#must_use
fn persian_epoch_jdn() {
    return f64_add(f64_from(1948320), f64_div(f64_from(1), f64_from(2)));
}

# Populate the exported PERSIAN_EPOCH_JDN global. Tests call this after
# alloc_init(); consumers that read the global should call it once at startup.
fn persian_init() {
    PERSIAN_EPOCH_JDN = persian_epoch_jdn();
    return 0;
}

# ---------------------------------------------------------------------------
# Days in each month of a common Persian year, by 0-based index.
# [31,31,31,31,31,31,30,30,30,30,30,29]. Months 1-6 = 31, 7-11 = 30, 12 = 29
# (30 in leap years). Built lazily.
# ---------------------------------------------------------------------------

var _pers_mdays = 0;
var _pers_mdays_done = 0;
fn _build_pers_mdays() {
    var a = alloc(12 * 8);
    store64(a + 0 * 8, 31);
    store64(a + 1 * 8, 31);
    store64(a + 2 * 8, 31);
    store64(a + 3 * 8, 31);
    store64(a + 4 * 8, 31);
    store64(a + 5 * 8, 31);
    store64(a + 6 * 8, 30);
    store64(a + 7 * 8, 30);
    store64(a + 8 * 8, 30);
    store64(a + 9 * 8, 30);
    store64(a + 10 * 8, 30);
    store64(a + 11 * 8, 29);
    return a;
}
#must_use
fn persian_month_days(idx) {
    if (_pers_mdays_done == 0) {
        _pers_mdays = _build_pers_mdays();
        _pers_mdays_done = 1;
    }
    return load64(_pers_mdays + idx * 8);
}

# ---------------------------------------------------------------------------
# Month enum (Farvardin=0 .. Esfand=11; the discriminant IS the month index)
# ---------------------------------------------------------------------------

enum PersianMonth {
    PM_FARVARDIN;
    PM_ORDIBEHESHT;
