}
fn _zodiac_table() {
    if (_zodiac_done == 0) {
        _zodiac = _build_zodiac();
        _zodiac_done = 1;
    }
    return _zodiac;
}

# Display string for a HeavenlyStem discriminant, e.g. "Jiǎ (甲)".
#must_use
fn heavenly_stem_to_str(stem) { return vec_get(_stem_disp_table(), stem); }

# {:?} identifier for a HeavenlyStem discriminant, e.g. "Jia".
#must_use
fn heavenly_stem_debug(stem) { return vec_get(_stem_dbg_table(), stem); }

# {:?} identifier for an EarthlyBranch discriminant, e.g. "Chen".
#must_use
fn earthly_branch_debug(branch) { return vec_get(_branch_dbg_table(), branch); }

# Zodiac animal name for an EarthlyBranch discriminant, e.g. "Dragon".
#must_use
fn zodiac_animal(branch) { return vec_get(_zodiac_table(), branch); }

# Display string for an EarthlyBranch discriminant, e.g. "Chén (辰) — Dragon"
# (note the em-dash U+2014 with surrounding spaces).
#must_use
fn earthly_branch_to_str(branch) {
    var sb = str_builder_new();
    str_builder_add(sb, vec_get(_branch_disp_table(), branch));
    str_builder_add_cstr(sb, " — ");
    str_builder_add(sb, zodiac_animal(branch));
    return str_builder_build(sb);
}

# SexagenaryYear { stem, branch, cycle_position } — 24 bytes.
enum SexOff { SX_STEM = 0; SX_BRANCH = 8; SX_POS = 16; SX_SIZE = 24; }

#must_use
fn sexagenary_year_new(stem, branch, cycle_position) {
    var p = alloc(SX_SIZE);
    store64(p + SX_STEM, stem);
    store64(p + SX_BRANCH, branch);
    store64(p + SX_POS, cycle_position);
    return p;
}
#must_use
fn sex_stem(p) { return load64(p + SX_STEM); }
#must_use
fn sex_branch(p) { return load64(p + SX_BRANCH); }
#must_use
fn sex_cycle_position(p) { return load64(p + SX_POS); }

# Display: "{stem:?}-{branch:?} ({animal}, {cycle_position})",
# e.g. "Jia-Chen (Dragon, 41)".
#must_use
fn sexagenary_year_to_str(p) {
    var sb = str_builder_new();
    str_builder_add(sb, heavenly_stem_debug(sex_stem(p)));
    str_builder_add_cstr(sb, "-");
    str_builder_add(sb, earthly_branch_debug(sex_branch(p)));
    str_builder_add_cstr(sb, " (");
    str_builder_add(sb, zodiac_animal(sex_branch(p)));
    str_builder_add_cstr(sb, ", ");
    str_builder_add_int(sb, sex_cycle_position(p));
    str_builder_add_cstr(sb, ")");
    return str_builder_build(sb);
}

# Sexagenary year for a Gregorian/Julian year. Anchored so 4 CE = Jiǎ-Zǐ
# (position 1). (year - 4) can be negative → Euclidean remainder is required.
#must_use
fn sexagenary_from_year(year) {
    var offset = rem_euclid(year - 4, 60);
    var stem_idx = rem_euclid(offset, 10);
    var branch_idx = rem_euclid(offset, 12);
    var cycle_position = offset % 60 + 1;
    return sexagenary_year_new(stem_idx, branch_idx, cycle_position);
}

# Sexagenary year for a Julian Day Number (via the proleptic Gregorian year).
#must_use
fn sexagenary_from_jdn(jdn) {
    var greg = jdn_to_gregorian(jdn);
    return sexagenary_from_year(gd_year(greg));
}

# ---------------------------------------------------------------------------
# Unicode rod numeral display (varna)
# ---------------------------------------------------------------------------

# Render a positive n using Unicode counting-rod numerals (U+1D360–U+1D371, the
# vertical forms 𝍠=1 .. 𝍨=9) via varna. Zero positions render as a space.
# Returns Ok(Str) or Err(InvalidBase) when n == 0 (rod numerals have no zero
# glyph — an empty space on the counting board).
#must_use
fn to_unicode_rods(n) {
    if (n == 0) {
        return sk_fail(SKE_INVALID_BASE, str_from("zero has no rod numeral representation"));
    }

    var system = numerals_chinese_rod_numerals();
    var digits = vec_new();
    var remaining = n;
    while (remaining > 0) {
        var d = remaining % 10;
        if (d == 0) {
            vec_push(digits, " ");
        }
        if (d != 0) {
            var ch = numerals_char_for(system, d);
            if (ch != 0) { vec_push(digits, ch); }
        }
        remaining = remaining / 10;
    }

    # digits were pushed least-significant-first; emit reversed and join.
    var sb = str_builder_new();
    var m = vec_len(digits);
    var k = m - 1;
    while (k >= 0) {
        str_builder_add_cstr(sb, vec_get(digits, k));
        k = k - 1;
    }
    return Ok(str_builder_build(sb));
}
