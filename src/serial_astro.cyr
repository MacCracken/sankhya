# ---------------------------------------------------------------------------
# Star { name, bayer, constellation: &str; ra_j2000, dec_j2000,
#        visual_magnitude: f64 }
# ---------------------------------------------------------------------------

#must_use
fn star_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_str(sb, "name", star_name(p));
    sk_json_sep(sb);
    sk_json_str(sb, "bayer", star_bayer(p));
    sk_json_sep(sb);
    sk_json_str(sb, "constellation", star_constellation(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "ra_j2000", star_ra_j2000(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "dec_j2000", star_dec_j2000(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "visual_magnitude", star_visual_magnitude(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

#must_use
fn star_from_json(v) {
    var nm = bayan_json_v_str(bayan_json_v_obj_get(v, "name"));
    var by = bayan_json_v_str(bayan_json_v_obj_get(v, "bayer"));
    var co = bayan_json_v_str(bayan_json_v_obj_get(v, "constellation"));
    var ra = bayan_json_v_float(bayan_json_v_obj_get(v, "ra_j2000"));
    var dec = bayan_json_v_float(bayan_json_v_obj_get(v, "dec_j2000"));
    var mag = bayan_json_v_float(bayan_json_v_obj_get(v, "visual_magnitude"));
    return star_rec_new(nm, by, co, ra, dec, mag);
}

#must_use
fn star_eq(a, b) {
    if (str_eq(star_name(a), star_name(b)) == 0) { return 0; }
    if (str_eq(star_bayer(a), star_bayer(b)) == 0) { return 0; }
    if (str_eq(star_constellation(a), star_constellation(b)) == 0) { return 0; }
    if (f64_eq(star_ra_j2000(a), star_ra_j2000(b)) == 0) { return 0; }
    if (f64_eq(star_dec_j2000(a), star_dec_j2000(b)) == 0) { return 0; }
    if (f64_eq(star_visual_magnitude(a), star_visual_magnitude(b)) == 0) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# StarName (unit-variant enum → JSON string).
# ---------------------------------------------------------------------------

#must_use
fn starname_to_json(sncode) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, starname_name(sncode));
    return str_builder_build(sb);
}

#must_use
fn starname_from_json(v) {
    var c = str_cstr(bayan_json_v_str(v));
    return starname_from_name(c);
}

#must_use
fn starname_eq(a, b) {
    if (a == b) { return 1; }
    return 0;
}

# ---------------------------------------------------------------------------
# HeliacalEventType (unit-variant enum → JSON string).
# ---------------------------------------------------------------------------

#must_use
fn heltype_to_json(etcode) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, heltype_name(etcode));
    return str_builder_build(sb);
}

#must_use
fn heltype_from_json(v) {
    var c = str_cstr(bayan_json_v_str(v));
    return heltype_from_name(c);
}

#must_use
fn heltype_eq(a, b) {
    if (a == b) { return 1; }
    return 0;
}

# ---------------------------------------------------------------------------
# HeliacalEvent { jdn: f64, star: StarName, event_type: HeliacalEventType }
# ---------------------------------------------------------------------------

#must_use
fn heliacal_event_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    _astro_json_f64(sb, "jdn", he_jdn(p));
    sk_json_sep(sb);
    sk_json_str(sb, "star", starname_name(he_star(p)));
    sk_json_sep(sb);
    sk_json_str(sb, "event_type", heltype_name(he_event_type(p)));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

#must_use
fn heliacal_event_from_json(v) {
    var jdn = bayan_json_v_float(bayan_json_v_obj_get(v, "jdn"));
    var sncode = starname_from_name(str_cstr(bayan_json_v_str(bayan_json_v_obj_get(v, "star"))));
    var etcode = heltype_from_name(str_cstr(bayan_json_v_str(bayan_json_v_obj_get(v, "event_type"))));
    return heliacal_event_new(jdn, sncode, etcode);
}

#must_use
fn heliacal_event_eq(a, b) {
    if (f64_eq(he_jdn(a), he_jdn(b)) == 0) { return 0; }
    if (he_star(a) != he_star(b)) { return 0; }
    if (he_event_type(a) != he_event_type(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# AlignmentTarget (6 unit variants + StarRising(StarName)). Because the ported
# module stores the carried StarName alongside the target code, the standalone
# (de)serializers take/return (target, starcode); starcode is -1 for unit
# variants.
# ---------------------------------------------------------------------------

#must_use
fn alignmenttarget_to_json(target, starcode) {
    var sb = str_builder_new();
    _at_emit(sb, target, starcode);
    return str_builder_build(sb);
}

# Returns (target_code, star_code). star_code is -1 for unit variants.
#must_use
fn alignmenttarget_from_json(v) {
    if (bayan_json_v_is_obj(v) == 1) {
        var svnode = bayan_json_v_obj_get(v, "StarRising");
        var scode = starname_from_name(str_cstr(bayan_json_v_str(svnode)));
        return (AT_STAR_RISING, scode);
    }
    var tcode = alignmenttarget_from_name(str_cstr(bayan_json_v_str(v)));
    return (tcode, 0 - 1);
}

#must_use
fn alignmenttarget_eq(ta, sa, tb, sb) {
    if (ta != tb) { return 0; }
    if (ta == AT_STAR_RISING) {
        if (sa != sb) { return 0; }
    }
    return 1;
}

# ---------------------------------------------------------------------------
# AlignmentResult { target: AlignmentTarget, azimuth: f64, deviation: f64 }
# ---------------------------------------------------------------------------

#must_use
fn alignment_result_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_key(sb, "target");
    _at_emit(sb, ar_target(p), ar_star(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "azimuth", ar_azimuth(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "deviation", ar_deviation(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

#must_use
fn alignment_result_from_json(v) {
    var tnode = bayan_json_v_obj_get(v, "target");
    var tcode, scode = alignmenttarget_from_json(tnode);
    var az = bayan_json_v_float(bayan_json_v_obj_get(v, "azimuth"));
    var dev = bayan_json_v_float(bayan_json_v_obj_get(v, "deviation"));
    return alignment_result_new(tcode, scode, az, dev);
}

#must_use
fn alignment_result_eq(a, b) {
    if (alignmenttarget_eq(ar_target(a), ar_star(a), ar_target(b), ar_star(b)) == 0) { return 0; }
    if (f64_eq(ar_azimuth(a), ar_azimuth(b)) == 0) { return 0; }
    if (f64_eq(ar_deviation(a), ar_deviation(b)) == 0) { return 0; }
    return 1;
}
