# ---------------------------------------------------------------------------
# Date struct: { year: i64, month: GregorianMonth, day: i64 } — 24 bytes
# ---------------------------------------------------------------------------

enum GregDateOff { GD_YEAR = 0; GD_MONTH = 8; GD_DAY = 16; GD_SIZE = 24; }

#must_use
fn gregorian_date_new(year, month, day) {
    var p = alloc(GD_SIZE);
    store64(p + GD_YEAR, year);
    store64(p + GD_MONTH, month);
    store64(p + GD_DAY, day);
    return p;
}
#must_use
fn gd_year(p) { return load64(p + GD_YEAR); }
#must_use
fn gd_month(p) { return load64(p + GD_MONTH); }
#must_use
fn gd_day(p) { return load64(p + GD_DAY); }

# Display impl for GregorianDate:
#   year >= 1  -> "<day> <month> <year> CE"
#   else       -> "<day> <month> <1 - year> BCE"
#must_use
fn gregorian_date_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_int(sb, gd_day(p));
    str_builder_add_cstr(sb, " ");
    str_builder_add(sb, gregorian_month_to_str(gd_month(p)));
    str_builder_add_cstr(sb, " ");
    var year = gd_year(p);
    if (year >= 1) {
        str_builder_add_int(sb, year);
        str_builder_add_cstr(sb, " CE");
    }
    if (year < 1) {
        str_builder_add_int(sb, 1 - year);
        str_builder_add_cstr(sb, " BCE");
    }
    return str_builder_build(sb);
}

# ---------------------------------------------------------------------------
# Leap year
# ---------------------------------------------------------------------------

# Leap iff (year%4==0) && (year%100!=0 || year%400==0). The rule is symmetric
# about zero, so truncating % (== 0 tests only) matches Rust for negative years.
#must_use
fn gregorian_is_leap(year) {
    if (year % 4 != 0) { return 0; }
    if (year % 100 != 0) { return 1; }
    if (year % 400 == 0) { return 1; }
    return 0;
}

# Days in a Gregorian year (365 common, 366 leap).
#must_use
fn gregorian_year_days(year) {
    if (gregorian_is_leap(year) == 1) { return 366; }
    return 365;
}

# ---------------------------------------------------------------------------
# JDN conversions
# ---------------------------------------------------------------------------

# Convert a Julian Day Number (f64) to a proleptic Gregorian date pointer.
# March-based computational calendar; correct for deep proleptic (BCE) dates.
#must_use
fn jdn_to_gregorian(jdn) {
    if (SK_TRACE <= sakshi_get_level()) {
        var _js = str_from_int(f64_to(jdn));
        sakshi_log_kv(SK_TRACE, "JDN to Gregorian", 16, "jdn", 3, str_data(_js), str_len(_js));
    }

    # Shift to midnight-based integer day count: (jdn + 0.5).floor() as i64.
    # floor rounds toward -inf; f64_to on the resulting whole f64 is exact.
    var half = f64_div(f64_from(1), f64_from(2));
    var j = f64_to(f64_floor(f64_add(jdn, half)));

    # Reference epoch: March 1, year 0 = JDN 1721120. days may be negative
    # for pre-epoch dates, so the 400-year split uses Euclidean div/rem.
    var days = j - 1721120;

    var n400 = div_euclid(days, 146097);
    var d400 = rem_euclid(days, 146097);

    # d400 is now in [0, 146097); all remaining divisions are on non-negative
    # values, so plain truncating / matches Rust exactly (do NOT Euclidize).
    var n100 = d400 / 36524;
    if (n100 > 3) { n100 = 3; }
    var d100 = d400 - n100 * 36524;

    var n4 = d100 / 1461;
    var d4 = d100 - n4 * 1461;

    var n1 = d4 / 365;
    if (n1 > 3) { n1 = 3; }
    var day_of_year = d4 - n1 * 365;

    # March-based month (0 = March, 11 = February) and day-of-month.
    var mp = (5 * day_of_year + 2) / 153;
    var day = day_of_year - (153 * mp + 2) / 5 + 1;

    # March-based month -> January-based index (0 = January).
    var month_idx = mp + 2;
    if (mp >= 10) { month_idx = mp - 10; }

    var year = 400 * n400 + 100 * n100 + 4 * n4 + n1;
    if (mp >= 10) { year = year + 1; }

    return gregorian_date_new(year, month_idx, day);
}

# Convert a proleptic Gregorian date to a midnight JDN (.5). Exact inverse of
# jdn_to_gregorian. Returns Ok(jdn_f64) or Err(InvalidDate) when day is out of
# range for the month/year. (Pattern C: real tagged Result, message preserved.)
#must_use
fn gregorian_to_jdn(date) {
    if (SK_TRACE <= sakshi_get_level()) {
        var _ys = str_from_int(gd_year(date));
        sakshi_log_kv(SK_TRACE, "Gregorian to JDN", 16, "year", 4, str_data(_ys), str_len(_ys));
    }

    # month enum discriminant IS the 0-based index (position() over the ordered
    # GREGORIAN_MONTHS array == the discriminant); unwrap_or(0) never triggers.
    var month_idx = gd_month(date);
    var year = gd_year(date);
    var day = gd_day(date);

    var max_day = greg_month_length(month_idx);
    if (month_idx == 1) {
        if (gregorian_is_leap(year) == 1) { max_day = 29; }
    }

    var bad = 0;
    if (day == 0) { bad = 1; }
    if (day > max_day) { bad = 1; }
    if (bad == 1) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "day ");
        str_builder_add_int(sb, day);
        str_builder_add_cstr(sb, " out of range for ");
        str_builder_add(sb, gregorian_month_to_str(month_idx));
        str_builder_add_cstr(sb, " ");
        str_builder_add_int(sb, year);
        str_builder_add_cstr(sb, " (max ");
        str_builder_add_int(sb, max_day);
        str_builder_add_cstr(sb, ")");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sb));
    }

    # March-based computational calendar. Convert Jan/Feb (idx 0/1) to months
    # 10/11 of the previous year.
    var y = year;
    var mp = month_idx - 2;
    if (month_idx < 2) {
        y = year - 1;
        mp = month_idx + 10;
    }

    # Reconstruct day count from March 1, year 0 = JDN 1721120. y may be
    # negative, so the /4, /100, /400 terms use Euclidean (floor) division.
    var days = 365 * y + div_euclid(y, 4) - div_euclid(y, 100)
             + div_euclid(y, 400)
             + (153 * mp + 2) / 5
             + day
             - 1;

    var half = f64_div(f64_from(1), f64_from(2));
    var jdn = f64_sub(f64_from(days + 1721120), half);
    return Ok(jdn);
}

# --- roman.cyr ---

# roman.cyr — Roman numeral system (was src/roman.rs).
#
# Conversion between Roman numerals and decimal values (1–3999), canonical
# subtractive-notation validation, and Roman-numeral arithmetic
# (add/subtract/multiply/divide). A self-contained leaf module: no floats, no
# calendar math — only integer conversion + string parsing.
#
# Parity notes vs Rust:
#   * u32 → i64. Range checks are written as `value < 1 || value > MAX_VALUE`
#     (Rust used `value == 0 || value > MAX_VALUE`; identical over the u32
#     domain but also rejects negative i64 callers).
#   * Rust's checked_add / checked_mul overflow branches are unreachable at
#     i64 width for in-range roman values, so roman_add / roman_multiply just
#     compute and defer the range check to from_value (which returns
#     InvalidBase for >3999 — exactly what Rust does for e.g. 3999+1=4000).
#   * from_roman keeps the explicit `total < val` underflow guard.

# --- Constants ---------------------------------------------------------------

# The maximum value representable in standard (non-vinculum) Roman numerals.
enum RomanMax { MAX_VALUE = 3999; }

# --- ROMAN_TABLE: parallel arrays (value, symbol), descending -----------------
# Built lazily on first use (needs alloc_init()); the Rust const was
# &[(u32,&str)] of 13 entries.

var roman_vals = 0;
var roman_syms = 0;
var roman_table_done = 0;

fn build_roman_table() {
    roman_vals = alloc(13 * 8);
    roman_syms = alloc(13 * 8);
    store64(roman_vals + 0 * 8, 1000); store64(roman_syms + 0 * 8, "M");
    store64(roman_vals + 1 * 8, 900);  store64(roman_syms + 1 * 8, "CM");
    store64(roman_vals + 2 * 8, 500);  store64(roman_syms + 2 * 8, "D");
    store64(roman_vals + 3 * 8, 400);  store64(roman_syms + 3 * 8, "CD");
    store64(roman_vals + 4 * 8, 100);  store64(roman_syms + 4 * 8, "C");
    store64(roman_vals + 5 * 8, 90);   store64(roman_syms + 5 * 8, "XC");
    store64(roman_vals + 6 * 8, 50);   store64(roman_syms + 6 * 8, "L");
    store64(roman_vals + 7 * 8, 40);   store64(roman_syms + 7 * 8, "XL");
    store64(roman_vals + 8 * 8, 10);   store64(roman_syms + 8 * 8, "X");
    store64(roman_vals + 9 * 8, 9);    store64(roman_syms + 9 * 8, "IX");
    store64(roman_vals + 10 * 8, 5);   store64(roman_syms + 10 * 8, "V");
    store64(roman_vals + 11 * 8, 4);   store64(roman_syms + 11 * 8, "IV");
    store64(roman_vals + 12 * 8, 1);   store64(roman_syms + 12 * 8, "I");
    roman_table_done = 1;
    return 0;
}

fn ensure_roman_table() {
    if (roman_table_done == 0) { build_roman_table(); }
    return 0;
}

# --- RomanNumeral struct: { value: i64, text: Str } --------------------------

enum RomanOff { RN_VALUE = 0; RN_TEXT = 8; RN_SIZE = 16; }

#must_use
fn romannum_new(value, text) {
    var p = alloc(RN_SIZE);
    store64(p + RN_VALUE, value);
    store64(p + RN_TEXT, text);
    return p;
}

#must_use
fn romannum_value(p) { return load64(p + RN_VALUE); }

#must_use
fn romannum_text(p) { return load64(p + RN_TEXT); }

# Display impl: writes the numeral's text (enables to_string()).
#must_use
fn romannum_to_str(p) { return load64(p + RN_TEXT); }

# --- (quotient, Option<remainder>) pair returned by divide -------------------
# remainder == 0 means None (no remainder).

enum DivOff { DIV_Q = 0; DIV_R = 8; DIV_SIZE = 16; }

#must_use
fn divresult_new(q, r) {
    var p = alloc(DIV_SIZE);
    store64(p + DIV_Q, q);
    store64(p + DIV_R, r);
    return p;
}

#must_use
fn divresult_quotient(p) { return load64(p + DIV_Q); }

# 0 = None (exact division), else pointer to the remainder RomanNumeral.
#must_use
fn divresult_remainder(p) { return load64(p + DIV_R); }

# --- Range helpers -----------------------------------------------------------

#must_use
fn roman_out_of_range(value) {
    if (value < 1) { return 1; }
    if (value > MAX_VALUE) { return 1; }
    return 0;
}

# "Roman numeral value {value} out of range 1..{MAX_VALUE}"
#must_use
fn roman_oor_msg(value) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Roman numeral value ");
    str_builder_add_int(sb, value);
    str_builder_add_cstr(sb, " out of range 1..");
    str_builder_add_int(sb, MAX_VALUE);
    return str_builder_build(sb);
}

# --- Conversion --------------------------------------------------------------

# Convert a decimal value (1–3999) to a Roman numeral string. Assumes valid
# input (private helper); use to_roman_str / from_value for validated calls.
#must_use
fn to_roman(n) {
    ensure_roman_table();
    var sb = str_builder_new();
    for (var i = 0; i < 13; i = i + 1) {
        var val = load64(roman_vals + i * 8);
        var sym = load64(roman_syms + i * 8);
        while (n >= val) {
            str_builder_add_cstr(sb, sym);
            n = n - val;
        }
    }
    return str_builder_build(sb);
}

# Validated decimal → Roman string. Returns Ok(Str) or Err (InvalidBase).
#must_use
fn to_roman_str(value) {
    if (roman_out_of_range(value) == 1) {
        return sk_fail(SKE_INVALID_BASE, roman_oor_msg(value));
    }
    return Ok(to_roman(value));
}

# Map a single Roman numeral character (ASCII byte) to its value, or 0 if the
# character is not a valid Roman symbol.
#must_use
# ⚠ PREFIXED. `char_value` collided with varna's `char_value(script_code, system, ch)` —
# a DIFFERENT function (gematria lookup) at a different arity. cyrius 6.6.2 makes a same-name
# different-arity duplicate a hard error; it surfaced when varna moved 2.1.0 -> 2.4.1.
# sankhya's is the one that moved: 2 callers here, against varna's own.
fn roman_char_value(ch) {
    if (ch == 73) { return 1; }     # 'I'
    if (ch == 86) { return 5; }     # 'V'
    if (ch == 88) { return 10; }    # 'X'
    if (ch == 76) { return 50; }    # 'L'
    if (ch == 67) { return 100; }   # 'C'
    if (ch == 68) { return 500; }   # 'D'
    if (ch == 77) { return 1000; }  # 'M'
    return 0;
}

# Parse a Roman numeral string to its decimal value. Accepts upper/lowercase.
# Returns Ok(value) or Err. Validates character set, range, and canonical form.
#must_use
fn from_roman(s) {
    var slen = str_len(s);
    if (slen == 0) {
        return sk_fail(SKE_INVALID_BASE, str_from("empty string is not a valid Roman numeral"));
    }
    var upper = sk_str_upper(s);
    var ulen = str_len(upper);
    var ud = str_data(upper);
    var total = 0;
    var prev_value = 0;
    var i = ulen - 1;
    while (i >= 0) {
        var ch = load8(ud + i);
        var val = roman_char_value(ch);
        if (val == 0) {
            var sbc = str_builder_new();
            str_builder_add_cstr(sbc, "'");
            str_builder_add_byte(sbc, ch);
            str_builder_add_cstr(sbc, "' is not a valid Roman numeral character");
            return sk_fail(SKE_INVALID_BASE, str_builder_build(sbc));
        }
        if (val < prev_value) {
            if (total < val) {
                return sk_fail(SKE_COMPUTATION, str_from("Roman numeral underflow"));
            }
            total = total - val;
        } else {
            total = total + val;
        }
        prev_value = val;
        i = i - 1;
    }

    if (roman_out_of_range(total) == 1) {
        var sbr = str_builder_new();
        str_builder_add_cstr(sbr, "Roman numeral '");
        str_builder_add(sbr, s);
        str_builder_add_cstr(sbr, "' produces value ");
        str_builder_add_int(sbr, total);
        str_builder_add_cstr(sbr, " out of range 1..");
        str_builder_add_int(sbr, MAX_VALUE);
        return sk_fail(SKE_INVALID_BASE, str_builder_build(sbr));
    }

    # Validate canonical form: round-trip check.
    var canonical = to_roman(total);
    if (str_eq(canonical, upper) == 0) {
        var sbn = str_builder_new();
        str_builder_add_cstr(sbn, "'");
        str_builder_add(sbn, s);
        str_builder_add_cstr(sbn, "' is not canonical Roman notation (expected '");
        str_builder_add(sbn, canonical);
        str_builder_add_cstr(sbn, "' for ");
        str_builder_add_int(sbn, total);
        str_builder_add_cstr(sbn, ")");
        return sk_fail(SKE_INVALID_BASE, str_builder_build(sbn));
    }

    return Ok(total);
}

# --- RomanNumeral constructors -----------------------------------------------

# Build a numeral from a decimal value. Returns Ok(RomanNumeral) or Err.
#must_use
fn romannum_from_value(value) {
    if (roman_out_of_range(value) == 1) {
        return sk_fail(SKE_INVALID_BASE, roman_oor_msg(value));
    }
    return Ok(romannum_new(value, to_roman(value)));
}

# Parse a Roman string into a RomanNumeral (re-canonicalizing the text).
#must_use
fn romannum_parse(s) {
    var r_t, r_v = from_roman(s);
    if (is_ok(r_t) == 0) { return Err(r_v); }
    var value = result_unwrap(r_t, r_v);
    return Ok(romannum_new(value, to_roman(value)));
}

# --- Arithmetic --------------------------------------------------------------

# Add two values → RomanNumeral. Sum > 3999 → InvalidBase (via from_value).
#must_use
fn roman_add(a, b) {
    var sum = a + b;
    return romannum_from_value(sum);
}

# Subtract b from a → RomanNumeral. a <= b → ComputationError.
#must_use
fn roman_subtract(a, b) {
    if (a <= b) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "Roman subtraction would produce zero or negative: ");
        str_builder_add_int(sb, a);
        str_builder_add_cstr(sb, " - ");
        str_builder_add_int(sb, b);
        return sk_fail(SKE_COMPUTATION, str_builder_build(sb));
    }
    return romannum_from_value(a - b);
}

# Multiply two values → RomanNumeral. Product > 3999 → InvalidBase.
#must_use
fn roman_multiply(a, b) {
    var product = a * b;
    return romannum_from_value(product);
}

# Divide a by b → Ok(DivResult{quotient, Option<remainder>}) or Err.
# b == 0 → InvalidFraction; quotient == 0 → ComputationError.
#must_use
fn roman_divide(a, b) {
    if (b == 0) {
        return sk_fail(SKE_INVALID_FRACTION, str_from("division by zero"));
    }
    var quotient = a / b;
    var remainder = a % b;
    if (quotient == 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "Roman division ");
        str_builder_add_int(sb, a);
        str_builder_add_cstr(sb, " / ");
        str_builder_add_int(sb, b);
        str_builder_add_cstr(sb, " produces zero quotient");
        return sk_fail(SKE_COMPUTATION, str_builder_build(sb));
    }
    var qr_t, qr_v = romannum_from_value(quotient);
    if (is_ok(qr_t) == 0) { return Err(qr_v); }
    var q = result_unwrap(qr_t, qr_v);
    var r = 0;
    if (remainder > 0) {
        var rr_t, rr_v = romannum_from_value(remainder);
        if (is_ok(rr_t) == 0) { return Err(rr_v); }
        r = result_unwrap(rr_t, rr_v);
    }
    return Ok(divresult_new(q, r));
}

# --- RomanNumeral methods (delegate to the free functions) -------------------

#must_use
fn romannum_add(x, y) { return roman_add(romannum_value(x), romannum_value(y)); }

#must_use
fn romannum_subtract(x, y) { return roman_subtract(romannum_value(x), romannum_value(y)); }

#must_use
fn romannum_multiply(x, y) { return roman_multiply(romannum_value(x), romannum_value(y)); }

#must_use
fn romannum_divide(x, y) { return roman_divide(romannum_value(x), romannum_value(y)); }

# --- Utility -----------------------------------------------------------------

# 1 iff s is a valid Roman numeral in canonical form.
#must_use
fn is_valid_roman(s) {
    var r_t, r_v = from_roman(s);
    if (is_ok(r_t) == 1) { return 1; }
    return 0;
}

# --- greek.cyr ---

# greek.cyr — Greek mathematics (was src/greek.rs).
#
# Golden ratio (PHI), Fibonacci ratio convergence, Sieve of Eratosthenes,
# Euclidean GCD/LCM, Archimedes' polygon pi bounds, Greek alphabetic-numeral
# isopsephy (encode/decode, via varna), and an Antikythera-mechanism gear-ratio
# catalog.
#
# Self-contained: no include lines. stdlib (str/vec/math/result/sakshi),
# varna (numerals_*), and sibling src modules (error/util/f64_util) are resolved
# by the build tool / distlib bundler.
#
# Parity notes:
# - Rust `gcd`/`lcm` are renamed `greek_gcd`/`greek_lcm` here because the `math`
#   stdlib already defines `gcd`/`lcm` (a bare redefinition would be a duplicate
#   symbol). The bodies replicate the Rust logic exactly (divide-before-multiply
#   in lcm to limit overflow).
# - Rust `PHI` const → `greek_phi()` accessor (f64 constants can't be float
#   literals; parsed once, lazily, via f64_parse).
# - antikythera_gear_ratios returns a vec of records sorted by name to preserve
#   the Rust BTreeMap<&str> lexicographic key order (names are ASCII, so a
#   byte-wise compare matches Rust's str Ord). Look up with antikythera_lookup.

# ---------------------------------------------------------------------------
# Golden ratio and Fibonacci
# ---------------------------------------------------------------------------

# PHI = (1 + sqrt(5)) / 2 = 1.618033988749895 (Euclid's "extreme and mean
# ratio"). Parsed once, lazily, into a global.
var _greek_phi = 0;
var _greek_phi_done = 0;

#must_use
fn greek_phi() {
    if (_greek_phi_done == 0) {
        _greek_phi = f64_parse("1.618033988749895");
        _greek_phi_done = 1;
    }
    return _greek_phi;
}

# F(n+1)/F(n) computed iteratively with f64 accumulators; 1.0 for n=0.
# Approaches PHI as n grows.
#must_use
fn fibonacci_ratio(n) {
    if (n == 0) {
        return f64_from(1);
    }
    var a = f64_from(1);
    var b = f64_from(1);
    var i = 0;
    while (i < n) {
        var temp = b;
        b = f64_add(b, a);
        a = temp;
        i = i + 1;
    }
    return f64_div(b, a);
}

# ---------------------------------------------------------------------------
# Sieve of Eratosthenes
# ---------------------------------------------------------------------------

# Primes <= limit. Empty vec if limit < 2. Uses a byte flag buffer (1 = prime).
#must_use
fn sieve(limit) {
    var tmsg = "Sieve of Eratosthenes";
    var tkey = "limit";
    var tval = str_from_int(limit);
    sakshi_log_kv(SK_TRACE, tmsg, strlen(tmsg), tkey, strlen(tkey), str_data(tval), str_len(tval));

    if (limit < 2) {
        return vec_new();
    }

    var is_prime = alloc(limit + 1);
    var k = 0;
    while (k <= limit) {
        store8(is_prime + k, 1);
        k = k + 1;
    }
    store8(is_prime + 0, 0);
    store8(is_prime + 1, 0);

    var p = 2;
    while (p * p <= limit) {
        if (load8(is_prime + p) == 1) {
            var multiple = p * p;
            while (multiple <= limit) {
                store8(is_prime + multiple, 0);
                multiple = multiple + p;
            }
        }
        p = p + 1;
    }

    var result = vec_new();
    var m = 0;
    while (m <= limit) {
        if (load8(is_prime + m) == 1) {
            vec_push(result, m);
        }
        m = m + 1;
    }
    return result;
}

# ---------------------------------------------------------------------------
# Euclidean algorithm (renamed to avoid the math-stdlib gcd/lcm)
# ---------------------------------------------------------------------------

# Greatest common divisor via Euclid's algorithm. Returns 0 if both are 0.
#must_use
fn greek_gcd(a, b) {
    while (b != 0) {
        var t = b;
        b = a % b;
        a = t;
    }
    return a;
}

# Least common multiple. Divide before multiply to limit overflow.
# Returns 0 if either input is 0.
#must_use
fn greek_lcm(a, b) {
    if (a == 0) {
        return 0;
    }
    if (b == 0) {
        return 0;
    }
    return (a / greek_gcd(a, b)) * b;
}

# ---------------------------------------------------------------------------
# Archimedes' pi approximation (method of exhaustion)
# ---------------------------------------------------------------------------

# Bound pi from a hexagon by repeatedly doubling the side count. Returns the
# 2-tuple (lower_bound, upper_bound).
#   inner initially 6*sin(pi/6) = 3 ; outer initially 6*tan(pi/6) = 2*sqrt(3)
#   outer_new = 2 * inner * outer / (inner + outer)   (harmonic mean)
#   inner_new = sqrt(inner * outer_new)               (geometric mean)
#must_use
fn archimedes_pi(iterations) {
    var inner = f64_from(3);
    var outer = f64_mul(f64_from(2), f64_sqrt(f64_from(3)));
    var i = 0;
    while (i < iterations) {
        var outer_new = f64_div(f64_mul(f64_mul(f64_from(2), inner), outer), f64_add(inner, outer));
        var inner_new = f64_sqrt(f64_mul(inner, outer_new));
        inner = inner_new;
        outer = outer_new;
        i = i + 1;
    }
    return (inner, outer);
}

# ---------------------------------------------------------------------------
# Greek isopsephy (alphabetic numeral values) — via varna
# ---------------------------------------------------------------------------

# Descending letter values usable for greedy decomposition. Deliberately OMITS
# 6, 90, 900 (the archaic digamma/koppa/sampi), matching the Rust `available`.
var _avail = 0;
var _avail_done = 0;

fn _available() {
    if (_avail_done == 0) {
        _avail = alloc(24 * 8);
        store64(_avail + 0 * 8, 800);
        store64(_avail + 1 * 8, 700);
        store64(_avail + 2 * 8, 600);
        store64(_avail + 3 * 8, 500);
        store64(_avail + 4 * 8, 400);
        store64(_avail + 5 * 8, 300);
        store64(_avail + 6 * 8, 200);
        store64(_avail + 7 * 8, 100);
        store64(_avail + 8 * 8, 80);
        store64(_avail + 9 * 8, 70);
        store64(_avail + 10 * 8, 60);
        store64(_avail + 11 * 8, 50);
        store64(_avail + 12 * 8, 40);
        store64(_avail + 13 * 8, 30);
        store64(_avail + 14 * 8, 20);
        store64(_avail + 15 * 8, 10);
        store64(_avail + 16 * 8, 9);
        store64(_avail + 17 * 8, 8);
        store64(_avail + 18 * 8, 7);
        store64(_avail + 19 * 8, 5);
        store64(_avail + 20 * 8, 4);
        store64(_avail + 21 * 8, 3);
        store64(_avail + 22 * 8, 2);
        store64(_avail + 23 * 8, 1);
        _avail_done = 1;
    }
    return _avail;
}

# Sum of Greek-letter numeral values of a word (cstr input). Errors on an empty
# string or any character with no isopsephy mapping.
# Rust: pub fn isopsephy(word: &str) -> Result<u32>
#must_use
fn isopsephy(word) {
    if (strlen(word) == 0) {
        return sk_fail(SKE_INVALID_BASE, str_from("empty string has no isopsephy value"));
    }
    var sys = numerals_greek_isopsephy();
    var v = numerals_string_value(sys, word);
    if (v < 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "word contains characters with no isopsephy mapping: ");
        str_builder_add_cstr(sb, word);
        return sk_fail(SKE_INVALID_BASE, str_builder_build(sb));
    }
    return Ok(v);
}

# Greedy additive decomposition of n into Greek alphabetic numerals. Errors on 0
# or a non-representable remainder.
# Rust: pub fn to_greek_numeral(n: u32) -> Result<String>
#must_use
fn to_greek_numeral(n) {
    if (n == 0) {
        return sk_fail(SKE_INVALID_BASE, str_from("zero has no Greek numeral representation"));
    }
    var sys = numerals_greek_isopsephy();
    var avail = _available();
    var remainder = n;
    var sb = str_builder_new();
    var i = 0;
    while (i < 24) {
        var val = load64(avail + i * 8);
        if (remainder >= val) {
            var ch = numerals_char_for(sys, val);
            if (ch != 0) {
                str_builder_add_cstr(sb, ch);
                remainder = remainder - val;
            }
        }
        if (remainder == 0) {
            break;
        }
        i = i + 1;
    }

    if (remainder > 0) {
        var eb = str_builder_new();
        str_builder_add_cstr(eb, "cannot represent ");
        str_builder_add_int(eb, n);
        str_builder_add_cstr(eb, " in Greek alphabetic numerals (remainder ");
        str_builder_add_int(eb, remainder);
        str_builder_add_cstr(eb, ")");
        return sk_fail(SKE_INVALID_BASE, str_builder_build(eb));
    }

    return Ok(str_builder_build(sb));
}

# ---------------------------------------------------------------------------
# Antikythera mechanism
# ---------------------------------------------------------------------------

# AntikytheraCycle record: name(Str) period_years(Str) gear_teeth(i64) desc(Str)
enum AntiOff { ANTI_NAME = 0; ANTI_PERIOD = 8; ANTI_TEETH = 16; ANTI_DESC = 24; ANTI_SIZE = 32; }

#must_use
fn anti_new(name, period_years, gear_teeth, description) {
    var p = alloc(ANTI_SIZE);
    store64(p + ANTI_NAME, name);
    store64(p + ANTI_PERIOD, period_years);
    store64(p + ANTI_TEETH, gear_teeth);
    store64(p + ANTI_DESC, description);
    return p;
}

#must_use
fn anti_name(p) { return load64(p + ANTI_NAME); }
#must_use
fn anti_period_years(p) { return load64(p + ANTI_PERIOD); }
#must_use
fn anti_gear_teeth(p) { return load64(p + ANTI_TEETH); }
#must_use
fn anti_description(p) { return load64(p + ANTI_DESC); }

# Lexicographic byte compare of two Str values: <0, 0, >0.
fn _str_cmp(a, b) {
    var la = str_len(a);
    var lb = str_len(b);
    var da = str_data(a);
    var db = str_data(b);
    var n = la;
    if (lb < la) { n = lb; }
    var i = 0;
    while (i < n) {
        var ca = load8(da + i) & 0xFF;
        var cb = load8(db + i) & 0xFF;
        if (ca != cb) { return ca - cb; }
        i = i + 1;
    }
    return la - lb;
}

# Comparator over AntikytheraCycle records, by name (for vec_sort).
fn _anti_name_cmp(a, b) {
    return _str_cmp(anti_name(a), anti_name(b));
}

# The known gear ratios of the Antikythera mechanism. Returns a vec of
# AntikytheraCycle records sorted by name (BTreeMap<&str> key order).
#must_use
fn antikythera_gear_ratios() {
    var v = vec_new();
    vec_push(v, anti_new(str_from("Metonic"), str_from("19"), 235,
        str_from("19 tropical years = 235 synodic months (Meton of Athens, 432 BCE)")));
    vec_push(v, anti_new(str_from("Saros"), str_from("18.03"), 223,
        str_from("223 synodic months — eclipse repeat cycle")));
    vec_push(v, anti_new(str_from("Exeligmos"), str_from("54.09"), 669,
        str_from("3 Saros cycles = 669 synodic months (exact eclipse repeat)")));
    vec_push(v, anti_new(str_from("Callippic"), str_from("76"), 940,
        str_from("4 Metonic cycles - 1 day = 940 synodic months (Callippus, 330 BCE)")));
    vec_push(v, anti_new(str_from("Olympiad"), str_from("4"), 57,
        str_from("4-year cycle of Panhellenic games (Olympic, Nemean, Isthmian, Pythian)")));
    vec_push(v, anti_new(str_from("Synodic Month"), str_from("0.0809"), 127,
        str_from("Lunar month: 29.53059 days — ratio 127/223 encodes month count")));
    vec_push(v, anti_new(str_from("Sidereal Year"), str_from("1"), 365,
        str_from("Solar year: 365.25 days — primary input gear")));
    sk_vec_sort(v, &_anti_name_cmp);
    return v;
}

# Look up a cycle by name in a gear-ratio vec. Returns the record ptr or 0.
#must_use
fn antikythera_lookup(v, name) {
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        var p = vec_get(v, i);
        if (str_eq_cstr(anti_name(p), name) == 1) { return p; }
        i = i + 1;
    }
    return 0;
}

# --- vedic.cyr ---

# vedic.cyr — Vedic / Indian mathematics.
#
# Ported from rust-old/src/vedic.rs (full parity):
#   - Nikhilam-Sutra multiplication (product + step-by-step demonstrator)
#   - Sulba Sutra geometry (rectangle diagonal via Pythagoras; Baudhayana's
#     577/408 sqrt(2) approximation)
#   - Katapayadi consonant<->digit encode/decode
#   - Meru Prastara (Pingala's / Pascal's triangle)
#   - Devanagari-script Katapayadi + numeral rendering (via varna — always-on).
#
# Self-contained: no include lines (the distlib bundler strips them; stdlib +
# varna symbols are resolved from the consumer's [deps]).
#
# Parity note on integers: the Rust code is u64-heavy (wrapping_mul,
# saturating_mul, checked_add/mul/sub -> Option). Cyrius ints are signed i64;
# we reproduce wrapping via `*%`, saturating via `*|`, and the checked-overflow
# Option paths via manual bound checks against the i64 max (0x7FFF...FFFF). For
# valid inputs (the domain of every test) this is exact; only values above the
# i64 range would diverge from the u64 original (see parity_notes).

# ---------------------------------------------------------------------------
# Vedic multiplication (Nikhilam Sutra)
# ---------------------------------------------------------------------------

# Multiply a and b. The Nikhilam method is pedagogical; the product itself is
# the direct identity (Rust: a.wrapping_mul(b)).
#must_use
fn vedic_multiply(a, b) {
    return a *% b;
}

# Smallest power of 10 >= n (minimum 10). Rust used saturating_mul; we saturate
# to the i64 max manually (the *| operator maps to an unlinked runtime helper).
#must_use
fn next_power_of_10(n) {
    var base = 10;
    var limit = 0x7FFFFFFFFFFFFFFF;
    while (base < n) {
        if (base > limit / 10) { base = limit; }
        if (base <= limit / 10) { base = base * 10; }
    }
    return base;
}

# NikhilamSteps record: base(0) da(8) db(16) cross(24) product(32) = 40 bytes.
enum NkOff { NK_BASE = 0; NK_DA = 8; NK_DB = 16; NK_CROSS = 24; NK_PRODUCT = 32; NK_SIZE = 40; }

fn nikhilam_new(base, da, db, cross, product) {
    var p = alloc(NK_SIZE);
    store64(p + NK_BASE, base);
    store64(p + NK_DA, da);
    store64(p + NK_DB, db);
    store64(p + NK_CROSS, cross);
    store64(p + NK_PRODUCT, product);
    return p;
}

#must_use
fn nk_base(p) { return load64(p + NK_BASE); }
#must_use
fn nk_da(p) { return load64(p + NK_DA); }
#must_use
fn nk_db(p) { return load64(p + NK_DB); }
#must_use
fn nk_cross(p) { return load64(p + NK_CROSS); }
#must_use
fn nk_product(p) { return load64(p + NK_PRODUCT); }

# Nikhilam multiplication showing the steps. Returns Ok(NikhilamSteps) or an
# Err carrying the exact Rust message. (Rust returned Result<(base, da, db,
# cross, product)>; we box the 5 values in a record.)
#must_use
fn vedic_multiply_nikhilam(a, b) {
    var max_val = a;
    if (b > a) { max_val = b; }
    var base = next_power_of_10(max_val);

    if (a > base) { return sk_fail(SKE_COMPUTATION, str_from("values exceed the Nikhilam base")); }
    if (b > base) { return sk_fail(SKE_COMPUTATION, str_from("values exceed the Nikhilam base")); }

    var da = base - a;
    var db = base - b;

    # cross-subtraction: a - db (Rust checked_sub underflows if db > a)
    if (db > a) { return sk_fail(SKE_OVERFLOW, str_from("Nikhilam cross-subtraction underflow")); }
    var cross = a - db;

    # product = cross * base + da * db, guarding overflow like Rust checked_*
    var limit = 0x7FFFFFFFFFFFFFFF;
    if (base != 0) {
        if (cross > limit / base) { return sk_fail(SKE_OVERFLOW, str_from("Nikhilam multiplication overflow")); }
    }
    var cb = cross * base;
    if (db != 0) {
        if (da > limit / db) { return sk_fail(SKE_OVERFLOW, str_from("Nikhilam multiplication overflow")); }
    }
    var dadb = da * db;
    if (cb > limit - dadb) { return sk_fail(SKE_OVERFLOW, str_from("Nikhilam multiplication overflow")); }
    var product = cb + dadb;

    return Ok(nikhilam_new(base, da, db, cross, product));
}

# ---------------------------------------------------------------------------
# Sulba Sutra geometry
# ---------------------------------------------------------------------------

# Diagonal of a rectangle: sqrt(a*a + b*b) (Baudhayana Sulba Sutra). f64 args.
#must_use
fn sulba_diagonal(a, b) {
    return f64_sqrt(f64_add(f64_mul(a, a), f64_mul(b, b)));
}

# Baudhayana's sqrt(2): 1 + 1/3 + 1/(3*4) - 1/(3*4*34) = 577/408. Op order
# mirrors the Rust expression exactly for bit parity.
#must_use
fn sulba_sqrt2() {
    var d2 = f64_mul(f64_from(3), f64_from(4));
    var d3 = f64_mul(f64_mul(f64_from(3), f64_from(4)), f64_from(34));
    var r = f64_add(f64_from(1), f64_div(f64_from(1), f64_from(3)));
    r = f64_add(r, f64_div(f64_from(1), d2));
    r = f64_sub(r, f64_div(f64_from(1), d3));
    return r;
}

# ---------------------------------------------------------------------------
# Katapayadi number encoding
# ---------------------------------------------------------------------------

# Romanized ka-varga/ca-varga consonant for digit 0-9.
fn _katapayadi_consonant(d) {
    if (d == 0) { return "nya"; }
    if (d == 1) { return "ka"; }
    if (d == 2) { return "kha"; }
    if (d == 3) { return "ga"; }
    if (d == 4) { return "gha"; }
    if (d == 5) { return "nga"; }
    if (d == 6) { return "ca"; }
    if (d == 7) { return "cha"; }
    if (d == 8) { return "ja"; }
    return "jha";
}

# Encode n as hyphen-joined consonant syllables, least-significant digit first.
#must_use
fn katapayadi_encode(n) {
    if (n == 0) { return str_from("nya"); }
    var sb = str_builder_new();
    var remaining = n;
    var first = 1;
    while (remaining > 0) {
        var digit = remaining % 10;
        remaining = remaining / 10;
        if (first == 0) { str_builder_add_cstr(sb, "-"); }
        str_builder_add_cstr(sb, _katapayadi_consonant(digit));
        first = 0;
    }
    return str_builder_build(sb);
}

# Digit 0-9 for a syllable cstr, or (0-1) if unrecognized.
fn _katapayadi_digit_of(tok) {
    if (streq(tok, "nya") == 1) { return 0; }
    if (streq(tok, "ka") == 1) { return 1; }
    if (streq(tok, "kha") == 1) { return 2; }
    if (streq(tok, "ga") == 1) { return 3; }
    if (streq(tok, "gha") == 1) { return 4; }
    if (streq(tok, "nga") == 1) { return 5; }
    if (streq(tok, "ca") == 1) { return 6; }
    if (streq(tok, "cha") == 1) { return 7; }
    if (streq(tok, "ja") == 1) { return 8; }
    if (streq(tok, "jha") == 1) { return 9; }
    return 0 - 1;
}

# Decode a hyphen-separated Katapayadi string back to a number. Returns
# Ok(value) or Err (unrecognized syllable / overflow), with the Rust messages.
#must_use
fn katapayadi_decode(s) {
    var slen = str_len(s);
    var sd = str_data(s);
    var result = 0;
    var place = 1;
    var tok_start = 0;
    var done = 0;
    var limit = 0x7FFFFFFFFFFFFFFF;
    while (done == 0) {
        # find next '-' (byte 45) or end
        var j = tok_start;
        while (j < slen) {
            var c = load8(sd + j);
            if (c == 45) { break; }
            j = j + 1;
        }
        # copy token [tok_start, j) into a fresh NUL-terminated cstr
        var toklen = j - tok_start;
        var tok = alloc(toklen + 1);
        var ci = 0;
        while (ci < toklen) {
            store8(tok + ci, load8(sd + tok_start + ci));
            ci = ci + 1;
        }
        store8(tok + toklen, 0);

        var digit = _katapayadi_digit_of(tok);
        if (digit < 0) {
            var em = str_builder_new();
            str_builder_add_cstr(em, "unrecognized Katapayadi syllable: ");
            str_builder_add_cstr(em, tok);
            return sk_fail(SKE_COMPUTATION, str_builder_build(em));
        }

        # result += digit * place   (checked)
        if (place != 0) {
            if (digit > limit / place) { return sk_fail(SKE_OVERFLOW, str_from("Katapayadi decode overflow")); }
        }
        var dp = digit * place;
        if (result > limit - dp) { return sk_fail(SKE_OVERFLOW, str_from("Katapayadi decode overflow")); }
        result = result + dp;

        # place *= 10   (checked)
        if (place > limit / 10) { return sk_fail(SKE_OVERFLOW, str_from("Katapayadi decode overflow")); }
        place = place * 10;

        if (j >= slen) { done = 1; }
        if (j < slen) { tok_start = j + 1; }
    }
    return Ok(result);
}

# ---------------------------------------------------------------------------
# Meru Prastara (Pingala's triangle / Pascal's triangle)
# ---------------------------------------------------------------------------

# Build rows 0..rows of Pingala's triangle. Returns Ok(vec of vec<i64>) or an
# Err on binomial-coefficient overflow. Mirrors the Rust tracing::debug! site.
#must_use
fn meru_prastara(rows) {
    var meru_msg = "generating Meru Prastara (Pingala's triangle)";
    var rows_str = str_from_int(rows);
    sakshi_log_kv(SK_DEBUG, meru_msg, strlen(meru_msg), "rows", 4, str_data(rows_str), str_len(rows_str));

    if (rows == 0) { return Ok(vec_new()); }

    var triangle = vec_new();
    var row0 = vec_new();
    vec_push(row0, 1);
    vec_push(triangle, row0);

    var limit = 0x7FFFFFFFFFFFFFFF;
    var i = 1;
    while (i < rows) {
        var prev = vec_get(triangle, i - 1);
        var row = vec_new();
        vec_push(row, 1);
        var j = 1;
        while (j < i) {
            var pa = vec_get(prev, j - 1);
            var pb = vec_get(prev, j);
            if (pa > limit - pb) {
                var em = str_builder_new();
                str_builder_add_cstr(em, "Meru Prastara overflow at row ");
                str_builder_add_int(em, i);
                str_builder_add_cstr(em, ", position ");
                str_builder_add_int(em, j);
                return sk_fail(SKE_OVERFLOW, str_builder_build(em));
            }
            vec_push(row, pa + pb);
            j = j + 1;
        }
        vec_push(row, 1);
        vec_push(triangle, row);
        i = i + 1;
    }
    return Ok(triangle);
}

# ---------------------------------------------------------------------------
# Devanagari Katapayadi encoding + numerals (via varna — always-on parity)
# ---------------------------------------------------------------------------

# IAST syllable (with inherent 'a') for digit 0-9, matching varna's
# Devanagari->IAST table (क->"ka", ख->"kha", ...; ञ->"ña", ङ->"ṅa").
fn _iast_syllable(d) {
    if (d == 0) { return "ña"; }
    if (d == 1) { return "ka"; }
    if (d == 2) { return "kha"; }
    if (d == 3) { return "ga"; }
    if (d == 4) { return "gha"; }
    if (d == 5) { return "ṅa"; }
    if (d == 6) { return "ca"; }
    if (d == 7) { return "cha"; }
    if (d == 8) { return "ja"; }
    return "jha";
}

# Katapayadi encoding rendered in Devanagari consonants, space-separated,
# least-significant digit first. Uses varna's IAST reverse map (IAST -> Deva).
#must_use
fn katapayadi_encode_devanagari(n) {
    var tt = translit_devanagari_iast();
    var rev = translit_reverse_map(tt);

    if (n == 0) {
        var g0 = map_get(rev, "ña");
        if (g0 == 0) { g0 = "ञ"; }
        return str_from(g0);
    }

    var sb = str_builder_new();
    var remaining = n;
    var first = 1;
    while (remaining > 0) {
        var digit = remaining % 10;
        remaining = remaining / 10;
        if (first == 0) { str_builder_add_cstr(sb, " "); }
        var syl = _iast_syllable(digit);
        var g = map_get(rev, syl);
        if (g == 0) { g = "?"; }
        str_builder_add_cstr(sb, g);
        first = 0;
    }
    return str_builder_build(sb);
}

# Render n in Devanagari numeral glyphs (०-९) via varna's numeral system.
#must_use
fn to_devanagari_digits(n) {
    var sys = numerals_devanagari_digits();
    if (n == 0) {
        var g0 = numerals_char_for(sys, 0);
        if (g0 == 0) { g0 = "०"; }
        return str_from(g0);
    }

    var digits = vec_new();
    var remaining = n;
    while (remaining > 0) {
        var d = remaining % 10;
        var g = numerals_char_for(sys, d);
        if (g == 0) { g = "?"; }
        vec_push(digits, g);
        remaining = remaining / 10;
    }

    # digits were pushed LSD-first; emit reversed (MSD-first) and join.
    var sb = str_builder_new();
    var m = vec_len(digits);
    var k = m - 1;
    while (k >= 0) {
        str_builder_add_cstr(sb, vec_get(digits, k));
        k = k - 1;
    }
    return str_builder_build(sb);
}

# --- mayan.cyr ---

# mayan.cyr — Mayan mathematics and calendar systems (ported from src/mayan.rs).
#
# Vigesimal (base-20) numbers, dot/bar/shell numeral glyphs (0-19), the
# five-position Long Count calendar (kin/uinal/tun/katun/baktun) with JDN
# correlation via the GMT constant 584283, the Tzolkin 260-day sacred cycle,
# the Haab 365-day solar calendar, the combined Calendar Round (18,980-day
# cycle) with forward-search matchers, and Dresden-Codex Venus phase.
#
# Pure integer arithmetic over day counts; all Rust operands are non-negative
# u64 so plain `%` and `/` (truncated) match Rust exactly (no rem_euclid needed).
#
# Parity: Rust returns Result<T, SankhyaError> with an interpolated format!
# message on each error variant. We preserve BOTH the code AND the message
# text via sk_fail(code, str) — see src/error.cyr. Display impls become
# <type>_to_str(p) returning a Str. JSON (de)serialization lives in serial.cyr.

# --- Integer constants (enum members: no global-init cost) ---
# EPOCH_JDN: GMT correlation JDN of the Mayan creation date (Aug 11, 3114 BCE).
# CALENDAR_ROUND_DAYS: lcm(260,365), Calendar Round cycle length (~52 years).
enum MayanConst {
    EPOCH_JDN = 584283;
    CALENDAR_ROUND_DAYS = 18980;
}

# ---------------------------------------------------------------------------
# Vigesimal (base-20) number system
# ---------------------------------------------------------------------------

# Convert a decimal number to vigesimal (base-20) digits, most significant
# first. Returns a vec containing [0] for zero (the Maya had an explicit zero
# glyph — the shell).
#must_use
fn to_vigesimal(n) {
    var v = vec_new();
    if (n == 0) {
        vec_push(v, 0);
        return v;
    }
    var m = n;
    while (m > 0) {
        vec_push(v, m % 20);
        m = m / 20;
    }
    # digits were pushed least-significant first; reverse in place.
    var len = vec_len(v);
    var half = len / 2;
    var i = 0;
    while (i < half) {
        var a = vec_get(v, i);
        var b = vec_get(v, len - 1 - i);
        vec_set(v, i, b);
        vec_set(v, len - 1 - i, a);
        i = i + 1;
    }
    return v;
}

# Convert vigesimal (base-20) digits (a vec, most-significant first) back to a
# decimal number. Errors InvalidBase if any digit >= 20; OverflowError on
# overflow (result*20 + digit exceeds i64 max). Returns Result<u64>.
#must_use
fn from_vigesimal(digits) {
    var result = 0;
    var n = vec_len(digits);
    var limit = 0x7FFFFFFFFFFFFFFF;
    var i = 0;
    while (i < n) {
        var d = vec_get(digits, i);
        if (d >= 20) {
            var sbd = str_builder_new();
            str_builder_add_cstr(sbd, "vigesimal digit ");
            str_builder_add_int(sbd, d);
            str_builder_add_cstr(sbd, " out of range 0..20");
            return sk_fail(SKE_INVALID_BASE, str_builder_build(sbd));
        }
        if (result > limit / 20) {
            return sk_fail(SKE_OVERFLOW, str_from("vigesimal conversion overflow"));
        }
        result = result * 20;
        if (result > limit - d) {
            return sk_fail(SKE_OVERFLOW, str_from("vigesimal conversion overflow"));
        }
        result = result + d;
        i = i + 1;
    }
    return Ok(result);
}

# ---------------------------------------------------------------------------
# Mayan numeral glyphs — MayanNumeral { dots, bars, shell }
# ---------------------------------------------------------------------------
# Offsets: dots(0) bars(8) shell(16) = 24 bytes. shell is a bool (0/1).
enum MayanNumeralOff { MN_DOTS = 0; MN_BARS = 8; MN_SHELL = 16; MN_SIZE = 24; }

#must_use
fn mayan_numeral_make(dots, bars, shell) {
    var p = alloc(MN_SIZE);
    store64(p + MN_DOTS, dots);
    store64(p + MN_BARS, bars);
    store64(p + MN_SHELL, shell);
    return p;
}
#must_use
fn mayan_numeral_dots(p) { return load64(p + MN_DOTS); }
#must_use
fn mayan_numeral_bars(p) { return load64(p + MN_BARS); }
#must_use
fn mayan_numeral_shell(p) { return load64(p + MN_SHELL); }

# Create a Mayan numeral from a value 0-19. InvalidBase if value > 19.
# value 0 => shell=true; else dots=value%5, bars=value/5. Returns Result.
#must_use
fn mayan_numeral_from_value(value) {
    if (value > 19) {
        var sbm = str_builder_new();
        str_builder_add_cstr(sbm, "Mayan numeral value ");
        str_builder_add_int(sbm, value);
        str_builder_add_cstr(sbm, " out of range 0..19");
        return sk_fail(SKE_INVALID_BASE, str_builder_build(sbm));
    }
    if (value == 0) {
        return Ok(mayan_numeral_make(0, 0, 1));
    }
    return Ok(mayan_numeral_make(value % 5, value / 5, 0));
}

# The decimal value of this numeral (0-19). shell => 0 else bars*5 + dots.
#must_use
fn mayan_numeral_value(p) {
    if (mayan_numeral_shell(p) == 1) {
        return 0;
    }
    return mayan_numeral_bars(p) * 5 + mayan_numeral_dots(p);
}

# ---------------------------------------------------------------------------
# Long Count calendar — LongCount { baktun, katun, tun, uinal, kin }
# ---------------------------------------------------------------------------
# Offsets: baktun(0) katun(8) tun(16) uinal(24) kin(32) = 40 bytes.
enum LongCountOff { LC_BAKTUN = 0; LC_KATUN = 8; LC_TUN = 16; LC_UINAL = 24; LC_KIN = 32; LC_SIZE = 40; }

#must_use
fn longcount_make(baktun, katun, tun, uinal, kin) {
    var p = alloc(LC_SIZE);
    store64(p + LC_BAKTUN, baktun);
    store64(p + LC_KATUN, katun);
    store64(p + LC_TUN, tun);
    store64(p + LC_UINAL, uinal);
    store64(p + LC_KIN, kin);
    return p;
}
#must_use
fn lc_baktun(p) { return load64(p + LC_BAKTUN); }
#must_use
fn lc_katun(p) { return load64(p + LC_KATUN); }
#must_use
fn lc_tun(p) { return load64(p + LC_TUN); }
#must_use
fn lc_uinal(p) { return load64(p + LC_UINAL); }
#must_use
fn lc_kin(p) { return load64(p + LC_KIN); }

# Validated constructor. InvalidDate if katun>=20, tun>=20, uinal>=18, or
# kin>=20 (baktun unbounded). Returns Result.
#must_use
fn long_count_new(baktun, katun, tun, uinal, kin) {
    if (katun >= 20) {
        var sbk = str_builder_new();
        str_builder_add_cstr(sbk, "katun ");
        str_builder_add_int(sbk, katun);
        str_builder_add_cstr(sbk, " out of range 0..20");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sbk));
    }
    if (tun >= 20) {
        var sbt = str_builder_new();
        str_builder_add_cstr(sbt, "tun ");
        str_builder_add_int(sbt, tun);
        str_builder_add_cstr(sbt, " out of range 0..20");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sbt));
    }
    if (uinal >= 18) {
        var sbu = str_builder_new();
        str_builder_add_cstr(sbu, "uinal ");
        str_builder_add_int(sbu, uinal);
        str_builder_add_cstr(sbu, " out of range 0..18");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sbu));
    }
    if (kin >= 20) {
        var sbn = str_builder_new();
        str_builder_add_cstr(sbn, "kin ");
        str_builder_add_int(sbn, kin);
        str_builder_add_cstr(sbn, " out of range 0..20");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sbn));
    }
    return Ok(longcount_make(baktun, katun, tun, uinal, kin));
}

# Convert a day count (days since creation) to Long Count via successive
# div/mod by 144000/7200/360/20. OverflowError if baktun exceeds u32::MAX.
# Returns Result.
#must_use
fn long_count_from_days(days) {
    var d = days;
    var baktun = d / 144000;
    d = d % 144000;
    var katun = d / 7200;
    d = d % 7200;
    var tun = d / 360;
    d = d % 360;
    var uinal = d / 20;
    var kin = d % 20;
    if (baktun > 0xFFFFFFFF) {
        # Faithful port of a Rust quirk: `days` was reduced to the mod-360
        # remainder before this format!, so the message interpolates `d`.
        var sbo = str_builder_new();
        str_builder_add_cstr(sbo, "day count ");
        str_builder_add_int(sbo, d);
        str_builder_add_cstr(sbo, " exceeds maximum representable baktun");
        return sk_fail(SKE_OVERFLOW, str_builder_build(sbo));
    }
    return Ok(longcount_make(baktun, katun, tun, uinal, kin));
}

# Long Count -> day count.
#must_use
fn long_count_to_days(p) {
    return lc_baktun(p) * 144000 + lc_katun(p) * 7200 + lc_tun(p) * 360 + lc_uinal(p) * 20 + lc_kin(p);
}

# JDN -> Long Count. InvalidDate if jdn < EPOCH_JDN. Returns Result.
#must_use
fn long_count_from_julian_day(jdn) {
    if (jdn < EPOCH_JDN) {
        var sbj = str_builder_new();
        str_builder_add_cstr(sbj, "JDN ");
        str_builder_add_int(sbj, jdn);
        str_builder_add_cstr(sbj, " is before the Mayan epoch (JDN ");
        str_builder_add_int(sbj, EPOCH_JDN);
        str_builder_add_cstr(sbj, ")");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sbj));
    }
    return long_count_from_days(jdn - EPOCH_JDN);
}

# Long Count -> JDN: to_days() + EPOCH_JDN.
#must_use
fn long_count_to_julian_day(p) {
    return long_count_to_days(p) + EPOCH_JDN;
}

# Display: "{baktun}.{katun}.{tun}.{uinal}.{kin}".
#must_use
fn longcount_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_int(sb, lc_baktun(p));
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, lc_katun(p));
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, lc_tun(p));
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, lc_uinal(p));
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, lc_kin(p));
    return str_builder_build(sb);
}

# ---------------------------------------------------------------------------
# Tzolkin (sacred 260-day cycle)
# ---------------------------------------------------------------------------
# The 20 day signs. Enum value IS the index into the ordered DAY_SIGNS table.
enum DaySign {
    DS_IMIX; DS_IK; DS_AKBAL; DS_KAN; DS_CHICCHAN; DS_CIMI; DS_MANIK;
    DS_LAMAT; DS_MULUC; DS_OC; DS_CHUEN; DS_EB; DS_BEN; DS_IX; DS_MEN;
    DS_CIB; DS_CABAN; DS_ETZNAB; DS_CAUAC; DS_AHAU;
}

# Lazy-singleton name table (serde identifier == Display via {:?}).
var daysign_names_vec = 0;
var daysign_names_done = 0;
fn build_daysign_names() {
    var v = vec_new();
    vec_push(v, str_from("Imix"));
    vec_push(v, str_from("Ik"));
    vec_push(v, str_from("Akbal"));
    vec_push(v, str_from("Kan"));
    vec_push(v, str_from("Chicchan"));
    vec_push(v, str_from("Cimi"));
    vec_push(v, str_from("Manik"));
    vec_push(v, str_from("Lamat"));
    vec_push(v, str_from("Muluc"));
    vec_push(v, str_from("Oc"));
    vec_push(v, str_from("Chuen"));
    vec_push(v, str_from("Eb"));
    vec_push(v, str_from("Ben"));
    vec_push(v, str_from("Ix"));
    vec_push(v, str_from("Men"));
    vec_push(v, str_from("Cib"));
    vec_push(v, str_from("Caban"));
    vec_push(v, str_from("Etznab"));
    vec_push(v, str_from("Cauac"));
    vec_push(v, str_from("Ahau"));
    return v;
}
#must_use
fn all_daysign_names() {
    if (daysign_names_done == 0) {
        daysign_names_vec = build_daysign_names();
        daysign_names_done = 1;
    }
    return daysign_names_vec;
}
#must_use
fn daysign_name(i) { return vec_get(all_daysign_names(), i); }

# Tzolkin { number, day_sign }. Offsets: number(0) day_sign(8) = 16 bytes.
enum TzolkinOff { TZ_NUMBER = 0; TZ_DAYSIGN = 8; TZ_SIZE = 16; }

#must_use
fn tzolkin_make(number, day_sign) {
    var p = alloc(TZ_SIZE);
    store64(p + TZ_NUMBER, number);
    store64(p + TZ_DAYSIGN, day_sign);
    return p;
}
#must_use
fn tz_number(p) { return load64(p + TZ_NUMBER); }
#must_use
fn tz_daysign(p) { return load64(p + TZ_DAYSIGN); }

# Compute the Tzolkin date for a day count from the Mayan epoch.
# Base at day 0 = 4 Ahau: number = (days+3)%13 + 1; sign = (days+19)%20.
#must_use
fn tzolkin_from_days(days) {
    var number = (days + 3) % 13 + 1;
    var sign_index = (days + 19) % 20;
    return tzolkin_make(number, sign_index);
}

# Display: "{number} {DaySign}" (day sign via its variant identifier).
#must_use
fn tzolkin_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_int(sb, tz_number(p));
    str_builder_add_cstr(sb, " ");
    str_builder_add(sb, daysign_name(tz_daysign(p)));
    return str_builder_build(sb);
}

# ---------------------------------------------------------------------------
# Haab (solar 365-day calendar)
# ---------------------------------------------------------------------------
# The 19 months (18 regular + Wayeb). Enum value IS the index into HAAB_MONTHS.
enum HaabMonth {
    HM_POP; HM_WO; HM_SIP; HM_SOTZ; HM_SEK; HM_XUL; HM_YAXKIN; HM_MOL;
    HM_CHEN; HM_YAX; HM_SAK; HM_KEH; HM_MAK; HM_KANKIN; HM_MUAN; HM_PAX;
    HM_KAYAB; HM_KUMKU; HM_WAYEB;
}

var haabmonth_names_vec = 0;
var haabmonth_names_done = 0;
fn build_haabmonth_names() {
    var v = vec_new();
    vec_push(v, str_from("Pop"));
    vec_push(v, str_from("Wo"));
    vec_push(v, str_from("Sip"));
    vec_push(v, str_from("Sotz"));
    vec_push(v, str_from("Sek"));
    vec_push(v, str_from("Xul"));
    vec_push(v, str_from("Yaxkin"));
    vec_push(v, str_from("Mol"));
    vec_push(v, str_from("Chen"));
    vec_push(v, str_from("Yax"));
    vec_push(v, str_from("Sak"));
    vec_push(v, str_from("Keh"));
    vec_push(v, str_from("Mak"));
    vec_push(v, str_from("Kankin"));
    vec_push(v, str_from("Muan"));
    vec_push(v, str_from("Pax"));
    vec_push(v, str_from("Kayab"));
    vec_push(v, str_from("Kumku"));
    vec_push(v, str_from("Wayeb"));
    return v;
}
#must_use
fn all_haabmonth_names() {
    if (haabmonth_names_done == 0) {
        haabmonth_names_vec = build_haabmonth_names();
        haabmonth_names_done = 1;
    }
    return haabmonth_names_vec;
}
#must_use
fn haabmonth_name(i) { return vec_get(all_haabmonth_names(), i); }

# Haab { day, month }. Offsets: day(0) month(8) = 16 bytes.
enum HaabOff { HB_DAY = 0; HB_MONTH = 8; HB_SIZE = 16; }

#must_use
fn haab_make(day, month) {
    var p = alloc(HB_SIZE);
    store64(p + HB_DAY, day);
    store64(p + HB_MONTH, month);
    return p;
}
#must_use
fn hb_day(p) { return load64(p + HB_DAY); }
#must_use
fn hb_month(p) { return load64(p + HB_MONTH); }

# Compute the Haab date for a day count from the Mayan epoch.
# Base at day 0 = 8 Kumku: haab_day = (days+348)%365; month = haab_day/20;
# day = haab_day%20.
#must_use
fn haab_from_days(days) {
    var haab_day = (days + 348) % 365;
    var month_index = haab_day / 20;
    var day = haab_day % 20;
    return haab_make(day, month_index);
}

# Display: "{day} {HaabMonth}" (month via its variant identifier).
#must_use
fn haab_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_int(sb, hb_day(p));
    str_builder_add_cstr(sb, " ");
    str_builder_add(sb, haabmonth_name(hb_month(p)));
    return str_builder_build(sb);
}

# ---------------------------------------------------------------------------
# Calendar Round
# ---------------------------------------------------------------------------
# calendar_round returns a (Tzolkin, Haab) pair record. Offsets: tz(0) hb(8).
enum CalRoundOff { CR_TZOLKIN = 0; CR_HAAB = 8; CR_SIZE = 16; }

#must_use
fn calendar_round(days) {
    var p = alloc(CR_SIZE);
    store64(p + CR_TZOLKIN, tzolkin_from_days(days));
    store64(p + CR_HAAB, haab_from_days(days));
    return p;
}
#must_use
fn cr_tzolkin(p) { return load64(p + CR_TZOLKIN); }
#must_use
fn cr_haab(p) { return load64(p + CR_HAAB); }

# Find the next occurrence of a Calendar Round date on or after start_day.
# InvalidDate if number not 1-13 or haab_day > (4 for Wayeb else 19);
# ComputationError if no match within one cycle. Returns Result<u64>.
#must_use
fn find_calendar_round(tzolkin_number, tzolkin_sign, haab_day, haab_month, start_day) {
    if (tzolkin_number < 1 || tzolkin_number > 13) {
        var sbc = str_builder_new();
        str_builder_add_cstr(sbc, "Tzolkin number ");
        str_builder_add_int(sbc, tzolkin_number);
        str_builder_add_cstr(sbc, " out of range 1..13");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sbc));
    }
    var haab_max = 19;
    if (haab_month == HM_WAYEB) {
        haab_max = 4;
    }
    if (haab_day > haab_max) {
        var sbh = str_builder_new();
        str_builder_add_cstr(sbh, "Haab day ");
        str_builder_add_int(sbh, haab_day);
        str_builder_add_cstr(sbh, " out of range for ");
        str_builder_add(sbh, haabmonth_name(haab_month));
        str_builder_add_cstr(sbh, " (max ");
        str_builder_add_int(sbh, haab_max);
        str_builder_add_cstr(sbh, ")");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sbh));
    }
    var offset = 0;
    while (offset < CALENDAR_ROUND_DAYS) {
        var day = start_day + offset;
        var tz = tzolkin_from_days(day);
        var hb = haab_from_days(day);
        if (tz_number(tz) == tzolkin_number && tz_daysign(tz) == tzolkin_sign && hb_day(hb) == haab_day && hb_month(hb) == haab_month) {
            return Ok(day);
        }
        offset = offset + 1;
    }
    return sk_fail(SKE_COMPUTATION, str_from("no matching Calendar Round date found within one cycle"));
}

# Find the next occurrence of a Tzolkin date on or after start_day.
# InvalidDate if number not 1-13; ComputationError if no match. Returns Result.
#must_use
fn find_tzolkin(tzolkin_number, tzolkin_sign, start_day) {
    if (tzolkin_number < 1 || tzolkin_number > 13) {
        var sbf = str_builder_new();
        str_builder_add_cstr(sbf, "Tzolkin number ");
        str_builder_add_int(sbf, tzolkin_number);
        str_builder_add_cstr(sbf, " out of range 1..13");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sbf));
    }
    var offset = 0;
    while (offset < 260) {
        var day = start_day + offset;
        var tz = tzolkin_from_days(day);
        if (tz_number(tz) == tzolkin_number && tz_daysign(tz) == tzolkin_sign) {
            return Ok(day);
        }
        offset = offset + 1;
    }
    return sk_fail(SKE_COMPUTATION, str_from("no matching Tzolkin date found within one cycle"));
}

# ---------------------------------------------------------------------------
# Venus table
# ---------------------------------------------------------------------------
# The 4 Venus phases tracked in the Dresden Codex.
enum VenusPhase {
    VP_MORNING_STAR; VP_SUPERIOR_CONJUNCTION; VP_EVENING_STAR; VP_INFERIOR_CONJUNCTION;
}

var venusphase_names_vec = 0;
var venusphase_names_done = 0;
fn build_venusphase_names() {
    var v = vec_new();
    vec_push(v, str_from("MorningStar"));
    vec_push(v, str_from("SuperiorConjunction"));
    vec_push(v, str_from("EveningStar"));
    vec_push(v, str_from("InferiorConjunction"));
    return v;
}
#must_use
fn all_venusphase_names() {
    if (venusphase_names_done == 0) {
        venusphase_names_vec = build_venusphase_names();
        venusphase_names_done = 1;
    }
    return venusphase_names_vec;
}
#must_use
fn venusphase_name(i) { return vec_get(all_venusphase_names(), i); }

# VENUS_SYNODIC_PERIOD = 583.92 (f64). Documentation-only: never used in any
# computation (venus_phase uses the integer 584). Lazy-parsed once.
var venus_synodic_period_val = 0;
var venus_synodic_period_done = 0;
#must_use
fn venus_synodic_period() {
    if (venus_synodic_period_done == 0) {
        venus_synodic_period_val = f64_parse("583.92");
        venus_synodic_period_done = 1;
    }
    return venus_synodic_period_val;
}

# Determine the phase of Venus given days from the Mayan epoch.
# Mayan model (Dresden Codex): Morning 236 / Superior 90 / Evening 250 /
# Inferior 8, summing to the 584-day cycle.
#must_use
fn venus_phase(days_from_epoch) {
    var phase_day = days_from_epoch % 584;
    if (phase_day < 236) {
        return VP_MORNING_STAR;
    }
    if (phase_day < 326) {
        return VP_SUPERIOR_CONJUNCTION;
    }
    if (phase_day < 576) {
        return VP_EVENING_STAR;
    }
    return VP_INFERIOR_CONJUNCTION;
}

# --- aztec.cyr ---

# aztec.cyr — Aztec (Mexica) calendar systems.
#
# Ports rust-old/src/aztec.rs: the Tonalpohualli (260-day sacred cycle) and
# Xiuhpohualli (365-day solar cycle), plus the Calendar Round that meshes them.
# Uses the Caso correlation (fall of Tenochtitlan, Aug 13 1521 CE, JDN 2275856
# = 1 Coatl / day 1 Xocotl Huetzi). Self-contained (no include lines); resolves
# stdlib (str/vec/math f64) from the consumer's [deps].
#
# Parity notes:
#   - rem_euclid (util) is MANDATORY: `days` is negative for pre-correlation
#     JDNs, so bare % would corrupt the number/sign/day-of-year.
#   - The serde variant identifiers (no spaces) are kept separate from the
#     Display strings (spaces in Huey Tozoztli / Huey Tecuilhuitl / Xocotl
#     Huetzi). *_name(i) yields the serde identifier; *_display(i) the Display
#     string. A later serial.cyr wave needs the serde identifier.
#   - The Rust source has no tracing sites, so none are ported.

# ---------------------------------------------------------------------------
# Constants (Rust private consts + public AZTEC_CALENDAR_ROUND_DAYS)
# ---------------------------------------------------------------------------
# Enum members are integer constants (no global-init cost, no forward-ref risk).
enum AztecConst {
    AZTEC_CORRELATION_JDN = 2275856;
    CORRELATION_TONAL_NUMBER = 1;
    CORRELATION_TONAL_SIGN = 4;
    CORRELATION_XIUH_DOY = 180;
    AZTEC_CALENDAR_ROUND_DAYS = 18980;
}

# ---------------------------------------------------------------------------
# TonalpohualliSign — the 20 day signs (discriminant order = cyclic index)
# ---------------------------------------------------------------------------
enum TonalpohualliSign {
    TS_CIPACTLI; TS_EHECATL; TS_CALLI; TS_CUETZPALIN; TS_COATL;
    TS_MIQUIZTLI; TS_MAZATL; TS_TOCHTLI; TS_ATL; TS_ITZCUINTLI;
    TS_OZOMATLI; TS_MALINALLI; TS_ACATL; TS_OCELOTL; TS_CUAUHTLI;
    TS_COZCACUAUHTLI; TS_OLLIN; TS_TECPATL; TS_QUIAHUITL; TS_XOCHITL;
}

# Lazy-singleton name table. For signs the serde identifier == the Display
# string (no spaces), so *_name and *_display share one table.
var tonal_sign_vec = 0;
var tonal_sign_init = 0;

fn build_tonal_signs() {
    var v = vec_new();
    vec_push(v, str_from("Cipactli"));
    vec_push(v, str_from("Ehecatl"));
    vec_push(v, str_from("Calli"));
    vec_push(v, str_from("Cuetzpalin"));
    vec_push(v, str_from("Coatl"));
    vec_push(v, str_from("Miquiztli"));
    vec_push(v, str_from("Mazatl"));
    vec_push(v, str_from("Tochtli"));
    vec_push(v, str_from("Atl"));
    vec_push(v, str_from("Itzcuintli"));
    vec_push(v, str_from("Ozomatli"));
    vec_push(v, str_from("Malinalli"));
    vec_push(v, str_from("Acatl"));
    vec_push(v, str_from("Ocelotl"));
    vec_push(v, str_from("Cuauhtli"));
    vec_push(v, str_from("Cozcacuauhtli"));
    vec_push(v, str_from("Ollin"));
    vec_push(v, str_from("Tecpatl"));
    vec_push(v, str_from("Quiahuitl"));
    vec_push(v, str_from("Xochitl"));
    return v;
}

#must_use
fn all_tonal_signs() {
    if (tonal_sign_init == 0) {
        tonal_sign_vec = build_tonal_signs();
        tonal_sign_init = 1;
    }
    return tonal_sign_vec;
}

# serde identifier (no spaces) for sign index i in [0,20).
#must_use
fn tonalpohualli_sign_name(i) { return vec_get(all_tonal_signs(), i); }

# Display string for sign index i (identical to the serde identifier here).
#must_use
fn tonalpohualli_sign_display(i) { return vec_get(all_tonal_signs(), i); }

# Display impl for TonalpohualliSign (the value is the enum discriminant).
#must_use
fn tonalpohualli_sign_to_str(sign) { return tonalpohualli_sign_display(sign); }

# ---------------------------------------------------------------------------
# Tonalpohualli — { number: 1..13, sign: TonalpohualliSign }
# ---------------------------------------------------------------------------
enum TonOff { TON_NUMBER = 0; TON_SIGN = 8; TON_SIZE = 16; }

#must_use
fn tonalpohualli_new(number, sign) {
    var p = alloc(TON_SIZE);
    store64(p + TON_NUMBER, number);
    store64(p + TON_SIGN, sign);
    return p;
}

#must_use
fn ton_number(p) { return load64(p + TON_NUMBER); }

#must_use
fn ton_sign(p) { return load64(p + TON_SIGN); }

# Display: "{number} {sign}".
#must_use
fn tonalpohualli_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_int(sb, ton_number(p));
    str_builder_add_cstr(sb, " ");
    str_builder_add(sb, tonalpohualli_sign_display(ton_sign(p)));
    return str_builder_build(sb);
}

# ---------------------------------------------------------------------------
# XiuhpohuallMonth — 18 named months + Nemontemi (discriminant order = index)
# ---------------------------------------------------------------------------
enum XiuhpohuallMonth {
    XM_ATLCAHUALO; XM_TLACAXIPEHUALIZTLI; XM_TOZOZTONTLI; XM_HUEYTOZOZTLI;
    XM_TOXCATL; XM_ETZALCUALIZTLI; XM_TECUILHUITONTLI; XM_HUEYTECUILHUITL;
