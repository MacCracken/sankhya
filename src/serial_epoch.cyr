# --- SexagenaryYear { stem, branch, cycle_position } ---
#must_use
fn ep_sex_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_str(sb, "stem", heavenly_stem_debug(sex_stem(p)));
    sk_json_sep(sb);
    sk_json_str(sb, "branch", earthly_branch_debug(sex_branch(p)));
    sk_json_sep(sb);
    sk_json_int(sb, "cycle_position", sex_cycle_position(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
#must_use
fn ep_sex_from_json(v) {
    var stem = ep_stem_from_name(bayan_json_v_str(bayan_json_v_obj_get(v, "stem")));
    var branch = ep_branch_from_name(bayan_json_v_str(bayan_json_v_obj_get(v, "branch")));
    var pos = bayan_json_v_int(bayan_json_v_obj_get(v, "cycle_position"));
    return sexagenary_year_new(stem, branch, pos);
}
#must_use
fn ep_sex_eq(a, b) {
    if (sex_stem(a) != sex_stem(b)) { return 0; }
    if (sex_branch(a) != sex_branch(b)) { return 0; }
    if (sex_cycle_position(a) != sex_cycle_position(b)) { return 0; }
    return 1;
}

