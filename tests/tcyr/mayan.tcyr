# mayan.tcyr — ports the Rust #[cfg(test)] mod tests from src/mayan.rs plus
# Display-string and error-message parity checks. Serde round-trip tests are
# skipped (JSON is a later module). Run:
#   cyrius build tests/tcyr/mayan.tcyr build/_v_mayan && ./build/_v_mayan
include "src/error.cyr"
include "src/util.cyr"
include "src/f64_util.cyr"
include "src/logging.cyr"
include "src/mayan.cyr"

# Assert that v is non-zero (truthy), labelled name in the failure report.
fn ok(v, name) { return assert_neq(v, 0, name); }

# Build a vec of digits from up to 5 most-significant-first values (unused
# trailing slots pass a sentinel of -1 to stop).
fn digits5(a, b, c, d, e) {
    var v = vec_new();
    if (a >= 0) { vec_push(v, a); }
    if (b >= 0) { vec_push(v, b); }
    if (c >= 0) { vec_push(v, c); }
    if (d >= 0) { vec_push(v, d); }
    if (e >= 0) { vec_push(v, e); }
    return v;
}

# Round-trip one value through to_vigesimal -> from_vigesimal, assert equal.
fn vig_roundtrip(n, name) {
    var digits = to_vigesimal(n);
    var r_t, r_v = from_vigesimal(digits);
    var okr = is_ok(r_t);
    if (okr == 0) { return assert_eq(0, 1, name); }
    return assert_eq(result_unwrap(r_t, r_v), n, name);
}

# Run every mayan test case and print the assert_summary; returns its exit code.
fn main() {
    alloc_init();
    println("=== sankhya mayan test suite ===");

    var tol = f64_parse("0.000001");

    # ---- vigesimal_zero ----
    var v0 = to_vigesimal(0);
    assert_eq(vec_len(v0), 1, "to_vigesimal(0) len 1");
    assert_eq(vec_get(v0, 0), 0, "to_vigesimal(0) = [0]");
    var d0 = digits5(0, (0 - 1), (0 - 1), (0 - 1), (0 - 1));
    var rz_t, rz_v = from_vigesimal(d0);
    ok(is_ok(rz_t), "from_vigesimal([0]) ok");
    assert_eq(result_unwrap(rz_t, rz_v), 0, "from_vigesimal([0]) = 0");

    # ---- vigesimal_roundtrip ----
    vig_roundtrip(1, "vig roundtrip 1");
    vig_roundtrip(19, "vig roundtrip 19");
    vig_roundtrip(20, "vig roundtrip 20");
    vig_roundtrip(399, "vig roundtrip 399");
    vig_roundtrip(400, "vig roundtrip 400");
    vig_roundtrip(8000, "vig roundtrip 8000");
    vig_roundtrip(160000, "vig roundtrip 160000");
    vig_roundtrip(1000000, "vig roundtrip 1000000");

    # ---- from_vigesimal error path (digit >= 20) ----
    var dbad = digits5(20, (0 - 1), (0 - 1), (0 - 1), (0 - 1));
    var rbad_t, rbad_v = from_vigesimal(dbad);
    ok(is_err_result(rbad_t), "from_vigesimal([20]) err");
    assert_eq(sk_result_code(rbad_t, rbad_v), SKE_INVALID_BASE, "from_vigesimal([20]) InvalidBase");
    ok(str_eq_cstr(sk_err_msg(err_code_of(rbad_t, rbad_v)), "vigesimal digit 20 out of range 0..20"),
        "from_vigesimal msg parity");

    # ---- mayan_numeral_values ----
    var rzero_t, rzero_v = mayan_numeral_from_value(0);
    ok(is_ok(rzero_t), "numeral 0 ok");
    var zero = result_unwrap(rzero_t, rzero_v);
    assert_eq(mayan_numeral_shell(zero), 1, "numeral 0 shell");
    assert_eq(mayan_numeral_value(zero), 0, "numeral 0 value");
    var r13_t, r13_v = mayan_numeral_from_value(13);
    var thirteen = result_unwrap(r13_t, r13_v);
    assert_eq(mayan_numeral_dots(thirteen), 3, "numeral 13 dots");
    assert_eq(mayan_numeral_bars(thirteen), 2, "numeral 13 bars");
    assert_eq(mayan_numeral_value(thirteen), 13, "numeral 13 value");
    # numeral out-of-range error
    var rbign_t, rbign_v = mayan_numeral_from_value(20);
    ok(is_err_result(rbign_t), "numeral 20 err");
    assert_eq(sk_result_code(rbign_t, rbign_v), SKE_INVALID_BASE, "numeral 20 InvalidBase");
    ok(str_eq_cstr(sk_err_msg(err_code_of(rbign_t, rbign_v)), "Mayan numeral value 20 out of range 0..19"),
        "numeral msg parity");

    # ---- long_count_creation_date ----
    var rc0_t, rc0_v = long_count_from_days(0);
    ok(is_ok(rc0_t), "from_days(0) ok");
    var lc0 = result_unwrap(rc0_t, rc0_v);
    assert_eq(long_count_to_days(lc0), 0, "from_days(0) to_days=0");
    assert_eq(lc_baktun(lc0), 0, "from_days(0) baktun=0");

    # ---- long_count_dec_21_2012 ----
    var days2012 = 13 * 144000;
    var rc12_t, rc12_v = long_count_from_days(days2012);
    var lc12 = result_unwrap(rc12_t, rc12_v);
    assert_eq(lc_baktun(lc12), 13, "2012 baktun=13");
    assert_eq(lc_katun(lc12), 0, "2012 katun=0");
    assert_eq(lc_tun(lc12), 0, "2012 tun=0");
    assert_eq(lc_uinal(lc12), 0, "2012 uinal=0");
    assert_eq(lc_kin(lc12), 0, "2012 kin=0");
    assert_eq(long_count_to_days(lc12), days2012, "2012 to_days round-trip");
    # Display parity
    ok(str_eq_cstr(longcount_to_str(lc12), "13.0.0.0.0"), "longcount display 13.0.0.0.0");

    # ---- long_count_new validation + JDN correlation ----
    var rnew_bad_t, rnew_bad_v = long_count_new(0, 20, 0, 0, 0);
    ok(is_err_result(rnew_bad_t), "new katun=20 err");
    assert_eq(sk_result_code(rnew_bad_t, rnew_bad_v), SKE_INVALID_DATE, "new katun=20 InvalidDate");
    ok(str_eq_cstr(sk_err_msg(err_code_of(rnew_bad_t, rnew_bad_v)), "katun 20 out of range 0..20"),
        "new katun msg parity");
    var rnew_ok_t, rnew_ok_v = long_count_new(13, 0, 0, 0, 0);
    ok(is_ok(rnew_ok_t), "new valid ok");
    var rjd_t, rjd_v = long_count_from_julian_day(EPOCH_JDN);
    ok(is_ok(rjd_t), "from_julian_day(EPOCH_JDN) ok");
    var lcjd = result_unwrap(rjd_t, rjd_v);
    assert_eq(long_count_to_days(lcjd), 0, "from_julian_day(EPOCH_JDN) = day 0");
    assert_eq(long_count_to_julian_day(lcjd), EPOCH_JDN, "to_julian_day = EPOCH_JDN");
    var pre = EPOCH_JDN - 1;
    var rjd_bad_t, rjd_bad_v = long_count_from_julian_day(pre);
    ok(is_err_result(rjd_bad_t), "from_julian_day(pre-epoch) err");
    assert_eq(sk_result_code(rjd_bad_t, rjd_bad_v), SKE_INVALID_DATE, "from_julian_day pre-epoch InvalidDate");

    # ---- tzolkin_at_creation ----
    var tz0 = tzolkin_from_days(0);
    assert_eq(tz_number(tz0), 4, "tzolkin day0 number=4");
    assert_eq(tz_daysign(tz0), DS_AHAU, "tzolkin day0 sign=Ahau");
    ok(str_eq_cstr(tzolkin_to_str(tz0), "4 Ahau"), "tzolkin display 4 Ahau");

    # ---- haab_at_creation ----
    var hb0 = haab_from_days(0);
    assert_eq(hb_day(hb0), 8, "haab day0 day=8");
    assert_eq(hb_month(hb0), HM_KUMKU, "haab day0 month=Kumku");
    ok(str_eq_cstr(haab_to_str(hb0), "8 Kumku"), "haab display 8 Kumku");

    # ---- calendar_round pair ----
    var cr = calendar_round(0);
    assert_eq(tz_number(cr_tzolkin(cr)), 4, "calendar_round tz number=4");
    assert_eq(hb_day(cr_haab(cr)), 8, "calendar_round hb day=8");

    # ---- venus_cycle_length ----
    assert_eq(236 + 90 + 250 + 8, 584, "venus cycle 584");
    # venus_phase classification across the cycle
    assert_eq(venus_phase(0), VP_MORNING_STAR, "venus 0 MorningStar");
    assert_eq(venus_phase(240), VP_SUPERIOR_CONJUNCTION, "venus 240 SuperiorConjunction");
    assert_eq(venus_phase(400), VP_EVENING_STAR, "venus 400 EveningStar");
    assert_eq(venus_phase(580), VP_INFERIOR_CONJUNCTION, "venus 580 InferiorConjunction");
    ok(f64_approx_eq(venus_synodic_period(), f64_parse("583.92"), tol), "VENUS_SYNODIC_PERIOD=583.92");

    # ---- find_calendar_round_at_creation ----
    var fcr0_t, fcr0_v = find_calendar_round(4, DS_AHAU, 8, HM_KUMKU, 0);
    ok(is_ok(fcr0_t), "find_calendar_round at creation ok");
    assert_eq(result_unwrap(fcr0_t, fcr0_v), 0, "find_calendar_round at creation = 0");

    # ---- find_calendar_round_next_cycle ----
    var fcr1_t, fcr1_v = find_calendar_round(4, DS_AHAU, 8, HM_KUMKU, 1);
    ok(is_ok(fcr1_t), "find_calendar_round next cycle ok");
    assert_eq(result_unwrap(fcr1_t, fcr1_v), CALENDAR_ROUND_DAYS, "find_calendar_round next = 18980");

    # ---- find_calendar_round_invalid_tzolkin ----
    var fcr_lo_t, fcr_lo_v = find_calendar_round(0, DS_AHAU, 0, HM_POP, 0);
    ok(is_err_result(fcr_lo_t), "find_calendar_round(0) err");
    assert_eq(sk_result_code(fcr_lo_t, fcr_lo_v), SKE_INVALID_DATE, "find_calendar_round(0) InvalidDate");
    ok(str_eq_cstr(sk_err_msg(err_code_of(fcr_lo_t, fcr_lo_v)), "Tzolkin number 0 out of range 1..13"),
        "fcr(0) msg parity");
    var fcr_hi_t, fcr_hi_v = find_calendar_round(14, DS_AHAU, 0, HM_POP, 0);
    ok(is_err_result(fcr_hi_t), "find_calendar_round(14) err");
    assert_eq(sk_result_code(fcr_hi_t, fcr_hi_v), SKE_INVALID_DATE, "find_calendar_round(14) InvalidDate");

    # ---- find_tzolkin_at_creation ----
    var ft0_t, ft0_v = find_tzolkin(4, DS_AHAU, 0);
    ok(is_ok(ft0_t), "find_tzolkin at creation ok");
    assert_eq(result_unwrap(ft0_t, ft0_v), 0, "find_tzolkin at creation = 0");

    # ---- find_tzolkin_next_occurrence ----
    var ft1_t, ft1_v = find_tzolkin(4, DS_AHAU, 1);
    ok(is_ok(ft1_t), "find_tzolkin next ok");
    assert_eq(result_unwrap(ft1_t, ft1_v), 260, "find_tzolkin next = 260");

    # ---- name-table spot checks ----
    ok(str_eq_cstr(daysign_name(DS_IMIX), "Imix"), "daysign_name Imix");
    ok(str_eq_cstr(daysign_name(DS_AHAU), "Ahau"), "daysign_name Ahau");
    ok(str_eq_cstr(haabmonth_name(HM_POP), "Pop"), "haabmonth_name Pop");
    ok(str_eq_cstr(haabmonth_name(HM_WAYEB), "Wayeb"), "haabmonth_name Wayeb");
    ok(str_eq_cstr(venusphase_name(VP_MORNING_STAR), "MorningStar"), "venusphase_name MorningStar");

    # ---- logging init does not crash ----
    sankhya_log_init();
    ok(1, "log init ok");

    # ---- 3.1.3 repairs ----
    # ADR-007: inputs Rust's u64/u32/u8 types ruled out are Err.
    var lcn_t, lcn_v = long_count_from_days(0 - 1);
    assert_eq(sk_result_code(lcn_t, lcn_v), SKE_INVALID_DATE, "long_count_from_days(-1) -> InvalidDate");
    var lce_t, lce_v = long_count_new(0 - 1, 0, 0, 0, 0);
    assert_eq(sk_result_code(lce_t, lce_v), SKE_INVALID_DATE, "long_count_new(-1, ...) -> InvalidDate");
    var mn_t, mn_v = mayan_numeral_from_value(0 - 3);
    assert_eq(sk_result_code(mn_t, mn_v), SKE_INVALID_BASE, "mayan_numeral_from_value(-3) -> InvalidBase");
    var vgd = vec_new();
    vec_push(vgd, 1);
    vec_push(vgd, 0 - 1);
    var vg_t, vg_v = from_vigesimal(vgd);
    assert_eq(sk_result_code(vg_t, vg_v), SKE_INVALID_BASE, "from_vigesimal([1,-1]) -> InvalidBase");
    # Pre-epoch day counts give in-range Tzolkin / Haab values (rem_euclid), so the name
    # lookups no longer abort.
    var tzn = tzolkin_from_days(0 - 30);
    ok(tz_number(tzn) >= 1 && tz_number(tzn) <= 13, "tzolkin_from_days(-30) number in 1..13");
    ok(str_len(tzolkin_to_str(tzn)) > 0, "tzolkin_to_str(tzolkin_from_days(-30)) does not abort");
    var hbn = haab_from_days(0 - 30);
    ok(hb_day(hbn) >= 0 && hb_month(hbn) >= 0, "haab_from_days(-30) in range");
    # The 260-day-stepping Calendar Round search returns the brute-force scan's first match.
    var cr_bad = 0;
    var ci = 0;
    while (ci < 40) {
        var sday = ci * 4111 + 7;
        var target = sday + rem_euclid(ci * 977 + 13, 18980);
        var ttz = tzolkin_from_days(target);
        var thb = haab_from_days(target);
        var brute = 0 - 1;
        var off = 0;
        while (off < 18980 && brute < 0) {
            var dd = sday + off;
            var a = tzolkin_from_days(dd);
            var h = haab_from_days(dd);
            if (tz_number(a) == tz_number(ttz) && tz_daysign(a) == tz_daysign(ttz)) {
                if (hb_day(h) == hb_day(thb) && hb_month(h) == hb_month(thb)) { brute = dd; }
            }
            off = off + 1;
        }
        var fc_t, fc_v = find_calendar_round(tz_number(ttz), tz_daysign(ttz), hb_day(thb), hb_month(thb), sday);
        if (is_ok(fc_t) == 0) { cr_bad = cr_bad + 1; }
        if (is_ok(fc_t) == 1) { if (result_unwrap(fc_t, fc_v) != brute) { cr_bad = cr_bad + 1; } }
        ci = ci + 1;
    }
    assert_eq(cr_bad, 0, "find_calendar_round == brute-force scan (40 cases)");
    # No matching Haab day in the cycle (day 19 of Wayeb does not exist) is still an Err.
    var fe_t, fe_v = find_calendar_round(4, DS_AHAU, 3, HM_WAYEB, 1);
    ok(is_ok(fe_t) == 1 || sk_result_code(fe_t, fe_v) != SKE_OK, "find_calendar_round(Wayeb 3) returns");

    return assert_summary();
}

var rc = main();
syscall(SYS_EXIT, rc);
