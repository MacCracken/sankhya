fn precessionalage_from_json(v) { return sk_de_variant(v, precessionalage_names()); }
# Equality of two PrecessionalAge discriminants; 1/0.
#must_use
fn precessionalage_eq(a, b) { if (a == b) { return 1; } return 0; }

