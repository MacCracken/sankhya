#must_use
fn haabmonth_from_json(v) {
    return sk_de_variant(v, all_haabmonth_names());
}
# Equality of two HaabMonth codes: 1 or 0.
#must_use
fn haabmonth_eq(a, b) {
    if (a != b) { return 0; }
    return 1;
}

