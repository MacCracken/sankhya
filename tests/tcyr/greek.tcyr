# greek.tcyr — integration suite for the greek module port.
# Ports every non-serde Rust #[cfg(test)] test from rust-old/src/greek.rs.
include "src/error.cyr"
include "src/util.cyr"
include "src/f64_util.cyr"
include "src/logging.cyr"
include "src/greek.cyr"

fn ok(v, name) { return assert_neq(v, 0, name); }

var TOL_1E15 = 0;
var TOL_1E10 = 0;
var TOL_1E6 = 0;

fn tols_init() {
    TOL_1E15 = f64_parse("0.000000000000001");
    TOL_1E10 = f64_parse("0.0000000001");
    TOL_1E6 = f64_parse("0.000001");
    return 0;
}

fn main() {
    alloc_init();
    tols_init();

    # ---- golden ratio value ----
    var expected = f64_div(f64_add(f64_from(1), f64_sqrt(f64_from(5))), f64_from(2));
    var gr = f64_approx_eq(greek_phi(), expected, TOL_1E15);
    ok(gr, "golden ratio PHI within 1e-15");

    # ---- fibonacci ratio converges to phi ----
    var fr = fibonacci_ratio(30);
    var frc = f64_approx_eq(fr, greek_phi(), TOL_1E10);
    ok(frc, "fibonacci_ratio(30) -> PHI within 1e-10");
    var fr0 = fibonacci_ratio(0);
    var fr0c = f64_eq(fr0, f64_from(1));
    ok(fr0c, "fibonacci_ratio(0) == 1.0");

    # ---- sieve ----
    var primes = sieve(30);
    assert_eq(vec_len(primes), 10, "sieve(30) count 10");
    assert_eq(vec_get(primes, 0), 2, "prime[0]=2");
    assert_eq(vec_get(primes, 1), 3, "prime[1]=3");
    assert_eq(vec_get(primes, 2), 5, "prime[2]=5");
    assert_eq(vec_get(primes, 3), 7, "prime[3]=7");
    assert_eq(vec_get(primes, 4), 11, "prime[4]=11");
    assert_eq(vec_get(primes, 5), 13, "prime[5]=13");
    assert_eq(vec_get(primes, 6), 17, "prime[6]=17");
    assert_eq(vec_get(primes, 7), 19, "prime[7]=19");
    assert_eq(vec_get(primes, 8), 23, "prime[8]=23");
    assert_eq(vec_get(primes, 9), 29, "prime[9]=29");
    assert_eq(vec_len(sieve(0)), 0, "sieve(0) empty");
    assert_eq(vec_len(sieve(1)), 0, "sieve(1) empty");

    # ---- gcd / lcm ----
    assert_eq(greek_gcd(48, 18), 6, "gcd(48,18)=6");
    assert_eq(greek_gcd(0, 5), 5, "gcd(0,5)=5");
    assert_eq(greek_gcd(7, 0), 7, "gcd(7,0)=7");
    assert_eq(greek_gcd(13, 13), 13, "gcd(13,13)=13");
    assert_eq(greek_lcm(4, 6), 12, "lcm(4,6)=12");
    assert_eq(greek_lcm(0, 5), 0, "lcm(0,5)=0");

    # ---- archimedes pi bounds ----
    var lower, upper = archimedes_pi(10);
    var c1 = f64_lt(lower, F64_PI);
    ok(c1, "lower < pi");
    var c2 = f64_gt(upper, F64_PI);
    ok(c2, "upper > pi");
    var c3 = f64_approx_eq(lower, F64_PI, TOL_1E6);
    ok(c3, "lower within 1e-6 of pi");
    var c4 = f64_approx_eq(upper, F64_PI, TOL_1E6);
    ok(c4, "upper within 1e-6 of pi");

    # ---- antikythera ----
    var ratios = antikythera_gear_ratios();
    var metonic = antikythera_lookup(ratios, "Metonic");
    ok(metonic, "Metonic found");
    assert_eq(anti_gear_teeth(metonic), 235, "Metonic gear_teeth 235");
    var per = str_eq_cstr(anti_period_years(metonic), "19");
    ok(per, "Metonic period_years 19");

    # ---- isopsephy (varna) ----
    var ia_t, ia_v = isopsephy("α");
    var iaok = is_ok(ia_t);
    ok(iaok, "isopsephy(α) ok");
    assert_eq(result_unwrap(ia_t, ia_v), 1, "α = 1");
    var iw_t, iw_v = isopsephy("ω");
    assert_eq(result_unwrap(iw_t, iw_v), 800, "ω = 800");
    var ipi_t, ipi_v = isopsephy("πι");
    assert_eq(result_unwrap(ipi_t, ipi_v), 90, "πι = 90");
    var iaw_t, iaw_v = isopsephy("αω");
    assert_eq(result_unwrap(iaw_t, iaw_v), 801, "αω = 801");
    var iem_t, iem_v = isopsephy("");
    var iemerr = is_err_result(iem_t);
    ok(iemerr, "isopsephy(empty) errors");
    var ihe_t, ihe_v = isopsephy("hello");
    var iheerr = is_err_result(ihe_t);
    ok(iheerr, "isopsephy(hello) errors");

    # ---- to_greek_numeral (varna) ----
    var g1_t, g1_v = to_greek_numeral(1);
    var g1s = str_eq_cstr(result_unwrap(g1_t, g1_v), "α");
    ok(g1s, "1 -> α");
    var g10_t, g10_v = to_greek_numeral(10);
    var g10s = str_eq_cstr(result_unwrap(g10_t, g10_v), "ι");
    ok(g10s, "10 -> ι");
    var g100_t, g100_v = to_greek_numeral(100);
    var g100s = str_eq_cstr(result_unwrap(g100_t, g100_v), "ρ");
    ok(g100s, "100 -> ρ");
    var g358_t, g358_v = to_greek_numeral(358);
    var g358s = str_eq_cstr(result_unwrap(g358_t, g358_v), "τνη");
    ok(g358s, "358 -> τνη");

    # roundtrip: encode 358 then isopsephy back to 358
    var _g_t, _g_v = to_greek_numeral(358);
    var num = result_unwrap(_g_t, _g_v);
    var back_t, back_v = isopsephy(str_data(num));
    assert_eq(result_unwrap(back_t, back_v), 358, "roundtrip 358");

    var g0_t, g0_v = to_greek_numeral(0);
    var g0err = is_err_result(g0_t);
    ok(g0err, "to_greek_numeral(0) errors");

    # ---- logging init does not crash ----
    sankhya_log_init();
    ok(1, "log init ok");

    return assert_summary();
}

var rc = main();
syscall(SYS_EXIT, rc);
