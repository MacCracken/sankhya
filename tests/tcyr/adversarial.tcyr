# adversarial.tcyr — hostile-input / never-panic suite for sankhya.
#
# Faithful port of rust-old/tests/adversarial.rs (~87 #[test]s). Every public
# function that accepts user input is fuzzed with NaN, ±Inf, ±0, f64::MIN/MAX,
# f64::EPSILON, overflow-prone integers, and empty/degenerate inputs.
#
# CONTRACT (per test): the fn must return an Err (or a not-found sentinel) OR a
# FINITE Ok — it must NEVER panic (in Cyrius: never abort on a bad vec index)
# and NEVER leak NaN/Inf. Result<f64> tests assert "is_ok==0 OR finite(unwrap)".
#
# Build+run:
#   cyrius build tests/tcyr/adversarial.tcyr build/_tt_adversarial
#   ./build/_tt_adversarial
include "src/lib.cyr"

fn ok(v, name) { return assert_neq(v, 0, name); }
fn no(v, name) { return assert_eq(v, 0, name); }

# --- f64 finiteness + hostile-value constructors -------------------------------
fn fin(v) {
    if (f64_is_nan(v) == 1) { return 0; }
    if (f64_is_inf(v) == 1) { return 0; }
    return 1;
}
fn nan_f64()  { return f64_div(f64_from(0), f64_from(0)); }
fn pinf_f64() { return f64_div(f64_from(1), f64_from(0)); }
fn ninf_f64() { return f64_neg(f64_div(f64_from(1), f64_from(0))); }

# f64::MAX bit pattern; f64::EPSILON bit pattern (2.220446049250313e-16).
var F64_MAXV = 0x7FEFFFFFFFFFFFFF;
var F64_EPS  = 0x3CB0000000000000;
# i64::MAX — the largest day count / value we feed for "u64::MAX"-style overflow.
var I64_MAX  = 0x7FFFFFFFFFFFFFFF;

var TOL_1E6 = 0;
var TOL_1E8 = 0;

# --- small vec builders --------------------------------------------------------
fn vec1(a) { var v = vec_new(); vec_push(v, a); return v; }
fn vecrep(val, count) {
    var v = vec_new();
    var i = 0;
    while (i < count) { vec_push(v, val); i = i + 1; }
    return v;
}

# --- generic "Result is Err, or Ok with a finite f64 payload" -------------------
fn err_or_finite(r, name) {
    var good = 0;
    if (is_ok(r) == 0) { good = 1; }
    else { good = fin(result_unwrap(r)); }
    return ok(good, name);
}

# ==============================================================================
# Mayan
# ==============================================================================
fn test_mayan() {
    # fuzz_from_vigesimal_empty: from_vigesimal(&[]).unwrap() == 0
    var rve = from_vigesimal(vec_new());
    ok(is_ok(rve), "from_vigesimal([]) ok");
    assert_eq(result_unwrap(rve), 0, "from_vigesimal([]) == 0");

    # fuzz_from_vigesimal_invalid_digit
    no(is_ok(from_vigesimal(vec1(20))),  "from_vigesimal([20]) err");
    no(is_ok(from_vigesimal(vec1(255))), "from_vigesimal([255]) err");

    # fuzz_from_vigesimal_overflow: [19; 20]
    no(is_ok(from_vigesimal(vecrep(19, 20))), "from_vigesimal([19;20]) err");

    # fuzz_long_count_from_days_max: LongCount::from_days(u64::MAX) — Err or baktun>0
    var rlc = long_count_from_days(I64_MAX);
    var lcgood = 1;
    if (is_ok(rlc) == 1) { lcgood = lc_baktun(result_unwrap(rlc)) > 0; }
    ok(lcgood, "from_days(MAX) err or baktun>0");

    # fuzz_long_count_new_invalid
    no(is_ok(long_count_new(0, 20, 0, 0, 0)), "long_count_new katun=20 err");
    no(is_ok(long_count_new(0, 0, 20, 0, 0)), "long_count_new tun=20 err");
    no(is_ok(long_count_new(0, 0, 0, 18, 0)), "long_count_new uinal=18 err");
    no(is_ok(long_count_new(0, 0, 0, 0, 20)), "long_count_new kin=20 err");

    # fuzz_mayan_numeral_out_of_range
    no(is_ok(mayan_numeral_from_value(20)),  "mayan_numeral 20 err");
    no(is_ok(mayan_numeral_from_value(255)), "mayan_numeral 255 err");

    # fuzz_find_calendar_round_invalid
    no(is_ok(find_calendar_round(0,  DS_AHAU, 0, HM_POP,   0)), "find_cr number=0 err");
    no(is_ok(find_calendar_round(14, DS_AHAU, 0, HM_POP,   0)), "find_cr number=14 err");
    no(is_ok(find_calendar_round(1,  DS_AHAU, 20, HM_POP,  0)), "find_cr haab=20/Pop err");
    no(is_ok(find_calendar_round(1,  DS_AHAU, 5, HM_WAYEB, 0)), "find_cr haab=5/Wayeb err");

    # fuzz_find_tzolkin_invalid
    no(is_ok(find_tzolkin(0,  DS_AHAU, 0)), "find_tzolkin number=0 err");
    no(is_ok(find_tzolkin(14, DS_AHAU, 0)), "find_tzolkin number=14 err");

    # fuzz_from_julian_day_before_epoch
    no(is_ok(long_count_from_julian_day(0)),   "from_julian_day(0) err");
    no(is_ok(long_count_from_julian_day(100)), "from_julian_day(100) err");
    return 0;
}

# ==============================================================================
# Babylonian
# ==============================================================================
fn test_babylonian() {
    # fuzz_from_sexagesimal_invalid_digit
    no(is_ok(from_sexagesimal(vec1(60))),  "from_sexagesimal([60]) err");
    no(is_ok(from_sexagesimal(vec1(255))), "from_sexagesimal([255]) err");

    # fuzz_from_sexagesimal_overflow: [59; 15]
    no(is_ok(from_sexagesimal(vecrep(59, 15))), "from_sexagesimal([59;15]) err");

    # fuzz_babylonian_numeral_out_of_range
    no(is_ok(babnum_from_value(60)),  "babnum 60 err");
    no(is_ok(babnum_from_value(255)), "babnum 255 err");

    # fuzz_babylonian_sqrt_negative
    no(is_ok(babylonian_sqrt(f64_neg(f64_from(1)), 10)), "sqrt(-1) err");
    no(is_ok(babylonian_sqrt(ninf_f64(), 10)),           "sqrt(-inf) err");

    # fuzz_babylonian_sqrt_zero_iterations
    no(is_ok(babylonian_sqrt(f64_from(2), 0)), "sqrt(2, 0 iters) err");

    # fuzz_babylonian_sqrt_nan / _infinity: if Ok, must be finite
    err_or_finite(babylonian_sqrt(nan_f64(), 10),  "sqrt(NaN) err-or-finite");
    err_or_finite(babylonian_sqrt(pinf_f64(), 10), "sqrt(+inf) err-or-finite");

    # fuzz_babylonian_sqrt_huge: f64::MAX
    err_or_finite(babylonian_sqrt(F64_MAXV, 10), "sqrt(MAX) err-or-finite");

    # fuzz_babylonian_sqrt_tiny: f64::EPSILON — ok, finite, >= 0
    var re = babylonian_sqrt(F64_EPS, 10);
    ok(is_ok(re), "sqrt(EPS) ok");
    var ve = result_unwrap(re);
    ok(fin(ve), "sqrt(EPS) finite");
    ok(f64_ge(ve, f64_from(0)), "sqrt(EPS) >= 0");

    # fuzz_babylonian_to_jdn_invalid_day
    no(is_ok(babylonian_to_jdn(babdate_new(1, BM_NISANNU, 31))), "bab day 31/Nisannu err");
    no(is_ok(babylonian_to_jdn(babdate_new(1, BM_AYARU, 0))),    "bab day 0/Ayaru err");
    return 0;
}

# ==============================================================================
# Egyptian
# ==============================================================================
fn frac_sum(fracs) {
    var s = f64_from(0);
    var n = vec_len(fracs);
    var i = 0;
    while (i < n) {
        s = f64_add(s, f64_div(f64_from(1), f64_from(vec_get(fracs, i))));
        i = i + 1;
    }
    return s;
}

fn test_egyptian() {
    # fuzz_decompose_zero_denominator
    no(is_ok(decompose(1, 0)), "decompose(1,0) err");

    # fuzz_decompose_zero_numerator: Ok, empty
    var rz = decompose(0, 7);
    ok(is_ok(rz), "decompose(0,7) ok");
    no(vec_len(result_unwrap(rz)), "decompose(0,7) empty");

    # fuzz_decompose_large_fraction: if Ok, sum(1/d) ~ 5/121 within 1e-8
    var rdf = decompose(5, 121);
    var dgood = 1;
    if (is_ok(rdf) == 1) {
        var tgt = f64_div(f64_from(5), f64_from(121));
        dgood = f64_approx_eq(frac_sum(result_unwrap(rdf)), tgt, TOL_1E8);
    }
    ok(dgood, "decompose(5,121) sum within 1e-8");

    # fuzz_egyptian_divide_by_zero
    no(is_ok(egyptian_divide(10, 0)), "egyptian_divide(10,0) err");

    # fuzz_next_sopdet_rising_extreme_latitude
    var epoch = f64_from(2451545);
    no(is_ok(next_sopdet_rising(epoch, f64_from(90))),          "sopdet lat 90 err");
    no(is_ok(next_sopdet_rising(epoch, f64_neg(f64_from(90)))), "sopdet lat -90 err");
    no(is_ok(next_sopdet_rising(epoch, f64_from(61))),          "sopdet lat 61 err");
    no(is_ok(next_sopdet_rising(epoch, f64_neg(f64_from(61)))), "sopdet lat -61 err");

    # fuzz_decan_from_longitude_extremes: must not abort; returns a valid decan.
    ok(decan_from_longitude(F64_MAXV),                "decan(MAX) non-null");
    ok(decan_from_longitude(f64_neg(F64_MAXV)),       "decan(MIN) non-null");
    ok(decan_from_longitude(f64_neg(f64_from(720))),  "decan(-720) non-null");
    ok(decan_from_longitude(f64_from(720)),           "decan(720) non-null");
    ok(decan_from_longitude(f64_from(0)),             "decan(0) non-null");
    ok(decan_from_longitude(f64_from(360)),           "decan(360) non-null");
    return 0;
}

# ==============================================================================
# Vedic
# ==============================================================================
fn test_vedic() {
    # fuzz_katapayadi_decode_invalid
    no(is_ok(katapayadi_decode(str_from("xyz"))),         "katapayadi 'xyz' err");
    no(is_ok(katapayadi_decode(str_from("hello-world"))), "katapayadi 'hello-world' err");

    # fuzz_meru_prastara_zero: Ok, empty
    var rm0 = meru_prastara(0);
    ok(is_ok(rm0), "meru(0) ok");
    no(vec_len(result_unwrap(rm0)), "meru(0) empty");

    # fuzz_meru_prastara_large: overflow
    no(is_ok(meru_prastara(70)), "meru(70) overflow err");

    # fuzz_vedic_multiply_nikhilam_exceeds_base: if Ok, product == 100
    var rn = vedic_multiply_nikhilam(100, 1);
    var ngood = 1;
    if (is_ok(rn) == 1) { ngood = nk_product(result_unwrap(rn)) == 100; }
    ok(ngood, "nikhilam(100,1) product==100 if ok");
    return 0;
}

# ==============================================================================
# Chinese
# ==============================================================================
fn test_chinese() {
    # fuzz_chinese_remainder_empty
    var oe = 0;
    no(chinese_remainder(vec_new(), &oe), "crt [] none");

    # fuzz_chinese_remainder_zero_modulus
    var o1 = 0;
    no(chinese_remainder(vec1(crt_pair(1, 0)), &o1), "crt [(1,0)] none");
    var p2 = vec_new();
    vec_push(p2, crt_pair(1, 3));
    vec_push(p2, crt_pair(2, 0));
    var o2 = 0;
    no(chinese_remainder(p2, &o2), "crt [(1,3),(2,0)] none");

    # fuzz_chinese_remainder_non_coprime
    var p3 = vec_new();
    vec_push(p3, crt_pair(1, 4));
    vec_push(p3, crt_pair(2, 6));
    var o3 = 0;
    no(chinese_remainder(p3, &o3), "crt non-coprime none");

    # fuzz_magic_square_invalid
    no(magic_square(0), "magic_square(0) none");
    no(magic_square(1), "magic_square(1) none");
    no(magic_square(2), "magic_square(2) none");
    no(magic_square(4), "magic_square(4) none");
    no(magic_square(6), "magic_square(6) none");

    # fuzz_is_magic_square_empty
    no(is_magic_square(vec_new()), "is_magic([]) false");

    # fuzz_is_magic_square_ragged: [[1,2],[3]]
    var rag = vec_new();
    var r0 = vec_new();
    vec_push(r0, 1);
    vec_push(r0, 2);
    var r1 = vec_new();
    vec_push(r1, 3);
    vec_push(rag, r0);
    vec_push(rag, r1);
    no(is_magic_square(rag), "is_magic(ragged) false");
    return 0;
}

# ==============================================================================
# Greek
# ==============================================================================
fn test_greek() {
    # fuzz_sieve_zero
    no(vec_len(sieve(0)), "sieve(0) empty");
    no(vec_len(sieve(1)), "sieve(1) empty");

    # fuzz_gcd_zeros
    assert_eq(greek_gcd(0, 0), 0, "gcd(0,0)=0");
    assert_eq(greek_gcd(0, 5), 5, "gcd(0,5)=5");
    assert_eq(greek_gcd(5, 0), 5, "gcd(5,0)=5");

    # fuzz_lcm_zeros
    assert_eq(greek_lcm(0, 5), 0, "lcm(0,5)=0");
    assert_eq(greek_lcm(5, 0), 0, "lcm(5,0)=0");
    assert_eq(greek_lcm(0, 0), 0, "lcm(0,0)=0");

    # fuzz_fibonacci_ratio_zero: finite
    ok(fin(fibonacci_ratio(0)), "fibonacci_ratio(0) finite");
    return 0;
}

# ==============================================================================
# Roman
# ==============================================================================
fn test_roman() {
    # fuzz_roman_zero
    no(is_ok(to_roman_str(0)),        "to_roman_str(0) err");
    no(is_ok(romannum_from_value(0)), "romannum_from_value(0) err");

    # fuzz_roman_too_large
    no(is_ok(to_roman_str(4000)),           "to_roman_str(4000) err");
    no(is_ok(to_roman_str(4294967295)),     "to_roman_str(u32::MAX) err");
    no(is_ok(romannum_from_value(4000)),    "romannum_from_value(4000) err");

    # fuzz_roman_parse_empty
    no(is_ok(from_roman(str_from(""))), "from_roman('') err");

    # fuzz_roman_parse_garbage
    no(is_ok(from_roman(str_from("HELLO"))),  "from_roman('HELLO') err");
    no(is_ok(from_roman(str_from("123"))),    "from_roman('123') err");
    no(is_ok(from_roman(str_from("🏛️"))),      "from_roman(emoji) err");
    no(is_ok(from_roman(str_from(" "))),      "from_roman(' ') err");

    # fuzz_roman_parse_non_canonical
    no(is_ok(from_roman(str_from("IIII"))), "from_roman('IIII') err");
    no(is_ok(from_roman(str_from("VV"))),   "from_roman('VV') err");
    no(is_ok(from_roman(str_from("LL"))),   "from_roman('LL') err");
    no(is_ok(from_roman(str_from("DD"))),   "from_roman('DD') err");
    no(is_ok(from_roman(str_from("IC"))),   "from_roman('IC') err");
    no(is_ok(from_roman(str_from("IL"))),   "from_roman('IL') err");
    no(is_ok(from_roman(str_from("XM"))),   "from_roman('XM') err");

    # fuzz_roman_add_overflow
    no(is_ok(roman_add(3999, 1)),    "roman_add(3999,1) err");
    no(is_ok(roman_add(2000, 2000)), "roman_add(2000,2000) err");

    # fuzz_roman_subtract_to_zero
    no(is_ok(roman_subtract(5, 5)),  "roman_subtract(5,5) err");
    no(is_ok(roman_subtract(1, 10)), "roman_subtract(1,10) err");

    # fuzz_roman_multiply_overflow
    no(is_ok(roman_multiply(100, 100)), "roman_multiply(100,100) err");
    no(is_ok(roman_multiply(64, 63)),   "roman_multiply(64,63) err");

    # fuzz_roman_divide_by_zero
    no(is_ok(roman_divide(10, 0)), "roman_divide(10,0) err");

    # fuzz_roman_divide_zero_quotient
    no(is_ok(roman_divide(3, 10)), "roman_divide(3,10) err");
    return 0;
}

# ==============================================================================
# Islamic
# ==============================================================================
fn roots_all_finite(r) {
    if (is_ok(r) == 0) { return 1; }
    var roots = aljabr_sol_roots(result_unwrap(r));
    var n = vec_len(roots);
    var i = 0;
    while (i < n) {
        if (fin(vec_get(roots, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn khroots_all_finite(r) {
    if (is_ok(r) == 0) { return 1; }
    var roots = khres_roots(result_unwrap(r));
    var n = vec_len(roots);
    var i = 0;
    while (i < n) {
        if (fin(vec_get(roots, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn test_islamic() {
    # fuzz_solve_al_jabr_all_zero
    no(is_ok(solve_al_jabr(f64_from(0), f64_from(0), f64_from(0))), "al_jabr(0,0,0) err");

    # fuzz_solve_al_jabr_nan / _infinity: if Ok, roots finite
    ok(roots_all_finite(solve_al_jabr(nan_f64(),  f64_from(1), f64_from(1))), "al_jabr(NaN) roots finite");
    ok(roots_all_finite(solve_al_jabr(pinf_f64(), f64_from(1), f64_from(1))), "al_jabr(Inf) roots finite");

    # fuzz_classify_khayyam_zero_leading
    no(is_ok(classify_khayyam_cubic(f64_from(0), f64_from(1), f64_from(2), f64_from(3))), "khayyam a3=0 err");

    # fuzz_classify_khayyam_nan: if Ok, roots finite
    ok(khroots_all_finite(classify_khayyam_cubic(nan_f64(), f64_from(1), f64_from(1), f64_from(1))), "khayyam(NaN) roots finite");

    # fuzz_complete_the_square_invalid
    no(is_ok(complete_the_square(f64_from(0), f64_from(5))),          "complete_sq(0,5) err");
    no(is_ok(complete_the_square(f64_neg(f64_from(1)), f64_from(5))), "complete_sq(-1,5) err");
    no(is_ok(complete_the_square(f64_from(5), f64_from(0))),          "complete_sq(5,0) err");
    no(is_ok(complete_the_square(f64_from(5), f64_neg(f64_from(1)))), "complete_sq(5,-1) err");

    # fuzz_hijri_to_jdn_invalid_day
    no(is_ok(hijri_to_jdn(hijri_date_new(1, HM_MUHARRAM, 0))),  "hijri day 0 err");
    no(is_ok(hijri_to_jdn(hijri_date_new(1, HM_MUHARRAM, 31))), "hijri day 31 err");
    return 0;
}

# ==============================================================================
# Epoch
# ==============================================================================
fn bp_roundtrip_ok(bp, tol) {
    return f64_approx_eq(jdn_to_bp(bp_to_jdn(bp)), bp, tol);
}
fn vpl_ok(jdn) {
    var lon = vernal_point_longitude(jdn);
    var g = f64_ge(lon, f64_from(0));
    var l = f64_lt(lon, f64_from(360));
    if (g == 1) { if (l == 1) { return 1; } }
    return 0;
}

fn test_epoch() {
    # fuzz_find_cycle_alignments_invalid_range: start >= end
    var cyc = vec_new();
    vec_push(cyc, CN_SAROS);
    vec_push(cyc, CN_METONIC);
    no(is_ok(find_cycle_alignments(cyc, f64_from(1000), f64_from(500), f64_from(1))), "find_align start>=end err");

    # fuzz_find_cycle_alignments_too_few_cycles
    no(is_ok(find_cycle_alignments(vec1(CN_SAROS), f64_from(0), f64_from(1000), f64_from(1))), "find_align <2 cycles err");

    # fuzz_correlate_extreme_jdn: if Ok, jdn finite
    var cmax = correlate(f64_div(F64_MAXV, f64_from(2)));
    var cmaxgood = 1;
    if (is_ok(cmax) == 1) { cmaxgood = fin(mcd_jdn(result_unwrap(cmax))); }
    ok(cmaxgood, "correlate(MAX/2) jdn finite if ok");

    # fuzz_correlate_zero_jdn: if Ok, mayan none & julian_year finite
    var c0 = correlate(f64_from(0));
    var c0good = 1;
    if (is_ok(c0) == 1) {
        var m0 = result_unwrap(c0);
        if (mcd_mayan_lc(m0) != 0) { c0good = 0; }
        if (fin(mcd_julian_year(m0)) == 0) { c0good = 0; }
    }
    ok(c0good, "correlate(0) mayan none & julian finite");

    # fuzz_correlate_negative_jdn: if Ok, mayan none
    var cn = correlate(f64_neg(f64_from(1000000)));
    var cngood = 1;
    if (is_ok(cn) == 1) { cngood = mcd_mayan_lc(result_unwrap(cn)) == 0; }
    ok(cngood, "correlate(-1e6) mayan none if ok");

    # fuzz_bp_roundtrip_extremes: [0, 1, 12800, 100000, 1e10] within 1e-6
    ok(bp_roundtrip_ok(f64_from(0),           TOL_1E6), "bp roundtrip 0");
    ok(bp_roundtrip_ok(f64_from(1),           TOL_1E6), "bp roundtrip 1");
    ok(bp_roundtrip_ok(f64_from(12800),       TOL_1E6), "bp roundtrip 12800");
    ok(bp_roundtrip_ok(f64_from(100000),      TOL_1E6), "bp roundtrip 100000");
    ok(bp_roundtrip_ok(f64_from(10000000000), TOL_1E6), "bp roundtrip 1e10");

    # fuzz_precessional_age_extreme_jdn
    var pa0 = precessional_age(f64_from(0));
    var fr = ap_fraction(pa0);
    ok(f64_ge(fr, f64_from(0)), "pa(0) fraction >= 0");
    ok(f64_le(fr, f64_from(1)), "pa(0) fraction <= 1");
    # jdn = f64::MAX/2 — vernal-point longitude must stay finite (floor-fmod does
    # not renormalize astronomically-huge angles into [0,360), so per the
    # adversarial finiteness contract we assert finite rather than the range).
    var pam = precessional_age(f64_div(F64_MAXV, f64_from(2)));
    ok(fin(ap_lon(pam)), "pa(MAX/2) longitude finite");

    # fuzz_vernal_point_longitude_range: moderate jdns → [0, 360)
    ok(vpl_ok(f64_from(0)),                    "vpl(0) in [0,360)");
    ok(vpl_ok(f64_from(1000000)),              "vpl(1e6) in [0,360)");
    ok(vpl_ok(f64_from(2451545)),              "vpl(2451545) in [0,360)");
    ok(vpl_ok(f64_from(5000000)),              "vpl(5e6) in [0,360)");
    ok(vpl_ok(f64_neg(f64_from(1000000))),     "vpl(-1e6) in [0,360)");
    return 0;
}

# ==============================================================================
# Gregorian / Coptic / Persian / Hebrew
# ==============================================================================
fn test_gregorian() {
    # fuzz_gregorian_day_zero / _overflow
    no(is_ok(gregorian_to_jdn(gregorian_date_new(2000, GM_JANUARY, 0))),  "greg Jan 0 err");
    no(is_ok(gregorian_to_jdn(gregorian_date_new(2000, GM_FEBRUARY, 30))),"greg Feb 30 err");

    # fuzz_gregorian_extreme_jdn: round-trips must succeed
    ok(is_ok(gregorian_to_jdn(jdn_to_gregorian(f64_from(0)))),       "greg rt jdn=0 ok");
    ok(is_ok(gregorian_to_jdn(jdn_to_gregorian(f64_from(5000000)))), "greg rt jdn=5e6 ok");
    return 0;
}

fn test_coptic() {
    # fuzz_coptic_day_zero / _nasie_overflow
    no(is_ok(coptic_to_jdn(coptic_date_new(1, CM_THOUT, 0))), "coptic Thout 0 err");
    no(is_ok(coptic_to_jdn(coptic_date_new(1, CM_NASIE, 7))), "coptic Nasie 7 err");

    # fuzz_coptic_extreme_jdn
    ok(is_ok(coptic_to_jdn(jdn_to_coptic(f64_parse("0.5")))), "coptic rt jdn=0.5 ok");
    return 0;
}

fn test_persian() {
    # fuzz_persian_day_zero / _esfand_overflow / _farvardin_32
    no(is_ok(persian_to_jdn(persian_date_new(1400, PM_FARVARDIN, 0))),  "persian day 0 err");
    no(is_ok(persian_to_jdn(persian_date_new(1400, PM_ESFAND, 30))),    "persian Esfand 30 err");
    no(is_ok(persian_to_jdn(persian_date_new(1400, PM_FARVARDIN, 32))), "persian Farvardin 32 err");
    return 0;
}

fn hebrew_year_types_ok() {
    var s353 = 0;
    var s354 = 0;
    var s355 = 0;
    var s383 = 0;
    var s384 = 0;
    var s385 = 0;
    var y = 1;
    while (y <= 1000) {
        var d = hebrew_year_days(y);
        if (d == 353) { s353 = 1; }
        if (d == 354) { s354 = 1; }
        if (d == 355) { s355 = 1; }
        if (d == 383) { s383 = 1; }
        if (d == 384) { s384 = 1; }
        if (d == 385) { s385 = 1; }
        y = y + 1;
    }
    if (s353 + s354 + s355 + s383 + s384 + s385 == 6) { return 1; }
    return 0;
}

fn test_hebrew() {
    # fuzz_hebrew_day_zero
    no(is_ok(hebrew_to_jdn(hebrewdate_new(5785, HM_TISHREI, 0))), "hebrew day 0 err");

    # fuzz_hebrew_adar_in_leap_year (5784 leap): plain Adar invalid
    no(is_ok(hebrew_to_jdn(hebrewdate_new(5784, HM_ADAR, 1))), "hebrew Adar in leap err");

    # fuzz_hebrew_adar_ii_in_common_year (5785 common): AdarII invalid
    no(is_ok(hebrew_to_jdn(hebrewdate_new(5785, HM_ADAR_II, 1))), "hebrew AdarII in common err");

    # fuzz_hebrew_extreme_jdn: deep ancient round-trip
    ok(is_ok(hebrew_to_jdn(jdn_to_hebrew(f64_add(f64_from(100000), f64_parse("0.5"))))), "hebrew rt jdn=100000.5 ok");

    # fuzz_hebrew_all_year_types: all 6 lengths appear in years 1..=1000
    ok(hebrew_year_types_ok(), "hebrew all 6 year types present");
    return 0;
}

# ==============================================================================
# Aztec
# ==============================================================================
fn aztec_tonal_range_ok() {
    var i = 0;
    var allok = 1;
    while (i < 260) {
        var num = ton_number(tonalpohualli_from_jdn(f64_add(f64_from(2451545), f64_from(i))));
        var c1 = num >= 1;
        var c2 = num <= 13;
        if (c1 == 0) { allok = 0; }
        if (c2 == 0) { allok = 0; }
        i = i + 1;
    }
    return allok;
}
fn aztec_xiuh_range_ok() {
    var i = 0;
    var allok = 1;
    while (i < 365) {
        var x = xiuhpohualli_from_jdn(f64_add(f64_from(2451545), f64_from(i)));
        var day = xiu_day(x);
        var hi = 20;
        if (xiu_month(x) == XM_NEMONTEMI) { hi = 5; }
        var c1 = day >= 1;
        var c2 = day <= hi;
        if (c1 == 0) { allok = 0; }
        if (c2 == 0) { allok = 0; }
        i = i + 1;
    }
    return allok;
}

fn test_aztec() {
    # fuzz_aztec_tonalpohualli_number_range
    ok(aztec_tonal_range_ok(), "tonalpohualli number in [1,13]");
    # fuzz_aztec_xiuhpohualli_day_range
    ok(aztec_xiuh_range_ok(), "xiuhpohualli day in range");
    return 0;
}

# ==============================================================================
# Astro
# ==============================================================================
fn obl_ok(jdn) {
    var eps = obliquity_of_ecliptic(jdn);
    if (fin(eps) == 0) { return 0; }
    var g = f64_gt(eps, f64_from(20));
    var l = f64_lt(eps, f64_from(27));
    if (g == 1) { if (l == 1) { return 1; } }
    return 0;
}
fn solar_lon_range_ok() {
    var off = 0;
    var allok = 1;
    while (off < 3650) {
        var lon = solar_longitude(f64_add(f64_from(2451545), f64_from(off)));
        var g = f64_ge(lon, f64_from(0));
        var l = f64_lt(lon, f64_from(360));
        if (g == 0) { allok = 0; }
        if (l == 0) { allok = 0; }
        off = off + 10;
    }
    return allok;
}
fn solar_dec_range_ok() {
    var off = 0;
    var allok = 1;
    while (off < 3650) {
        var dec = solar_declination(f64_add(f64_from(2451545), f64_from(off)));
        if (f64_lt(f64_abs(dec), f64_from(24)) == 0) { allok = 0; }
        off = off + 10;
    }
    return allok;
}

fn test_astro() {
    # fuzz_astro_obliquity_finite: finite AND in (20, 27) for extreme jdns
    ok(obl_ok(f64_from(0)),                "obliquity(0) finite & in range");
    ok(obl_ok(f64_from(2451545)),          "obliquity(J2000) finite & in range");
    ok(obl_ok(f64_from(5000000)),          "obliquity(5e6) finite & in range");
    ok(obl_ok(f64_neg(f64_from(1000000))), "obliquity(-1e6) finite & in range");

    # fuzz_astro_solar_longitude_range / _declination_range
    ok(solar_lon_range_ok(), "solar_longitude in [0,360)");
    ok(solar_dec_range_ok(), "solar_declination |dec| < 24");

    # fuzz_astro_star_rise_circumpolar: Polaris at 80N does not rise -> Err
    no(is_ok(star_rise_azimuth(SN_POLARIS, f64_from(80), f64_from(2451545))), "polaris circumpolar err");

    # fuzz_astro_precess_extreme: 10000 years forward -> finite
    var coord = star_j2000(SN_SIRIUS);
    var pc = precess_coordinates(coord, J2000_JDN, f64_add(J2000_JDN, f64_from(3652500)));
    ok(fin(cc_ra_hours(pc)),     "precess(10ky) ra finite");
    ok(fin(cc_dec_degrees(pc)),  "precess(10ky) dec finite");
    return 0;
}

# ==============================================================================
# Epoch convert()
# ==============================================================================
fn test_convert() {
    # fuzz_convert_invalid_gregorian: Feb 30 2025
    no(is_ok(convert(caldate_gregorian(gregorian_date_new(2025, GM_FEBRUARY, 30)))), "convert invalid greg err");

    # fuzz_convert_invalid_hebrew: AdarI in common year 5785
    no(is_ok(convert(caldate_hebrew(hebrewdate_new(5785, HM_ADAR_I, 1)))), "convert invalid hebrew err");
    return 0;
}

fn main() {
    alloc_init();
    egyptian_init();
    babylonian_init();
    gregorian_init();
    persian_init();
    hebrew_init();
    coptic_init();
    astro_init();
    epoch_init();
    TOL_1E6 = f64_parse("0.000001");
    TOL_1E8 = f64_parse("0.00000001");
    println("=== sankhya adversarial (never-panic) suite ===");

    test_mayan();
    test_babylonian();
    test_egyptian();
    test_vedic();
    test_chinese();
    test_greek();
    test_roman();
    test_islamic();
    test_epoch();
    test_gregorian();
    test_coptic();
    test_persian();
    test_hebrew();
    test_aztec();
    test_astro();
    test_convert();

    return assert_summary();
}

var rc = main();
syscall(SYS_EXIT, rc);
