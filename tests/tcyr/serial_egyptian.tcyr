# serial_egyptian.tcyr — round-trip serde parity tests for the egyptian module.
# The Rust egyptian module derives Serialize/Deserialize on Decan but ships no
# explicit serde round-trip test, so this suite provides the round-trip coverage:
# build a Decan, emit JSON, assert it matches serde_json's format (Rust field
# names, bare int number, quoted string name, f64 with decimal point), then parse
# it back and assert field-by-field equality.
include "src/error.cyr"
include "src/util.cyr"
include "src/f64_util.cyr"
include "src/logging.cyr"
include "src/serial_util.cyr"
include "src/egyptian.cyr"
include "src/serial_egyptian.cyr"

# Assert that v is non-zero (truthy), labelled name in the failure report.
fn ok(v, name) { return assert_neq(v, 0, name); }

# Decode js (a C-string) as a Decan; returns decan_from_json's Result pair (k is unused:
# egyptian has one decoder).
fn de_run(k, js) {
    var n = sk_json_parse(str_from(js));
    return decan_from_json(n);
}

# The C-string a followed by the C-string b, for expected messages too long for one line.
fn cat2(a, b) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_cstr(str_builder_build(sb));
}

# Decode js with decoder k and check it fails with SKE_DESERIALIZE and exactly the message
# want (a C-string); a mismatch prints the message it got.
fn de_err(k, js, want, label) {
    var t, v = de_run(k, js);
    assert_eq(sk_result_code(t, v), SKE_DESERIALIZE, label);
    if (is_ok(t) == 0) {
        var same = str_eq_cstr(sk_err_msg(v), want);
        if (same == 0) { str_println(sk_err_msg(v)); }
        ok(same, label);
    }
    return 0;
}

# Run every serial_egyptian test case and print the assert_summary; returns its exit code.
fn main() {
    alloc_init();

    # --- Decan #1 (Kenmet, longitude 0.0) constructed directly ---
    var k = decan_new(1, str_from("Kenmet"), f64_from(0));
    var kjs = decan_to_json(k);

    # serde_json format: compact, no spaces, Rust field names.
    var h1 = str_contains_cstr(kjs, "\"number\":1");
    ok(h1, "number is bare integer 1");
    var h2 = str_contains_cstr(kjs, "\"name\":\"Kenmet\"");
    ok(h2, "name is quoted string Kenmet");
    # f64 field MUST carry the decimal point (serde/ryu emits 0.0, not 0).
    var h3 = str_contains_cstr(kjs, "\"ecliptic_longitude\":0.0");
    ok(h3, "ecliptic_longitude is f64 number 0.0 (with decimal)");

    var kp_t, kp_v = decan_from_json(sk_json_parse(kjs));
    ok(is_ok(kp_t), "Decan decodes (Kenmet)");
    ok(decan_eq(k, result_unwrap(kp_t, kp_v)), "Decan serde round-trip (Kenmet)");

    # --- Decan #20 (Sopdet, longitude 190.0) from the module's real catalog ---
    var s = sopdet();
    var sjs = decan_to_json(s);
    var hs1 = str_contains_cstr(sjs, "\"number\":20");
    ok(hs1, "Sopdet number is bare integer 20");
    var hs2 = str_contains_cstr(sjs, "\"name\":\"Sopdet\"");
    ok(hs2, "Sopdet name is quoted string Sopdet");
    var hs3 = str_contains_cstr(sjs, "\"ecliptic_longitude\":190.0");
    ok(hs3, "Sopdet ecliptic_longitude is f64 number 190.0 (with decimal)");

    var sp_t, sp_v = decan_from_json(sk_json_parse(sjs));
    ok(decan_eq(s, result_unwrap(sp_t, sp_v)), "Decan serde round-trip (Sopdet, from catalog)");

    # --- Decan with a multi-word name (Khentet Hrt, longitude 10.0) ---
    var m = decan_new(2, str_from("Khentet Hrt"), f64_from(10));
    var mjs = decan_to_json(m);
    var hm1 = str_contains_cstr(mjs, "\"name\":\"Khentet Hrt\"");
    ok(hm1, "multi-word name preserved");
    var hm2 = str_contains_cstr(mjs, "\"ecliptic_longitude\":10.0");
    ok(hm2, "longitude 10.0 emitted with decimal");
    var mp_t, mp_v = decan_from_json(sk_json_parse(mjs));
    ok(decan_eq(m, result_unwrap(mp_t, mp_v)), "Decan serde round-trip (Khentet Hrt)");

    # ---- 3.2.0: decode errors are serde's (Err, SKE_DESERIALIZE) ----
    de_err(0, "{\"number\":1,\"name\":\"Kenmet\"}", "missing field `ecliptic_longitude`", "missing longitude");
    de_err(0, "{\"number\":1,\"ecliptic_longitude\":0.0}", "missing field `name`", "missing name");
    # name is a Rust &'static str: serde's &str visitor expects "a borrowed string".
    de_err(0, "{\"number\":1,\"name\":5,\"ecliptic_longitude\":0.0}",
        "invalid type: integer `5`, expected a borrowed string", "integer name");
    de_err(0, "{\"number\":1,\"name\":\"Kenmet\",\"ecliptic_longitude\":\"x\"}",
        "invalid type: string \"x\", expected f64", "string longitude");
    de_err(0, "{\"number\":1,\"name\":\"Kenmet\",\"ecliptic_longitude\":null}",
        "invalid type: null, expected f64", "null longitude");
    de_err(0, "{\"number\":256,\"name\":\"Kenmet\",\"ecliptic_longitude\":0.0}",
        "invalid value: integer `256`, expected u8", "number 256");
    de_err(0, "[1,\"Kenmet\",0.0]", "invalid type: sequence, expected struct Decan", "array for Decan");
    # An integer longitude converts to f64 (serde accepts it); unknown keys are ignored and
    # the number is not range-checked (37 decodes).
    var ex_t, ex_v = de_run(0, "{\"number\":37,\"name\":\"X\",\"ecliptic_longitude\":190,\"star\":1}");
    ok(is_ok(ex_t), "integer longitude, unknown key, number 37 decode");
    if (is_ok(ex_t) == 1) {
        ok(f64_eq(decan_longitude(ex_v), f64_from(190)), "integer longitude 190 -> 190.0");
        assert_eq(decan_number(ex_v), 37, "number 37 kept as decoded");
    }

    return assert_summary();
}

var rc = main();
syscall(SYS_EXIT, rc);
