# serial_mayan.cyr — JSON (de)serialization for the mayan module, matching
# Rust serde_json EXACTLY (compact, no spaces; field order = Rust declaration
# order; enum variants as their identifier strings).
#
# Serde types covered (7):
#   MayanNumeral { dots, bars, shell }   struct — shell is a bool
#   LongCount    { baktun, katun, tun, uinal, kin }  struct
#   Tzolkin      { number, day_sign }    struct — day_sign is a DaySign enum
#   Haab         { day, month }          struct — month is a HaabMonth enum
#   DaySign      enum (20 variants)      → variant-name JSON string
#   HaabMonth    enum (19 variants)      → variant-name JSON string
#   VenusPhase   enum (4 variants)       → variant-name JSON string
#
# Emit uses the sk_json_* helpers from serial_util.cyr (str_builder based); enum
# fields serialize via <Enum>_name(value). No f64 fields exist in any mayan serde
# type, so every numeric field is an int.
#
# Decoding (3.2.0): every <type>_from_json takes a bayan value node and returns a
# Result as serde_json::from_str did: Ok(value) or Err(SKE_DESERIALIZE) with serde's
# message, via the sk_de_* helpers (serial_util.cyr). Fields are checked against
# their Rust types (u8 / u32 / bool / enum variant names); unknown keys are ignored
# and no calendar validation happens (a katun of 25 decodes; long_count_new rejects it).

# ---------------------------------------------------------------------------
# Enum <-> variant-name mapping (module supplies <Enum>_name; add from_name).
# The *_from_name lookups stay public; the decoders use sk_de_variant instead.
# ---------------------------------------------------------------------------

# DaySign: map a variant-name Str back to its discriminant; -1 if unmatched.
#must_use
fn daysign_from_name(name) {
    var i = 0;
    while (i < 20) {
        if (str_eq(daysign_name(i), name) == 1) {
            return i;
        }
        i = i + 1;
    }
    return (0 - 1);
}

# HaabMonth: variant-name Str -> discriminant; -1 if unmatched.
#must_use
fn haabmonth_from_name(name) {
    var j = 0;
    while (j < 19) {
        if (str_eq(haabmonth_name(j), name) == 1) {
            return j;
        }
        j = j + 1;
    }
    return (0 - 1);
}

# VenusPhase: variant-name Str -> discriminant; -1 if unmatched.
#must_use
fn venusphase_from_name(name) {
    var k = 0;
    while (k < 4) {
        if (str_eq(venusphase_name(k), name) == 1) {
            return k;
        }
        k = k + 1;
    }
    return (0 - 1);
}

# ---------------------------------------------------------------------------
# MayanNumeral { dots, bars, shell } — shell is a JSON bool.
# ---------------------------------------------------------------------------
# Serialize a MayanNumeral to a JSON Str: {"dots":D,"bars":B,"shell":bool}.
#must_use
fn mayan_numeral_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "dots", mayan_numeral_dots(p));
    sk_json_sep(sb);
    sk_json_int(sb, "bars", mayan_numeral_bars(p));
    sk_json_sep(sb);
    sk_json_bool(sb, "shell", mayan_numeral_shell(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Deserialize a MayanNumeral from a bayan value node (an object), as serde:
# Ok(fresh, unvalidated MayanNumeral) or Err(SKE_DESERIALIZE). dots and bars are
# required u8 (0..255), shell a required JSON boolean.
#must_use
fn mayan_numeral_from_json(v) {
    var obj = sk_de_struct(v, "MayanNumeral")?;
    var dots = sk_de_int_field(obj, "dots", 0, SK_U8_MAX, "u8")?;
    var bars = sk_de_int_field(obj, "bars", 0, SK_U8_MAX, "u8")?;
    var shell = sk_de_bool_field(obj, "shell")?;
    return Ok(mayan_numeral_make(dots, bars, shell));
}
# Structural equality of two MayanNumerals (dots, bars, shell): 1 or 0.
#must_use
fn mayan_numeral_eq(a, b) {
    if (mayan_numeral_dots(a) != mayan_numeral_dots(b)) { return 0; }
    if (mayan_numeral_bars(a) != mayan_numeral_bars(b)) { return 0; }
    if (mayan_numeral_shell(a) != mayan_numeral_shell(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# LongCount { baktun, katun, tun, uinal, kin } — all integers.
# ---------------------------------------------------------------------------
# Serialize a LongCount to a JSON Str: {"baktun":..,"katun":..,"tun":..,
# "uinal":..,"kin":..}.
#must_use
fn longcount_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "baktun", lc_baktun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "katun", lc_katun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "tun", lc_tun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "uinal", lc_uinal(p));
    sk_json_sep(sb);
    sk_json_int(sb, "kin", lc_kin(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Deserialize a LongCount from a bayan value node (an object), as serde:
# Ok(fresh LongCount, no period range checks) or Err(SKE_DESERIALIZE). All five
# periods are required u32 (0..4294967295); a float or negative value is an Err.
#must_use
fn longcount_from_json(v) {
    var obj = sk_de_struct(v, "LongCount")?;
    var baktun = sk_de_int_field(obj, "baktun", 0, SK_U32_MAX, "u32")?;
    var katun = sk_de_int_field(obj, "katun", 0, SK_U32_MAX, "u32")?;
    var tun = sk_de_int_field(obj, "tun", 0, SK_U32_MAX, "u32")?;
    var uinal = sk_de_int_field(obj, "uinal", 0, SK_U32_MAX, "u32")?;
    var kin = sk_de_int_field(obj, "kin", 0, SK_U32_MAX, "u32")?;
    return Ok(longcount_make(baktun, katun, tun, uinal, kin));
}
# Structural equality of two LongCounts (all five periods): 1 or 0.
#must_use
fn longcount_eq(a, b) {
    if (lc_baktun(a) != lc_baktun(b)) { return 0; }
    if (lc_katun(a) != lc_katun(b)) { return 0; }
    if (lc_tun(a) != lc_tun(b)) { return 0; }
    if (lc_uinal(a) != lc_uinal(b)) { return 0; }
    if (lc_kin(a) != lc_kin(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# Tzolkin { number, day_sign } — day_sign is a DaySign enum (variant string).
# ---------------------------------------------------------------------------
# Serialize a Tzolkin to a JSON Str: {"number":N,"day_sign":"<DaySign>"}.
#must_use
fn tzolkin_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "number", tz_number(p));
    sk_json_sep(sb);
    sk_json_str(sb, "day_sign", daysign_name(tz_daysign(p)));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Deserialize a Tzolkin from a bayan value node (an object), as serde:
# Ok(fresh Tzolkin) or Err(SKE_DESERIALIZE). number is a required u8 and day_sign a
# required DaySign variant string.
#must_use
fn tzolkin_from_json(v) {
    var obj = sk_de_struct(v, "Tzolkin")?;
    var number = sk_de_int_field(obj, "number", 0, SK_U8_MAX, "u8")?;
    var sign = sk_de_variant_field(obj, "day_sign", all_daysign_names())?;
    return Ok(tzolkin_make(number, sign));
}
# Structural equality of two Tzolkins (number, day sign): 1 or 0.
#must_use
fn tzolkin_eq(a, b) {
    if (tz_number(a) != tz_number(b)) { return 0; }
    if (tz_daysign(a) != tz_daysign(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# Haab { day, month } — month is a HaabMonth enum (variant string).
# ---------------------------------------------------------------------------
# Serialize a Haab to a JSON Str: {"day":D,"month":"<HaabMonth>"}.
#must_use
fn haab_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "day", hb_day(p));
    sk_json_sep(sb);
    sk_json_str(sb, "month", haabmonth_name(hb_month(p)));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Deserialize a Haab from a bayan value node (an object), as serde: Ok(fresh Haab) or
# Err(SKE_DESERIALIZE). day is a required u8 and month a required HaabMonth variant
# string.
#must_use
fn haab_from_json(v) {
    var obj = sk_de_struct(v, "Haab")?;
    var day = sk_de_int_field(obj, "day", 0, SK_U8_MAX, "u8")?;
    var month = sk_de_variant_field(obj, "month", all_haabmonth_names())?;
    return Ok(haab_make(day, month));
}
# Structural equality of two Haabs (day, month): 1 or 0.
#must_use
fn haab_eq(a, b) {
    if (hb_day(a) != hb_day(b)) { return 0; }
    if (hb_month(a) != hb_month(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# DaySign enum — serde emits the bare variant-name JSON string, e.g. "Ahau".
# ---------------------------------------------------------------------------
# Serialize a DaySign code as a JSON string Str (its variant name, "Ahau").
#must_use
fn daysign_to_json(val) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, daysign_name(val));
    return str_builder_build(sb);
}
# Deserialize a DaySign from a bayan value node holding a JSON string, as serde:
# Ok(DS_* code), or Err(SKE_DESERIALIZE) "unknown variant" / "invalid type".
#must_use
fn daysign_from_json(v) {
    return sk_de_variant(v, all_daysign_names());
}
# Equality of two DaySign codes: 1 or 0.
#must_use
fn daysign_eq(a, b) {
    if (a != b) { return 0; }
    return 1;
}

