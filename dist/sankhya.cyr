# serde identifier (no spaces) for month index i in [0,19).
#must_use
fn xiuh_month_name(i) { return vec_get(all_xiuh_names(), i); }

# Display string (spaces where the Rust Display inserts them).
#must_use
fn xiuh_month_display(i) { return vec_get(all_xiuh_displays(), i); }

# Display impl for XiuhpohuallMonth (the value is the enum discriminant).
#must_use
fn xiuhpohuall_month_to_str(month) { return xiuh_month_display(month); }

# ---------------------------------------------------------------------------
# Xiuhpohualli — { day: 1..20 (or 1..5 Nemontemi), month: XiuhpohuallMonth }
# ---------------------------------------------------------------------------
enum XiuOff { XIU_DAY = 0; XIU_MONTH = 8; XIU_SIZE = 16; }

#must_use
fn xiuhpohualli_new(day, month) {
    var p = alloc(XIU_SIZE);
    store64(p + XIU_DAY, day);
    store64(p + XIU_MONTH, month);
    return p;
}

#must_use
fn xiu_day(p) { return load64(p + XIU_DAY); }

#must_use
fn xiu_month(p) { return load64(p + XIU_MONTH); }

# Display: "{day} {month}".
#must_use
fn xiuhpohualli_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_int(sb, xiu_day(p));
    str_builder_add_cstr(sb, " ");
    str_builder_add(sb, xiuh_month_display(xiu_month(p)));
    return str_builder_build(sb);
}

# ---------------------------------------------------------------------------
# Conversion functions
# ---------------------------------------------------------------------------
# Shared: days elapsed since the Caso correlation date.
# Rust: let jdn_int = (jdn + 0.5).floor() as i64; jdn_int - AZTEC_CORRELATION_JDN
#must_use
fn aztec_days_since_correlation(jdn) {
    var jdn_int = f64_to(f64_floor(f64_add(jdn, F64_HALF)));
    return jdn_int - AZTEC_CORRELATION_JDN;
}

# Tonalpohualli (260-day sacred cycle) for a Julian Day Number (f64).
#must_use
fn tonalpohualli_from_jdn(jdn) {
    var days = aztec_days_since_correlation(jdn);
    # number cycles 1..13: ((days + 1 - 1).rem_euclid(13)) + 1
    var number = rem_euclid(days + CORRELATION_TONAL_NUMBER - 1, 13) + 1;
    # sign cycles through 20: (days + 4).rem_euclid(20)
    var sign_idx = rem_euclid(days + CORRELATION_TONAL_SIGN, 20);
    return tonalpohualli_new(number, sign_idx);
}

# Xiuhpohualli (365-day solar cycle) for a Julian Day Number (f64).
#must_use
fn xiuhpohualli_from_jdn(jdn) {
    var days = aztec_days_since_correlation(jdn);
    # day-of-year: (days + 180).rem_euclid(365) -> always in [0, 365)
    var doy = rem_euclid(days + CORRELATION_XIUH_DOY, 365);
    # month_idx = (doy / 20).min(18); doy >= 0 so plain / matches Rust.
    var month_idx = doy / 20;
    if (month_idx > 18) { month_idx = 18; }
    var day = doy - month_idx * 20 + 1;
    return xiuhpohualli_new(day, month_idx);
}

# Aztec Calendar Round: (Tonalpohualli, Xiuhpohualli) for a JDN. Repeats every
# lcm(260, 365) = 18,980 days (~52 years).
#must_use
fn aztec_calendar_round(jdn) {
    return (tonalpohualli_from_jdn(jdn), xiuhpohualli_from_jdn(jdn));
}

# --- coptic.cyr ---

# coptic.cyr — Coptic (Alexandrian) calendar (ported from rust-old/src/coptic.rs).
#
# 13-month structure: months 1..12 have 30 days each, month 13 (Nasie /
# Pi Kogi Enavot) has 5 epagomenal days (6 in leap years). Era = Anno Martyrum;
# epoch = 1 Thout, Year 1 AM = August 29, 284 CE Julian = JDN 1825029.5.
# Leap rule: year mod 4 == 3 (Euclidean). Bidirectional JDN conversion per
# Dershowitz & Reingold, Calendrical Calculations (4th ed.), ch. 4.
#
# Self-contained: no include lines (distlib bundler resolves stdlib + foundation).

# ---------------------------------------------------------------------------
# Epoch constant: COPTIC_EPOCH_JDN = 1_825_029.5 (a non-integer f64).
# Held lazily so no external init ordering is required — first use parses it.
# ---------------------------------------------------------------------------
var _coptic_epoch = 0;
var _coptic_epoch_done = 0;

#must_use
fn coptic_epoch_jdn() {
    if (_coptic_epoch_done == 0) {
        _coptic_epoch = f64_parse("1825029.5");
        _coptic_epoch_done = 1;
    }
    return _coptic_epoch;
}

# ---------------------------------------------------------------------------
# CopticMonth enum — discriminant IS the 0-based month index.
# Months 1..12 (CM_THOUT..CM_MESORI) have 30 days; CM_NASIE (12) has 5 or 6.
# ---------------------------------------------------------------------------
enum CopticMonth {
    CM_THOUT;    CM_PAOPI;   CM_HATHOR;  CM_KOIAK;
    CM_TOBI;     CM_MESHIR;  CM_PAREMHAT; CM_PARMOUTI;
    CM_PASHONS;  CM_PAONI;   CM_EPIP;    CM_MESORI;
    CM_NASIE;
}

# COPTIC_MONTH_DAYS: [30 x12, 5] — common-year days per month (index 0..12).
var _coptic_month_days = 0;
var _coptic_month_days_done = 0;

fn _build_coptic_month_days() {
    var a = alloc(13 * 8);
    var i = 0;
    while (i < 12) {
        store64(a + i * 8, 30);
        i = i + 1;
    }
    store64(a + 12 * 8, 5);
    return a;
}

#must_use
fn coptic_month_days(idx) {
    if (_coptic_month_days_done == 0) {
        _coptic_month_days = _build_coptic_month_days();
        _coptic_month_days_done = 1;
    }
    return load64(_coptic_month_days + idx * 8);
}

# Month name table (serde identifier == Display string for every Coptic month,
# so a single accessor serves both). Lazy singleton vec of Str.
var _coptic_month_names = 0;
var _coptic_month_names_done = 0;

fn _build_coptic_month_names() {
    var v = vec_new();
    vec_push(v, str_from("Thout"));
    vec_push(v, str_from("Paopi"));
    vec_push(v, str_from("Hathor"));
    vec_push(v, str_from("Koiak"));
    vec_push(v, str_from("Tobi"));
    vec_push(v, str_from("Meshir"));
    vec_push(v, str_from("Paremhat"));
    vec_push(v, str_from("Parmouti"));
    vec_push(v, str_from("Pashons"));
    vec_push(v, str_from("Paoni"));
    vec_push(v, str_from("Epip"));
    vec_push(v, str_from("Mesori"));
    vec_push(v, str_from("Nasie"));
    return v;
}

#must_use
fn coptic_month_name(idx) {
    if (_coptic_month_names_done == 0) {
        _coptic_month_names = _build_coptic_month_names();
        _coptic_month_names_done = 1;
    }
    return vec_get(_coptic_month_names, idx);
}

# Display impl for CopticMonth: `write!(f, "{name}")`.
#must_use
fn coptic_month_to_str(m) {
    return coptic_month_name(m);
}

# ---------------------------------------------------------------------------
# CopticDate struct: { year: i64, month: CopticMonth, day: i64 }
# Offsets: year(0) month(8) day(16) = 24 bytes.
# ---------------------------------------------------------------------------
enum CopticDateOff { CD_YEAR = 0; CD_MONTH = 8; CD_DAY = 16; CD_SIZE = 24; }

#must_use
fn coptic_date_new(year, month, day) {
    var p = alloc(CD_SIZE);
    store64(p + CD_YEAR, year);
    store64(p + CD_MONTH, month);
    store64(p + CD_DAY, day);
    return p;
}

#must_use
fn coptic_date_year(p) { return load64(p + CD_YEAR); }
#must_use
fn coptic_date_month(p) { return load64(p + CD_MONTH); }
#must_use
fn coptic_date_day(p) { return load64(p + CD_DAY); }

# Display impl for CopticDate: `write!(f, "{} {} {} AM", day, month, year)`.
#must_use
fn coptic_date_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_int(sb, load64(p + CD_DAY));
    str_builder_add_cstr(sb, " ");
    str_builder_add(sb, coptic_month_name(load64(p + CD_MONTH)));
    str_builder_add_cstr(sb, " ");
    str_builder_add_int(sb, load64(p + CD_YEAR));
    str_builder_add_cstr(sb, " AM");
    return str_builder_build(sb);
}

# ---------------------------------------------------------------------------
# Leap year & year length
# ---------------------------------------------------------------------------

# Leap iff year.rem_euclid(4) == 3. rem_euclid load-bearing for negative years.
#must_use
fn coptic_is_leap(year) {
    if (rem_euclid(year, 4) == 3) { return 1; }
    return 0;
}

# Days in a Coptic year (365 common, 366 leap).
#must_use
fn coptic_year_days(year) {
    if (coptic_is_leap(year) == 1) { return 366; }
    return 365;
}

# ---------------------------------------------------------------------------
# JDN conversions
# ---------------------------------------------------------------------------

# Days from epoch to the start of a given 1-based year (the Rust `year_start`
# closure): 365*(year-1) + year.div_euclid(4).
#must_use
fn _coptic_year_start(year) {
    var y0 = year - 1;
    return 365 * y0 + div_euclid(year, 4);
}

# Convert a Julian Day Number (f64 bit pattern) to a CopticDate pointer.
#must_use
fn jdn_to_coptic(jdn) {
    # tracing::trace!(jdn, "JDN to Coptic")
    if (sakshi_get_level() >= SK_TRACE) {
        var jval = str_from_int(f64_to(jdn));
        sakshi_log_kv(SK_TRACE, "JDN to Coptic", 13, "jdn", 3, str_data(jval), str_len(jval));
    }

    var delta = f64_sub(jdn, coptic_epoch_jdn());
    var days_since_epoch = f64_to(f64_floor(delta));

    # Estimate year (366 divisor avoids overestimating), then correct.
    var year = div_euclid(days_since_epoch, 366) + 1;

    # Correct upward while next year's start is still <= our day count.
    var next_start = _coptic_year_start(year + 1);
    while (next_start <= days_since_epoch) {
        year = year + 1;
        next_start = _coptic_year_start(year + 1);
    }
    # Correct downward if we overshot.
    var this_start = _coptic_year_start(year);
    while (this_start > days_since_epoch) {
        year = year - 1;
        this_start = _coptic_year_start(year);
    }

    var day_of_year = days_since_epoch - this_start;

    # Month: each of the first 12 months has 30 days; clamp to 12 (Nasie).
    var month_idx = day_of_year / 30;
    if (month_idx > 12) { month_idx = 12; }
    var day = day_of_year - month_idx * 30 + 1;

    return coptic_date_new(year, month_idx, day);
}

# Convert a CopticDate pointer to a Julian Day Number.
# Returns Ok(jdn f64) or Err(SkErr{SKE_INVALID_DATE, msg}) on out-of-range day.
#must_use
fn coptic_to_jdn(date) {
    var year = coptic_date_year(date);
    var month_idx = coptic_date_month(date);
    var day = coptic_date_day(date);

    # tracing::trace!(year, ?month, day, "Coptic to JDN")
    if (sakshi_get_level() >= SK_TRACE) {
        var yval = str_from_int(year);
        sakshi_log_kv(SK_TRACE, "Coptic to JDN", 13, "year", 4, str_data(yval), str_len(yval));
    }

    # max_day = 6 only for Nasie (idx 12) in a leap year; else the table value.
    var max_day = coptic_month_days(month_idx);
    if (month_idx == 12) {
        if (coptic_is_leap(year) == 1) { max_day = 6; }
    }

    var too_big = day > max_day;
    if (day == 0) { too_big = 1; }
    if (too_big == 1) {
        # format!: "day {} out of range for {} in year {} AM (max {max_day})"
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "day ");
        str_builder_add_int(sb, day);
        str_builder_add_cstr(sb, " out of range for ");
        str_builder_add(sb, coptic_month_name(month_idx));
        str_builder_add_cstr(sb, " in year ");
        str_builder_add_int(sb, year);
        str_builder_add_cstr(sb, " AM (max ");
        str_builder_add_int(sb, max_day);
        str_builder_add_cstr(sb, ")");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sb));
    }

    var y = year - 1;
    var days = 365 * y + div_euclid(year, 4) + 30 * month_idx + day - 1;
    return Ok(f64_add(coptic_epoch_jdn(), f64_from(days)));
}

# Warm the lazy singletons (epoch, tables, names). Optional — every accessor
# self-initializes — but a test/consumer may call it to front-load the work.
fn coptic_init() {
    var e = coptic_epoch_jdn();
    var d = coptic_month_days(0);
    var n = coptic_month_name(0);
    return 0;
}

# --- egyptian.cyr ---

# egyptian.cyr — Ancient Egyptian mathematics and stellar astronomy.
#
# Ported from rust-old/src/egyptian.rs (full parity, v3.0.0):
#   - greedy (Fibonacci-Sylvester) unit-fraction decomposition
#   - Rhind-Papyrus doubling multiplication and its inverse division
#   - the 36 stellar decans (star-clock catalog)
#   - the Sothic (Sirius/Sopdet) cycle: drift + JDN-position math anchored to
#     the Censorinus 139 CE epoch
#   - hieroglyphic numeral rendering (via varna, always-on)
#
# Self-contained: NO include lines (the distlib bundler resolves stdlib + varna
# from the consumer's [deps]). All `%` here operate on non-negative operands
# (u32/u64 in Rust); the float positive-modulo idioms use the floor-based
# f64_fmod, which already returns the canonical [0, turn) representative.

# ---------------------------------------------------------------------------
# Constants (Sothic cycle)
# ---------------------------------------------------------------------------

# Integer constants — literal globals (cheap, no global-init cost).
var SOTHIC_CYCLE_CIVIL_YEARS = 1461;   # civil years per Sothic cycle
var SOTHIC_CYCLE_DAYS = 533265;        # 365 * 1461

# f64 constants — bit patterns set once in egyptian_init() / egy_ensure().
var SOTHIC_DRIFT_PER_YEAR = 0;         # 0.25 days per civil year
var CENSORINUS_EPOCH_JDN = 0;          # 1_772_028.5 (139 CE Sopdet rising)

# f64 scratch constants (whole numbers) also lazily initialized.
var EGY_F64_360 = 0;
var EGY_F64_10 = 0;
var EGY_F64_365 = 0;
var EGY_F64_1461 = 0;
var EGY_F64_30 = 0;
var EGY_F64_60 = 0;
var EGY_F64_NEG60 = 0;
var EGY_F64_2000 = 0;
var EGY_F64_200 = 0;

var egy_consts_done = 0;

fn egyptian_init() {
    SOTHIC_DRIFT_PER_YEAR = f64_parse("0.25");
    CENSORINUS_EPOCH_JDN = f64_parse("1772028.5");
    EGY_F64_360 = f64_from(360);
    EGY_F64_10 = f64_from(10);
    EGY_F64_365 = f64_from(365);
    EGY_F64_1461 = f64_from(1461);
    EGY_F64_30 = f64_from(30);
    EGY_F64_60 = f64_from(60);
    EGY_F64_NEG60 = f64_neg(f64_from(60));
    EGY_F64_2000 = f64_from(2000);
    EGY_F64_200 = f64_from(200);
    egy_consts_done = 1;
    return 0;
}

# Lazy guard so the module is correct even if a consumer forgets egyptian_init().
fn egy_ensure() {
    if (egy_consts_done == 0) { egyptian_init(); }
    return 0;
}

# ---------------------------------------------------------------------------
# Egyptian fractions (unit fraction decomposition)
# ---------------------------------------------------------------------------

# Private GCD (mirrors the Rust module's own gcd, not the stdlib one).
#must_use
fn egy_gcd(a, b) {
    var x = a;
    var y = b;
    while (y != 0) {
        var t = y;
        y = x % y;
        x = t;
    }
    return x;
}

# Decompose numerator/denominator into distinct unit-fraction denominators via
# the greedy (Fibonacci-Sylvester) algorithm. Returns Ok(vec of denominators)
# or Err on zero denominator / overflow / non-termination.
#must_use
fn decompose(numerator, denominator) {
    # tracing::debug!(numerator, denominator, "Egyptian fraction decomposition")
    sakshi_debug("Egyptian fraction decomposition", 31);

    if (denominator == 0) {
        return sk_fail(SKE_INVALID_FRACTION, str_from("denominator cannot be zero"));
    }
    if (numerator == 0) {
        return Ok(vec_new());
    }

    var num = numerator;
    var den = denominator;

    # Simplify the fraction first.
    var g = egy_gcd(num, den);
    num = num / g;
    den = den / g;

    # If already a unit fraction.
    if (num == 1) {
        var v1 = vec_new();
        vec_push(v1, den);
        return Ok(v1);
    }

    var result = vec_new();
    var iter = 0;
    var LIMIT = 0x7FFFFFFFFFFFFFFF;

    while (iter < 100) {
        if (num == 0) { break; }
        if (num == 1) {
            vec_push(result, den);
            break;
        }

        # d = ceil(den / num)
        var d = (den + num - 1) / num;
        vec_push(result, d);

        # new_num = num*d - den ; new_den = den*d  (checked, in Rust order)
        if (d != 0) {
            var lim1 = LIMIT / d;
            if (num > lim1) {
                return sk_fail(SKE_OVERFLOW, str_from("Egyptian fraction decomposition overflow"));
            }
        }
        var prod_nd = num * d;
        if (prod_nd < den) {
            return sk_fail(SKE_OVERFLOW, str_from("Egyptian fraction decomposition overflow"));
        }
        var new_num = prod_nd - den;

        if (d != 0) {
            var lim2 = LIMIT / d;
            if (den > lim2) {
                return sk_fail(SKE_OVERFLOW, str_from("Egyptian fraction decomposition overflow"));
            }
        }
        var new_den = den * d;

        if (new_num == 0) { break; }

        var g2 = egy_gcd(new_num, new_den);
        num = new_num / g2;
        den = new_den / g2;
        iter = iter + 1;
    }

    # Non-termination check (matches Rust's final guard).
    var bad = 0;
    if (num != 0) {
        if (vec_len(result) == 0) { bad = 1; }
        if (num != 1) { bad = 1; }
    }
    if (bad == 1) {
        return sk_fail(SKE_COMPUTATION, str_from("Egyptian fraction decomposition did not terminate"));
    }

    return Ok(result);
}

# ---------------------------------------------------------------------------
# Rhind Papyrus multiplication (doubling method)
# ---------------------------------------------------------------------------

# Multiply via repeated doubling/halving (binary multiplication). Bare +/<<
# are 2's-complement wrapping, matching Rust wrapping_add / wrapping_shl(1).
#must_use
fn egyptian_multiply(a, b) {
    var result = 0;
    var multiplicand = a;
    var multiplier = b;
    while (multiplier > 0) {
        var bit = multiplier & 1;
        if (bit == 1) { result = result + multiplicand; }
        multiplicand = multiplicand << 1;
        multiplier = multiplier >> 1;
    }
    return result;
}

# ---------------------------------------------------------------------------
# Egyptian division
# ---------------------------------------------------------------------------

# Result record for egyptian_divide: { quotient, fractions(vec) } — 16 bytes.
enum EgyDivOff { ED_QUOT = 0; ED_FRACS = 8; ED_SIZE = 16; }

#must_use
fn egydiv_new(quotient, fractions) {
    var p = alloc(ED_SIZE);
    store64(p + ED_QUOT, quotient);
    store64(p + ED_FRACS, fractions);
    return p;
}
#must_use
fn egydiv_quotient(p) { return load64(p + ED_QUOT); }
#must_use
fn egydiv_fractions(p) { return load64(p + ED_FRACS); }

# Divide via the Egyptian method: integer quotient + remainder as unit
# fractions. Returns Ok(EgyDiv record) or Err(InvalidFraction) on zero divisor.
#must_use
fn egyptian_divide(dividend, divisor) {
    if (divisor == 0) {
        return sk_fail(SKE_INVALID_FRACTION, str_from("divisor cannot be zero"));
    }

    var quotient = dividend / divisor;
    var remainder = dividend % divisor;

    if (remainder == 0) {
        return Ok(egydiv_new(quotient, vec_new()));
    }

    var dres_t, dres_v = decompose(remainder, divisor);
    if (is_err_result(dres_t) == 1) { return Err(dres_v); }
    var fractions = result_unwrap(dres_t, dres_v);
    return Ok(egydiv_new(quotient, fractions));
}

# ---------------------------------------------------------------------------
# Stellar decans
# ---------------------------------------------------------------------------

# Decan record: { number(u8), name(Str), ecliptic_longitude(f64) } — 24 bytes.
enum DecanOff { DEC_NUMBER = 0; DEC_NAME = 8; DEC_LON = 16; DEC_SIZE = 24; }

#must_use
fn decan_new(number, name, ecliptic_longitude) {
    var p = alloc(DEC_SIZE);
    store64(p + DEC_NUMBER, number);
    store64(p + DEC_NAME, name);
    store64(p + DEC_LON, ecliptic_longitude);
    return p;
}
#must_use
fn decan_number(p) { return load64(p + DEC_NUMBER); }
#must_use
fn decan_name(p) { return load64(p + DEC_NAME); }
#must_use
fn decan_longitude(p) { return load64(p + DEC_LON); }

# The 36 Egyptian stellar decans, longitudes 0.0..350.0 in 10-degree steps.
# Lazy-init singleton vec of Decan pointers (index i == decan #(i+1)).
var decans_vec = 0;
var decans_done = 0;

fn build_decans() {
    var v = vec_new();
    vec_push(v, decan_new(1, str_from("Kenmet"), f64_from(0)));
    vec_push(v, decan_new(2, str_from("Khentet Hrt"), f64_from(10)));
    vec_push(v, decan_new(3, str_from("Khentet Khrt"), f64_from(20)));
    vec_push(v, decan_new(4, str_from("Hat Djat"), f64_from(30)));
    vec_push(v, decan_new(5, str_from("Pehui Djat"), f64_from(40)));
    vec_push(v, decan_new(6, str_from("Temat Hrt"), f64_from(50)));
    vec_push(v, decan_new(7, str_from("Temat Khrt"), f64_from(60)));
    vec_push(v, decan_new(8, str_from("Ushat"), f64_from(70)));
    vec_push(v, decan_new(9, str_from("Bekati"), f64_from(80)));
    vec_push(v, decan_new(10, str_from("Tepai"), f64_from(90)));
    vec_push(v, decan_new(11, str_from("Khentu Hrt"), f64_from(100)));
    vec_push(v, decan_new(12, str_from("Khentu Khrt"), f64_from(110)));
    vec_push(v, decan_new(13, str_from("Sapt Khenmet"), f64_from(120)));
    vec_push(v, decan_new(14, str_from("Khenmet"), f64_from(130)));
    vec_push(v, decan_new(15, str_from("Seshmu"), f64_from(140)));
    vec_push(v, decan_new(16, str_from("Kenmu"), f64_from(150)));
    vec_push(v, decan_new(17, str_from("Semed"), f64_from(160)));
    vec_push(v, decan_new(18, str_from("Seret"), f64_from(170)));
    vec_push(v, decan_new(19, str_from("Sah"), f64_from(180)));
    vec_push(v, decan_new(20, str_from("Sopdet"), f64_from(190)));
    vec_push(v, decan_new(21, str_from("Knmt"), f64_from(200)));
    vec_push(v, decan_new(22, str_from("Sah Sapt"), f64_from(210)));
    vec_push(v, decan_new(23, str_from("Tepy Khentet"), f64_from(220)));
    vec_push(v, decan_new(24, str_from("Khentet Hrt S"), f64_from(230)));
    vec_push(v, decan_new(25, str_from("Khentet Khrt S"), f64_from(240)));
    vec_push(v, decan_new(26, str_from("Apt Hnt"), f64_from(250)));
    vec_push(v, decan_new(27, str_from("Ipds"), f64_from(260)));
    vec_push(v, decan_new(28, str_from("Sba N Hry Ib"), f64_from(270)));
    vec_push(v, decan_new(29, str_from("Kher Khept Khentet"), f64_from(280)));
    vec_push(v, decan_new(30, str_from("Tepy Ahui"), f64_from(290)));
    vec_push(v, decan_new(31, str_from("Ahui"), f64_from(300)));
    vec_push(v, decan_new(32, str_from("Pehui Ahui"), f64_from(310)));
    vec_push(v, decan_new(33, str_from("Tepy Baka"), f64_from(320)));
    vec_push(v, decan_new(34, str_from("Baka"), f64_from(330)));
    vec_push(v, decan_new(35, str_from("Tepy Akhui"), f64_from(340)));
    vec_push(v, decan_new(36, str_from("Akhui"), f64_from(350)));
    return v;
}

#must_use
fn all_decans() {
    if (decans_done == 0) {
        decans_vec = build_decans();
        decans_done = 1;
    }
    return decans_vec;
}

# Find the decan for a given ecliptic longitude (input normalized to 0..360).
# Each decan spans 10 degrees. Returns a Decan pointer from all_decans().
#must_use
fn decan_from_longitude(degrees) {
    egy_ensure();
    # normalized = ((degrees % 360) + 360) % 360  (floor-based fmod gives [0,360))
    var m1 = f64_fmod(degrees, EGY_F64_360);
    var normalized = f64_fmod(f64_add(m1, EGY_F64_360), EGY_F64_360);
    # index = (normalized / 10.0) as usize  (truncate toward zero)
    # Rust's `as usize` saturates negatives (and NaN) to 0; f64_to does not, so
    # guard the lower bound too (matches Rust's [0,35] clamp; avoids a negative
    # vec_get abort on non-finite/extreme inputs).
    var idx = f64_to(f64_div(normalized, EGY_F64_10));
    if (idx < 0) { idx = 0; }
    if (idx >= 36) { idx = 35; }
    return vec_get(all_decans(), idx);
}

# ---------------------------------------------------------------------------
# Sothic cycle (Sopdet / Sirius)
# ---------------------------------------------------------------------------

# Sopdet (Sirius) — decan #20 (0-indexed 19).
#must_use
fn sopdet() {
    return vec_get(all_decans(), 19);
}

# Drift in days between the civil calendar and the heliacal rising of Sopdet
# for a given number of civil years since a Sothic epoch. Resets each cycle.
#must_use
fn sothic_drift(years_since_epoch) {
    egy_ensure();
    var years_in_cycle = years_since_epoch % SOTHIC_CYCLE_CIVIL_YEARS;
    return f64_mul(f64_from(years_in_cycle), SOTHIC_DRIFT_PER_YEAR);
}

# Position record for sothic_position: { cycle_number(i32), year_in_cycle(u32),
# drift_days(f64) } — 24 bytes.
enum SothicPosOff { SP_CYCLE = 0; SP_YEAR = 8; SP_DRIFT = 16; SP_SIZE = 24; }

#must_use
fn sothicpos_new(cycle, year, drift) {
    var p = alloc(SP_SIZE);
    store64(p + SP_CYCLE, cycle);
    store64(p + SP_YEAR, year);
    store64(p + SP_DRIFT, drift);
    return p;
}
#must_use
fn sothicpos_cycle(p) { return load64(p + SP_CYCLE); }
#must_use
fn sothicpos_year(p) { return load64(p + SP_YEAR); }
#must_use
fn sothicpos_drift(p) { return load64(p + SP_DRIFT); }

# Determine the position within the current Sothic cycle for a given JDN,
# referenced to the Censorinus epoch (139 CE). Returns a SothicPos record.
#must_use
fn sothic_position(jdn) {
    egy_ensure();
    var days_from_epoch = f64_sub(jdn, CENSORINUS_EPOCH_JDN);
    var civil_years = f64_div(days_from_epoch, EGY_F64_365);

    var cycle_f = f64_floor(f64_div(civil_years, EGY_F64_1461));
    var cycle_number = f64_to(cycle_f);

    # year_in_cycle = ((civil_years % 1461) + 1461) % 1461  (floor-based fmod)
    var m1 = f64_fmod(civil_years, EGY_F64_1461);
    var year_in_cycle = f64_fmod(f64_add(m1, EGY_F64_1461), EGY_F64_1461);
    var year_u32 = f64_to(year_in_cycle);

    var drift = sothic_drift(year_u32);
    return sothicpos_new(cycle_number, year_u32, drift);
}

# Predict the JDN of the next heliacal rising of Sopdet after a given JDN for a
# geographic latitude. Errors (InvalidDate) if latitude outside -60..=60.
#must_use
fn next_sopdet_rising(jdn, latitude) {
    egy_ensure();
    var below = f64_lt(latitude, EGY_F64_NEG60);
    var above = f64_gt(latitude, EGY_F64_60);
    if (below == 1) {
        var sb1 = str_builder_new();
        str_builder_add_cstr(sb1, "latitude ");
        str_builder_add_int(sb1, f64_to(latitude));
        str_builder_add_cstr(sb1, " outside observable range for Sirius (-60 to +60)");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sb1));
    }
    if (above == 1) {
        var sb2 = str_builder_new();
        str_builder_add_cstr(sb2, "latitude ");
        str_builder_add_int(sb2, f64_to(latitude));
        str_builder_add_cstr(sb2, " outside observable range for Sirius (-60 to +60)");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sb2));
    }

    var latitude_offset = f64_sub(latitude, EGY_F64_30);

    # year_approx = 2000 + (jdn - J2000) / 365.25
    var year_approx = f64_add(EGY_F64_2000, f64_div(f64_sub(jdn, J2000_JDN), JULIAN_YEAR_DAYS));
    # jan1_jdn = J2000 + (floor(year_approx) - 2000) * 365.25
    var jan1_jdn = f64_add(J2000_JDN, f64_mul(f64_sub(f64_floor(year_approx), EGY_F64_2000), JULIAN_YEAR_DAYS));
    # rising_jdn = jan1_jdn + 200 + latitude_offset
    var rising_jdn = f64_add(f64_add(jan1_jdn, EGY_F64_200), latitude_offset);

    var passed = f64_le(rising_jdn, jdn);
    if (passed == 1) {
        return Ok(f64_add(rising_jdn, JULIAN_YEAR_DAYS));
    }
    return Ok(rising_jdn);
}

# ---------------------------------------------------------------------------
# Hieroglyphic numeral display (via varna, always-on)
# ---------------------------------------------------------------------------

# Powers of ten, high -> low, used by to_hieroglyphic. Lazy-init singleton.
var egy_powers_vec = 0;
var egy_powers_done = 0;

fn egy_powers() {
    if (egy_powers_done == 0) {
        var v = vec_new();
        vec_push(v, 1000000);
        vec_push(v, 100000);
        vec_push(v, 10000);
        vec_push(v, 1000);
        vec_push(v, 100);
        vec_push(v, 10);
        vec_push(v, 1);
        egy_powers_vec = v;
        egy_powers_done = 1;
    }
    return egy_powers_vec;
}

# Render a number in Egyptian hieroglyphic notation (additive decimal).
# Returns Ok("") for 0; Err(OverflowError) for n > 9_999_999.
#must_use
fn to_hieroglyphic(n) {
    if (n == 0) {
        return Ok(str_from(""));
    }
    if (n > 9999999) {
        var sbo = str_builder_new();
        str_builder_add_cstr(sbo, "cannot represent ");
        str_builder_add_int(sbo, n);
        str_builder_add_cstr(sbo, " in Egyptian hieroglyphic numerals (max 9,999,999)");
        return sk_fail(SKE_OVERFLOW, str_builder_build(sbo));
    }

    var sys = numerals_egyptian_hieroglyphic();
    var powers = egy_powers();
    var np = vec_len(powers);
    var result = str_builder_new();
    var remainder = n;

    for (var i = 0; i < np; i = i + 1) {
        var power = vec_get(powers, i);
        var count = remainder / power;
        remainder = remainder % power;
        if (count > 0) {
            var ch = numerals_char_for(sys, power);
            if (ch != 0) {
                for (var j = 0; j < count; j = j + 1) {
                    str_builder_add_cstr(result, ch);
                }
            }
        }
    }

    return Ok(str_builder_build(result));
}

# --- babylonian.cyr ---

# babylonian.cyr — Babylonian mathematics (port of rust-old/src/babylonian.rs).
#
# Sexagesimal (base-60) number system, Babylonian cuneiform numeral
# decomposition (via varna), the Saros eclipse cycle, a simplified 354-day
# Babylonian lunisolar calendar (Seleucid Era) with JDN<->date conversion,
# reciprocal tables of regular numbers, the 15 Plimpton 322 Pythagorean
# triples, and Heron's iterative square-root method.
#
# Self-contained (NO include lines): stdlib + varna are auto-resolved by the
# build tool. Depends (in link order) on error.cyr, util.cyr, f64_util.cyr.
#
# Parity notes:
#  * Rust returned Result<T, SankhyaError>. Here: Ok(v) on success, or
#    sk_fail(SKE_*, str_from("<exact Rust message>")) on error (error.cyr).
#  * tracing::trace!/debug! sites are preserved as message-only sakshi_trace/
#    sakshi_debug calls; the structured field values (jdn, n, ...) are dropped
#    (the playbook's recommended reduction — no field=value f64 formatting).

# ---------------------------------------------------------------------------
# Module f64 constants (initialised once via babylonian_init()).
# ---------------------------------------------------------------------------

# SAROS_DAYS: 6585.3211 — Saros eclipse cycle length in days (223 synodic months).
var SAROS_DAYS = 0;
# SYNODIC_MONTH_DAYS: 29.530594 — Babylonian System B mean synodic month.
var SYNODIC_MONTH_DAYS = 0;
# BABYLONIAN_EPOCH_JDN: 1607738.5 — JDN of 1 Nisannu, Year 1 SE (April 3, 311 BCE Julian).
var BABYLONIAN_EPOCH_JDN = 0;

# Days in a standard 12-month year (6*30 + 6*29). Integer-literal global (no init cost).
var BABYLONIAN_YEAR_DAYS = 354;

# Call once (after alloc_init) before using the calendar / cycle functions.
fn babylonian_init() {
    SAROS_DAYS = f64_parse("6585.3211");
    SYNODIC_MONTH_DAYS = f64_parse("29.530594");
    BABYLONIAN_EPOCH_JDN = f64_parse("1607738.5");
    return 0;
}

# ---------------------------------------------------------------------------
# BabylonianMonth enum + name table
# ---------------------------------------------------------------------------

# The 12 months of the lunisolar calendar. Enum value == month index (0-11).
enum BabylonianMonth {
    BM_NISANNU;
    BM_AYARU;
    BM_SIMANU;
    BM_DUMUZU;
    BM_ABU;
    BM_ULULU;
    BM_TASHRITU;
    BM_ARAHSAMNA;
    BM_KISLIMU;
    BM_TEBETU;
    BM_SHABATU;
    BM_ADDARU;
}

# Lazy-singleton vec of month names. Serde identifier == Display string here
# (all ASCII, no spaces), so babmonth_name and babmonth_display are equal.
var babmonth_names_vec = 0;
var babmonth_names_done = 0;

fn _build_babmonth_names() {
    var v = vec_new();
    vec_push(v, str_from("Nisannu"));
    vec_push(v, str_from("Ayaru"));
    vec_push(v, str_from("Simanu"));
    vec_push(v, str_from("Dumuzu"));
    vec_push(v, str_from("Abu"));
    vec_push(v, str_from("Ululu"));
    vec_push(v, str_from("Tashritu"));
    vec_push(v, str_from("Arahsamna"));
    vec_push(v, str_from("Kislimu"));
    vec_push(v, str_from("Tebetu"));
    vec_push(v, str_from("Shabatu"));
    vec_push(v, str_from("Addaru"));
    return v;
}

#must_use
fn all_babmonth_names() {
    if (babmonth_names_done == 0) {
        babmonth_names_vec = _build_babmonth_names();
        babmonth_names_done = 1;
    }
    return babmonth_names_vec;
}

# Serde identifier (== Display string for Babylonian months).
#must_use
fn babmonth_name(i) { return vec_get(all_babmonth_names(), i); }

# Display string (identical to the serde identifier here).
#must_use
fn babmonth_display(i) { return vec_get(all_babmonth_names(), i); }

# ---------------------------------------------------------------------------
# Babylonian month-length table (alternating 30/29, private const in Rust)
# ---------------------------------------------------------------------------

var babmonthdays_vec = 0;
var babmonthdays_done = 0;

fn _build_babmonthdays() {
    var v = vec_new();
    vec_push(v, 30);
    vec_push(v, 29);
    vec_push(v, 30);
    vec_push(v, 29);
    vec_push(v, 30);
    vec_push(v, 29);
    vec_push(v, 30);
    vec_push(v, 29);
    vec_push(v, 30);
    vec_push(v, 29);
    vec_push(v, 30);
    vec_push(v, 29);
    return v;
}

#must_use
fn all_bab_month_days() {
    if (babmonthdays_done == 0) {
        babmonthdays_vec = _build_babmonthdays();
        babmonthdays_done = 1;
    }
    return babmonthdays_vec;
}

#must_use
fn bab_month_days(i) { return vec_get(all_bab_month_days(), i); }

# ---------------------------------------------------------------------------
# Sexagesimal (base-60) number system
# ---------------------------------------------------------------------------

# Decimal -> base-60 digits, most significant first. Returns [0] for n == 0.
#must_use
fn to_sexagesimal(n) {
    if (n == 0) {
        var z = vec_new();
        vec_push(z, 0);
        return z;
    }
    var digits = vec_new();
    var m = n;
    while (m > 0) {
        vec_push(digits, m % 60);
        m = m / 60;
    }
    # reverse (least-significant-first -> most-significant-first)
    var rev = vec_new();
    var len = vec_len(digits);
    var i = len - 1;
    while (i >= 0) {
        vec_push(rev, vec_get(digits, i));
        i = i - 1;
    }
    return rev;
}

fn _msg_sexa_digit(d) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "sexagesimal digit ");
    str_builder_add_int(sb, d);
    str_builder_add_cstr(sb, " out of range 0..60");
    return str_builder_build(sb);
}

# Base-60 digits (a vec of i64) -> decimal. Ok(value), or an Err:
#   SKE_INVALID_BASE if any digit >= 60,
#   SKE_OVERFLOW on checked_mul(60)/checked_add overflow.
#must_use
fn from_sexagesimal(digits) {
    var result = 0;
    var n = vec_len(digits);
    var limit = 0x7FFFFFFFFFFFFFFF;
    var i = 0;
    while (i < n) {
        var d = vec_get(digits, i);
        if (d >= 60) {
            return sk_fail(SKE_INVALID_BASE, _msg_sexa_digit(d));
        }
        var lim60 = limit / 60;
        if (result > lim60) {
            return sk_fail(SKE_OVERFLOW, str_from("sexagesimal conversion overflow"));
        }
        result = result * 60;
        var limd = limit - d;
        if (result > limd) {
            return sk_fail(SKE_OVERFLOW, str_from("sexagesimal conversion overflow"));
        }
        result = result + d;
        i = i + 1;
    }
    return Ok(result);
}

# ---------------------------------------------------------------------------
# BabylonianNumeral: a single sexagesimal digit 0-59 as { tens, units }.
# ---------------------------------------------------------------------------

enum BabNumOff { BN_TENS = 0; BN_UNITS = 8; BN_SIZE = 16; }

#must_use
fn babnum_new(tens, units) {
    var p = alloc(BN_SIZE);
    store64(p + BN_TENS, tens);
    store64(p + BN_UNITS, units);
    return p;
}

#must_use
fn babnum_tens(p) { return load64(p + BN_TENS); }

#must_use
fn babnum_units(p) { return load64(p + BN_UNITS); }

# Decimal value of a numeral: tens*10 + units.
#must_use
fn babnum_value(p) { return load64(p + BN_TENS) * 10 + load64(p + BN_UNITS); }

fn _msg_bab_digit(v) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Babylonian digit ");
    str_builder_add_int(sb, v);
    str_builder_add_cstr(sb, " out of range 0..60");
    return str_builder_build(sb);
}

# Build a numeral from 0-59. Ok(ptr) or Err(SKE_INVALID_BASE) if value >= 60.
#must_use
fn babnum_from_value(value) {
    if (value >= 60) {
        return sk_fail(SKE_INVALID_BASE, _msg_bab_digit(value));
    }
    var p = babnum_new(value / 10, value % 10);
    return Ok(p);
}

# ---------------------------------------------------------------------------
# Saros cycle
# ---------------------------------------------------------------------------

# Predict the JDN of the next eclipse one Saros cycle later.
#must_use
fn saros_cycle(eclipse_jdn) {
    return f64_add(eclipse_jdn, SAROS_DAYS);
}

# ---------------------------------------------------------------------------
# Babylonian lunar calendar
# ---------------------------------------------------------------------------

enum BabDateOff { BD_YEAR = 0; BD_MONTH = 8; BD_DAY = 16; BD_SIZE = 24; }

#must_use
fn babdate_new(year, month, day) {
    var p = alloc(BD_SIZE);
    store64(p + BD_YEAR, year);
    store64(p + BD_MONTH, month);
    store64(p + BD_DAY, day);
    return p;
}

#must_use
fn babdate_year(p) { return load64(p + BD_YEAR); }

#must_use
fn babdate_month(p) { return load64(p + BD_MONTH); }

#must_use
fn babdate_day(p) { return load64(p + BD_DAY); }

# Convert a Julian Day Number to a Babylonian date (354-day model).
#must_use
fn jdn_to_babylonian(jdn) {
    sakshi_trace("JDN to Babylonian", strlen("JDN to Babylonian"));
    var diff = f64_sub(jdn, BABYLONIAN_EPOCH_JDN);
    var days_since_epoch = f64_to(f64_floor(diff));
    var years = div_euclid(days_since_epoch, BABYLONIAN_YEAR_DAYS);
    var remaining = rem_euclid(days_since_epoch, BABYLONIAN_YEAR_DAYS);
    var year = years + 1;
    var month_idx = 0;
    var i = 0;
    while (i < 12) {
        var md = bab_month_days(i);
        if (remaining < md) {
            month_idx = i;
            break;
        }
        remaining = remaining - md;
        if (i == 11) { month_idx = 11; }
        i = i + 1;
    }
    return babdate_new(year, month_idx, remaining + 1);
}

fn _msg_invalid_day(day, month_idx, max_day) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "day ");
    str_builder_add_int(sb, day);
    str_builder_add_cstr(sb, " out of range for ");
    str_builder_add(sb, babmonth_name(month_idx));
    str_builder_add_cstr(sb, " (max ");
    str_builder_add_int(sb, max_day);
    str_builder_add_cstr(sb, ")");
    return str_builder_build(sb);
}

# Convert a Babylonian date to a JDN. Ok(jdn) or Err(SKE_INVALID_DATE).
#must_use
fn babylonian_to_jdn(date) {
    sakshi_trace("Babylonian to JDN", strlen("Babylonian to JDN"));
    var month_idx = babdate_month(date);
    var max_day = bab_month_days(month_idx);
    var day = babdate_day(date);
    var bad = 0;
    if (day == 0) { bad = 1; }
    if (day > max_day) { bad = 1; }
    if (bad == 1) {
        return sk_fail(SKE_INVALID_DATE, _msg_invalid_day(day, month_idx, max_day));
    }
    var days = BABYLONIAN_YEAR_DAYS * (babdate_year(date) - 1);
    var i = 0;
    while (i < month_idx) {
        days = days + bab_month_days(i);
        i = i + 1;
    }
    days = days + (day - 1);
    var jdn = f64_add(BABYLONIAN_EPOCH_JDN, f64_from(days));
    return Ok(jdn);
}

# Complete synodic months elapsed between two JDNs, and the leftover days.
# Returns (complete_months, remainder_days).
#must_use
fn synodic_months_between(jdn1, jdn2) {
    var elapsed = f64_abs(f64_sub(jdn2, jdn1));
    var months_f = f64_floor(f64_div(elapsed, SYNODIC_MONTH_DAYS));
    var remainder = f64_sub(elapsed, f64_mul(months_f, SYNODIC_MONTH_DAYS));
    var months = f64_to(months_f);
    return (months, remainder);
}

# Display for BabylonianDate: "{day} {month}, Year {year} SE".
#must_use
fn babdate_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_int(sb, babdate_day(p));
    str_builder_add_cstr(sb, " ");
    str_builder_add(sb, babmonth_name(babdate_month(p)));
    str_builder_add_cstr(sb, ", Year ");
    str_builder_add_int(sb, babdate_year(p));
    str_builder_add_cstr(sb, " SE");
    return str_builder_build(sb);
}

# Display for BabylonianMonth (ASCII variant name).
#must_use
fn babmonth_to_str(i) { return babmonth_name(i); }

# ---------------------------------------------------------------------------
# Reciprocal tables (regular numbers) — was BTreeMap<u64, Vec<u8>>.
# Modelled as a vec of { key, digits-vec } records, inserted key-ascending.
# ---------------------------------------------------------------------------

enum RecipOff { RC_KEY = 0; RC_DIGITS = 8; RC_SIZE = 16; }

#must_use
fn recip_new(key, digits_vec) {
    var p = alloc(RC_SIZE);
    store64(p + RC_KEY, key);
    store64(p + RC_DIGITS, digits_vec);
    return p;
}

#must_use
fn recip_key(p) { return load64(p + RC_KEY); }

#must_use
fn recip_digits(p) { return load64(p + RC_DIGITS); }

fn _dv1(a) { var v = vec_new(); vec_push(v, a); return v; }
fn _dv2(a, b) { var v = vec_new(); vec_push(v, a); vec_push(v, b); return v; }
fn _dv3(a, b, c) { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); return v; }
fn _dv4(a, b, c, d) { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); vec_push(v, d); return v; }

# Reciprocal table for regular numbers up to 81 (29 entries, key-ascending).
#must_use
fn reciprocal_table() {
    var t = vec_new();
    vec_push(t, recip_new(2, _dv1(30)));
    vec_push(t, recip_new(3, _dv1(20)));
    vec_push(t, recip_new(4, _dv1(15)));
    vec_push(t, recip_new(5, _dv1(12)));
    vec_push(t, recip_new(6, _dv1(10)));
    vec_push(t, recip_new(8, _dv2(7, 30)));
    vec_push(t, recip_new(9, _dv2(6, 40)));
    vec_push(t, recip_new(10, _dv1(6)));
    vec_push(t, recip_new(12, _dv1(5)));
    vec_push(t, recip_new(15, _dv1(4)));
    vec_push(t, recip_new(16, _dv2(3, 45)));
    vec_push(t, recip_new(18, _dv2(3, 20)));
    vec_push(t, recip_new(20, _dv1(3)));
    vec_push(t, recip_new(24, _dv2(2, 30)));
    vec_push(t, recip_new(25, _dv2(2, 24)));
    vec_push(t, recip_new(27, _dv3(2, 13, 20)));
    vec_push(t, recip_new(30, _dv1(2)));
    vec_push(t, recip_new(32, _dv3(1, 52, 30)));
    vec_push(t, recip_new(36, _dv2(1, 40)));
    vec_push(t, recip_new(40, _dv2(1, 30)));
    vec_push(t, recip_new(45, _dv2(1, 20)));
    vec_push(t, recip_new(48, _dv2(1, 15)));
    vec_push(t, recip_new(50, _dv2(1, 12)));
    vec_push(t, recip_new(54, _dv3(1, 6, 40)));
    vec_push(t, recip_new(60, _dv1(1)));
    vec_push(t, recip_new(64, _dv3(0, 56, 15)));
    vec_push(t, recip_new(72, _dv2(0, 50)));
    vec_push(t, recip_new(80, _dv2(0, 45)));
    vec_push(t, recip_new(81, _dv4(0, 44, 26, 40)));
    return t;
}

# BTreeMap::get analogue — linear scan, returns the digits vec or 0 if absent.
#must_use
fn reciprocal_lookup(table, key) {
    var n = vec_len(table);
    var i = 0;
    while (i < n) {
        var p = vec_get(table, i);
        if (recip_key(p) == key) { return recip_digits(p); }
        i = i + 1;
    }
    return 0;
}

# ---------------------------------------------------------------------------
# Plimpton 322 Pythagorean triples
# ---------------------------------------------------------------------------

enum TripleOff { TR_A = 0; TR_B = 8; TR_C = 16; TR_SIZE = 24; }

#must_use
fn triple_new(a, b, c) {
    var p = alloc(TR_SIZE);
    store64(p + TR_A, a);
    store64(p + TR_B, b);
    store64(p + TR_C, c);
    return p;
}

#must_use
fn triple_a(p) { return load64(p + TR_A); }

#must_use
fn triple_b(p) { return load64(p + TR_B); }

#must_use
fn triple_c(p) { return load64(p + TR_C); }

# The 15 Pythagorean triples of Plimpton 322, in tablet row order.
#must_use
fn generate_plimpton_triples() {
    var v = vec_new();
    vec_push(v, triple_new(119, 120, 169));
    vec_push(v, triple_new(3367, 3456, 4825));
    vec_push(v, triple_new(4601, 4800, 6649));
    vec_push(v, triple_new(12709, 13500, 18541));
    vec_push(v, triple_new(65, 72, 97));
    vec_push(v, triple_new(319, 360, 481));
    vec_push(v, triple_new(2291, 2700, 3541));
    vec_push(v, triple_new(799, 960, 1249));
    vec_push(v, triple_new(481, 600, 769));
    vec_push(v, triple_new(4961, 6480, 8161));
    vec_push(v, triple_new(45, 60, 75));
    vec_push(v, triple_new(1679, 2400, 2929));
    vec_push(v, triple_new(161, 240, 289));
    vec_push(v, triple_new(1771, 2700, 3229));
    vec_push(v, triple_new(56, 90, 106));
    return v;
}

# ---------------------------------------------------------------------------
# Babylonian square root (Heron's method)
# ---------------------------------------------------------------------------

# Heron iteration x = (x + n/x) / 2, `iterations` times.
#   Err(SKE_COMPUTATION) if n is negative, NaN, or infinite.
#   Ok(0.0) if n == 0.0.
#   Err(SKE_INVALID_BASE) if iterations == 0.
#must_use
fn babylonian_sqrt(n, iterations) {
    sakshi_debug("Babylonian/Heron sqrt", strlen("Babylonian/Heron sqrt"));
    if (f64_is_nan(n) == 1) {
        return sk_fail(SKE_COMPUTATION, str_from("cannot compute square root of negative, NaN, or infinite number"));
    }
    if (f64_is_inf(n) == 1) {
        return sk_fail(SKE_COMPUTATION, str_from("cannot compute square root of negative, NaN, or infinite number"));
    }
    var neg = f64_lt(n, f64_from(0));
    if (neg == 1) {
        return sk_fail(SKE_COMPUTATION, str_from("cannot compute square root of negative, NaN, or infinite number"));
    }
    var zero = f64_eq(n, f64_from(0));
    if (zero == 1) {
        return Ok(f64_from(0));
    }
    if (iterations == 0) {
        return sk_fail(SKE_INVALID_BASE, str_from("iterations must be at least 1"));
    }
    # Initial guess: 1.0 if n < 2, else n/2.
    var x = f64_from(1);
    var ge2 = f64_ge(n, f64_from(2));
    if (ge2 == 1) {
        x = f64_div(n, f64_from(2));
    }
    var i = 0;
    while (i < iterations) {
        x = f64_div(f64_add(x, f64_div(n, x)), f64_from(2));
        i = i + 1;
    }
    return Ok(x);
}

# ---------------------------------------------------------------------------
# Cuneiform display (via varna numerals)
# ---------------------------------------------------------------------------

# The available tens symbols, highest first: 30, 20, 10.
fn _cune_tens_val(ti) {
    if (ti == 0) { return 30; }
    if (ti == 1) { return 20; }
    return 10;
}

fn _msg_cune_digit(d) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "cuneiform digit ");
    str_builder_add_int(sb, d);
    str_builder_add_cstr(sb, " out of range 0..60");
    return str_builder_build(sb);
}

# Render a sexagesimal digit (0-59) in cuneiform. " " for 0.
#   Err(SKE_INVALID_BASE) if digit >= 60.
#must_use
fn cuneiform_digit(digit) {
    if (digit >= 60) {
        return sk_fail(SKE_INVALID_BASE, _msg_cune_digit(digit));
    }
    if (digit == 0) {
        return Ok(str_from(" "));
    }
    var sys = numerals_babylonian_sexagesimal();
    var tens = digit / 10;
    var units = digit % 10;
    var sb = str_builder_new();
    if (tens > 0) {
        var remaining_tens = tens;
        var ti = 0;
        while (ti < 3) {
            var val = _cune_tens_val(ti);
            var lhs = remaining_tens * 10;
            var cond = lhs >= val;
            if (cond == 1) {
                var ch = numerals_char_for(sys, val);
                if (ch != 0) {
                    str_builder_add_cstr(sb, ch);
                    remaining_tens = remaining_tens - val / 10;
                }
            }
            if (remaining_tens == 0) { break; }
            ti = ti + 1;
        }
    }
    if (units > 0) {
        var uch = numerals_char_for(sys, units);
        if (uch != 0) {
            str_builder_add_cstr(sb, uch);
        }
    }
    return Ok(str_builder_build(sb));
}

# Render a full number in cuneiform sexagesimal, digits joined with '·'.
#   Propagates any Err from cuneiform_digit.
#must_use
fn to_cuneiform(n) {
    var digits = to_sexagesimal(n);
    var sb = str_builder_new();
    var len = vec_len(digits);
    var i = 0;
    while (i < len) {
        var d = vec_get(digits, i);
        var r_t, r_v = cuneiform_digit(d);
        if (is_err_result(r_t) == 1) {
            return Err(r_v);
        }
        var part = result_unwrap(r_t, r_v);
        if (i > 0) {
            str_builder_add_cstr(sb, "·");
        }
        str_builder_add(sb, part);
        i = i + 1;
    }
    return Ok(str_builder_build(sb));
}

# --- hebrew.cyr ---

# hebrew.cyr — Hebrew (Jewish) lunisolar calendar.
#
# Ported from rust-old/src/hebrew.rs. Implements the arithmetic Hebrew calendar
# with Julian Day Number conversions, following Dershowitz & Reingold,
# *Calendrical Calculations* (4th ed., 2018), ch. 8:
#   - 19-year Metonic leap rule (years 3,6,8,11,14,17,19 leap)
#   - arithmetic molad (mean new moon) in chalakim (parts)
#   - four dehiyyot (postponement rules) for Rosh Hashana
#   - six year types (353/354/355 common, 383/384/385 leap)
#   - JDN <-> HebrewDate round-trip
#
# SELF-CONTAINED: no include lines (distlib bundler strips them; stdlib + the
# foundation modules error/util/f64_util/logging are resolved at bundle time).
#
# CALENDAR MODULO: every Rust .rem_euclid()/.div_euclid() maps to the util
# helpers rem_euclid()/div_euclid() — pre-epoch day/molad counts can be
# negative, where plain %/ are truncated and would corrupt the day-of-week and
# month decomposition.

# ---------------------------------------------------------------------------
# Constants (integer chalakim / parts arithmetic). Enum members carry no
# global-init cost.
# ---------------------------------------------------------------------------
# PARTS_PER_HOUR = 1080; PARTS_PER_DAY = 24 * 1080 = 25920;
# MONTH_PARTS = 29*25920 + 12*1080 + 793 = 765433 (mean synodic month);
# MOLAD_EPOCH offset = PARTS_PER_DAY + 5*PARTS_PER_HOUR + 204 = 31524
#   (molad of Tishrei year 1: day 1 (Monday), 5h, 204 parts from Sunday 0h);
# JDN_OFFSET: molad day 1 = JDN 347997, so JDN = day + 347996;
# MONTHS_PER_CYCLE = 235 (12*19 + 7 leap months per 19-year cycle).
enum HebConst {
    HEB_PARTS_PER_HOUR = 1080;
    HEB_PARTS_PER_DAY = 25920;
    HEB_MONTH_PARTS = 765433;
    HEB_JDN_OFFSET = 347996;
    HEB_MONTHS_PER_CYCLE = 235;
}

# Julian Day Number of the Hebrew epoch (1 Tishrei year 1 AM), midnight-based:
# 347996.5. Set by hebrew_init() (called by the test harness / consumer init).
var HEBREW_EPOCH_JDN = 0;

fn hebrew_init() {
    HEBREW_EPOCH_JDN = f64_add(f64_from(347996), F64_HALF);
    return 0;
}

# ---------------------------------------------------------------------------
# Month enum — 14 possible months (Adar splits into Adar I / Adar II in leap
# years). Discriminants match the Rust enum order (Tishrei = 0 ... Elul = 13).
# ---------------------------------------------------------------------------
enum HebrewMonth {
    HM_TISHREI;
    HM_CHESHVAN;
    HM_KISLEV;
    HM_TEVET;
    HM_SHEVAT;
    HM_ADAR;
    HM_ADAR_I;
    HM_ADAR_II;
    HM_NISAN;
    HM_IYAR;
    HM_SIVAN;
    HM_TAMMUZ;
    HM_AV;
    HM_ELUL;
}

# --- Serde identifier names (no spaces: "AdarI"/"AdarII") ---
var hm_names_vec = 0;
var hm_names_done = 0;

fn build_hm_names() {
    var v = vec_new();
    vec_push(v, str_from("Tishrei"));
    vec_push(v, str_from("Cheshvan"));
    vec_push(v, str_from("Kislev"));
    vec_push(v, str_from("Tevet"));
    vec_push(v, str_from("Shevat"));
    vec_push(v, str_from("Adar"));
    vec_push(v, str_from("AdarI"));
    vec_push(v, str_from("AdarII"));
    vec_push(v, str_from("Nisan"));
    vec_push(v, str_from("Iyar"));
    vec_push(v, str_from("Sivan"));
    vec_push(v, str_from("Tammuz"));
    vec_push(v, str_from("Av"));
    vec_push(v, str_from("Elul"));
    return v;
}

#must_use
fn hebrewmonth_name(i) {
    if (hm_names_done == 0) { hm_names_vec = build_hm_names(); hm_names_done = 1; }
    return vec_get(hm_names_vec, i);
}

# --- Display names (with spaces: "Adar I"/"Adar II") ---
var hm_disp_vec = 0;
var hm_disp_done = 0;

fn build_hm_disp() {
    var v = vec_new();
    vec_push(v, str_from("Tishrei"));
    vec_push(v, str_from("Cheshvan"));
    vec_push(v, str_from("Kislev"));
    vec_push(v, str_from("Tevet"));
    vec_push(v, str_from("Shevat"));
    vec_push(v, str_from("Adar"));
    vec_push(v, str_from("Adar I"));
    vec_push(v, str_from("Adar II"));
    vec_push(v, str_from("Nisan"));
    vec_push(v, str_from("Iyar"));
    vec_push(v, str_from("Sivan"));
    vec_push(v, str_from("Tammuz"));
    vec_push(v, str_from("Av"));
    vec_push(v, str_from("Elul"));
    return v;
}

#must_use
fn hebrewmonth_display(i) {
    if (hm_disp_done == 0) { hm_disp_vec = build_hm_disp(); hm_disp_done = 1; }
    return vec_get(hm_disp_vec, i);
}

# Display impl for HebrewMonth (returns the Display string, e.g. "Adar I").
#must_use
fn hebrewmonth_to_str(m) { return hebrewmonth_display(m); }

# ---------------------------------------------------------------------------
# HebrewDate struct: { year: i64 (Anno Mundi), month: HebrewMonth, day: i64 }
# Offsets: year(0) month(8) day(16) = 24 bytes.
# ---------------------------------------------------------------------------
enum HebDateOff { HD_YEAR = 0; HD_MONTH = 8; HD_DAY = 16; HD_SIZE = 24; }

#must_use
fn hebrewdate_new(year, month, day) {
    var p = alloc(HD_SIZE);
    store64(p + HD_YEAR, year);
    store64(p + HD_MONTH, month);
    store64(p + HD_DAY, day);
    return p;
}

#must_use
fn hebdate_year(p) { return load64(p + HD_YEAR); }
#must_use
fn hebdate_month(p) { return load64(p + HD_MONTH); }
#must_use
fn hebdate_day(p) { return load64(p + HD_DAY); }

# Display impl for HebrewDate: "{day} {month} {year} AM".
#must_use
fn hebrewdate_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_int(sb, hebdate_day(p));
    str_builder_add_cstr(sb, " ");
    str_builder_add(sb, hebrewmonth_to_str(hebdate_month(p)));
    str_builder_add_cstr(sb, " ");
    str_builder_add_int(sb, hebdate_year(p));
    str_builder_add_cstr(sb, " AM");
    return str_builder_build(sb);
}

# ---------------------------------------------------------------------------
# Month-order tables (lazy singletons of month discriminants).
# COMMON_MONTHS [12], LEAP_MONTHS [13].
# ---------------------------------------------------------------------------
var common_months_vec = 0;
var common_months_done = 0;

fn build_common_months() {
    var v = vec_new();
    vec_push(v, HM_TISHREI);
    vec_push(v, HM_CHESHVAN);
    vec_push(v, HM_KISLEV);
    vec_push(v, HM_TEVET);
    vec_push(v, HM_SHEVAT);
    vec_push(v, HM_ADAR);
    vec_push(v, HM_NISAN);
    vec_push(v, HM_IYAR);
    vec_push(v, HM_SIVAN);
    vec_push(v, HM_TAMMUZ);
    vec_push(v, HM_AV);
    vec_push(v, HM_ELUL);
    return v;
}

#must_use
fn common_months() {
    if (common_months_done == 0) { common_months_vec = build_common_months(); common_months_done = 1; }
    return common_months_vec;
}

var leap_months_vec = 0;
var leap_months_done = 0;

fn build_leap_months() {
    var v = vec_new();
    vec_push(v, HM_TISHREI);
    vec_push(v, HM_CHESHVAN);
    vec_push(v, HM_KISLEV);
    vec_push(v, HM_TEVET);
    vec_push(v, HM_SHEVAT);
    vec_push(v, HM_ADAR_I);
    vec_push(v, HM_ADAR_II);
    vec_push(v, HM_NISAN);
    vec_push(v, HM_IYAR);
    vec_push(v, HM_SIVAN);
    vec_push(v, HM_TAMMUZ);
    vec_push(v, HM_AV);
    vec_push(v, HM_ELUL);
    return v;
}

#must_use
fn leap_months() {
    if (leap_months_done == 0) { leap_months_vec = build_leap_months(); leap_months_done = 1; }
    return leap_months_vec;
}

# ---------------------------------------------------------------------------
# Leap year and year properties
# ---------------------------------------------------------------------------
# Whether a Hebrew year is a leap year (13 months). Arithmetic Metonic rule:
# ((7*year)+1).rem_euclid(19) < 7.
#must_use
fn hebrew_is_leap(year) {
    var r = rem_euclid(7 * year + 1, 19);
    if (r < 7) { return 1; }
    return 0;
}

# Whether a 1-based position within a 19-year cycle is a leap year.
#must_use
fn hebrew_is_leap_in_cycle(pos) {
    if (pos == 3) { return 1; }
    if (pos == 6) { return 1; }
    if (pos == 8) { return 1; }
    if (pos == 11) { return 1; }
    if (pos == 14) { return 1; }
    if (pos == 17) { return 1; }
    if (pos == 19) { return 1; }
    return 0;
}

# Total months elapsed from creation to the start of a Hebrew year.
#must_use
fn months_before_year(year) {
    var y = year - 1;
    var cycles = div_euclid(y, 19);
    var remainder = rem_euclid(y, 19);
    var months = cycles * HEB_MONTHS_PER_CYCLE;
    for (var i = 0; i < remainder; i = i + 1) {
        var yr = i + 1;
        if (hebrew_is_leap_in_cycle(yr) == 1) { months = months + 13; }
        else { months = months + 12; }
    }
    return months;
}

# Molad (mean new moon) of Tishrei for a given year, in parts (chalakim).
#must_use
fn molad_tishrei(year) {
    var months_elapsed = months_before_year(year);
    var molad_epoch = HEB_PARTS_PER_DAY + 5 * HEB_PARTS_PER_HOUR + 204;
    return molad_epoch + months_elapsed * HEB_MONTH_PARTS;
}

# JDN of 1 Tishrei (Rosh Hashana) for a given year, applying the four dehiyyot.
#must_use
fn rosh_hashana_jdn(year) {
    var molad = molad_tishrei(year);
    var day = div_euclid(molad, HEB_PARTS_PER_DAY);
    var parts_in_day = rem_euclid(molad, HEB_PARTS_PER_DAY);

    # Day of week (0=Sunday .. 6=Saturday)
    var dow = rem_euclid(day, 7);

    # molad day 1 = JDN 347997, so JDN = day + 347996
    var jdn = day + HEB_JDN_OFFSET;

    # Dehiyya 1 (Lo ADU Rosh): cannot fall on Sunday(0), Wednesday(3), Friday(5).
    var postpone = 0;
    if (dow == 0) { postpone = 1; }
    if (dow == 3) { postpone = 1; }
    if (dow == 5) { postpone = 1; }

    # Dehiyya 2 (Molad Zaken): molad at or after noon (18h = 18*1080 = 19440).
    if (parts_in_day >= 18 * HEB_PARTS_PER_HOUR) {
        postpone = 1;
        var new_dow = rem_euclid(dow + 1, 7);
        if (new_dow == 0) { postpone = 2; }
        if (new_dow == 3) { postpone = 2; }
        if (new_dow == 5) { postpone = 2; }
    }

    # Dehiyya 3 (GaTRaD): common year, molad on Tuesday(2) >= 9h204p (9924) -> Thursday.
    var leap_this = hebrew_is_leap(year);
    if (leap_this == 0) {
        if (dow == 2) {
            if (parts_in_day >= 9 * HEB_PARTS_PER_HOUR + 204) { postpone = 2; }
        }
    }

    # Dehiyya 4 (BeTUTeKPaT): year after a leap year, molad on Monday(1) >= 15h589p (16789) -> Tuesday.
    var leap_prev = hebrew_is_leap(year - 1);
    if (leap_prev == 1) {
        if (dow == 1) {
            if (parts_in_day >= 15 * HEB_PARTS_PER_HOUR + 589) { postpone = 1; }
        }
    }

    jdn = jdn + postpone;
    return jdn;
}

# Days in a Hebrew year: 353/354/355 (common) or 383/384/385 (leap).
#must_use
fn hebrew_year_days(year) {
    return rosh_hashana_jdn(year + 1) - rosh_hashana_jdn(year);
}

# Days in a specific Hebrew month for a given year.
#must_use
fn hebrew_month_days(year, month) {
    var year_len = hebrew_year_days(year);
    if (month == HM_TISHREI) { return 30; }
    if (month == HM_CHESHVAN) {
        # 30 in "complete" years (355 or 385), 29 otherwise.
        if (rem_euclid(year_len, 10) == 5) { return 30; }
        return 29;
    }
    if (month == HM_KISLEV) {
        # 29 in "deficient" years (353 or 383), 30 otherwise.
        if (rem_euclid(year_len, 10) == 3) { return 29; }
        return 30;
    }
    if (month == HM_TEVET) { return 29; }
    if (month == HM_SHEVAT) { return 30; }
    if (month == HM_ADAR) { return 29; }
    if (month == HM_ADAR_I) { return 30; }
    if (month == HM_ADAR_II) { return 29; }
    if (month == HM_NISAN) { return 30; }
    if (month == HM_IYAR) { return 29; }
    if (month == HM_SIVAN) { return 30; }
    if (month == HM_TAMMUZ) { return 29; }
    if (month == HM_AV) { return 30; }
    if (month == HM_ELUL) { return 29; }
    return 29;
}

# ---------------------------------------------------------------------------
# JDN conversions
# ---------------------------------------------------------------------------
# Convert a Julian Day Number (f64) to a Hebrew date.
#must_use
fn jdn_to_hebrew(jdn) {
    # (jdn + 0.5).floor() as i64
    var jdn_int = f64_to(f64_floor(f64_add(jdn, F64_HALF)));

    # trace!(jdn, "JDN to Hebrew")
    var tv = str_from_int(jdn_int);
    sakshi_log_kv(SK_TRACE, "JDN to Hebrew", 13, "jdn", 3, str_data(tv), str_len(tv));

    # Estimate year: ((jdn_int - 347996) as f64 / 365.25).floor() as i64 + 1
    var diff = jdn_int - HEB_JDN_OFFSET;
    var approx_f = f64_div(f64_from(diff), JULIAN_YEAR_DAYS);
    var year = f64_to(f64_floor(approx_f)) + 1;

    # Correct: find the year whose Rosh Hashana is <= jdn_int.
    while (rosh_hashana_jdn(year + 1) <= jdn_int) { year = year + 1; }
    while (rosh_hashana_jdn(year) > jdn_int) { year = year - 1; }

    var day_of_year = jdn_int - rosh_hashana_jdn(year);
    var is_leap = hebrew_is_leap(year);

    var months = common_months();
    if (is_leap == 1) { months = leap_months(); }

    var remaining = day_of_year;
    var month = vec_get(months, 0);
    var n = vec_len(months);
    var stop = 0;
    for (var i = 0; i < n; i = i + 1) {
        var m = vec_get(months, i);
        if (stop == 0) {
            var md = hebrew_month_days(year, m);
            if (remaining < md) {
                month = m;
                stop = 1;
            } else {
                remaining = remaining - md;
                month = m;
            }
        }
    }

    return hebrewdate_new(year, month, remaining + 1);
}

# --- error message builders (preserve the exact Rust format! text) ---
fn _heb_err_common(month, year) {
    var sb = str_builder_new();
    str_builder_add(sb, hebrewmonth_to_str(month));
    str_builder_add_cstr(sb, " is not valid in common year ");
    str_builder_add_int(sb, year);
    str_builder_add_cstr(sb, " AM");
    return sk_fail(SKE_INVALID_DATE, str_builder_build(sb));
}

fn _heb_err_leap_adar(year) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Adar is not valid in leap year ");
    str_builder_add_int(sb, year);
    str_builder_add_cstr(sb, " AM (use Adar I or Adar II)");
    return sk_fail(SKE_INVALID_DATE, str_builder_build(sb));
}

fn _heb_err_day(day, month, year, max_day) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "day ");
    str_builder_add_int(sb, day);
    str_builder_add_cstr(sb, " out of range for ");
    str_builder_add(sb, hebrewmonth_to_str(month));
    str_builder_add_cstr(sb, " in year ");
    str_builder_add_int(sb, year);
    str_builder_add_cstr(sb, " AM (max ");
    str_builder_add_int(sb, max_day);
    str_builder_add_cstr(sb, ")");
    return sk_fail(SKE_INVALID_DATE, str_builder_build(sb));
}

# Convert a Hebrew date to a Julian Day Number. Returns Ok(f64) or an Err
# (SKE_INVALID_DATE) if the month is invalid for the year type or the day is
# out of range.
#must_use
fn hebrew_to_jdn(date) {
    var year = hebdate_year(date);
    var month = hebdate_month(date);
    var day = hebdate_day(date);

    # trace!(year, ?month, day, "Hebrew to JDN")
    var yv = str_from_int(year);
    sakshi_log_kv(SK_TRACE, "Hebrew to JDN", 13, "year", 4, str_data(yv), str_len(yv));

    var is_leap = hebrew_is_leap(year);

    # Validate month for year type.
    if (is_leap == 0) {
        if (month == HM_ADAR_I) { return _heb_err_common(month, year); }
        if (month == HM_ADAR_II) { return _heb_err_common(month, year); }
    }
    if (is_leap == 1) {
        if (month == HM_ADAR) { return _heb_err_leap_adar(year); }
    }

    var max_day = hebrew_month_days(year, month);
    if (day == 0) { return _heb_err_day(day, month, year, max_day); }
    if (day > max_day) { return _heb_err_day(day, month, year, max_day); }

    var months = common_months();
    if (is_leap == 1) { months = leap_months(); }

    var day_of_year = day - 1;
    var n = vec_len(months);
    var stop = 0;
    for (var i = 0; i < n; i = i + 1) {
        var m = vec_get(months, i);
        if (stop == 0) {
            if (m == month) { stop = 1; }
            else { day_of_year = day_of_year + hebrew_month_days(year, m); }
        }
    }

    var jdn_int = rosh_hashana_jdn(year) + day_of_year;
    # Ok(jdn as f64 - 0.5)
    return Ok(f64_sub(f64_from(jdn_int), F64_HALF));
}

# --- islamic.cyr ---

# islamic.cyr — Islamic / Arabic mathematics (port of rust-old/src/islamic.rs).
#
# al-Khwarizmi's six canonical quadratic forms with geometric completion of the
# square; Omar Khayyam's cubic classification (solved numerically via Newton's
# method); and the tabular Hijri (Islamic lunar) calendar with JDN<->date
# conversion over the 30-year leap cycle.
#
# Depends on foundation: error.cyr (sk_fail/SKE_*), util.cyr (rem_euclid/
# div_euclid), f64_util.cyr, logging.cyr. Self-contained — no include lines.

# ---------------------------------------------------------------------------
# Constants (exact IEEE-754 bit patterns → no global-init cost, always valid)
# ---------------------------------------------------------------------------

# JDN of 1 Muharram 1 AH (16 Jul 622 CE Julian). Half-integer f64 = 1948439.5.
var HIJRI_EPOCH_JDN = 0x413DBB1780000000;

# Mean synodic lunar month length in days = 29.53058886 (declared, unused here).
var ISLAMIC_MONTH_DAYS = 0x403D87D4ABE9526A;

# Days in the 30-year tabular cycle (19*354 + 11*355 = 10631).
var HIJRI_30_YEAR_CYCLE_DAYS = 10631;

# f64::EPSILON = 2.220446049250313e-16 (used for zero-coeff + form branching).
var ISLAMIC_F64_EPSILON = 0x3CB0000000000000;
# Newton's-method step tolerance = 1e-12.
var ISLAMIC_STEP_TOL = 0x3D719799812DEA11;
# Newton's-method residual-accept / root-dedup tolerance = 1e-8.
var ISLAMIC_ACCEPT_TOL = 0x3E45798EE2308C3A;

# ---------------------------------------------------------------------------
# Enums (integer constants)
# ---------------------------------------------------------------------------

# al-Khwarizmi's six canonical forms of degree-<=2 equations.
enum AlJabrForm {
    ALJ_SQUARES_EQUAL_ROOTS;            # ax^2 = bx
    ALJ_SQUARES_EQUAL_NUMBER;           # ax^2 = c
    ALJ_ROOTS_EQUAL_NUMBER;             # bx = c
    ALJ_SQUARES_AND_ROOTS_EQUAL_NUMBER; # ax^2 + bx = c
    ALJ_SQUARES_AND_NUMBER_EQUAL_ROOTS; # ax^2 + c = bx
    ALJ_ROOTS_AND_NUMBER_EQUAL_SQUARES; # bx + c = ax^2
}

# Omar Khayyam's cubic classification (5 of his 19 types).
enum KhayyamCubicType {
    KCT_CUBE_EQUAL_NUMBER;              # x^3 = d
    KCT_CUBE_AND_THING_EQUAL_NUMBER;    # x^3 + bx = d
    KCT_CUBE_AND_SQUARE_EQUAL_NUMBER;   # x^3 + cx^2 = d
    KCT_CUBE_EQUAL_THING_AND_NUMBER;    # x^3 = bx + d
    KCT_CUBE_THING_NUMBER_EQUAL_SQUARE; # x^3 + bx + d = cx^2
}

# The 12 months of the Islamic calendar (value == index, 0..11).
enum HijriMonth {
    HM_MUHARRAM;        # 0
    HM_SAFAR;           # 1
    HM_RABI_AL_AWWAL;   # 2
    HM_RABI_AL_THANI;   # 3
    HM_JUMADA_AL_ULA;   # 4
    HM_JUMADA_AL_THANI; # 5
    HM_RAJAB;           # 6
    HM_SHABAN;          # 7
    HM_RAMADAN;         # 8
    HM_SHAWWAL;         # 9
    HM_DHUL_QADAH;      # 10
    HM_DHUL_HIJJAH;     # 11
}

# ---------------------------------------------------------------------------
# tracing → sakshi (keep the Rust trace sites; no-ops at default SK_INFO level)
# ---------------------------------------------------------------------------

fn _islamic_trace(s) {
    var m = str_from(s);
    sakshi_trace(str_data(m), str_len(m));
    return 0;
}

fn _islamic_debug(s) {
    var m = str_from(s);
    sakshi_debug(str_data(m), str_len(m));
    return 0;
}

# ---------------------------------------------------------------------------
# HijriMonth name tables (lazy singletons)
#   hijri_month_name(i)    — serde/Debug identifier (no spaces): "RabiAlAwwal"
#   hijri_month_display(i) — Display string (spelled): "Rabi al-Awwal"
# ---------------------------------------------------------------------------

var _hm_name_vec = 0;
var _hm_name_done = 0;

fn _build_hm_names() {
    var v = vec_new();
    vec_push(v, str_from("Muharram"));
    vec_push(v, str_from("Safar"));
    vec_push(v, str_from("RabiAlAwwal"));
    vec_push(v, str_from("RabiAlThani"));
    vec_push(v, str_from("JumadaAlUla"));
    vec_push(v, str_from("JumadaAlThani"));
    vec_push(v, str_from("Rajab"));
    vec_push(v, str_from("Shaban"));
    vec_push(v, str_from("Ramadan"));
    vec_push(v, str_from("Shawwal"));
    vec_push(v, str_from("DhulQadah"));
    vec_push(v, str_from("DhulHijjah"));
    return v;
}

#must_use
fn hijri_month_name(i) {
    if (_hm_name_done == 0) { _hm_name_vec = _build_hm_names(); _hm_name_done = 1; }
    return vec_get(_hm_name_vec, i);
}

var _hm_disp_vec = 0;
var _hm_disp_done = 0;

fn _build_hm_disp() {
    var v = vec_new();
    vec_push(v, str_from("Muharram"));
    vec_push(v, str_from("Safar"));
    vec_push(v, str_from("Rabi al-Awwal"));
    vec_push(v, str_from("Rabi al-Thani"));
    vec_push(v, str_from("Jumada al-Ula"));
    vec_push(v, str_from("Jumada al-Thani"));
    vec_push(v, str_from("Rajab"));
    vec_push(v, str_from("Sha'ban"));
    vec_push(v, str_from("Ramadan"));
    vec_push(v, str_from("Shawwal"));
    vec_push(v, str_from("Dhul Qa'dah"));
    vec_push(v, str_from("Dhul Hijjah"));
    return v;
}

#must_use
fn hijri_month_display(i) {
    if (_hm_disp_done == 0) { _hm_disp_vec = _build_hm_disp(); _hm_disp_done = 1; }
    return vec_get(_hm_disp_vec, i);
}

# HijriMonth Display impl.
#must_use
fn hijri_month_to_str(m) {
    return hijri_month_display(m);
}

# ---------------------------------------------------------------------------
# HIJRI_MONTH_DAYS table [30,29,30,29,...] (lazy singleton)
# ---------------------------------------------------------------------------

var _hmd_arr = 0;
var _hmd_done = 0;

fn _build_hmd() {
    var a = alloc(12 * 8);
    store64(a + 0 * 8, 30);
    store64(a + 1 * 8, 29);
    store64(a + 2 * 8, 30);
    store64(a + 3 * 8, 29);
    store64(a + 4 * 8, 30);
    store64(a + 5 * 8, 29);
    store64(a + 6 * 8, 30);
    store64(a + 7 * 8, 29);
    store64(a + 8 * 8, 30);
    store64(a + 9 * 8, 29);
    store64(a + 10 * 8, 30);
    store64(a + 11 * 8, 29);
    return a;
}

#must_use
fn hijri_month_days(idx) {
    if (_hmd_done == 0) { _hmd_arr = _build_hmd(); _hmd_done = 1; }
    return load64(_hmd_arr + idx * 8);
}

# ---------------------------------------------------------------------------
# AlJabrSolution struct: form(0) roots(8) a(16) b(24) c(32) = 40 bytes
# ---------------------------------------------------------------------------

enum AljSolOff { AJS_FORM = 0; AJS_ROOTS = 8; AJS_A = 16; AJS_B = 24; AJS_C = 32; AJS_SIZE = 40; }

#must_use
fn aljabr_sol_new(form, roots, a, b, c) {
    var p = alloc(AJS_SIZE);
    store64(p + AJS_FORM, form);
    store64(p + AJS_ROOTS, roots);
    store64(p + AJS_A, a);
    store64(p + AJS_B, b);
    store64(p + AJS_C, c);
    return p;
}

#must_use
fn aljabr_sol_form(p) { return load64(p + AJS_FORM); }
#must_use
fn aljabr_sol_roots(p) { return load64(p + AJS_ROOTS); }
#must_use
fn aljabr_sol_a(p) { return load64(p + AJS_A); }
#must_use
fn aljabr_sol_b(p) { return load64(p + AJS_B); }
#must_use
fn aljabr_sol_c(p) { return load64(p + AJS_C); }

# ---------------------------------------------------------------------------
# KhayyamResult (the (KhayyamCubicType, Vec<f64>) tuple): type(0) roots(8)
# ---------------------------------------------------------------------------

enum KhResOff { KHR_TYPE = 0; KHR_ROOTS = 8; KHR_SIZE = 16; }

#must_use
fn khres_new(ctype, roots) {
    var p = alloc(KHR_SIZE);
    store64(p + KHR_TYPE, ctype);
    store64(p + KHR_ROOTS, roots);
    return p;
}

#must_use
fn khres_type(p) { return load64(p + KHR_TYPE); }
#must_use
fn khres_roots(p) { return load64(p + KHR_ROOTS); }

# ---------------------------------------------------------------------------
# CompleteSquare (the (x, area) tuple): x(0) area(8)
# ---------------------------------------------------------------------------

enum CsqOff { CSQ_X = 0; CSQ_AREA = 8; CSQ_SIZE = 16; }

#must_use
fn csq_new(x, area) {
    var p = alloc(CSQ_SIZE);
    store64(p + CSQ_X, x);
    store64(p + CSQ_AREA, area);
    return p;
}

#must_use
fn csq_x(p) { return load64(p + CSQ_X); }
#must_use
fn csq_area(p) { return load64(p + CSQ_AREA); }

# ---------------------------------------------------------------------------
# HijriDate struct: year(0) month(8) day(16) = 24 bytes
# ---------------------------------------------------------------------------

enum HijriDateOff { HD_YEAR = 0; HD_MONTH = 8; HD_DAY = 16; HD_SIZE = 24; }

#must_use
fn hijri_date_new(year, month, day) {
    var p = alloc(HD_SIZE);
    store64(p + HD_YEAR, year);
    store64(p + HD_MONTH, month);
    store64(p + HD_DAY, day);
    return p;
}

#must_use
fn hijri_date_year(p) { return load64(p + HD_YEAR); }
#must_use
fn hijri_date_month(p) { return load64(p + HD_MONTH); }
#must_use
fn hijri_date_day(p) { return load64(p + HD_DAY); }

# HijriDate Display impl: "{day} {month:?} {year} AH" (month via Debug identifier).
#must_use
fn hijri_date_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_int(sb, hijri_date_day(p));
    str_builder_add_cstr(sb, " ");
    str_builder_add(sb, hijri_month_name(hijri_date_month(p)));
    str_builder_add_cstr(sb, " ");
    str_builder_add_int(sb, hijri_date_year(p));
    str_builder_add_cstr(sb, " AH");
    return str_builder_build(sb);
}

# ---------------------------------------------------------------------------
# Al-Khwarizmi's al-Jabr: classify + solve a quadratic
# ---------------------------------------------------------------------------

#must_use
fn solve_al_jabr(a, b, c) {
    _islamic_debug("solving al-Jabr equation ax^2 + bx + c = 0");

    var aeps = f64_lt(f64_abs(a), ISLAMIC_F64_EPSILON);
    var beps = f64_lt(f64_abs(b), ISLAMIC_F64_EPSILON);
    var ceps = f64_lt(f64_abs(c), ISLAMIC_F64_EPSILON);

    if (aeps == 1 && beps == 1 && ceps == 1) {
        return sk_fail(SKE_COMPUTATION, str_from("all coefficients are zero"));
    }

    # Linear case: bx + c = 0
    if (aeps == 1) {
        if (beps == 1) {
            return sk_fail(SKE_COMPUTATION, str_from("degenerate equation: no variable terms"));
        }
        var lroot = f64_div(f64_neg(c), b);
        var lroots = vec_new();
        var lpos = f64_gt(lroot, f64_from(0));
        if (lpos == 1) { vec_push(lroots, lroot); }
        return Ok(aljabr_sol_new(ALJ_ROOTS_EQUAL_NUMBER, lroots, a, b, c));
    }

    # Quadratic case: normalize x^2 + p x + q = 0 with p = b/a, q = c/a
    var p = f64_div(b, a);
    var q = f64_div(c, a);

    var peps = f64_lt(f64_abs(p), ISLAMIC_F64_EPSILON);
    var qeps = f64_lt(f64_abs(q), ISLAMIC_F64_EPSILON);
    var ppos = f64_gt(p, f64_from(0));
    var qpos = f64_gt(q, f64_from(0));
    var pneg = f64_lt(p, f64_from(0));
    var qneg = f64_lt(q, f64_from(0));

    # Cascade mirroring the Rust if/else-if chain exactly.
    var form = ALJ_ROOTS_AND_NUMBER_EQUAL_SQUARES;
    if (peps == 1 && qeps == 1) {
        form = ALJ_SQUARES_EQUAL_ROOTS;
    } else {
        if (qeps == 1) {
            form = ALJ_SQUARES_EQUAL_ROOTS;
        } else {
            if (peps == 1) {
                form = ALJ_SQUARES_EQUAL_NUMBER;
            } else {
                if (ppos == 1 && qpos == 1) {
                    form = ALJ_SQUARES_AND_ROOTS_EQUAL_NUMBER;
                } else {
                    if (ppos == 1 && qneg == 1) {
                        form = ALJ_SQUARES_AND_ROOTS_EQUAL_NUMBER;
                    } else {
                        if (pneg == 1 && qpos == 1) {
                            form = ALJ_SQUARES_AND_NUMBER_EQUAL_ROOTS;
                        } else {
                            form = ALJ_ROOTS_AND_NUMBER_EQUAL_SQUARES;
                        }
                    }
                }
            }
        }
    }

    # Quadratic formula, keep positive roots (> EPSILON), dedup within EPSILON.
    var disc = f64_sub(f64_mul(b, b), f64_mul(f64_mul(f64_from(4), a), c));
    var roots = vec_new();
    var discnn = f64_ge(disc, f64_from(0));
    if (discnn == 1) {
        var sqrt_d = f64_sqrt(disc);
        var two_a = f64_mul(f64_from(2), a);
        var r1 = f64_div(f64_add(f64_neg(b), sqrt_d), two_a);
        var r2 = f64_div(f64_sub(f64_neg(b), sqrt_d), two_a);
        var r1pos = f64_gt(r1, ISLAMIC_F64_EPSILON);
        if (r1pos == 1) { vec_push(roots, r1); }
        var r2pos = f64_gt(r2, ISLAMIC_F64_EPSILON);
        var rdiff = f64_gt(f64_abs(f64_sub(r1, r2)), ISLAMIC_F64_EPSILON);
        if (r2pos == 1 && rdiff == 1) { vec_push(roots, r2); }
    }

    return Ok(aljabr_sol_new(form, roots, a, b, c));
}

# ---------------------------------------------------------------------------
# Al-Khwarizmi's completion of the square: x^2 + bx = c  (b, c > 0)
# ---------------------------------------------------------------------------

#must_use
fn complete_the_square(b, c) {
    var bbad = f64_le(b, f64_from(0));
    var cbad = f64_le(c, f64_from(0));
    if (bbad == 1 || cbad == 1) {
        return sk_fail(SKE_INVALID_BASE, str_from("al-Khwarizmi's completion requires positive b and c"));
    }
    var half_b = f64_div(b, f64_from(2));
    var completed_area = f64_add(c, f64_mul(half_b, half_b));
    var x = f64_sub(f64_sqrt(completed_area), half_b);
    return Ok(csq_new(x, completed_area));
}

# ---------------------------------------------------------------------------
# Omar Khayyam's cubic classification + numeric root solving (Newton)
# ---------------------------------------------------------------------------

# f(x) = a3*x*x*x + a2*x*x + a1*x + a0   (Rust left-assoc op order preserved)
fn _khayyam_f(a3, a2, a1, a0, x) {
    var t1 = f64_mul(f64_mul(f64_mul(a3, x), x), x);
    var t2 = f64_mul(f64_mul(a2, x), x);
    var t3 = f64_mul(a1, x);
    return f64_add(f64_add(f64_add(t1, t2), t3), a0);
}

# df(x) = 3*a3*x*x + 2*a2*x + a1
fn _khayyam_df(a3, a2, a1, x) {
    var d1 = f64_mul(f64_mul(f64_mul(f64_from(3), a3), x), x);
    var d2 = f64_mul(f64_mul(f64_from(2), a2), x);
    return f64_add(f64_add(d1, d2), a1);
}

# Ascending f64 comparator (partial_cmp with NaN → Equal); for vec_sort.
fn _f64_cmp_asc(u, w) {
    var lt = f64_lt(u, w);
    if (lt == 1) { return 0 - 1; }
    var gt = f64_gt(u, w);
    if (gt == 1) { return 1; }
    return 0;
}

#must_use
fn classify_khayyam_cubic(a3, a2, a1, a0) {
    var a3eps = f64_lt(f64_abs(a3), ISLAMIC_F64_EPSILON);
    if (a3eps == 1) {
        return sk_fail(SKE_COMPUTATION, str_from("leading coefficient is zero — not a cubic"));
    }

    # Normalize to monic: x^3 + c x^2 + b x + d = 0
    var c = f64_div(a2, a3);
    var b = f64_div(a1, a3);
    var d = f64_div(a0, a3);

    var ceps = f64_lt(f64_abs(c), ISLAMIC_F64_EPSILON);
    var beps = f64_lt(f64_abs(b), ISLAMIC_F64_EPSILON);
    var dneg = f64_lt(d, f64_from(0));
    var bneg = f64_lt(b, f64_from(0));

    var cubic_type = KCT_CUBE_THING_NUMBER_EQUAL_SQUARE;
    if (ceps == 1 && beps == 1) {
        cubic_type = KCT_CUBE_EQUAL_NUMBER;
    } else {
        if (ceps == 1 && dneg == 1) {
            cubic_type = KCT_CUBE_AND_THING_EQUAL_NUMBER;
        } else {
            if (beps == 1 && dneg == 1) {
                cubic_type = KCT_CUBE_AND_SQUARE_EQUAL_NUMBER;
            } else {
                if (ceps == 1 && bneg == 1) {
                    cubic_type = KCT_CUBE_EQUAL_THING_AND_NUMBER;
                } else {
                    cubic_type = KCT_CUBE_THING_NUMBER_EQUAL_SQUARE;
                }
            }
        }
    }

    # Newton's method from 7 seed points.
    var seeds = alloc(7 * 8);
    store64(seeds + 0 * 8, f64_from(0));
    store64(seeds + 1 * 8, f64_from(1));
    store64(seeds + 2 * 8, f64_neg(f64_from(1)));
    store64(seeds + 3 * 8, f64_from(10));
    store64(seeds + 4 * 8, f64_neg(f64_from(10)));
    store64(seeds + 5 * 8, f64_from(100));
    store64(seeds + 6 * 8, f64_neg(f64_from(100)));

    var roots = vec_new();
    var si = 0;
    while (si < 7) {
        var x = load64(seeds + si * 8);
        var conv = 0;
        var it = 0;
        while (it < 200) {
            var fx = _khayyam_f(a3, a2, a1, a0, x);
            var dfx = _khayyam_df(a3, a2, a1, x);
            var dfxsmall = f64_lt(f64_abs(dfx), ISLAMIC_F64_EPSILON);
            if (dfxsmall == 1) { break; }
            var x_new = f64_sub(x, f64_div(fx, dfx));
            var stepsmall = f64_lt(f64_abs(f64_sub(x_new, x)), ISLAMIC_STEP_TOL);
            if (stepsmall == 1) { conv = 1; x = x_new; break; }
            x = x_new;
            it = it + 1;
        }
        var fxfinal = _khayyam_f(a3, a2, a1, a0, x);
        var accept = f64_lt(f64_abs(fxfinal), ISLAMIC_ACCEPT_TOL);
        if (conv == 1 && accept == 1) {
            var isdup = 0;
            var ri = 0;
            var rn = vec_len(roots);
            while (ri < rn) {
                var rv = vec_get(roots, ri);
                var close = f64_lt(f64_abs(f64_sub(rv, x)), ISLAMIC_ACCEPT_TOL);
                if (close == 1) { isdup = 1; }
                ri = ri + 1;
            }
            if (isdup == 0) { vec_push(roots, x); }
        }
        si = si + 1;
    }

    var nroots = vec_len(roots);
    if (nroots == 0) {
        return sk_fail(SKE_COMPUTATION, str_from("Newton's method failed to find a real root"));
    }

    # Sort ascending for deterministic output.
    sk_vec_sort(roots, &_f64_cmp_asc);
    return Ok(khres_new(cubic_type, roots));
}

# ---------------------------------------------------------------------------
# Hijri (Islamic) tabular calendar
# ---------------------------------------------------------------------------

# Leap test in the 30-year cycle. rem_euclid is load-bearing for negative years.
#must_use
fn hijri_is_leap(year) {
    var y = rem_euclid(year, 30);
    if (y == 2) { return 1; }
    if (y == 5) { return 1; }
    if (y == 7) { return 1; }
    if (y == 10) { return 1; }
    if (y == 13) { return 1; }
    if (y == 16) { return 1; }
    if (y == 18) { return 1; }
    if (y == 21) { return 1; }
    if (y == 24) { return 1; }
    if (y == 26) { return 1; }
    if (y == 29) { return 1; }
    return 0;
}

# Days in a Hijri year (354 common, 355 leap).
#must_use
fn hijri_year_days(year) {
    var leap = hijri_is_leap(year);
    if (leap == 1) { return 355; }
    return 354;
}

# Position of a HijriMonth in the month order (== its value for 0..11).
#must_use
fn hijri_month_index(month) {
    if (month < 0) { return 0; }
    if (month >= 12) { return 0; }
    return month;
}

# Convert a Julian Day Number to a Hijri date (tabular calendar).
#must_use
fn jdn_to_hijri(jdn) {
    _islamic_trace("JDN to Hijri");
    var days_since_epoch = f64_to(f64_floor(f64_sub(jdn, HIJRI_EPOCH_JDN)));

    var cycles = div_euclid(days_since_epoch, HIJRI_30_YEAR_CYCLE_DAYS);
    var remaining = rem_euclid(days_since_epoch, HIJRI_30_YEAR_CYCLE_DAYS);

    var year = cycles * 30 + 1;

    # Count complete years within the cycle.
    while (1 == 1) {
        var yd = hijri_year_days(year);
        if (remaining < yd) { break; }
        remaining = remaining - yd;
        year = year + 1;
    }

    # Count complete months within the year.
    var month_idx = 0;
    while (1 == 1) {
        var md = hijri_month_days(month_idx);
        if (month_idx == 11 && hijri_is_leap(year) == 1) { md = 30; }
        if (remaining < md) { break; }
        remaining = remaining - md;
        month_idx = month_idx + 1;
        if (month_idx >= 12) { month_idx = 11; break; }
    }

    return hijri_date_new(year, month_idx, remaining + 1);
}

# Convert a Hijri date to a Julian Day Number (tabular calendar).
#must_use
fn hijri_to_jdn(date) {
    _islamic_trace("Hijri to JDN");
    var month = hijri_date_month(date);
    var year = hijri_date_year(date);
    var day = hijri_date_day(date);

    var month_idx = hijri_month_index(month);

    var max_day = hijri_month_days(month_idx);
    if (month_idx == 11 && hijri_is_leap(year) == 1) { max_day = 30; }

    if (day == 0 || day > max_day) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "day ");
        str_builder_add_int(sb, day);
        str_builder_add_cstr(sb, " out of range for ");
        str_builder_add(sb, hijri_month_name(month));
        str_builder_add_cstr(sb, " (max ");
        str_builder_add_int(sb, max_day);
        str_builder_add_cstr(sb, ")");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sb));
    }

    # Days from complete years.
    var days = 0;
    var y = 1;
    while (y < year) {
        days = days + hijri_year_days(y);
        y = y + 1;
    }

    # Days from complete months in this year.
    var m = 0;
    while (m < month_idx) {
        var md2 = hijri_month_days(m);
        if (m == 11 && hijri_is_leap(year) == 1) { md2 = 30; }
        days = days + md2;
        m = m + 1;
    }

    # Days within the month.
    days = days + (day - 1);

    return Ok(f64_add(HIJRI_EPOCH_JDN, f64_from(days)));
}

# --- astro.cyr ---

# astro.cyr — archaeoastronomy computations (ported from rust-old/src/astro.rs).
#
# Coordinate systems (equatorial / ecliptic / horizontal) with pairwise
# conversions; mean obliquity of the ecliptic (IAU / Lieske 1977); approximate
# solar longitude / declination (Meeus ch.25); sidereal-time helpers; a 20-star
# catalog of archaeologically significant bright stars at J2000.0 (Hipparcos);
# IAU precession of equatorial coordinates (Lieske 1977, Meeus ch.21); heliacal
# rising search via the arcus-visionis model (Schaefer 1987); monument-alignment
# analysis against solstice/equinox sunrise-sunset and star-rising azimuths.
#
# SELF-CONTAINED: no include lines (the distlib bundler strips them; stdlib +
# ganita + sakshi are resolved from the consumer's [deps]). J2000_JDN and
# JULIAN_YEAR_DAYS live in f64_util (in Rust astro imported them from epoch).
#
# f64 note: every non-integer constant is parsed ONCE (f64_parse) into a global
# by astro_init(), which every public entry point calls (guarded, idempotent).
# Whole-number constants use f64_from directly. Angle wrapping uses f64_fmod
# (floor-based), which reproduces Rust's `((x % turn) + turn) % turn` result.

# ---------------------------------------------------------------------------
# Enums
# ---------------------------------------------------------------------------

# StarName — discriminant order IS the STAR_CATALOG index (0=Sirius..19=Dubhe).
enum StarName {
    SN_SIRIUS = 0;
    SN_CANOPUS = 1;
    SN_VEGA = 2;
    SN_ARCTURUS = 3;
    SN_RIGEL = 4;
    SN_PROCYON = 5;
    SN_BETELGEUSE = 6;
    SN_ALDEBARAN = 7;
    SN_ANTARES = 8;
    SN_SPICA = 9;
    SN_POLLUX = 10;
    SN_FOMALHAUT = 11;
    SN_DENEB = 12;
    SN_REGULUS = 13;
    SN_POLARIS = 14;
    SN_THUBAN = 15;
    SN_KOCHAB = 16;
    SN_PLEIADES = 17;
    SN_ALCYONE = 18;
    SN_DUBHE = 19;
}

enum HeliacalEventType {
    HET_RISING = 0;
    HET_SETTING = 1;
}

# AlignmentTarget — the 6 fieldless variants plus StarRising(StarName). The
# data-carrying StarRising is represented by AT_STAR_RISING plus the star code
# stored alongside in AlignmentResult (AR_STAR).
enum AlignmentTarget {
    AT_SUMMER_SOLSTICE_SUNRISE = 0;
    AT_SUMMER_SOLSTICE_SUNSET = 1;
    AT_WINTER_SOLSTICE_SUNRISE = 2;
    AT_WINTER_SOLSTICE_SUNSET = 3;
    AT_EQUINOX_SUNRISE = 4;
    AT_EQUINOX_SUNSET = 5;
    AT_STAR_RISING = 6;
}

# ---------------------------------------------------------------------------
# Struct offsets + constructors + getters
# ---------------------------------------------------------------------------

# CelestialCoord { ra_hours: f64, dec_degrees: f64 }
enum CcOff { CC_RA = 0; CC_DEC = 8; CC_SIZE = 16; }
#must_use
fn celestial_new(ra_hours, dec_degrees) {
    var p = alloc(CC_SIZE);
    store64(p + CC_RA, ra_hours);
    store64(p + CC_DEC, dec_degrees);
    return p;
}
#must_use
fn cc_ra_hours(p) { return load64(p + CC_RA); }
#must_use
fn cc_dec_degrees(p) { return load64(p + CC_DEC); }

# EclipticCoord { longitude: f64, latitude: f64 }
enum EcOff { EC_LON = 0; EC_LAT = 8; EC_SIZE = 16; }
#must_use
fn ecliptic_new(longitude, latitude) {
    var p = alloc(EC_SIZE);
    store64(p + EC_LON, longitude);
    store64(p + EC_LAT, latitude);
    return p;
}
#must_use
fn ec_longitude(p) { return load64(p + EC_LON); }
#must_use
fn ec_latitude(p) { return load64(p + EC_LAT); }

# HorizontalCoord { azimuth: f64, altitude: f64 }
enum HcOff { HC_AZ = 0; HC_ALT = 8; HC_SIZE = 16; }
#must_use
fn horizontal_new(azimuth, altitude) {
    var p = alloc(HC_SIZE);
    store64(p + HC_AZ, azimuth);
    store64(p + HC_ALT, altitude);
    return p;
}
#must_use
fn hc_azimuth(p) { return load64(p + HC_AZ); }
#must_use
fn hc_altitude(p) { return load64(p + HC_ALT); }

# Star { name: Str, bayer: Str, constellation: Str, ra_j2000: f64,
#        dec_j2000: f64, visual_magnitude: f64 }
enum StOff { ST_NAME = 0; ST_BAYER = 8; ST_CONST = 16; ST_RA = 24; ST_DEC = 32; ST_MAG = 40; ST_SIZE = 48; }
#must_use
fn star_rec_new(name, bayer, constellation, ra_j2000, dec_j2000, visual_magnitude) {
    var p = alloc(ST_SIZE);
    store64(p + ST_NAME, name);
    store64(p + ST_BAYER, bayer);
    store64(p + ST_CONST, constellation);
    store64(p + ST_RA, ra_j2000);
    store64(p + ST_DEC, dec_j2000);
    store64(p + ST_MAG, visual_magnitude);
    return p;
}
#must_use
fn star_name(p) { return load64(p + ST_NAME); }
#must_use
fn star_bayer(p) { return load64(p + ST_BAYER); }
#must_use
fn star_constellation(p) { return load64(p + ST_CONST); }
#must_use
fn star_ra_j2000(p) { return load64(p + ST_RA); }
#must_use
fn star_dec_j2000(p) { return load64(p + ST_DEC); }
#must_use
fn star_visual_magnitude(p) { return load64(p + ST_MAG); }

# HeliacalEvent { jdn: f64, star: StarName, event_type: HeliacalEventType }
enum HeOff { HE_JDN = 0; HE_STAR = 8; HE_TYPE = 16; HE_SIZE = 24; }
#must_use
fn heliacal_event_new(jdn, star, event_type) {
    var p = alloc(HE_SIZE);
    store64(p + HE_JDN, jdn);
    store64(p + HE_STAR, star);
    store64(p + HE_TYPE, event_type);
    return p;
}
#must_use
fn he_jdn(p) { return load64(p + HE_JDN); }
#must_use
fn he_star(p) { return load64(p + HE_STAR); }
#must_use
fn he_event_type(p) { return load64(p + HE_TYPE); }

# AlignmentResult { target: AlignmentTarget, star: StarName (or -1), azimuth: f64,
#                   deviation: f64 }
enum ArOff { AR_TARGET = 0; AR_STAR = 8; AR_AZ = 16; AR_DEV = 24; AR_SIZE = 32; }
#must_use
fn alignment_result_new(target, star, azimuth, deviation) {
    var p = alloc(AR_SIZE);
    store64(p + AR_TARGET, target);
    store64(p + AR_STAR, star);
    store64(p + AR_AZ, azimuth);
    store64(p + AR_DEV, deviation);
    return p;
}
#must_use
fn ar_target(p) { return load64(p + AR_TARGET); }
#must_use
fn ar_star(p) { return load64(p + AR_STAR); }
#must_use
fn ar_azimuth(p) { return load64(p + AR_AZ); }
#must_use
fn ar_deviation(p) { return load64(p + AR_DEV); }

# ---------------------------------------------------------------------------
# Parsed constant globals (all set once by astro_init; 0 = not yet built)
# ---------------------------------------------------------------------------

var astro_init_done = 0;
var astro_star_vec = 0;
var astro_align_stars = 0;
var astro_starname_names = 0;
var astro_heltype_names = 0;
var astro_target_names = 0;

# Obliquity IAU/Lieske 1977 cubic (degrees)
var OBL_A = 0;   # 23.4392911
var OBL_B = 0;   # 0.0130042
var OBL_C = 0;   # 1.64e-7
var OBL_D = 0;   # 5.04e-7

# Solar position (Meeus ch.25)
var SL_L0A = 0;  # 280.46646
var SL_L0B = 0;  # 36000.76983
var SL_MA = 0;   # 357.52811
var SL_MB = 0;   # 35999.05029
var SL_C1 = 0;   # 1.914602
var SL_C2 = 0;   # 0.019993

# Greenwich Mean Sidereal Time (Meeus ch.12)
var GMST_A = 0;  # 280.46061837
var GMST_B = 0;  # 360.98564736629
var GMST_C = 0;  # 0.000387933

# Precession Lieske 1977 (degrees/century coefficients)
var PR_A = 0;    # 0.6406161
var PR_B = 0;    # 0.0000839
var PR_C = 0;    # 0.0000050
var PR_D = 0;    # 0.0000830
var PR_E = 0;    # 0.0003041
var PR_F = 0;    # 0.0000051
var PR_G = 0;    # 0.0000073
var PR_H = 0;    # 0.5567530
var PR_I = 0;    # 0.0001185
var PR_J = 0;    # 0.0000116
var PR_K = 0;    # 0.0001162

var AV_K = 0;       # arcus visionis slope 1.7
var SOL_DEC = 0;    # solstice declination 23.44
var HORIZ_TOL = 0;  # 1e-10 azimuth-branch guard

fn build_star_catalog() {
    var v = vec_new();
    vec_push(v, star_rec_new(str_from("Sirius"),     str_from("α CMa"), str_from("Canis Major"),      f64_parse("6.752"),  f64_parse("-16.716"), f64_parse("-1.46")));
    vec_push(v, star_rec_new(str_from("Canopus"),    str_from("α Car"), str_from("Carina"),           f64_parse("6.399"),  f64_parse("-52.696"), f64_parse("-0.74")));
    vec_push(v, star_rec_new(str_from("Vega"),       str_from("α Lyr"), str_from("Lyra"),             f64_parse("18.616"), f64_parse("38.784"),  f64_parse("0.03")));
    vec_push(v, star_rec_new(str_from("Arcturus"),   str_from("α Boo"), str_from("Boötes"),           f64_parse("14.261"), f64_parse("19.182"),  f64_parse("-0.05")));
    vec_push(v, star_rec_new(str_from("Rigel"),      str_from("β Ori"), str_from("Orion"),            f64_parse("5.242"),  f64_parse("-8.202"),  f64_parse("0.13")));
    vec_push(v, star_rec_new(str_from("Procyon"),    str_from("α CMi"), str_from("Canis Minor"),      f64_parse("7.655"),  f64_parse("5.225"),   f64_parse("0.34")));
    vec_push(v, star_rec_new(str_from("Betelgeuse"), str_from("α Ori"), str_from("Orion"),            f64_parse("5.919"),  f64_parse("7.407"),   f64_parse("0.42")));
    vec_push(v, star_rec_new(str_from("Aldebaran"),  str_from("α Tau"), str_from("Taurus"),           f64_parse("4.599"),  f64_parse("16.509"),  f64_parse("0.86")));
    vec_push(v, star_rec_new(str_from("Antares"),    str_from("α Sco"), str_from("Scorpius"),         f64_parse("16.490"), f64_parse("-26.432"), f64_parse("0.96")));
    vec_push(v, star_rec_new(str_from("Spica"),      str_from("α Vir"), str_from("Virgo"),            f64_parse("13.420"), f64_parse("-11.161"), f64_parse("0.97")));
    vec_push(v, star_rec_new(str_from("Pollux"),     str_from("β Gem"), str_from("Gemini"),           f64_parse("7.755"),  f64_parse("28.026"),  f64_parse("1.14")));
    vec_push(v, star_rec_new(str_from("Fomalhaut"),  str_from("α PsA"), str_from("Piscis Austrinus"), f64_parse("22.961"), f64_parse("-29.622"), f64_parse("1.16")));
    vec_push(v, star_rec_new(str_from("Deneb"),      str_from("α Cyg"), str_from("Cygnus"),           f64_parse("20.690"), f64_parse("45.280"),  f64_parse("1.25")));
    vec_push(v, star_rec_new(str_from("Regulus"),    str_from("α Leo"), str_from("Leo"),              f64_parse("10.139"), f64_parse("11.967"),  f64_parse("1.40")));
    vec_push(v, star_rec_new(str_from("Polaris"),    str_from("α UMi"), str_from("Ursa Minor"),       f64_parse("2.530"),  f64_parse("89.264"),  f64_parse("1.98")));
    vec_push(v, star_rec_new(str_from("Thuban"),     str_from("α Dra"), str_from("Draco"),            f64_parse("14.073"), f64_parse("64.376"),  f64_parse("3.65")));
    vec_push(v, star_rec_new(str_from("Kochab"),     str_from("β UMi"), str_from("Ursa Minor"),       f64_parse("14.845"), f64_parse("74.156"),  f64_parse("2.08")));
    vec_push(v, star_rec_new(str_from("Pleiades"),   str_from("M45"),   str_from("Taurus"),           f64_parse("3.787"),  f64_parse("24.105"),  f64_parse("1.60")));
    vec_push(v, star_rec_new(str_from("Alcyone"),    str_from("η Tau"), str_from("Taurus"),           f64_parse("3.791"),  f64_parse("24.105"),  f64_parse("2.87")));
    vec_push(v, star_rec_new(str_from("Dubhe"),      str_from("α UMa"), str_from("Ursa Major"),       f64_parse("11.062"), f64_parse("61.751"),  f64_parse("1.79")));
    return v;
}

fn build_align_stars() {
    var v = vec_new();
    vec_push(v, SN_SIRIUS);
    vec_push(v, SN_VEGA);
    vec_push(v, SN_ALDEBARAN);
    vec_push(v, SN_ANTARES);
    vec_push(v, SN_REGULUS);
    vec_push(v, SN_SPICA);
    vec_push(v, SN_PLEIADES);
    vec_push(v, SN_THUBAN);
    vec_push(v, SN_POLARIS);
    return v;
}

fn build_starname_names() {
    var v = vec_new();
    vec_push(v, str_from("Sirius"));    vec_push(v, str_from("Canopus"));
    vec_push(v, str_from("Vega"));      vec_push(v, str_from("Arcturus"));
    vec_push(v, str_from("Rigel"));     vec_push(v, str_from("Procyon"));
    vec_push(v, str_from("Betelgeuse"));vec_push(v, str_from("Aldebaran"));
    vec_push(v, str_from("Antares"));   vec_push(v, str_from("Spica"));
    vec_push(v, str_from("Pollux"));    vec_push(v, str_from("Fomalhaut"));
    vec_push(v, str_from("Deneb"));     vec_push(v, str_from("Regulus"));
    vec_push(v, str_from("Polaris"));   vec_push(v, str_from("Thuban"));
    vec_push(v, str_from("Kochab"));    vec_push(v, str_from("Pleiades"));
    vec_push(v, str_from("Alcyone"));   vec_push(v, str_from("Dubhe"));
    return v;
}

fn build_heltype_names() {
    var v = vec_new();
    vec_push(v, str_from("Rising"));
    vec_push(v, str_from("Setting"));
    return v;
}

fn build_target_names() {
    var v = vec_new();
    vec_push(v, str_from("SummerSolsticeSunrise"));
    vec_push(v, str_from("SummerSolsticeSunset"));
    vec_push(v, str_from("WinterSolsticeSunrise"));
    vec_push(v, str_from("WinterSolsticeSunset"));
    vec_push(v, str_from("EquinoxSunrise"));
    vec_push(v, str_from("EquinoxSunset"));
    vec_push(v, str_from("StarRising"));
    return v;
}

# Idempotent lazy init: parse all constants and build all tables. Called at the
# top of every public entry point that reads a parsed constant or the catalog.
fn astro_init() {
    if (astro_init_done == 1) { return 0; }
    OBL_A = f64_parse("23.4392911");
    OBL_B = f64_parse("0.0130042");
    OBL_C = f64_parse("0.000000164");
    OBL_D = f64_parse("0.000000504");

    SL_L0A = f64_parse("280.46646");
    SL_L0B = f64_parse("36000.76983");
    SL_MA = f64_parse("357.52811");
    SL_MB = f64_parse("35999.05029");
    SL_C1 = f64_parse("1.914602");
    SL_C2 = f64_parse("0.019993");

    GMST_A = f64_parse("280.46061837");
    GMST_B = f64_parse("360.98564736629");
    GMST_C = f64_parse("0.000387933");

    PR_A = f64_parse("0.6406161");
    PR_B = f64_parse("0.0000839");
    PR_C = f64_parse("0.0000050");
    PR_D = f64_parse("0.0000830");
    PR_E = f64_parse("0.0003041");
    PR_F = f64_parse("0.0000051");
    PR_G = f64_parse("0.0000073");
    PR_H = f64_parse("0.5567530");
    PR_I = f64_parse("0.0001185");
    PR_J = f64_parse("0.0000116");
    PR_K = f64_parse("0.0001162");

    AV_K = f64_parse("1.7");
    SOL_DEC = f64_parse("23.44");
    HORIZ_TOL = f64_parse("0.0000000001");

    astro_star_vec = build_star_catalog();
    astro_align_stars = build_align_stars();
    astro_starname_names = build_starname_names();
    astro_heltype_names = build_heltype_names();
    astro_target_names = build_target_names();
    astro_init_done = 1;
    return 0;
}

# ---------------------------------------------------------------------------
# Angle conversion helpers
# ---------------------------------------------------------------------------

#must_use
fn degrees_to_radians(deg) {
    return f64_div(f64_mul(deg, F64_PI), f64_from(180));
}
#must_use
fn radians_to_degrees(rad) {
    return f64_div(f64_mul(rad, f64_from(180)), F64_PI);
}
#must_use
fn hours_to_degrees(hours) {
    return f64_mul(hours, f64_from(15));
}
#must_use
fn degrees_to_hours(deg) {
    return f64_div(deg, f64_from(15));
}

# ---------------------------------------------------------------------------
# Obliquity of the ecliptic
# ---------------------------------------------------------------------------

#must_use
fn obliquity_of_ecliptic(jdn) {
    astro_init();
    var t = f64_div(f64_sub(jdn, J2000_JDN), f64_from(36525));
    var tt = f64_mul(t, t);
    var ttt = f64_mul(tt, t);
    var r = f64_sub(OBL_A, f64_mul(OBL_B, t));
    r = f64_sub(r, f64_mul(OBL_C, tt));
    r = f64_add(r, f64_mul(OBL_D, ttt));
    return r;
}

# ---------------------------------------------------------------------------
# Coordinate conversions
# ---------------------------------------------------------------------------

#must_use
fn equatorial_to_ecliptic(coord, jdn) {
    astro_init();
    var eps = degrees_to_radians(obliquity_of_ecliptic(jdn));
    var ra = degrees_to_radians(hours_to_degrees(load64(coord + CC_RA)));
    var dec = degrees_to_radians(load64(coord + CC_DEC));

    var sin_lon = f64_add(f64_mul(f64_sin(ra), f64_cos(eps)), f64_mul(f64_tan(dec), f64_sin(eps)));
    var cos_lon = f64_cos(ra);
    var lon = radians_to_degrees(f64_atan2(sin_lon, cos_lon));
    if (f64_lt(lon, f64_from(0)) == 1) { lon = f64_add(lon, f64_from(360)); }

    var sin_lat = f64_sub(f64_mul(f64_sin(dec), f64_cos(eps)), f64_mul(f64_mul(f64_cos(dec), f64_sin(eps)), f64_sin(ra)));
    var lat = radians_to_degrees(f64_asin(sin_lat));
    return ecliptic_new(lon, lat);
}

#must_use
fn ecliptic_to_equatorial(coord, jdn) {
    astro_init();
    var eps = degrees_to_radians(obliquity_of_ecliptic(jdn));
    var lon = degrees_to_radians(load64(coord + EC_LON));
    var lat = degrees_to_radians(load64(coord + EC_LAT));

    var sin_ra = f64_sub(f64_mul(f64_sin(lon), f64_cos(eps)), f64_mul(f64_tan(lat), f64_sin(eps)));
    var cos_ra = f64_cos(lon);
    var ra_deg = radians_to_degrees(f64_atan2(sin_ra, cos_ra));
    if (f64_lt(ra_deg, f64_from(0)) == 1) { ra_deg = f64_add(ra_deg, f64_from(360)); }

    var sin_dec = f64_add(f64_mul(f64_sin(lat), f64_cos(eps)), f64_mul(f64_mul(f64_cos(lat), f64_sin(eps)), f64_sin(lon)));
    var dec = radians_to_degrees(f64_asin(sin_dec));
    return celestial_new(degrees_to_hours(ra_deg), dec);
}

#must_use
fn equatorial_to_horizontal(coord, jdn, observer_lat, observer_lon) {
    astro_init();
    var lat = degrees_to_radians(observer_lat);
    var dec = degrees_to_radians(load64(coord + CC_DEC));

    var lst = local_sidereal_time(jdn, observer_lon);
    var ha = degrees_to_radians(f64_sub(f64_mul(lst, f64_from(15)), hours_to_degrees(load64(coord + CC_RA))));

    var sin_alt = f64_add(f64_mul(f64_sin(dec), f64_sin(lat)), f64_mul(f64_mul(f64_cos(dec), f64_cos(lat)), f64_cos(ha)));
    var alt = radians_to_degrees(f64_asin(sin_alt));

    var cos_az_num = f64_sub(f64_sin(dec), f64_mul(sin_alt, f64_sin(lat)));
    var cos_az_den = f64_mul(f64_sin(f64_acos(sin_alt)), f64_cos(lat));
    var neg_num = f64_neg(f64_mul(f64_cos(dec), f64_sin(ha)));
    var az = radians_to_degrees(f64_atan2(neg_num, cos_az_num));
    var den_abs = f64_abs(cos_az_den);
    if (f64_gt(den_abs, HORIZ_TOL) == 1) {
        az = radians_to_degrees(f64_atan2(neg_num, f64_div(cos_az_num, den_abs)));
    }
    if (f64_lt(az, f64_from(0)) == 1) { az = f64_add(az, f64_from(360)); }
    return horizontal_new(az, alt);
}

# Approximate Greenwich Mean Sidereal Time in hours (Meeus ch.12).
#must_use
fn greenwich_sidereal_time(jdn) {
    astro_init();
    var d = f64_sub(jdn, J2000_JDN);
    var t = f64_div(d, f64_from(36525));
    var tt = f64_mul(t, t);
    var ttt = f64_mul(tt, t);
    var gmst = f64_add(GMST_A, f64_mul(GMST_B, d));
    gmst = f64_add(gmst, f64_mul(GMST_C, tt));
    gmst = f64_sub(gmst, f64_div(ttt, f64_from(38710000)));
    var m1 = f64_fmod(gmst, f64_from(360));
    var m2 = f64_fmod(f64_add(m1, f64_from(360)), f64_from(360));
    return f64_div(m2, f64_from(15));
}

# Local Sidereal Time in hours.
#must_use
fn local_sidereal_time(jdn, observer_lon) {
    var gmst = greenwich_sidereal_time(jdn);
    var lst = f64_add(gmst, f64_div(observer_lon, f64_from(15)));
    var m1 = f64_fmod(lst, f64_from(24));
    return f64_fmod(f64_add(m1, f64_from(24)), f64_from(24));
}

# ---------------------------------------------------------------------------
# Approximate solar position
# ---------------------------------------------------------------------------

#must_use
fn solar_longitude(jdn) {
    astro_init();
    var t = f64_div(f64_sub(jdn, J2000_JDN), f64_from(36525));
    var l0 = f64_add(SL_L0A, f64_mul(SL_L0B, t));
    var m = degrees_to_radians(f64_add(SL_MA, f64_mul(SL_MB, t)));
    var c = f64_add(f64_mul(SL_C1, f64_sin(m)), f64_mul(SL_C2, f64_sin(f64_mul(f64_from(2), m))));
    var lon = f64_add(l0, c);
    var m1 = f64_fmod(lon, f64_from(360));
    return f64_fmod(f64_add(m1, f64_from(360)), f64_from(360));
}

#must_use
fn solar_declination(jdn) {
    astro_init();
    var lon = degrees_to_radians(solar_longitude(jdn));
    var eps = degrees_to_radians(obliquity_of_ecliptic(jdn));
    return radians_to_degrees(f64_asin(f64_mul(f64_sin(eps), f64_sin(lon))));
}

# ---------------------------------------------------------------------------
# Star catalog
# ---------------------------------------------------------------------------

#must_use
fn star_catalog() {
    astro_init();
    return astro_star_vec;
}
#must_use
fn star_catalog_len() {
    return vec_len(star_catalog());
}
#must_use
fn star(name) {
    astro_init();
    return vec_get(astro_star_vec, name);
}
#must_use
fn star_j2000(name) {
    var s = star(name);
    return celestial_new(load64(s + ST_RA), load64(s + ST_DEC));
}

# ---------------------------------------------------------------------------
# Precession
# ---------------------------------------------------------------------------

#must_use
fn precess_coordinates(coord, from_jdn, to_jdn) {
    astro_init();
    sakshi_debug("precessing coordinates", strlen("precessing coordinates"));
    var t = f64_div(f64_sub(from_jdn, J2000_JDN), f64_from(36525));
    var dt = f64_div(f64_sub(to_jdn, from_jdn), f64_from(36525));
    var tt = f64_mul(t, t);
    var dtdt = f64_mul(dt, dt);
    var dtdtdt = f64_mul(dtdt, dt);

    # zeta_a and z_a share the first bracket b1.
    var b1 = f64_add(f64_add(PR_A, f64_mul(PR_B, t)), f64_mul(PR_C, tt));
    var zeta_a = f64_add(f64_add(f64_mul(b1, dt), f64_mul(f64_add(PR_D, f64_mul(PR_C, t)), dtdt)), f64_mul(PR_C, dtdtdt));
    var z_a = f64_add(f64_add(f64_mul(b1, dt), f64_mul(f64_add(PR_E, f64_mul(PR_F, t)), dtdt)), f64_mul(PR_G, dtdtdt));
    var tb1 = f64_sub(f64_sub(PR_H, f64_mul(PR_I, t)), f64_mul(PR_J, tt));
    var theta_a = f64_sub(f64_sub(f64_mul(tb1, dt), f64_mul(f64_add(PR_K, f64_mul(PR_J, t)), dtdt)), f64_mul(PR_J, dtdtdt));

    var zeta = degrees_to_radians(zeta_a);
    var z = degrees_to_radians(z_a);
    var theta = degrees_to_radians(theta_a);

    var ra0 = degrees_to_radians(hours_to_degrees(load64(coord + CC_RA)));
    var dec0 = degrees_to_radians(load64(coord + CC_DEC));
    var ra0z = f64_add(ra0, zeta);

    var ra_a = f64_mul(f64_cos(dec0), f64_sin(ra0z));
    var ra_b = f64_sub(f64_mul(f64_mul(f64_cos(theta), f64_cos(dec0)), f64_cos(ra0z)), f64_mul(f64_sin(theta), f64_sin(dec0)));
    var ra_c = f64_add(f64_mul(f64_mul(f64_sin(theta), f64_cos(dec0)), f64_cos(ra0z)), f64_mul(f64_cos(theta), f64_sin(dec0)));

    var ra_new = f64_add(f64_atan2(ra_a, ra_b), z);
    var dec_new = f64_asin(ra_c);

    ra_new = radians_to_degrees(ra_new);
    if (f64_lt(ra_new, f64_from(0)) == 1) { ra_new = f64_add(ra_new, f64_from(360)); }
    ra_new = f64_fmod(ra_new, f64_from(360));

    return celestial_new(degrees_to_hours(ra_new), radians_to_degrees(dec_new));
}

#must_use
fn star_position_at(name, jdn) {
    var j2000 = star_j2000(name);
    return precess_coordinates(j2000, J2000_JDN, jdn);
}

# ---------------------------------------------------------------------------
# Heliacal rising
# ---------------------------------------------------------------------------

# Arcus visionis (minimum solar depression angle), degrees. Schoch/Purrington.
#must_use
fn arcus_visionis(visual_magnitude) {
    astro_init();
    return f64_add(f64_from(11), f64_mul(AV_K, visual_magnitude));
}

# Find the next heliacal rising after jdn_start. Returns Result:
#   Ok(HeliacalEvent) or Err(SkErr{SKE_COMPUTATION, msg}).
fn heliacal_rising(name, jdn_start, observer_lat, _observer_lon) {
    astro_init();
    var s = star(name);
    sakshi_debug("computing heliacal rising", strlen("computing heliacal rising"));
    var min_depression = arcus_visionis(load64(s + ST_MAG));

    var day_offset = 0;
    while (day_offset < 400) {
        var jdn = f64_add(jdn_start, f64_from(day_offset));
        var star_coord = star_position_at(name, jdn);

        var max_dec = f64_neg(f64_sub(f64_from(90), f64_abs(observer_lat)));
        var lat_ge0 = f64_ge(observer_lat, f64_from(0));
        var dec_lt = f64_lt(load64(star_coord + CC_DEC), max_dec);
        if (lat_ge0 == 1 && dec_lt == 1) {
            # Star never rises at this latitude on this date — skip.
            day_offset = day_offset + 1;
        } else {
            var sun_lon = solar_longitude(jdn);
            var star_ecl = equatorial_to_ecliptic(star_coord, jdn);

            var sep = f64_sub(load64(star_ecl + EC_LON), sun_lon);
            if (f64_lt(sep, f64_from(0)) == 1) { sep = f64_add(sep, f64_from(360)); }
            if (f64_gt(sep, f64_from(180)) == 1) { sep = f64_sub(f64_from(360), sep); }

            var cond1 = f64_gt(sep, min_depression);
            var cond2 = f64_lt(sep, f64_add(min_depression, f64_from(20)));
            if (cond1 == 1 && cond2 == 1) {
                var star_minus_sun = f64_sub(load64(star_ecl + EC_LON), sun_lon);
                var nm1 = f64_fmod(star_minus_sun, f64_from(360));
                var normalized = f64_fmod(f64_add(nm1, f64_from(360)), f64_from(360));
                if (f64_lt(normalized, f64_from(180)) == 1) {
                    return Ok(heliacal_event_new(jdn, name, HET_RISING));
                }
            }
            day_offset = day_offset + 1;
        }
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "no heliacal rising found for ");
    str_builder_add(sb, star_name(s));
    str_builder_add_cstr(sb, " within 400 days of JDN ");
    str_builder_add_int(sb, f64_to(jdn_start));
    return sk_fail(SKE_COMPUTATION, str_builder_build(sb));
}

# ---------------------------------------------------------------------------
# Monument alignment
# ---------------------------------------------------------------------------

# Azimuth (degrees from north) of solstice sunrise for a latitude. summer: 1/0.
#must_use
fn solstice_sunrise_azimuth(observer_lat, summer) {
    astro_init();
    var lat = degrees_to_radians(observer_lat);
    var decv = degrees_to_radians(SOL_DEC);
    if (summer == 0) { decv = degrees_to_radians(f64_neg(SOL_DEC)); }
    var cos_az = f64_div(f64_sin(decv), f64_cos(lat));
    return radians_to_degrees(f64_acos(cos_az));
}

# Azimuth where a star rises. Returns Result: Ok(f64 azimuth) or Err.
fn star_rise_azimuth(name, observer_lat, jdn) {
    astro_init();
    var coord = star_position_at(name, jdn);
    var lat = degrees_to_radians(observer_lat);
    var dec = degrees_to_radians(load64(coord + CC_DEC));

    var cos_az = f64_div(f64_sin(dec), f64_cos(lat));
    var cos_abs = f64_abs(cos_az);
    if (f64_gt(cos_abs, f64_from(1)) == 1) {
        var sb = str_builder_new();
        str_builder_add(sb, star_name(star(name)));
        str_builder_add_cstr(sb, " does not rise at latitude ");
        sb_add_f64(sb, observer_lat, 1);
        str_builder_add_cstr(sb, "°");
        return sk_fail(SKE_COMPUTATION, str_builder_build(sb));
    }
    return Ok(radians_to_degrees(f64_acos(cos_az)));
}

# Internal: check one solstice/equinox target and push if within tolerance.
fn _ma_check(results, azimuth, target, star, target_az, tolerance) {
    var dev = angle_deviation(azimuth, target_az);
    if (f64_le(dev, tolerance) == 1) {
        vec_push(results, alignment_result_new(target, star, target_az, dev));
    }
    return 0;
}

# Analyze which celestial targets align with a monument's bearing.
#must_use
fn monument_alignment(observer_lat, azimuth, jdn, tolerance_degrees) {
    astro_init();
    sakshi_info("analyzing monument alignment", strlen("analyzing monument alignment"));
    var results = vec_new();
    var no_star = 0 - 1;

    var summer_az = solstice_sunrise_azimuth(observer_lat, 1);
    var winter_az = solstice_sunrise_azimuth(observer_lat, 0);

    _ma_check(results, azimuth, AT_SUMMER_SOLSTICE_SUNRISE, no_star, summer_az, tolerance_degrees);
    _ma_check(results, azimuth, AT_SUMMER_SOLSTICE_SUNSET, no_star, f64_sub(f64_from(360), summer_az), tolerance_degrees);
    _ma_check(results, azimuth, AT_WINTER_SOLSTICE_SUNRISE, no_star, winter_az, tolerance_degrees);
    _ma_check(results, azimuth, AT_WINTER_SOLSTICE_SUNSET, no_star, f64_sub(f64_from(360), winter_az), tolerance_degrees);
    _ma_check(results, azimuth, AT_EQUINOX_SUNRISE, no_star, f64_from(90), tolerance_degrees);
    _ma_check(results, azimuth, AT_EQUINOX_SUNSET, no_star, f64_from(270), tolerance_degrees);

    var n = vec_len(astro_align_stars);
    var si = 0;
    while (si < n) {
        var sn = vec_get(astro_align_stars, si);
        var r_t, r_v = star_rise_azimuth(sn, observer_lat, jdn);
        if (is_ok(r_t) == 1) {
            var star_az = result_unwrap(r_t, r_v);
            var dev = angle_deviation(azimuth, star_az);
            if (f64_le(dev, tolerance_degrees) == 1) {
                vec_push(results, alignment_result_new(AT_STAR_RISING, sn, star_az, dev));
            }
        }
        si = si + 1;
    }
    return results;
}

# Angular deviation between two azimuths, accounting for wrap-around.
#must_use
fn angle_deviation(a, b) {
    var diff = f64_fmod(f64_abs(f64_sub(a, b)), f64_from(360));
    if (f64_gt(diff, f64_from(180)) == 1) { return f64_sub(f64_from(360), diff); }
    return diff;
}

# ---------------------------------------------------------------------------
# Display impls (Rust core::fmt::Display) as *_to_str returning a Str.
# ---------------------------------------------------------------------------

# Append an f64 to a str_builder with `decimals` fixed decimal places.
fn sb_add_f64(sb, val, decimals) {
    var buf[64];
    var base = &buf;
    var n = fmt_float_buf(val, base, decimals);
    var i = 0;
    while (i < n) {
        str_builder_add_byte(sb, load8(base + i));
        i = i + 1;
    }
    return 0;
}

# Append an integer zero-padded to 2 digits (Rust {:02}) for small non-negatives.
fn sb_add_02(sb, n) {
    if (n >= 0 && n < 10) { str_builder_add_byte(sb, 48); }
    str_builder_add_int(sb, n);
    return 0;
}

#must_use
fn celestial_coord_to_str(p) {
    var ra = load64(p + CC_RA);
    var dec = load64(p + CC_DEC);
    var ra_h_f = f64_floor(ra);
    var ra_h = f64_to(ra_h_f);
    var ra_m_f = f64_floor(f64_mul(f64_sub(ra, ra_h_f), f64_from(60)));
    var ra_m = f64_to(ra_m_f);
    var ra_s = f64_abs(f64_sub(f64_mul(f64_sub(ra, ra_h_f), f64_from(3600)), f64_mul(ra_m_f, f64_from(60))));
    var dec_neg = f64_lt(dec, f64_from(0));
    var dec_abs = f64_abs(dec);
    var dec_d_f = f64_floor(dec_abs);
    var dec_d = f64_to(dec_d_f);
    var dec_m = f64_to(f64_floor(f64_mul(f64_sub(dec_abs, dec_d_f), f64_from(60))));

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "RA ");
    sb_add_02(sb, ra_h);
    str_builder_add_cstr(sb, "h ");
    sb_add_02(sb, ra_m);
    str_builder_add_cstr(sb, "m ");
    sb_add_f64(sb, ra_s, 1);
    str_builder_add_cstr(sb, "s, Dec ");
    if (dec_neg == 1) { str_builder_add_cstr(sb, "-"); } else { str_builder_add_cstr(sb, "+"); }
    sb_add_02(sb, dec_d);
    str_builder_add_cstr(sb, "d ");
    sb_add_02(sb, dec_m);
    str_builder_add_cstr(sb, "'");
    return str_builder_build(sb);
}

#must_use
fn ecliptic_coord_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "lon ");
    sb_add_f64(sb, load64(p + EC_LON), 4);
    str_builder_add_cstr(sb, "°, lat ");
    sb_add_f64(sb, load64(p + EC_LAT), 4);
    str_builder_add_cstr(sb, "°");
    return str_builder_build(sb);
}

#must_use
fn horizontal_coord_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "az ");
    sb_add_f64(sb, load64(p + HC_AZ), 2);
    str_builder_add_cstr(sb, "°, alt ");
    sb_add_f64(sb, load64(p + HC_ALT), 2);
    str_builder_add_cstr(sb, "°");
    return str_builder_build(sb);
}

#must_use
fn heliacal_event_type_to_str(t) {
    if (t == HET_SETTING) { return str_from("heliacal setting"); }
    return str_from("heliacal rising");
}

# ---------------------------------------------------------------------------
# Enum name tables (serde identifiers). Display strings differ for
# HeliacalEventType (see heliacal_event_type_to_str).
# ---------------------------------------------------------------------------

#must_use
fn starname_name(i) {
    astro_init();
    return vec_get(astro_starname_names, i);
}
#must_use
fn heltype_name(i) {
    astro_init();
    return vec_get(astro_heltype_names, i);
}
#must_use
fn alignmenttarget_name(i) {
    astro_init();
    return vec_get(astro_target_names, i);
}

# --- chinese.cyr ---

# chinese.cyr — Chinese mathematics (was src/chinese.rs).
#
# Counting-rod numerals (i64 wrapper with ASCII rod-art Display + wrapping
# add/sub/mul), the Chinese Remainder Theorem (Sun Tzu's algorithm via extended
# Euclid modular inverse), magic-square construction (hardcoded Lo Shu 3x3 +
# Siamese method for odd n) with a verifier, and the 60-year sexagenary cycle
# (10 Heavenly Stems x 12 Earthly Branches / zodiac animals) from a Gregorian
# year or a JDN.
#
# SELF-CONTAINED: no include lines (the distlib bundler strips them; stdlib +
# error/util/f64_util/logging/gregorian + varna symbols resolve from the
# consumer's bundle).
#
# Parity notes vs Rust:
#   * u64/u128/i128 all collapse to i64. The Rust CRT accumulates the product of
#     moduli in u128 (checked_mul) and does `r*p % product * inv % product` in
#     u128, with mod_inverse in i128. This port reduces every product modulo
#     `product` via a Russian-peasant _mulmod, so results are EXACT as long as
#     the product of all moduli fits below 2^62 (0x3FFFFFFFFFFFFFFF). For the
#     sexagenary moduli (10*12=120) and every historically meaningful CRT this
#     holds. Where the moduli product would exceed that bound, this port returns
#     0 (None) — matching Rust's checked_mul-None on u128 overflow, but at a
#     smaller threshold than Rust's ~3.4e38.
#   * unsigned_abs() on RodNumeral::MIN (i64::MIN) would be 2^63 in Rust; the
#     i64 int_abs here overflows to i64::MIN. Not exercised by any test.
#   * rem_euclid on (year - 4) reproduces the Rust Euclidean remainder so BCE /
#     negative years anchor correctly.

# ---------------------------------------------------------------------------
# Rod numerals — RodNumeral { value: i64 } (8 bytes)
# ---------------------------------------------------------------------------

enum RodNumOff { ROD_VALUE = 0; ROD_SIZE = 8; }

#must_use
fn rod_numeral_new(value) {
    var p = alloc(ROD_SIZE);
    store64(p + ROD_VALUE, value);
    return p;
}

#must_use
fn rod_value(p) { return load64(p + ROD_VALUE); }

# Add two rod numerals (2's-complement wrapping — matches Rust wrapping_add).
#must_use
fn rod_add(a, b) { return rod_numeral_new(rod_value(a) + rod_value(b)); }

# Subtract two rod numerals (wrapping_sub).
#must_use
fn rod_subtract(a, b) { return rod_numeral_new(rod_value(a) - rod_value(b)); }

# Multiply two rod numerals (wrapping_mul).
#must_use
fn rod_multiply(a, b) { return rod_numeral_new(rod_value(a) * rod_value(b)); }

# Display: ASCII rod-art. Zero -> "[ ]". Otherwise sign + "[" + per-digit rods
# ("|" in odd places-from-right, "-" in even; "+" prefix for digits > 5) + "]".
#must_use
fn rod_numeral_to_str(p) {
    var value = rod_value(p);
    if (value == 0) { return str_from("[ ]"); }

    var abs_val = value;
    if (value < 0) { abs_val = 0 - value; }

    var sb = str_builder_new();
    if (value < 0) { str_builder_add_cstr(sb, "-"); }
    str_builder_add_cstr(sb, "[");

    # Collect decimal digits least-significant-first.
    var digs = vec_new();
    var n = abs_val;
    while (n > 0) {
        vec_push(digs, n % 10);
        n = n / 10;
    }

    var dlen = vec_len(digs);
    var i = 0;
    while (i < dlen) {
        var digit = vec_get(digs, dlen - 1 - i);
        if (i > 0) { str_builder_add_cstr(sb, " "); }
        var pos_from_right = dlen - 1 - i;
        var rod_char = 124;
        if (pos_from_right % 2 != 0) { rod_char = 45; }
        if (digit == 0) {
            str_builder_add_cstr(sb, " ");
        }
        if (digit != 0) {
            var cnt = digit;
            if (cnt > 5) { cnt = 5; }
            var k = 0;
            while (k < cnt) { str_builder_add_byte(sb, rod_char); k = k + 1; }
            if (digit > 5) {
                str_builder_add_cstr(sb, "+");
                var extra = digit - 5;
                var e = 0;
                while (e < extra) { str_builder_add_byte(sb, rod_char); e = e + 1; }
            }
        }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return str_builder_build(sb);
}

# ---------------------------------------------------------------------------
# Chinese Remainder Theorem
# ---------------------------------------------------------------------------

# (a * b) mod m without i64 overflow, via Russian-peasant doubling. Exact for
# a, b >= 0 and m < 2^62 (so result+x and x+x stay below i64 max).
#must_use
fn _mulmod(a, b, m) {
    var result = 0;
    var x = a % m;
    var y = b;
    while (y > 0) {
        var bit = y & 1;
        if (bit == 1) { result = (result + x) % m; }
        x = (x + x) % m;
        y = y >> 1;
    }
    return result;
}

# Modular multiplicative inverse of a mod m via extended Euclid. Returns 1 and
# writes the inverse to *out if gcd(a,m)==1; returns 0 (no inverse) otherwise.
#must_use
fn mod_inverse(a, m, out) {
    if (m == 1) { store64(out, 0); return 1; }

    var old_r = a;
    var r = m;
    var old_s = 1;
    var s = 0;
    while (r != 0) {
        var quotient = old_r / r;
        var tr = r;
        r = old_r - quotient * r;
        old_r = tr;
        var ts = s;
        s = old_s - quotient * s;
        old_s = ts;
    }

    if (old_r != 1) { return 0; }

    # Ensure a non-negative representative (old_s may be negative; truncated %
    # matches Rust's i128 `((old_s % m) + m) % m`).
    var res = ((old_s % m) + m) % m;
    store64(out, res);
    return 1;
}

# Solve a system of congruences (Sun Tzu's algorithm).
# `pairs` is a vec of 16-byte records { remainder(offset 0), modulus(offset 8) }.
# Returns 1 and writes the smallest non-negative solution to *out when a unique
# solution mod (product of moduli) exists; returns 0 (None) if the input is
# empty, any modulus is 0, the moduli are not pairwise coprime, or the product
# overflows the safe _mulmod bound.
#must_use
fn chinese_remainder(pairs, out) {
    var count = vec_len(pairs);
    if (count == 0) { return 0; }

    var i = 0;
    while (i < count) {
        var pr = vec_get(pairs, i);
        if (load64(pr + 8) == 0) { return 0; }
        i = i + 1;
    }

    # Single congruence: x = r (mod m).
    if (count == 1) {
        var p0 = vec_get(pairs, 0);
        store64(out, load64(p0) % load64(p0 + 8));
        return 1;
    }

    # Product of all moduli (checked against the _mulmod safe bound).
    var product = 1;
    var MULMOD_LIMIT = 0x3FFFFFFFFFFFFFFF;
    i = 0;
    while (i < count) {
        var pm = load64(vec_get(pairs, i) + 8);
        if (product > MULMOD_LIMIT / pm) { return 0; }
        product = product * pm;
        i = i + 1;
    }

    var sum = 0;
    i = 0;
    while (i < count) {
        var pr2 = vec_get(pairs, i);
        var remainder = load64(pr2);
        var modulus = load64(pr2 + 8);
        var p = product / modulus;

        var inv = 0;
        var have_inv = mod_inverse(p % modulus, modulus, &inv);
        if (have_inv == 0) { return 0; }

        # sum = (sum + r*p % product * inv % product) % product
        var t1 = _mulmod(remainder, p, product);
        var t2 = _mulmod(t1, inv, product);
        sum = (sum + t2) % product;
        i = i + 1;
    }

    store64(out, sum);
    return 1;
}

# Convenience: build a { remainder, modulus } pair record.
#must_use
fn crt_pair(remainder, modulus) {
    var p = alloc(16);
    store64(p, remainder);
    store64(p + 8, modulus);
    return p;
}

# ---------------------------------------------------------------------------
# Magic squares (row-major vec of row-vecs of i64)
# ---------------------------------------------------------------------------

fn _magic_row3(a, b, c) {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    return v;
}

# Magic square of order n. Returns a vec of n row-vecs, or 0 (None) for n < 3 or
# even n. n==3 is the historical Lo Shu; odd n>3 uses the Siamese method.
#must_use
fn magic_square(n) {
    if (n < 3) { return 0; }
    if (n % 2 == 0) { return 0; }

    if (n == 3) {
        var lo = vec_new();
        vec_push(lo, _magic_row3(2, 7, 6));
        vec_push(lo, _magic_row3(9, 5, 1));
        vec_push(lo, _magic_row3(4, 3, 8));
        return lo;
    }

    # Allocate an n x n grid of zeros.
    var square = vec_new();
    var mri = 0;
    while (mri < n) {
        var row = vec_new();
        var mci = 0;
        while (mci < n) {
            vec_push(row, 0);
            mci = mci + 1;
        }
        vec_push(square, row);
        mri = mri + 1;
    }

    # Siamese method: start top-center, move up-right, drop down when occupied.
    var row_i = 0;
    var col_i = n / 2;
    var num = 1;
    var total = n * n;
    while (num <= total) {
        vec_set(vec_get(square, row_i), col_i, num);

        var new_row = n - 1;
        if (row_i != 0) { new_row = row_i - 1; }
        var new_col = (col_i + 1) % n;

        var occ = vec_get(vec_get(square, new_row), new_col);
        if (occ != 0) {
            row_i = (row_i + 1) % n;
        }
        if (occ == 0) {
            row_i = new_row;
            col_i = new_col;
        }
        num = num + 1;
    }

    return square;
}

# Verify a square (vec of row-vecs) is magic: square, and all rows / columns /
# both diagonals share one sum. Returns 1 (true) or 0 (false).
#must_use
fn is_magic_square(square) {
    var n = vec_len(square);
    if (n == 0) { return 0; }

    var ci = 0;
    while (ci < n) {
        var row = vec_get(square, ci);
        if (vec_len(row) != n) { return 0; }
        ci = ci + 1;
    }

    var magic_sum = 0;
    var row0 = vec_get(square, 0);
    var j = 0;
    while (j < n) {
        magic_sum = magic_sum + vec_get(row0, j);
        j = j + 1;
    }

    # Rows.
    var ri = 0;
    while (ri < n) {
        var r = vec_get(square, ri);
        var rs = 0;
        var k = 0;
        while (k < n) {
            rs = rs + vec_get(r, k);
            k = k + 1;
        }
        if (rs != magic_sum) { return 0; }
        ri = ri + 1;
    }

    # Columns.
    var col = 0;
    while (col < n) {
        var cs = 0;
        var rr = 0;
        while (rr < n) {
            cs = cs + vec_get(vec_get(square, rr), col);
            rr = rr + 1;
        }
        if (cs != magic_sum) { return 0; }
        col = col + 1;
    }

    # Main diagonal.
    var ds = 0;
    var di = 0;
    while (di < n) {
        ds = ds + vec_get(vec_get(square, di), di);
        di = di + 1;
    }
    if (ds != magic_sum) { return 0; }

    # Anti-diagonal.
    var anti_s = 0;
    var ai = 0;
    while (ai < n) {
        anti_s = anti_s + vec_get(vec_get(square, ai), n - 1 - ai);
        ai = ai + 1;
    }
    if (anti_s != magic_sum) { return 0; }

    return 1;
}

