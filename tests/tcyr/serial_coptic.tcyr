# serial_coptic.tcyr — serde round-trip parity tests for the coptic module.
# Ports the serde_roundtrip #[cfg(test)] test from rust-old/src/coptic.rs and
# adds explicit JSON-format assertions (field names, enum as variant-name string).
# Run: cyrius build tests/tcyr/serial_coptic.tcyr build/_s_coptic && ./build/_s_coptic

include "src/error.cyr"
include "src/util.cyr"
include "src/f64_util.cyr"
include "src/logging.cyr"
include "src/serial_util.cyr"
include "src/coptic.cyr"
include "src/serial_coptic.cyr"

# Assert that v is non-zero (truthy), labelled name in the failure report.
fn ok(v, name) { return assert_neq(v, 0, name); }

# Decode js (a C-string) with decoder k (1 CopticDate, else CopticMonth); returns that
# decoder's Result pair.
fn de_run(k, js) {
    var n = sk_json_parse(str_from(js));
    if (k == 1) { return coptic_date_from_json(n); }
    return coptic_month_from_json(n);
}

# The C-string a followed by the C-string b, for expected messages too long for one line.
fn cat2(a, b) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_cstr(str_builder_build(sb));
}

# Decode js with decoder k and check it fails with SKE_DESERIALIZE and exactly the message
# want (a C-string); a mismatch prints the message it got.
fn de_err(k, js, want, label) {
    var t, v = de_run(k, js);
    assert_eq(sk_result_code(t, v), SKE_DESERIALIZE, label);
    if (is_ok(t) == 0) {
        var same = str_eq_cstr(sk_err_msg(v), want);
        if (same == 0) { str_println(sk_err_msg(v)); }
        ok(same, label);
    }
    return 0;
}

# Run every serial_coptic test case and print the assert_summary; returns its exit code.
fn main() {
    alloc_init();
    coptic_init();

    var epoch = coptic_epoch_jdn();

    # ---- serde_roundtrip: jdn_to_coptic(COPTIC_EPOCH_JDN + 500.0) ----
    # days_since_epoch = 500 -> year 2, month Tobi (idx 4), day 16.
    var jsrc = f64_add(epoch, f64_from(500));
    var date = jdn_to_coptic(jsrc);
    assert_eq(coptic_date_year(date), 2, "constructed year=2");
    assert_eq(coptic_date_month(date), CM_TOBI, "constructed month=Tobi");
    assert_eq(coptic_date_day(date), 16, "constructed day=16");

    var js = coptic_date_to_json(date);
    # JSON format: {"year":2,"month":"Tobi","day":16}
    ok(str_contains_cstr(js, "\"year\":2"), "json has year field");
    ok(str_contains_cstr(js, "\"month\":\"Tobi\""), "json month is variant-name string");
    ok(str_contains_cstr(js, "\"day\":16"), "json has day field");

    var v = sk_json_parse(js);
    ok(v, "json parses");
    var parsed_t, parsed_v = coptic_date_from_json(v);
    ok(is_ok(parsed_t), "CopticDate decodes");
    ok(coptic_date_eq(date, result_unwrap(parsed_t, parsed_v)), "CopticDate serde round-trip");

    # ---- explicit enum-as-variant-name path (Nasie, month idx 12) ----
    var dn = coptic_date_new(3, CM_NASIE, 6);
    var jn = coptic_date_to_json(dn);
    ok(str_contains_cstr(jn, "\"month\":\"Nasie\""), "Nasie serializes as \"Nasie\"");
    ok(str_contains_cstr(jn, "\"year\":3"), "Nasie json year=3");
    ok(str_contains_cstr(jn, "\"day\":6"), "Nasie json day=6");
    var vn = sk_json_parse(jn);
    var pn_t, pn_v = coptic_date_from_json(vn);
    ok(coptic_date_eq(dn, result_unwrap(pn_t, pn_v)), "CopticDate(Nasie) round-trip");

    # ---- pre-epoch date exercises negative year serialization ----
    var jpre = f64_sub(epoch, f64_from(400));
    var dpre = jdn_to_coptic(jpre);
    var jpre_json = coptic_date_to_json(dpre);
    var vpre = sk_json_parse(jpre_json);
    var ppre_t, ppre_v = coptic_date_from_json(vpre);
    ok(coptic_date_eq(dpre, result_unwrap(ppre_t, ppre_v)), "pre-epoch CopticDate round-trip");

    # ---- CopticMonth enum serde: to_json is a bare quoted identifier ----
    var jm = coptic_month_to_json(CM_THOUT);
    ok(str_eq_cstr(jm, "\"Thout\""), "CopticMonth::Thout -> \"Thout\"");
    var vm = sk_json_parse(jm);
    var pm_t, pm_v = coptic_month_from_json(vm);
    ok(is_ok(pm_t), "CopticMonth decodes");
    ok(coptic_month_eq(result_unwrap(pm_t, pm_v), CM_THOUT), "CopticMonth serde round-trip");

    # ---- from_name lookup: known and unknown ----
    assert_eq(coptic_month_from_name("Mesori"), CM_MESORI, "from_name Mesori=11");
    var missing = coptic_month_from_name("Nonesuch");
    var missing_ok = missing == (0 - 1);
    ok(missing_ok, "from_name unknown -> -1");

    # ---- 3.2.0: decode errors are serde's (Err, SKE_DESERIALIZE) ----
    var cm = cat2("`Thout`, `Paopi`, `Hathor`, `Koiak`, `Tobi`, `Meshir`, `Paremhat`, `Parmouti`, ",
        "`Pashons`, `Paoni`, `Epip`, `Mesori`, `Nasie`");
    de_err(1, "{\"month\":\"Tobi\",\"day\":16}", "missing field `year`", "missing year");
    de_err(1, "{\"year\":2,\"month\":\"Tobi\",\"day\":-1}", "invalid value: integer `-1`, expected u8", "negative day");
    de_err(1, "{\"year\":2,\"month\":\"Tobi\",\"day\":\"16\"}", "invalid type: string \"16\", expected u8",
        "string day");
    de_err(1, "{\"year\":2,\"month\":\"Tout\",\"day\":16}", cat2("unknown variant `Tout`, expected one of ", cm),
        "date unknown month");
    de_err(1, "true", "invalid type: boolean `true`, expected struct CopticDate", "boolean for date");
    de_err(2, "\"Tout\"", cat2("unknown variant `Tout`, expected one of ", cm), "unknown month");
    de_err(2, "[1]", "invalid type: sequence, expected variant identifier", "array month");
    de_err(2, "12", "invalid type: integer `12`, expected variant identifier", "integer month");
    # serde ignores unknown keys and does no calendar validation (Nasie 30 decodes).
    var ex_t, ex_v = de_run(1, "{\"year\":2,\"month\":\"Nasie\",\"day\":30,\"era\":\"AM\"}");
    ok(is_ok(ex_t), "unknown key ignored, Nasie 30 decodes");
    if (is_ok(ex_t) == 1) { assert_eq(coptic_date_day(ex_v), 30, "day 30 kept as decoded"); }

    return assert_summary();
}

var rc = main();
syscall(SYS_EXIT, rc);
