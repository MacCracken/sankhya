        str_from("Pleiades (Tzab-ek) and Orion"),
        str_from("Multiple cycles of creation and destruction; the current (fourth) world was preceded by a great flood that destroyed the wooden people."));
}

fn _st_greek() {
    var names = vec_new();
    vec_push(names, str_from("Thales"));
    vec_push(names, str_from("Solon"));
    vec_push(names, str_from("Chilon"));
    vec_push(names, str_from("Bias"));
