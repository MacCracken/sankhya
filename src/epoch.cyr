enum Civilization {
    ECIV_VEDIC; ECIV_BABYLONIAN; ECIV_EGYPTIAN; ECIV_MAYAN; ECIV_GREEK; ECIV_CHINESE;
}

var _civ_names_vec = 0;
var _civ_names_done = 0;
fn _build_civ_names() {
