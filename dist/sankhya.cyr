    return sgt_new(ECIV_BABYLONIAN, str_from("Apkallu"), names, texts,
        str_from("Associated with Ea/Enki and the Abzu (cosmic waters)"),
        str_cat(str_from("Seven antediluvian sages sent by Ea before the Great Flood; taught the arts of "),
            str_from("civilization to humanity.")));
}

fn _st_egyptian() {
