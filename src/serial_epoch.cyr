# Decode a HebrewDate {year: i64, month: HebrewMonth, day: u8} from bayan node v: Ok(HebrewDate) or
# Err(SKE_DESERIALIZE). No calendar validation (serde's derive does none).
#must_use
fn ep_hebrew_from_json(v) {
    var obj = sk_de_struct(v, "HebrewDate")?;
    var y = sk_de_int_field(obj, "year", SK_I64_MIN, SK_I64_MAX, "i64")?;
    var m = sk_de_variant_field(obj, "month", _ep_hebrew_month_names())?;
    var d = sk_de_int_field(obj, "day", 0, SK_U8_MAX, "u8")?;
    return Ok(hebrewdate_new(y, m, d));
}
# Structural equality of two HebrewDate records (year, month, day); 1/0.
#must_use
fn ep_hebrew_eq(a, b) {
    if (hebdate_year(a) != hebdate_year(b)) { return 0; }
    if (hebdate_month(a) != hebdate_month(b)) { return 0; }
    if (hebdate_day(a) != hebdate_day(b)) { return 0; }
    return 1;
}

