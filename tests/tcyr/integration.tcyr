    while (d < 1500) {
        var jdn = f64_add(epoch, f64_from(d));
        var date = jdn_to_coptic(jdn);
        var r = coptic_to_jdn(date);
        if (is_ok(r) == 0) { fail = fail + 1; }
        else { if (f64_approx_eq(result_unwrap(r), jdn, TOL_JDN) == 0) { fail = fail + 1; } }
        d = d + 1;
    }
    return fail;
}

fn test_coptic() {
    assert_eq(coptic_rt_fail(coptic_epoch_jdn()), 0, "coptic JDN roundtrip 1500 days");
    return 0;
}

