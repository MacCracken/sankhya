# serial_malformed.tcyr — every <type>_from_json on malformed input (3.1.3).
#
# serde returns an Err for a missing field, a wrong type or an unknown variant. The
# hand-written decoders return a record instead, and before 3.1.3 about 44 of them
# crashed on such input: bayan_json_v_str gave 0 for a missing or non-string field, and
# str_eq / str_cstr read through it. Decoders now see "" there (sk_json_v_str), an
# unknown name decodes to -1, and the name lookups render -1 as "?". This suite feeds each
# decoder the inputs below and re-serializes what comes back: reaching the summary means
# nothing crashed. Domain functions reject the -1 codes and bad days (calendar checks).
include "src/lib.cyr"

# Assert that v is non-zero (truthy), labelled name in the failure report.
fn ok(v, name) { return assert_neq(v, 0, name); }

var MAL_INPUTS = 0;

# Build the malformed-input list: each entry is a parsed bayan node (0 where parsing fails).
fn mal_init() {
    MAL_INPUTS = vec_new();
    vec_push(MAL_INPUTS, sk_json_parse(str_from("{}")));
    vec_push(MAL_INPUTS, sk_json_parse(str_from("null")));
    vec_push(MAL_INPUTS, sk_json_parse(str_from("123")));
    vec_push(MAL_INPUTS, sk_json_parse(str_from("[]")));
    vec_push(MAL_INPUTS, sk_json_parse(str_from("\"x\"")));
    vec_push(MAL_INPUTS, sk_json_parse(str_from("{\"name\":5,\"month\":\"Foo\",\"day\":-5,\"year\":\"y\"}")));
    vec_push(MAL_INPUTS, sk_json_parse(str_from("{\"Gregorian\":{\"year\":2024,\"day\":1}}")));
    vec_push(MAL_INPUTS, sk_json_parse(str_from("{\"Julian\":5}")));
    vec_push(MAL_INPUTS, sk_json_parse(str_from("[1,[2,{\"a\":null}]]")));
    vec_push(MAL_INPUTS, sk_json_parse(str_from("{\"jdn\":1.0}")));
    vec_push(MAL_INPUTS, sk_json_parse(str_from("{")));
    vec_push(MAL_INPUTS, 0);
    return 0;
}

# Run every decoder over every malformed input, re-serializing each result.
fn main() {
    alloc_init();
    mal_init();
    var n = vec_len(MAL_INPUTS);
    var i = 0;
    var decoded = 0;
    while (i < n) {
        var v = vec_get(MAL_INPUTS, i);
        var r_age_position = age_position_from_json(v);
        if (r_age_position != 0) { var s_age_position = age_position_to_json(r_age_position); }
        decoded = decoded + 1;
        var r_alignment_result = alignment_result_from_json(v);
        if (r_alignment_result != 0) { var s_alignment_result = alignment_result_to_json(r_alignment_result); }
        decoded = decoded + 1;
        var r_alignmenttarget = alignmenttarget_from_json(v);
        decoded = decoded + 1;
        var r_aljabr_sol = aljabr_sol_from_json(v);
        if (r_aljabr_sol != 0) { var s_aljabr_sol = aljabr_sol_to_json(r_aljabr_sol); }
        decoded = decoded + 1;
        var r_anti = anti_from_json(v);
        if (r_anti != 0) { var s_anti = anti_to_json(r_anti); }
        decoded = decoded + 1;
        var r_babdate = babdate_from_json(v);
        if (r_babdate != 0) { var s_babdate = babdate_to_json(r_babdate); }
        decoded = decoded + 1;
        var r_babmonth = babmonth_from_json(v);
        if (r_babmonth != 0) { var s_babmonth = babmonth_to_json(r_babmonth); }
        decoded = decoded + 1;
        var r_babnum = babnum_from_json(v);
        if (r_babnum != 0) { var s_babnum = babnum_to_json(r_babnum); }
        decoded = decoded + 1;
        var r_calendar_date = calendar_date_from_json(v);
        if (r_calendar_date != 0) { var s_calendar_date = calendar_date_to_json(r_calendar_date); }
        decoded = decoded + 1;
        var r_celestial_coord = celestial_coord_from_json(v);
        if (r_celestial_coord != 0) { var s_celestial_coord = celestial_coord_to_json(r_celestial_coord); }
        decoded = decoded + 1;
        var r_civilization = civilization_from_json(v);
        if (r_civilization != 0) { var s_civilization = civilization_to_json(r_civilization); }
        decoded = decoded + 1;
        var r_coptic_date = coptic_date_from_json(v);
        if (r_coptic_date != 0) { var s_coptic_date = coptic_date_to_json(r_coptic_date); }
        decoded = decoded + 1;
        var r_coptic_month = coptic_month_from_json(v);
        if (r_coptic_month != 0) { var s_coptic_month = coptic_month_to_json(r_coptic_month); }
        decoded = decoded + 1;
        var r_cycle_alignment = cycle_alignment_from_json(v);
        if (r_cycle_alignment != 0) { var s_cycle_alignment = cycle_alignment_to_json(r_cycle_alignment); }
        decoded = decoded + 1;
        var r_cyclename = cyclename_from_json(v);
        if (r_cyclename != 0) { var s_cyclename = cyclename_to_json(r_cyclename); }
        decoded = decoded + 1;
        var r_daysign = daysign_from_json(v);
        if (r_daysign != 0) { var s_daysign = daysign_to_json(r_daysign); }
        decoded = decoded + 1;
        var r_decan = decan_from_json(v);
        if (r_decan != 0) { var s_decan = decan_to_json(r_decan); }
        decoded = decoded + 1;
        var r_earthly_branch = earthly_branch_from_json(v);
        if (r_earthly_branch != 0) { var s_earthly_branch = earthly_branch_to_json(r_earthly_branch); }
        decoded = decoded + 1;
        var r_ecliptic_coord = ecliptic_coord_from_json(v);
        if (r_ecliptic_coord != 0) { var s_ecliptic_coord = ecliptic_coord_to_json(r_ecliptic_coord); }
        decoded = decoded + 1;
        var r_ep_coptic = ep_coptic_from_json(v);
        if (r_ep_coptic != 0) { var s_ep_coptic = ep_coptic_to_json(r_ep_coptic); }
        decoded = decoded + 1;
        var r_ep_greg = ep_greg_from_json(v);
        if (r_ep_greg != 0) { var s_ep_greg = ep_greg_to_json(r_ep_greg); }
        decoded = decoded + 1;
        var r_ep_haab = ep_haab_from_json(v);
        if (r_ep_haab != 0) { var s_ep_haab = ep_haab_to_json(r_ep_haab); }
        decoded = decoded + 1;
        var r_ep_hebrew = ep_hebrew_from_json(v);
        if (r_ep_hebrew != 0) { var s_ep_hebrew = ep_hebrew_to_json(r_ep_hebrew); }
        decoded = decoded + 1;
        var r_ep_hijri = ep_hijri_from_json(v);
        if (r_ep_hijri != 0) { var s_ep_hijri = ep_hijri_to_json(r_ep_hijri); }
        decoded = decoded + 1;
        var r_ep_lc = ep_lc_from_json(v);
        if (r_ep_lc != 0) { var s_ep_lc = ep_lc_to_json(r_ep_lc); }
        decoded = decoded + 1;
        var r_ep_persian = ep_persian_from_json(v);
        if (r_ep_persian != 0) { var s_ep_persian = ep_persian_to_json(r_ep_persian); }
        decoded = decoded + 1;
        var r_ep_sex = ep_sex_from_json(v);
        if (r_ep_sex != 0) { var s_ep_sex = ep_sex_to_json(r_ep_sex); }
        decoded = decoded + 1;
        var r_ep_tonal = ep_tonal_from_json(v);
        if (r_ep_tonal != 0) { var s_ep_tonal = ep_tonal_to_json(r_ep_tonal); }
        decoded = decoded + 1;
        var r_ep_tzolkin = ep_tzolkin_from_json(v);
        if (r_ep_tzolkin != 0) { var s_ep_tzolkin = ep_tzolkin_to_json(r_ep_tzolkin); }
        decoded = decoded + 1;
        var r_ep_xiuh = ep_xiuh_from_json(v);
        if (r_ep_xiuh != 0) { var s_ep_xiuh = ep_xiuh_to_json(r_ep_xiuh); }
        decoded = decoded + 1;
        var r_gregorian_date = gregorian_date_from_json(v);
        if (r_gregorian_date != 0) { var s_gregorian_date = gregorian_date_to_json(r_gregorian_date); }
        decoded = decoded + 1;
        var r_gregorian_month = gregorian_month_from_json(v);
        if (r_gregorian_month != 0) { var s_gregorian_month = gregorian_month_to_json(r_gregorian_month); }
        decoded = decoded + 1;
        var r_haab = haab_from_json(v);
        if (r_haab != 0) { var s_haab = haab_to_json(r_haab); }
        decoded = decoded + 1;
        var r_haabmonth = haabmonth_from_json(v);
        if (r_haabmonth != 0) { var s_haabmonth = haabmonth_to_json(r_haabmonth); }
        decoded = decoded + 1;
        var r_heavenly_stem = heavenly_stem_from_json(v);
        if (r_heavenly_stem != 0) { var s_heavenly_stem = heavenly_stem_to_json(r_heavenly_stem); }
        decoded = decoded + 1;
        var r_hebrewdate = hebrewdate_from_json(v);
        if (r_hebrewdate != 0) { var s_hebrewdate = hebrewdate_to_json(r_hebrewdate); }
        decoded = decoded + 1;
        var r_hebrewmonth = hebrewmonth_from_json(v);
        if (r_hebrewmonth != 0) { var s_hebrewmonth = hebrewmonth_to_json(r_hebrewmonth); }
        decoded = decoded + 1;
        var r_heliacal_event = heliacal_event_from_json(v);
        if (r_heliacal_event != 0) { var s_heliacal_event = heliacal_event_to_json(r_heliacal_event); }
        decoded = decoded + 1;
        var r_heltype = heltype_from_json(v);
        if (r_heltype != 0) { var s_heltype = heltype_to_json(r_heltype); }
        decoded = decoded + 1;
        var r_hijri_date = hijri_date_from_json(v);
        if (r_hijri_date != 0) { var s_hijri_date = hijri_date_to_json(r_hijri_date); }
        decoded = decoded + 1;
        var r_horizontal_coord = horizontal_coord_from_json(v);
        if (r_horizontal_coord != 0) { var s_horizontal_coord = horizontal_coord_to_json(r_horizontal_coord); }
        decoded = decoded + 1;
        var r_longcount = longcount_from_json(v);
        if (r_longcount != 0) { var s_longcount = longcount_to_json(r_longcount); }
        decoded = decoded + 1;
        var r_mayan_numeral = mayan_numeral_from_json(v);
        if (r_mayan_numeral != 0) { var s_mayan_numeral = mayan_numeral_to_json(r_mayan_numeral); }
        decoded = decoded + 1;
        var r_meru = meru_from_json(v);
        if (r_meru != 0) { var s_meru = meru_to_json(r_meru); }
        decoded = decoded + 1;
        var r_multi_calendar_date = multi_calendar_date_from_json(v);
        if (r_multi_calendar_date != 0) {
            var s_multi_calendar_date = multi_calendar_date_to_json(r_multi_calendar_date);
        }
        decoded = decoded + 1;
        var r_nikhilam = nikhilam_from_json(v);
        if (r_nikhilam != 0) { var s_nikhilam = nikhilam_to_json(r_nikhilam); }
        decoded = decoded + 1;
        var r_persian_date = persian_date_from_json(v);
        if (r_persian_date != 0) { var s_persian_date = persian_date_to_json(r_persian_date); }
        decoded = decoded + 1;
        var r_persian_month = persian_month_from_json(v);
        if (r_persian_month != 0) { var s_persian_month = persian_month_to_json(r_persian_month); }
        decoded = decoded + 1;
        var r_precessionalage = precessionalage_from_json(v);
        if (r_precessionalage != 0) { var s_precessionalage = precessionalage_to_json(r_precessionalage); }
        decoded = decoded + 1;
        var r_rod_numeral = rod_numeral_from_json(v);
        if (r_rod_numeral != 0) { var s_rod_numeral = rod_numeral_to_json(r_rod_numeral); }
        decoded = decoded + 1;
        var r_romannum = romannum_from_json(v);
        if (r_romannum != 0) { var s_romannum = romannum_to_json(r_romannum); }
        decoded = decoded + 1;
        var r_sages_tradition = sages_tradition_from_json(v);
        if (r_sages_tradition != 0) { var s_sages_tradition = sages_tradition_to_json(r_sages_tradition); }
        decoded = decoded + 1;
        var r_sexagenary_year = sexagenary_year_from_json(v);
        if (r_sexagenary_year != 0) { var s_sexagenary_year = sexagenary_year_to_json(r_sexagenary_year); }
        decoded = decoded + 1;
        var r_star = star_from_json(v);
        if (r_star != 0) { var s_star = star_to_json(r_star); }
        decoded = decoded + 1;
        var r_starname = starname_from_json(v);
        if (r_starname != 0) { var s_starname = starname_to_json(r_starname); }
        decoded = decoded + 1;
        var r_tonalpohualli = tonalpohualli_from_json(v);
        if (r_tonalpohualli != 0) { var s_tonalpohualli = tonalpohualli_to_json(r_tonalpohualli); }
        decoded = decoded + 1;
        var r_tzolkin = tzolkin_from_json(v);
        if (r_tzolkin != 0) { var s_tzolkin = tzolkin_to_json(r_tzolkin); }
        decoded = decoded + 1;
        var r_venusphase = venusphase_from_json(v);
        if (r_venusphase != 0) { var s_venusphase = venusphase_to_json(r_venusphase); }
        decoded = decoded + 1;
        var r_xiuhpohualli = xiuhpohualli_from_json(v);
        if (r_xiuhpohualli != 0) { var s_xiuhpohualli = xiuhpohualli_to_json(r_xiuhpohualli); }
        decoded = decoded + 1;
        i = i + 1;
    }
    ok(decoded > 0, "every decoder ran on every malformed input without crashing");

    # A CalendarDate decoded from malformed JSON reaches convert() as an Err, not a crash
    # or a garbage Ok (month "Foo" -> -1, day -5, an unknown variant -> 0).
    var js1 = str_from("{\"Gregorian\":{\"year\":2024,\"month\":\"Foo\",\"day\":40}}");
    var bad1 = calendar_date_from_json(sk_json_parse(js1));
    var c1_t, c1_v = convert(bad1);
    assert_eq(is_ok(c1_t), 0, "convert(Gregorian month Foo) -> Err");
    var bad2 = calendar_date_from_json(sk_json_parse(str_from("{\"Julian\":5}")));
    var c2_t, c2_v = convert(bad2);
    assert_eq(is_ok(c2_t), 0, "convert(unknown variant) -> Err");
    var js3 = str_from("{\"Gregorian\":{\"year\":2024,\"month\":\"January\",\"day\":-5}}");
    var bad3 = calendar_date_from_json(sk_json_parse(js3));
    var c3_t, c3_v = convert(bad3);
    assert_eq(is_ok(c3_t), 0, "convert(Gregorian day -5) -> Err");
    # An unknown enum name decodes to -1 and re-serializes as "?" (no abort).
    var sn = starname_from_json(sk_json_parse(str_from("\"Vulcan\"")));
    assert_eq(sn, 0 - 1, "unknown star name -> -1");
    ok(str_contains_cstr(starname_to_json(sn), "?"), "starname -1 serializes as ?");
    return assert_summary();
}

var rc = main();
syscall(SYS_EXIT, rc);

