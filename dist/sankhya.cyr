    vec_push(texts, str_from("Shanhaijing"));
    vec_push(texts, str_from("Shujing (Book of Documents)"));
    return sgt_new(ECIV_CHINESE, str_from("Fuxi and Nuwa"), names, texts,
        str_from("Beidou (Northern Dipper / Ursa Major)"),
        str_cat(str_from("Fuxi and Nuwa survived the Great Flood; Nuwa repaired the broken sky. Yu the Great "),
            str_from("later tamed the floodwaters and founded civilization.")));
}

# Build the Seven Sages traditions across all six civilizations. Returns a
# fresh vec of SagesTradition records each call.
#must_use
fn seven_sages() {
    var v = vec_new();
    vec_push(v, _st_vedic());
    vec_push(v, _st_babylonian());
    vec_push(v, _st_egyptian());
    vec_push(v, _st_mayan());
    vec_push(v, _st_greek());
    vec_push(v, _st_chinese());
    return v;
}

# Return the Seven Sages tradition for a given civilization, or 0 (None).
#must_use
fn sages_tradition(civ) {
    var v = seven_sages();
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        var p = vec_get(v, i);
        if (sgt_civ(p) == civ) { return p; }
        i = i + 1;
    }
    return 0;
}

# Return all Seven Sages traditions.
#must_use
fn all_sages_traditions() {
    return seven_sages();
}

# ---------------------------------------------------------------------------
# Time conversion utilities
# ---------------------------------------------------------------------------

# BP (Present = 1950 CE) -> JDN.
#must_use
fn bp_to_jdn(years_bp) {
    epoch_init();
    return f64_sub(BP_REFERENCE_JDN, f64_mul(years_bp, JULIAN_YEAR_DAYS));
}

# JDN -> years Before Present.
#must_use
fn jdn_to_bp(jdn) {
    epoch_init();
    return f64_div(f64_sub(BP_REFERENCE_JDN, jdn), JULIAN_YEAR_DAYS);
}

# Julian calendar year (i64; negative = BCE) -> approximate JDN (Jan 1).
#must_use
fn julian_year_to_jdn(year) {
    return f64_add(J2000_JDN, f64_mul(f64_sub(f64_from(year), f64_from(2000)), JULIAN_YEAR_DAYS));
}

# JDN -> approximate (fractional) Julian calendar year.
#must_use
fn jdn_to_julian_year(jdn) {
    return f64_add(f64_from(2000), f64_div(f64_sub(jdn, J2000_JDN), JULIAN_YEAR_DAYS));
}

# ---------------------------------------------------------------------------
# Precession calculations
# ---------------------------------------------------------------------------

# Ecliptic longitude (0..360) of the vernal-equinox point for a JDN.
# 150 deg at the Younger Dryas, drifting westward at 1 deg / 72 yr; normalized
# via ((x % 360) + 360) % 360 with f64_rem, Rust's truncating `%` exactly (3.1.3).
#must_use
fn vernal_point_longitude(jdn) {
    epoch_init();
    var years_since_yd = f64_div(f64_sub(jdn, YOUNGER_DRYAS_JDN), JULIAN_YEAR_DAYS);
    var longitude = f64_sub(f64_from(150), f64_mul(years_since_yd, PRECESSION_RATE_DEG_PER_YEAR));
    var m1 = f64_rem(longitude, f64_from(360));
    return f64_rem(f64_add(m1, f64_from(360)), f64_from(360));
}

# ---------------------------------------------------------------------------
# AgePosition record: { age, years_into_age: f64, fraction: f64,
#                       vernal_point_longitude: f64 } — 32 bytes.
enum ApOff { AP_AGE = 0; AP_YEARS = 8; AP_FRACTION = 16; AP_LON = 24; AP_SIZE = 32; }

# Construct an AgePosition record (fresh 32-byte alloc) storing: age (PA_*), years_into_age
# (f64 Julian years), fraction of the age elapsed (f64) and vernal-point longitude (f64 deg).
#must_use
fn ap_new(age, years_into_age, fraction, lon) {
    var p = alloc(AP_SIZE);
    store64(p + AP_AGE, age);
    store64(p + AP_YEARS, years_into_age);
    store64(p + AP_FRACTION, fraction);
    store64(p + AP_LON, lon);
    return p;
}
# AgePosition field: the current precessional age (PA_*).
#must_use
fn ap_age(p) { return load64(p + AP_AGE); }
# AgePosition field: Julian years elapsed within the age, f64 (0.0 to ~2160.0).
#must_use
fn ap_years(p) { return load64(p + AP_YEARS); }
# AgePosition field: fraction of the current age elapsed, f64 (0.0 to 1.0).
#must_use
fn ap_fraction(p) { return load64(p + AP_FRACTION); }
# AgePosition field: ecliptic longitude of the vernal equinox point, f64 degrees (0..360).
#must_use
fn ap_lon(p) { return load64(p + AP_LON); }

# Compute the precessional age + position for a JDN. Canonical 25,920-year
# period, Age of Leo beginning at the Younger Dryas.
#must_use
fn precessional_age(jdn) {
    epoch_init();
    var years_since_yd = f64_div(f64_sub(jdn, YOUNGER_DRYAS_JDN), JULIAN_YEAR_DAYS);

    # cycle_years = ((years_since_yd % GREAT_YEAR) + GREAT_YEAR) % GREAT_YEAR.
    var m1 = f64_rem(years_since_yd, GREAT_YEAR_YEARS);
    var cycle_years = f64_rem(f64_add(m1, GREAT_YEAR_YEARS), GREAT_YEAR_YEARS);

    # age_index = (cycle_years / 2160) as usize, clamped to <= 11.
    var age_index = f64_to(f64_div(cycle_years, PRECESSIONAL_AGE_YEARS));
    if (age_index >= 12) { age_index = 11; }

    var years_into_age = f64_sub(cycle_years, f64_mul(f64_from(age_index), PRECESSIONAL_AGE_YEARS));
    var fraction = f64_div(years_into_age, PRECESSIONAL_AGE_YEARS);
    var lon = vernal_point_longitude(jdn);

    # AGE_ORDER[i] == i, so the age discriminant is age_index directly.
    return ap_new(age_index, years_into_age, fraction, lon);
}

# JDN when a given precessional age begins (most recent occurrence relative to
# the Younger Dryas anchor). AGE_ORDER.position(age) == age.
#must_use
fn age_start_jdn(age) {
    epoch_init();
    return f64_add(YOUNGER_DRYAS_JDN, f64_mul(f64_from(age), PRECESSIONAL_AGE_DAYS));
}

# ---------------------------------------------------------------------------
# Cycle infrastructure
# ---------------------------------------------------------------------------

# Period in days for a named astronomical cycle. Pulls constants from the
# egyptian/babylonian/mayan modules (SOTHIC_CYCLE_DAYS and CALENDAR_ROUND_DAYS
# are integers cast to f64; SAROS_DAYS is babylonian's f64 global — requires
# babylonian_init(); venus_synodic_period() is mayan's f64 accessor).
#must_use
fn cycle_period(cycle) {
    epoch_init();
    if (cycle == CN_PRECESSION) { return GREAT_YEAR_DAYS; }
    if (cycle == CN_SOTHIC) { return f64_from(SOTHIC_CYCLE_DAYS); }
    if (cycle == CN_SAROS) { babylonian_init(); return SAROS_DAYS; }
    if (cycle == CN_VENUS_SYNODIC) { return venus_synodic_period(); }
    if (cycle == CN_CALENDAR_ROUND) { return f64_from(CALENDAR_ROUND_DAYS); }
    if (cycle == CN_METONIC) { return f64_mul(f64_from(19), JULIAN_YEAR_DAYS); }
    return PRECESSIONAL_AGE_DAYS;
}

# CyclesElapsed row: { cycle, complete: u64, remainder_days: f64 } — 24 bytes.
enum CeOff { CE_CYCLE = 0; CE_COMPLETE = 8; CE_REMAINDER = 16; CE_SIZE = 24; }

# Construct a CyclesElapsed row (fresh 24-byte alloc) storing: cycle (CN_*), complete
# (i64 whole-cycle count) and remainder_days (f64).
#must_use
fn ce_new(cycle, complete, remainder) {
    var p = alloc(CE_SIZE);
    store64(p + CE_CYCLE, cycle);
    store64(p + CE_COMPLETE, complete);
    store64(p + CE_REMAINDER, remainder);
    return p;
}
# CyclesElapsed field: the cycle (CN_*).
#must_use
fn ce_cycle(p) { return load64(p + CE_CYCLE); }
# CyclesElapsed field: complete cycles elapsed, i64 (cycles_elapsed clamps negatives to 0).
#must_use
fn ce_complete(p) { return load64(p + CE_COMPLETE); }
# CyclesElapsed field: days past the last whole-cycle boundary, f64.
#must_use
fn ce_remainder(p) { return load64(p + CE_REMAINDER); }

# For each cycle, the number of complete cycles elapsed since a reference epoch,
# plus the remainder in days. `cycles` is a vec of CycleName ints; returns a vec
# of CeOff rows.
#must_use
fn cycles_elapsed(jdn, reference_jdn, cycles) {
    var elapsed_days = f64_sub(jdn, reference_jdn);
    var result = vec_new();
    var n = vec_len(cycles);
    var i = 0;
    while (i < n) {
        var cycle = vec_get(cycles, i);
        var period = cycle_period(cycle);
        if (f64_le(period, f64_from(0)) == 1) {
            vec_push(result, ce_new(cycle, 0, elapsed_days));
        }
        if (f64_gt(period, f64_from(0)) == 1) {
            var complete = f64_floor(f64_div(elapsed_days, period));
            var remainder = f64_sub(elapsed_days, f64_mul(complete, period));
            var complete_u64 = 0;
            if (f64_ge(complete, f64_from(0)) == 1) { complete_u64 = f64_to(complete); }
            vec_push(result, ce_new(cycle, complete_u64, remainder));
        }
        i = i + 1;
    }
    return result;
}

# CycleAlignment record: { jdn: f64, cycles: vec<CycleName>,
#                          max_residual_days: f64 } — 24 bytes.
enum CalgnOff { CALG_JDN = 0; CALG_CYCLES = 8; CALG_MAXRES = 16; CALG_SIZE = 24; }

# Construct a CycleAlignment record (fresh 24-byte alloc) storing: jdn (f64), cycles (vec of
# CN_*, stored as-is) and max_residual_days (f64).
#must_use
fn calgn_new(jdn, cycles, max_residual) {
    var p = alloc(CALG_SIZE);
    store64(p + CALG_JDN, jdn);
    store64(p + CALG_CYCLES, cycles);
    store64(p + CALG_MAXRES, max_residual);
    return p;
}
# CycleAlignment field: JDN of the alignment (f64).
#must_use
fn calgn_jdn(p) { return load64(p + CALG_JDN); }
# CycleAlignment field: vec of the CN_* cycles that align at this point.
#must_use
fn calgn_cycles(p) { return load64(p + CALG_CYCLES); }
# CycleAlignment field: maximum residual error in days across the aligned cycles (f64).
#must_use
fn calgn_maxres(p) { return load64(p + CALG_MAXRES); }

# Find dates when multiple cycles align within tolerance_days. Steps by the
# shortest cycle (min of the periods, at least 1 day). Returns Ok(vec of
# CycleAlignment) or Err (InvalidDate if start >= end; ComputationError if < 2
# cycles or the search exceeds 10,000,000 steps).
#must_use
fn find_cycle_alignments(cycles, start_jdn, end_jdn, tolerance_days) {
    if (f64_ge(start_jdn, end_jdn) == 1) {
        return sk_fail(SKE_INVALID_DATE, str_from("start_jdn must be before end_jdn"));
    }
    var nc = vec_len(cycles);
    if (nc < 2) {
        return sk_fail(SKE_COMPUTATION, str_from("need at least 2 cycles for alignment search"));
    }

    var periods = vec_new();
    var pi = 0;
    while (pi < nc) {
        vec_push(periods, cycle_period(vec_get(cycles, pi)));
        pi = pi + 1;
    }

    # step = min(periods).max(1.0) — fold from the first period (fold seed
    # f64::INFINITY reduces to min over the >= 2 periods).
    var minp = vec_get(periods, 0);
    var mi = 1;
    while (mi < nc) {
        var pp = vec_get(periods, mi);
        if (f64_lt(pp, minp) == 1) { minp = pp; }
        mi = mi + 1;
    }
    var step = f64_max(minp, f64_from(1));

    var num_steps = f64_to(f64_ceil(f64_div(f64_sub(end_jdn, start_jdn), step)));
    if (num_steps > 10000000) {
        var sbo = str_builder_new();
        str_builder_add_cstr(sbo, "search space too large: ");
        str_builder_add_int(sbo, num_steps);
        str_builder_add_cstr(sbo, " steps (max ");
        str_builder_add_int(sbo, 10000000);
        str_builder_add_cstr(sbo, ")");
        return sk_fail(SKE_COMPUTATION, str_builder_build(sbo));
    }

    var alignments = vec_new();
    var jdn = start_jdn;
    while (f64_lt(jdn, end_jdn) == 1) {
        var max_residual = f64_from(0);
        var all_aligned = 1;
        var k = 0;
        while (k < nc) {
            var period = vec_get(periods, k);
            var elapsed = f64_sub(jdn, start_jdn);
            var ratio = f64_div(elapsed, period);
            var residual = f64_mul(f64_abs(f64_sub(ratio, f64_round(ratio))), period);
            if (f64_gt(residual, tolerance_days) == 1) {
                all_aligned = 0;
                k = nc;
            }
            if (k < nc) {
                if (f64_gt(residual, max_residual) == 1) { max_residual = residual; }
                k = k + 1;
            }
        }
        if (all_aligned == 1) {
            var cyc_copy = vec_new();
            var ci = 0;
            while (ci < nc) {
                vec_push(cyc_copy, vec_get(cycles, ci));
                ci = ci + 1;
            }
            vec_push(alignments, calgn_new(jdn, cyc_copy, max_residual));
        }
        jdn = f64_add(jdn, step);
    }
    return Ok(alignments);
}

# ---------------------------------------------------------------------------
# Saptarishi profile pair: { name: Str, profile: ptr } — 16 bytes.
# Matches the Rust Vec<(String, avatara::ArchetypeProfile)> shape.
enum SapOff { SAP_NAME = 0; SAP_PROFILE = 8; SAP_SIZE = 16; }

# Construct a Saptarishi profile pair (fresh 16-byte alloc) storing: name and the avatara
# ArchetypeProfile pointer. correlate() passes avatara's prof_name (a C-string) as the name.
#must_use
fn sap_new(name, profile) {
    var p = alloc(SAP_SIZE);
    store64(p + SAP_NAME, name);
    store64(p + SAP_PROFILE, profile);
    return p;
}
# Saptarishi pair field: the sage name (a C-string from avatara prof_name in correlate()).
#must_use
fn sap_name(p) { return load64(p + SAP_NAME); }
# Saptarishi pair field: the avatara ArchetypeProfile pointer.
#must_use
fn sap_profile(p) { return load64(p + SAP_PROFILE); }

# ---------------------------------------------------------------------------
# MultiCalendarDate record — the "Rosetta Stone" output (18 fields, 144 bytes).
# Option<T> fields (mayan_long_count / tzolkin / haab) use 0 for None.
# eras/civilizations/events are vecs of itihas record ptrs; saptarishi_profiles
# is a vec of SapOff pair records (always-on, full parity).
# ---------------------------------------------------------------------------
enum McdOff {
    MCD_JDN = 0;
    MCD_MAYAN_LC = 8;
    MCD_TZOLKIN = 16;
    MCD_HAAB = 24;
    MCD_SOTHIC = 32;
    MCD_AGE = 40;
    MCD_JULIAN_YEAR = 48;
    MCD_GREGORIAN = 56;
    MCD_COPTIC = 64;
    MCD_PERSIAN = 72;
    MCD_HEBREW = 80;
    MCD_CHINESE = 88;
    MCD_TONAL = 96;
    MCD_XIUH = 104;
    MCD_ERAS = 112;
    MCD_CIVS = 120;
    MCD_EVENTS = 128;
    MCD_SAPTARISHI = 136;
    MCD_SIZE = 144;
}

# MultiCalendarDate field: the Julian Day Number (f64), the common currency.
#must_use
fn mcd_jdn(p) { return load64(p + MCD_JDN); }
# MultiCalendarDate field: Mayan LongCount record, or 0 (None) before the Mayan epoch.
#must_use
fn mcd_mayan_lc(p) { return load64(p + MCD_MAYAN_LC); }
# MultiCalendarDate field: Mayan Tzolkin record, or 0 (None) before the Mayan epoch.
#must_use
fn mcd_tzolkin(p) { return load64(p + MCD_TZOLKIN); }
# MultiCalendarDate field: Mayan Haab record, or 0 (None) before the Mayan epoch.
#must_use
fn mcd_haab(p) { return load64(p + MCD_HAAB); }
# MultiCalendarDate field: Egyptian SothicPos record (cycle, year_in_cycle, f64 drift days).
#must_use
fn mcd_sothic(p) { return load64(p + MCD_SOTHIC); }
# MultiCalendarDate field: the AgePosition record (precessional age and position).
#must_use
fn mcd_age(p) { return load64(p + MCD_AGE); }
# MultiCalendarDate field: approximate Julian calendar year, f64 (negative = BCE).
#must_use
fn mcd_julian_year(p) { return load64(p + MCD_JULIAN_YEAR); }
# MultiCalendarDate field: the proleptic Gregorian date record (GregorianDate).
#must_use
fn mcd_gregorian(p) { return load64(p + MCD_GREGORIAN); }
# MultiCalendarDate field: the Coptic (Alexandrian) date record (CopticDate).
#must_use
fn mcd_coptic(p) { return load64(p + MCD_COPTIC); }
# MultiCalendarDate field: the Persian (Solar Hijri / Jalaali) date record (PersianDate).
#must_use
fn mcd_persian(p) { return load64(p + MCD_PERSIAN); }
# MultiCalendarDate field: the Hebrew date record (HebrewDate).
#must_use
fn mcd_hebrew(p) { return load64(p + MCD_HEBREW); }
# MultiCalendarDate field: the Chinese sexagenary (60-year) cycle year (SexagenaryYear).
#must_use
fn mcd_chinese(p) { return load64(p + MCD_CHINESE); }
# MultiCalendarDate field: the Aztec Tonalpohualli (260-day sacred cycle) record.
#must_use
fn mcd_tonalpohualli(p) { return load64(p + MCD_TONAL); }
# MultiCalendarDate field: the Aztec Xiuhpohualli (365-day solar cycle) record.
#must_use
fn mcd_xiuhpohualli(p) { return load64(p + MCD_XIUH); }
# MultiCalendarDate field: vec of itihas eras containing the rounded Julian year.
#must_use
fn mcd_eras(p) { return load64(p + MCD_ERAS); }
# MultiCalendarDate field: vec of itihas civilizations active at the rounded Julian year.
#must_use
fn mcd_civs(p) { return load64(p + MCD_CIVS); }
# MultiCalendarDate field: vec of itihas events at the rounded Julian year.
#must_use
fn mcd_events(p) { return load64(p + MCD_EVENTS); }
# MultiCalendarDate field: vec of Saptarishi (name, ArchetypeProfile) pair records (sap_*).
#must_use
fn mcd_saptarishi(p) { return load64(p + MCD_SAPTARISHI); }

# Convert a JDN to a MultiCalendarDate expressing that moment in every calendar
# sankhya knows, plus itihas historical context and avatara Saptarishi profiles.
# Returns Ok(MultiCalendarDate) or Err (Mayan Long Count overflow for extreme
# dates, re-wrapped as ComputationError to mirror the Rust map_err).
#must_use
fn correlate(jdn) {
    # ADR-007: a NaN JDN came back Ok with NaN fields, and |JDN| beyond ~1e14 hung in the
    # Coptic/Hebrew year searches (as in Rust). Both are Err now.
    if (f64_is_finite(jdn) == 0) {
        return sk_fail(SKE_INVALID_DATE, str_from("JDN must be finite"));
    }
    if (f64_gt(f64_abs(jdn), f64_from(100000000000000)) == 1) {
        var sbl = str_builder_new();
        str_builder_add_cstr(sbl, "JDN ");
        str_builder_add(sbl, sk_f64_display(jdn));
        str_builder_add_cstr(sbl, " outside the supported range +/-1e14");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sbl));
    }
    # tracing::debug!(jdn, "correlating JDN to multi-calendar date")
    if (SK_DEBUG <= sk_log_level()) {
        var _ds = str_from_int(f64_to(jdn));
        sk_log_kv(SK_DEBUG, "correlating JDN to multi-calendar date", 38, "jdn", 3, str_data(_ds), str_len(_ds));
    }

    # Mayan calendars (None if before the Mayan epoch). The day is the civil day containing
    # jdn, floor(jdn + 0.5), as the Hebrew and Aztec conversions take it. The Rust
    # truncated (`jdn as u64`), so every midnight JDN, which is what convert() passes for
    # a calendar date, read as the day before: Gregorian 21 Dec 2012 gave 12.19.19.17.19
    # while convert(13.0.0.0.0) gave 21 Dec 2012 (ADR-008).
    var jdn_civil = f64_to(f64_floor(f64_add(jdn, F64_HALF)));
    var mayan_lc = 0;
    var tzolkin = 0;
    var haab = 0;
    if (jdn_civil >= EPOCH_JDN) {
        var days = jdn_civil - EPOCH_JDN;
        var lc_res_t, lc_res_v = long_count_from_days(days);
        if (is_ok(lc_res_t) == 0) {
            # map_err(|e| ComputationError(format!("Mayan Long Count: {e}")))
            var em = sk_err_msg(err_code_of(lc_res_t, lc_res_v));
            var sbm = str_builder_new();
            str_builder_add_cstr(sbm, "Mayan Long Count: ");
            if (em != 0) { str_builder_add(sbm, em); }
            return sk_fail(SKE_COMPUTATION, str_builder_build(sbm));
        }
        mayan_lc = result_unwrap(lc_res_t, lc_res_v);
        tzolkin = tzolkin_from_days(days);
        haab = haab_from_days(days);
    }

    # Egyptian Sothic position (record carrying cycle/year/drift).
    var sothic = sothic_position(jdn);

    # Precession.
    var age = precessional_age(jdn);

    # Approximate Julian year.
    var year = jdn_to_julian_year(jdn);

    # Historical context from itihas (always-on). approx_year = year.round() as i32.
    var approx_year = f64_to(f64_round(year));
    var eras = eras_containing(approx_year);
    var civs = civs_active_at(approx_year);
    var events = events_at_year(approx_year);

    # Saptarishi archetype profiles from avatara (always-on): each profile p
    # becomes a (prof_name(p), p) pair, mirroring Vec<(String, ArchetypeProfile)>.
    var profiles = vec_new();
    var sages = all_incarnate_sage();
    var sn = vec_len(sages);
    var si = 0;
    while (si < sn) {
        var sage = vec_get(sages, si);
        vec_push(profiles, sap_new(prof_name(sage), sage));
        si = si + 1;
    }

    var p = alloc(MCD_SIZE);
    store64(p + MCD_JDN, jdn);
    store64(p + MCD_MAYAN_LC, mayan_lc);
    store64(p + MCD_TZOLKIN, tzolkin);
    store64(p + MCD_HAAB, haab);
    store64(p + MCD_SOTHIC, sothic);
    store64(p + MCD_AGE, age);
    store64(p + MCD_JULIAN_YEAR, year);
    store64(p + MCD_GREGORIAN, jdn_to_gregorian(jdn));
    store64(p + MCD_COPTIC, jdn_to_coptic(jdn));
    store64(p + MCD_PERSIAN, jdn_to_persian(jdn));
    store64(p + MCD_HEBREW, jdn_to_hebrew(jdn));
    store64(p + MCD_CHINESE, sexagenary_from_jdn(jdn));
    store64(p + MCD_TONAL, tonalpohualli_from_jdn(jdn));
    store64(p + MCD_XIUH, xiuhpohualli_from_jdn(jdn));
    store64(p + MCD_ERAS, eras);
    store64(p + MCD_CIVS, civs);
    store64(p + MCD_EVENTS, events);
    store64(p + MCD_SAPTARISHI, profiles);
    return Ok(p);
}

# ---------------------------------------------------------------------------
# Unified calendar conversion API
# ---------------------------------------------------------------------------
# CalendarDate tagged union: { tag: CalDateTag, value } — 16 bytes. For CDT_JDN
# the value is an f64 bit pattern; otherwise it is a date-record pointer.
enum CdvOff { CDV_TAG = 0; CDV_VAL = 8; CDV_SIZE = 16; }

# Construct a CalendarDate tagged-union record (fresh 16-byte alloc) storing: tag (CDT_*)
# and value (an f64 JDN for CDT_JDN, otherwise a date-record pointer, stored as-is).
#must_use
fn cdv_new(tag, val) {
    var p = alloc(CDV_SIZE);
    store64(p + CDV_TAG, tag);
    store64(p + CDV_VAL, val);
    return p;
}
# CalendarDate field: the variant tag (CDT_*).
#must_use
fn cdv_tag(p) { return load64(p + CDV_TAG); }
# CalendarDate field: the payload (f64 JDN for CDT_JDN, otherwise a date-record pointer).
#must_use
fn cdv_val(p) { return load64(p + CDV_VAL); }

# CalendarDate variant constructors.
# CalendarDate::Jdn: wrap an f64 Julian Day Number in a fresh CalendarDate.
#must_use
fn caldate_jdn(jdn) { return cdv_new(CDT_JDN, jdn); }
# CalendarDate::Gregorian: wrap a proleptic GregorianDate record in a fresh CalendarDate.
#must_use
fn caldate_gregorian(date) { return cdv_new(CDT_GREGORIAN, date); }
# CalendarDate::Coptic: wrap a CopticDate record in a fresh CalendarDate.
#must_use
fn caldate_coptic(date) { return cdv_new(CDT_COPTIC, date); }
# CalendarDate::Persian: wrap a Solar Hijri (Jalaali) PersianDate in a fresh CalendarDate.
#must_use
fn caldate_persian(date) { return cdv_new(CDT_PERSIAN, date); }
# CalendarDate::Hebrew: wrap a HebrewDate record in a fresh CalendarDate.
#must_use
fn caldate_hebrew(date) { return cdv_new(CDT_HEBREW, date); }
# CalendarDate::Hijri: wrap a tabular Islamic HijriDate record in a fresh CalendarDate.
#must_use
fn caldate_hijri(date) { return cdv_new(CDT_HIJRI, date); }
# CalendarDate::MayanLongCount: wrap a Mayan LongCount record in a fresh CalendarDate.
#must_use
fn caldate_mayan_long_count(lc) { return cdv_new(CDT_MAYAN_LC, lc); }

# Convert any supported CalendarDate to its Julian Day Number. Returns Ok(f64)
# or Err (InvalidDate) for out-of-range dates. Dispatches to each sibling
# module's *_to_jdn; Jdn is direct; MayanLongCount is to_julian_day() - 0.5.
#must_use
fn calendar_to_jdn(date) {
    # tracing::debug!(?date, "converting calendar date to JDN")
    if (SK_DEBUG <= sk_log_level()) {
        var _dm = str_from("converting calendar date to JDN");
        sk_debug(str_data(_dm), str_len(_dm));
    }
    # A null date (0 from a caller's own bookkeeping) or a tag outside the six variants was
    # read as a Mayan Long Count record (ADR-007). From 3.2.0 calendar_date_from_json returns
    # an Err for malformed input instead of a 0 date, so this guards hand-built values.
    if (date == 0) { return sk_fail(SKE_INVALID_DATE, str_from("no calendar date")); }
    var tag = cdv_tag(date);
    var val = cdv_val(date);
    if (tag < CDT_JDN || tag > CDT_MAYAN_LC) {
        return sk_fail(SKE_INVALID_DATE, str_from("unknown calendar date variant"));
    }
    if (tag == CDT_JDN) { return Ok(val); }
    if (tag == CDT_GREGORIAN) { return gregorian_to_jdn(val); }
    if (tag == CDT_COPTIC) { return coptic_to_jdn(val); }
    if (tag == CDT_PERSIAN) { return persian_to_jdn(val); }
    if (tag == CDT_HEBREW) { return hebrew_to_jdn(val); }
    if (tag == CDT_HIJRI) { return hijri_to_jdn(val); }
    # CDT_MAYAN_LC: to_julian_day() as f64 - 0.5.
    if (val == 0) { return sk_fail(SKE_INVALID_DATE, str_from("no Long Count record")); }
    var jd = long_count_to_julian_day(val);
    return Ok(f64_sub(f64_from(jd), F64_HALF));
}

# Unified any-to-any conversion: input -> JDN -> all systems. Returns
# Ok(MultiCalendarDate) or the propagated Err from calendar_to_jdn/correlate.
#must_use
fn convert(date) {
    # tracing::info!(?date, "unified calendar conversion")
    if (SK_INFO <= sk_log_level()) {
        var _im = str_from("unified calendar conversion");
        sk_info(str_data(_im), str_len(_im));
    }
    var jr_t, jr_v = calendar_to_jdn(date);
    if (is_ok(jr_t) == 0) { return Err(jr_v); }
    var jdn = result_unwrap(jr_t, jr_v);
    return correlate(jdn);
}

# --- serial_util.cyr ---

# serial_util.cyr — shared JSON (de)serialization helpers for the per-module
# serial_<module>.cyr files. Output matches Rust serde_json exactly.
#
# bayan (folded stdlib) provides str_builder_add_json_str (emit: adds surrounding
# quotes + RFC-8259 escaping) and bayan_json_v_* (parse into a tagged value tree).
# Helpers are sk_json_*-prefixed to avoid colliding with itihas's bundled serial.cyr
# (_json_str/_json_int/_json_sep).

# writes  "key":
fn sk_json_key(sb, key) {
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\":");
    return 0;
}

# String field  "key":"escaped"  — val is a Str.
fn sk_json_str(sb, key, val) {
    sk_json_key(sb, key);
    str_builder_add_json_str(sb, val);
    return 0;
}

# String field from a C-string literal.
fn sk_json_cstr(sb, key, cstr) {
    sk_json_key(sb, key);
    str_builder_add_json_str(sb, str_from(cstr));
    return 0;
}

# Integer field  "key":123
fn sk_json_int(sb, key, n) {
    sk_json_key(sb, key);
    str_builder_add_int(sb, n);
    return 0;
}

# Bool field  "key":true / "key":false  (JSON booleans, matching serde).
fn sk_json_bool(sb, key, b) {
    sk_json_key(sb, key);
    if (b != 0) { str_builder_add_cstr(sb, "true"); }
    else { str_builder_add_cstr(sb, "false"); }
    return 0;
}

# Field separator.
fn sk_json_sep(sb) { str_builder_add_cstr(sb, ","); return 0; }

# Parse a JSON Str into a bayan value tree (0 on error). Wrapper over bayan.
# NOTE: bayan_json_v_parse takes a Str (it does str_data/str_len internally) —
# pass the Str directly, NOT str_data(js).
#must_use
fn sk_json_parse(js) {
    return bayan_json_v_parse(js);
}

# ===========================================================================
# Decoding (3.2.0): every <type>_from_json returns a Result, as serde_json's
# from_str did. Ok(value), or Err(SkErr{SKE_DESERIALIZE, msg}) with serde's wording:
#   missing field `year`
#   unknown variant `Foo`, expected one of `January`, `February`, ...
#   invalid type: string "x", expected u8
#   invalid value: integer `-5`, expected u8
# serde_json appends " at line L column C"; bayan's value tree keeps no positions, so the
# messages stop before it. As with serde's derive, unknown object keys are ignored and no
# domain validation happens here (a day of 40 decodes; gregorian_to_jdn rejects it).
# ===========================================================================

# Integer ranges of the Rust field types, for sk_de_int.
var SK_U8_MAX = 255;
var SK_U16_MAX = 65535;
var SK_U32_MAX = 4294967295;
var SK_I32_MIN = 0 - 2147483648;
var SK_I32_MAX = 2147483647;
var SK_I64_MIN = 0 - 0x7FFFFFFFFFFFFFFF - 1;
var SK_I64_MAX = 0x7FFFFFFFFFFFFFFF;

# Err(SKE_DESERIALIZE) carrying msg (a Str).
fn sk_de_fail(msg) {
    return sk_fail(SKE_DESERIALIZE, msg);
}

# serde's description of an unexpected JSON value: null, boolean `true`, integer `5`,
# floating point `1.5`, string "x", sequence, map. v == 0 (no node) reads as null.
#must_use
fn sk_de_unexpected(v) {
    var sb = str_builder_new();
    var t = bayan_json_v_tag(v);
    if (v == 0 || t == JTAG_NULL) { str_builder_add_cstr(sb, "null"); }
    if (v != 0 && t == JTAG_BOOL) {
        str_builder_add_cstr(sb, "boolean `");
        if (bayan_json_v_bool(v) != 0) { str_builder_add_cstr(sb, "true`"); }
        else { str_builder_add_cstr(sb, "false`"); }
    }
    if (v != 0 && t == JTAG_INT) {
        str_builder_add_cstr(sb, "integer `");
        str_builder_add_int(sb, bayan_json_v_int(v));
        str_builder_add_cstr(sb, "`");
    }
    if (v != 0 && t == JTAG_FLOAT) {
        str_builder_add_cstr(sb, "floating point `");
        var buf = alloc(48);
        if (buf != 0) {
            var n = bayan_f64_to_json(bayan_json_v_float(v), buf);
            str_builder_add(sb, str_new(buf, n));
        }
        str_builder_add_cstr(sb, "`");
    }
    if (v != 0 && t == JTAG_STR) {
        str_builder_add_cstr(sb, "string ");
        str_builder_add_json_str(sb, bayan_json_v_str(v));
    }
    if (v != 0 && t == JTAG_ARR) { str_builder_add_cstr(sb, "sequence"); }
    if (v != 0 && t == JTAG_OBJ) { str_builder_add_cstr(sb, "map"); }
    return str_builder_build(sb);
}

# Err "invalid type: <what v is>, expected <expected>" (expected is a C-string).
fn sk_de_invalid_type(v, expected) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "invalid type: ");
    str_builder_add(sb, sk_de_unexpected(v));
    str_builder_add_cstr(sb, ", expected ");
    str_builder_add_cstr(sb, expected);
    return sk_de_fail(str_builder_build(sb));
}

# Ok(v) when v is a JSON object, else Err "invalid type: ..., expected struct <name>".
#must_use
fn sk_de_struct(v, name) {
    if (bayan_json_v_is_obj(v) == 1) { return Ok(v); }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "struct ");
    str_builder_add_cstr(sb, name);
    return sk_de_invalid_type(v, str_cstr(str_builder_build(sb)));
}

# Ok(the node for key) of object obj, or Err "missing field `key`".
#must_use
fn sk_de_field(obj, key) {
    var n = bayan_json_v_obj_get_by_cstr(obj, key);
    if (n != 0) { return Ok(n); }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "missing field `");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "`");
    return sk_de_fail(str_builder_build(sb));
}

# Ok(i64) when node is a JSON integer within lo..hi, else Err: "invalid type" for any
# other JSON type (a float too, as serde: 1.0 is not a u8), "invalid value: integer `N`,
# expected <ty>" when out of range. ty names the Rust type ("u8", "i32", ...).
#must_use
fn sk_de_int(node, lo, hi, ty) {
    if (bayan_json_v_is_int(node) != 1) { return sk_de_invalid_type(node, ty); }
    var n = bayan_json_v_int(node);
    if (n < lo || n > hi) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "invalid value: integer `");
        str_builder_add_int(sb, n);
        str_builder_add_cstr(sb, "`, expected ");
        str_builder_add_cstr(sb, ty);
        return sk_de_fail(str_builder_build(sb));
    }
    return Ok(n);
}

# sk_de_int on field key of object obj (missing field -> Err).
#must_use
fn sk_de_int_field(obj, key, lo, hi, ty) {
    var n = sk_de_field(obj, key)?;
    return sk_de_int(n, lo, hi, ty);
}

# Ok(f64 bits) when node is a JSON number (an integer converts, as serde accepts), else
# Err "invalid type: ..., expected f64". null is an Err: serde_json writes NaN and +/-Inf
# as null and then cannot read them back, and neither can this.
#must_use
fn sk_de_f64(node) {
    if (bayan_json_v_is_float(node) == 1) { return Ok(bayan_json_v_float(node)); }
    if (bayan_json_v_is_int(node) == 1) { return Ok(f64_from(bayan_json_v_int(node))); }
    return sk_de_invalid_type(node, "f64");
}

# sk_de_f64 on field key of object obj.
#must_use
fn sk_de_f64_field(obj, key) {
    var n = sk_de_field(obj, key)?;
    return sk_de_f64(n);
}

# Ok(Str) when node is a JSON string, else Err "invalid type: ..., expected a string".
#must_use
fn sk_de_str(node) {
    if (bayan_json_v_is_str(node) == 1) { return Ok(bayan_json_v_str(node)); }
    return sk_de_invalid_type(node, "a string");
}

# sk_de_str on field key of object obj.
#must_use
fn sk_de_str_field(obj, key) {
    var n = sk_de_field(obj, key)?;
    return sk_de_str(n);
}

# Ok(0/1) when node is a JSON boolean, else Err "invalid type: ..., expected a boolean".
#must_use
fn sk_de_bool(node) {
    if (bayan_json_v_is_bool(node) == 1) {
        if (bayan_json_v_bool(node) != 0) { return Ok(1); }
        return Ok(0);
    }
    return sk_de_invalid_type(node, "a boolean");
}

# sk_de_bool on field key of object obj.
#must_use
fn sk_de_bool_field(obj, key) {
    var n = sk_de_field(obj, key)?;
    return sk_de_bool(n);
}

# Ok(node) when node is a JSON array, else Err "invalid type: ..., expected a sequence".
#must_use
fn sk_de_seq(node) {
    if (bayan_json_v_is_arr(node) == 1) { return Ok(node); }
    return sk_de_invalid_type(node, "a sequence");
}

# sk_de_seq on field key of object obj.
#must_use
fn sk_de_seq_field(obj, key) {
    var n = sk_de_field(obj, key)?;
    return sk_de_seq(n);
}

# An Option<T> field: Ok(0) when key is missing or null (serde's derive reads both as None),
# else Ok(the node).
#must_use
fn sk_de_opt_field(obj, key) {
    var n = bayan_json_v_obj_get_by_cstr(obj, key);
    if (n == 0) { return Ok(0); }
    if (bayan_json_v_is_null(n) == 1) { return Ok(0); }
    return Ok(n);
}

# Err "unknown variant `name`, expected <list>", serde's wording: "expected `A`" for one
# variant, "expected `A` or `B`" for two, "expected one of `A`, `B`, `C`" for more.
fn sk_de_unknown_variant(name, names) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "unknown variant `");
    str_builder_add(sb, name);
    str_builder_add_cstr(sb, "`, expected ");
    var n = vec_len(names);
    if (n > 2) { str_builder_add_cstr(sb, "one of "); }
    var i = 0;
    while (i < n) {
        if (i > 0) {
            if (n == 2) { str_builder_add_cstr(sb, " or "); } else { str_builder_add_cstr(sb, ", "); }
        }
        str_builder_add_cstr(sb, "`");
        str_builder_add(sb, vec_get(names, i));
        str_builder_add_cstr(sb, "`");
        i = i + 1;
    }
    return sk_de_fail(str_builder_build(sb));
}

# A unit-variant enum: Ok(index into names) when node is a string equal to names[i] (a vec
# of the serde identifiers as Strs, in discriminant order), else Err "unknown variant" for
# an unknown string or "invalid type: ..., expected variant identifier" for a non-string.
#must_use
fn sk_de_variant(node, names) {
    if (bayan_json_v_is_str(node) != 1) { return sk_de_invalid_type(node, "variant identifier"); }
    var s = bayan_json_v_str(node);
    var i = 0;
    while (i < vec_len(names)) {
        if (str_eq(vec_get(names, i), s) == 1) { return Ok(i); }
        i = i + 1;
    }
    return sk_de_unknown_variant(s, names);
}

# sk_de_variant on field key of object obj.
#must_use
fn sk_de_variant_field(obj, key, names) {
    var n = sk_de_field(obj, key)?;
    return sk_de_variant(n, names);
}

# An externally tagged enum whose variants carry data, as serde writes it: {"Variant": {..}}.
# Ok(index into names) when v is an object with exactly one key naming a variant; the
# payload is then bayan_json_v_obj_val(v, 0). Errors as serde's: a non-object is "invalid
# type: ..., expected enum <name>", an unknown key "unknown variant", and an object with
# zero or several keys "invalid value: map, expected map with a single key".
#must_use
fn sk_de_tagged(v, names, enum_name) {
    if (bayan_json_v_is_obj(v) != 1) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "enum ");
        str_builder_add_cstr(sb, enum_name);
        return sk_de_invalid_type(v, str_cstr(str_builder_build(sb)));
    }
    if (bayan_json_v_obj_len(v) != 1) {
        return sk_de_fail(str_from("invalid value: map, expected map with a single key"));
    }
    var key = bayan_json_v_obj_key(v, 0);
    var i = 0;
    while (i < vec_len(names)) {
        if (str_eq(vec_get(names, i), key) == 1) { return Ok(i); }
        i = i + 1;
    }
    return sk_de_unknown_variant(key, names);
}

# Parse a JSON Str and decode it in one step: Ok(node) or Err on malformed JSON (bayan
# returned 0). The decoders take a node, so this is the usual first call.
#must_use
fn sk_de_parse(js) {
    var v = bayan_json_v_parse(js);
    if (v == 0) { return sk_de_fail(str_from("malformed JSON")); }
    return Ok(v);
}

# --- serial_gregorian.cyr ---

# serial_gregorian.cyr — JSON (de)serialization for the gregorian module.
#
# Full serde ROUND-TRIP parity with the Rust derived Serialize + Deserialize on
# GregorianMonth and GregorianDate (rust-old/src/gregorian.rs). Emit format
# matches serde_json EXACTLY (compact, no spaces):
#   GregorianMonth (unit enum) -> the variant-name JSON string, e.g. "January".
#   GregorianDate  -> {"year":<i64>,"month":"<variant>","day":<u8>}
#
# SELF-CONTAINED: no include lines. Uses the sk_json_* helpers from
# src/serial_util.cyr, the bayan_json_v_* value tree, and the gregorian module's
# constructors/getters/name accessors (all resolved from the consumer bundle).

# ---------------------------------------------------------------------------
# GregorianMonth enum <-> variant-name string
# ---------------------------------------------------------------------------

# Map a serde variant-name string (a Str) back to a GregorianMonth discriminant
# (0..11). Returns (0 - 1) if no month name matches. The module already exposes
# gregorian_month_name(i); this is the inverse it lacked.
#must_use
fn gregorian_month_from_name(name) {
    var i = 0;
    while (i < 12) {
        if (str_eq(gregorian_month_name(i), name) != 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Serialize a GregorianMonth discriminant as a bare JSON string (serde emits a
# unit enum variant as its quoted name), e.g. GM_JANUARY -> "January".
#must_use
fn gregorian_month_to_json(m) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, gregorian_month_name(m));
    return str_builder_build(sb);
}

# Deserialize a GregorianMonth from a bayan value node holding a JSON string, as serde:
# Ok(discriminant), or Err(SKE_DESERIALIZE) "unknown variant" / "invalid type".
#must_use
fn gregorian_month_from_json(v) {
    return sk_de_variant(v, gregorian_month_names());
}

# Field-by-field equality for a GregorianMonth (a plain integer discriminant).
#must_use
fn gregorian_month_eq(a, b) {
    if (a == b) { return 1; }
    return 0;
}

# ---------------------------------------------------------------------------
# GregorianDate struct <-> JSON object
# ---------------------------------------------------------------------------

# Serialize a GregorianDate pointer to {"year":..,"month":"..","day":..}.
# Field order matches the Rust struct declaration order (year, month, day).
# month is emitted as the variant-name string (NOT the integer).
#must_use
fn gregorian_date_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "year", gd_year(p));
    sk_json_sep(sb);
    sk_json_str(sb, "month", gregorian_month_name(gd_month(p)));
    sk_json_sep(sb);
    sk_json_int(sb, "day", gd_day(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a GregorianDate from a bayan value tree node (an object).
# Ok(GregorianDate) or Err(SKE_DESERIALIZE), with serde's checks on the Rust field types:
# year an i64, month a GregorianMonth variant, day a u8. No calendar validation (serde's
# derive does none either; gregorian_to_jdn rejects day 40).
#must_use
fn gregorian_date_from_json(v) {
    var obj = sk_de_struct(v, "GregorianDate")?;
    var year = sk_de_int_field(obj, "year", SK_I64_MIN, SK_I64_MAX, "i64")?;
    var month = sk_de_variant_field(obj, "month", gregorian_month_names())?;
    var day = sk_de_int_field(obj, "day", 0, SK_U8_MAX, "u8")?;
    return Ok(gregorian_date_new(year, month, day));
}

# Field-by-field equality of two GregorianDate pointers (for the round-trip test).
#must_use
fn gregorian_date_eq(a, b) {
    if (gd_year(a) != gd_year(b)) { return 0; }
    if (gd_month(a) != gd_month(b)) { return 0; }
    if (gd_day(a) != gd_day(b)) { return 0; }
    return 1;
}

# --- serial_roman.cyr ---

# serial_roman.cyr — JSON (de)serialization for the roman module.
#
# Full serde round-trip parity with Rust's derived Serialize + Deserialize on
#   pub struct RomanNumeral { value: u32, text: String }
# serde_json emits fields in declaration order (value, then text), compact:
#   {"value":1776,"text":"MDCCLXXVI"}
#
# Self-contained (NO include lines). Relies on:
#   * serial_util.cyr — sk_json_int / sk_json_str / sk_json_sep, and the sk_de_* decoders
#   * roman.cyr       — romannum_new / romannum_value / romannum_text (RN_* offsets)
#
# Decoding (3.2.0) returns a Result as serde_json::from_str did. The Rust type uses the
# plain derive, so both fields decode as-is: the text is NOT re-derived from the value and
# neither is validated ({"value":5,"text":"IV"} decodes, as it does in Rust).
#
# There are NO enums, floats, bools, nested structs, arrays, or Options among
# roman's serde types, so this is a plain {int, string} record.

# --- RomanNumeral ------------------------------------------------------------

# RomanNumeral → {"value":N,"text":"STR"}  (Rust field order: value, then text).
#must_use
fn romannum_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "value", romannum_value(p));
    sk_json_sep(sb);
    sk_json_str(sb, "text", romannum_text(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a RomanNumeral from a bayan value node (a JSON object), as serde's derive:
# Ok(RomanNumeral) or Err(SKE_DESERIALIZE) — value a u32, text a String, both stored as
# decoded (no 1-3999 or canonical-text check; romannum_from_value / romannum_parse do that).
#must_use
fn romannum_from_json(v) {
    var obj = sk_de_struct(v, "RomanNumeral")?;
    var value = sk_de_int_field(obj, "value", 0, SK_U32_MAX, "u32")?;
    var text = sk_de_str_field(obj, "text")?;
    return Ok(romannum_new(value, text));
}

# Field-by-field equality for the round-trip test.
#must_use
fn romannum_eq(a, b) {
    if (romannum_value(a) != romannum_value(b)) { return 0; }
    if (str_eq(romannum_text(a), romannum_text(b)) == 0) { return 0; }
    return 1;
}

# --- serial_greek.cyr ---

# serial_greek.cyr — JSON (de)serialization for the greek module, matching
# Rust serde_json exactly for full round-trip parity.
#
# Self-contained: no include lines. Uses the shared sk_json_* helpers from
# src/serial_util.cyr, the bayan value-tree API (folded stdlib), and the greek
# module's anti_new/anti_* accessors.
#
# Serde types in greek:
#   AntikytheraCycle  — struct { name: &str, period_years: &str,
#                                gear_teeth: u32, description: &str }
#     serde JSON: {"name":"Metonic","period_years":"19",
#                  "gear_teeth":235,"description":"..."}
#     name/period_years/description are STRINGS (period_years holds "19", a
#     quoted string, NOT the number 19). gear_teeth is an integer. No enums,
#     no f64, no nested/array/option fields in this module.
#
# Decoding (3.2.0) returns a Result as serde_json::from_str did: Ok(AntikytheraCycle)
# or Err(SKE_DESERIALIZE) with serde's message (the sk_de_* helpers in serial_util.cyr).
# The string fields are &'static str in Rust, so a non-string reads "expected a borrowed
# string" (serde's &str visitor) rather than String's "expected a string".

# ---------------------------------------------------------------------------
# AntikytheraCycle
# ---------------------------------------------------------------------------

# Serialize an AntikytheraCycle record to a JSON object string, byte-for-byte
# matching serde_json (compact, no spaces, Rust field names).
#must_use
fn anti_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_str(sb, "name", anti_name(p));
    sk_json_sep(sb);
    sk_json_str(sb, "period_years", anti_period_years(p));
    sk_json_sep(sb);
    sk_json_int(sb, "gear_teeth", anti_gear_teeth(p));
    sk_json_sep(sb);
    sk_json_str(sb, "description", anti_description(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# A Rust &'static str field key of object obj, as serde reads one: Ok(Str) for a JSON
# string, else Err "missing field" or "invalid type: ..., expected a borrowed string".
fn _acj_str_field(obj, key) {
    var n = sk_de_field(obj, key)?;
    var t, s = sk_de_str(n);
    if (is_ok(t) == 0) { return sk_de_invalid_type(n, "a borrowed string"); }
    return Ok(s);
}

# Deserialize an AntikytheraCycle from a bayan value node (an object, from sk_json_parse).
# Ok(AntikytheraCycle) or Err(SKE_DESERIALIZE), with serde's checks on the Rust field
# types: name, period_years and description &'static strs, gear_teeth a u32.
#must_use
fn anti_from_json(v) {
    var obj = sk_de_struct(v, "AntikytheraCycle")?;
    var name = _acj_str_field(obj, "name")?;
    var period = _acj_str_field(obj, "period_years")?;
    var teeth = sk_de_int_field(obj, "gear_teeth", 0, SK_U32_MAX, "u32")?;
    var desc = _acj_str_field(obj, "description")?;
    return Ok(anti_new(name, period, teeth, desc));
}

# Field-by-field equality of two AntikytheraCycle records (for round-trip
# testing). String fields compared with str_eq, the integer field with ==.
#must_use
fn anti_eq(a, b) {
    if (str_eq(anti_name(a), anti_name(b)) == 0) {
        return 0;
    }
    if (str_eq(anti_period_years(a), anti_period_years(b)) == 0) {
        return 0;
    }
    if (anti_gear_teeth(a) != anti_gear_teeth(b)) {
        return 0;
    }
    if (str_eq(anti_description(a), anti_description(b)) == 0) {
        return 0;
    }
    return 1;
}

# --- serial_vedic.cyr ---

# serial_vedic.cyr — JSON (de)serialization for the vedic module, full serde
# round-trip parity with Rust serde_json.
#
# IMPORTANT PARITY NOTE: rust-old/src/vedic.rs derives Serialize/Deserialize on
# NO type — it declares no structs and no enums. Its only compound values are
# plain return payloads:
#   * vedic_multiply_nikhilam -> Result<(u64,u64,u64,u64,u64)>   (a 5-tuple)
#   * meru_prastara           -> Result<Vec<Vec<u64>>>            (nested vecs)
# serde_json serializes a Rust tuple as a JSON ARRAY (no field names) and a
# Vec<Vec<u64>> as an array-of-arrays. Those two array forms are therefore the
# authoritative "Rust serde format" for this module, and this file reproduces
# them exactly (compact, no spaces — matching serde_json::to_string).
#
# The Cyrius port models the 5-tuple as the NikhilamSteps record (NkOff offsets,
# nikhilam_new, nk_base/nk_da/nk_db/nk_cross/nk_product in src/vedic.cyr); we
# emit/parse it as the 5-element array serde would produce for the tuple.
#
# Decoding (3.2.0) returns a Result as serde_json::from_str did: Ok(value) or
# Err(SKE_DESERIALIZE) with serde's message (the sk_de_* helpers in serial_util.cyr).
# Every number is a u64 (a negative is "invalid value: integer `-1`, expected u64"; the
# port's i64 cells cap it at i64::MAX). The tuple must be an array of exactly 5: a short
# one is "invalid length N, expected a tuple of size 5", a long one serde_json's
# "trailing characters".
#
# Self-contained: NO include lines. Resolves stdlib (str_builder_*, vec_*,
# bayan_json_v_*) and the vedic module accessors from the consumer's [deps].

# ---------------------------------------------------------------------------
# NikhilamSteps  <->  serde tuple  (u64,u64,u64,u64,u64)  ->  [b,da,db,cr,pr]
# ---------------------------------------------------------------------------

# Serialize the NikhilamSteps record as the JSON array serde_json emits for the
# tuple return of vedic_multiply_nikhilam: e.g. [100,3,4,93,9312].
#must_use
fn nikhilam_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    str_builder_add_int(sb, nk_base(p));
    str_builder_add_cstr(sb, ",");
    str_builder_add_int(sb, nk_da(p));
    str_builder_add_cstr(sb, ",");
    str_builder_add_int(sb, nk_db(p));
    str_builder_add_cstr(sb, ",");
    str_builder_add_int(sb, nk_cross(p));
    str_builder_add_cstr(sb, ",");
    str_builder_add_int(sb, nk_product(p));
    str_builder_add_cstr(sb, "]");
    return str_builder_build(sb);
}

# Element i of the tuple array arr (n elements) as a u64, or serde's tuple visitor Err
# "invalid length n, expected a tuple of size 5" when the array is too short.
fn _nkj_elem(arr, n, i) {
    if (i >= n) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "invalid length ");
        str_builder_add_int(sb, n);
        str_builder_add_cstr(sb, ", expected a tuple of size 5");
        return sk_de_fail(str_builder_build(sb));
    }
    return sk_de_int(bayan_json_v_arr_get(arr, i), 0, SK_I64_MAX, "u64");
}

# Deserialize a NikhilamSteps record from a bayan array node (the [b,da,db,cr,pr] array
# from sk_json_parse), as serde reads the (u64, u64, u64, u64, u64) tuple: Ok(NikhilamSteps)
# or Err(SKE_DESERIALIZE). A non-array is "expected a tuple of size 5". The steps are not
# re-checked against each other.
#must_use
fn nikhilam_from_json(v) {
    var t, arr = sk_de_seq(v);
    if (is_ok(t) == 0) { return sk_de_invalid_type(v, "a tuple of size 5"); }
    var n = bayan_json_v_arr_len(arr);
    var b = _nkj_elem(arr, n, 0)?;
    var da = _nkj_elem(arr, n, 1)?;
    var db = _nkj_elem(arr, n, 2)?;
    var cr = _nkj_elem(arr, n, 3)?;
    var pr = _nkj_elem(arr, n, 4)?;
    if (n > 5) { return sk_de_fail(str_from("trailing characters")); }
    return Ok(nikhilam_new(b, da, db, cr, pr));
}

# Field-by-field equality for the round-trip test. Returns 1 if equal, else 0.
#must_use
fn nikhilam_eq(a, b) {
    if (nk_base(a) != nk_base(b)) { return 0; }
    if (nk_da(a) != nk_da(b)) { return 0; }
    if (nk_db(a) != nk_db(b)) { return 0; }
    if (nk_cross(a) != nk_cross(b)) { return 0; }
    if (nk_product(a) != nk_product(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# Meru Prastara  <->  serde Vec<Vec<u64>>  ->  array-of-arrays [[1],[1,1],...]
# ---------------------------------------------------------------------------

# Serialize a vec-of-vecs (as produced by meru_prastara) as the nested JSON
# array serde_json emits, e.g. [[1],[1,1],[1,2,1],[1,3,3,1],[1,4,6,4,1]].
#must_use
fn meru_to_json(tri) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    var n = vec_len(tri);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var row = vec_get(tri, i);
        str_builder_add_cstr(sb, "[");
        var m = vec_len(row);
        var j = 0;
        while (j < m) {
            if (j > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_int(sb, vec_get(row, j));
            j = j + 1;
        }
        str_builder_add_cstr(sb, "]");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return str_builder_build(sb);
}

# Deserialize a vec-of-vecs from a bayan array-of-arrays node, as serde reads Vec<Vec<u64>>:
# Ok(vec of row vecs) or Err(SKE_DESERIALIZE) — the outer value and every row must be JSON
# arrays ("expected a sequence") and every cell a u64. The rows are not checked to form
# Pingala's triangle.
#must_use
fn meru_from_json(v) {
    var outer = sk_de_seq(v)?;
    var tri = vec_new();
    var n = bayan_json_v_arr_len(outer);
    var i = 0;
    while (i < n) {
        var rowv = sk_de_seq(bayan_json_v_arr_get(outer, i))?;
        var row = vec_new();
        var m = bayan_json_v_arr_len(rowv);
        var j = 0;
        while (j < m) {
            var cell = sk_de_int(bayan_json_v_arr_get(rowv, j), 0, SK_I64_MAX, "u64")?;
            vec_push(row, cell);
            j = j + 1;
        }
        vec_push(tri, row);
        i = i + 1;
    }
    return Ok(tri);
}

# Deep equality over the vec-of-vecs. Returns 1 if equal, else 0.
#must_use
fn meru_eq(a, b) {
    var na = vec_len(a);
    var nb = vec_len(b);
    if (na != nb) { return 0; }
    var i = 0;
    while (i < na) {
        var ra = vec_get(a, i);
        var rb = vec_get(b, i);
        var ma = vec_len(ra);
        var mb = vec_len(rb);
        if (ma != mb) { return 0; }
        var j = 0;
        while (j < ma) {
            if (vec_get(ra, j) != vec_get(rb, j)) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

# --- serial_mayan.cyr ---

# serial_mayan.cyr — JSON (de)serialization for the mayan module, matching
# Rust serde_json EXACTLY (compact, no spaces; field order = Rust declaration
# order; enum variants as their identifier strings).
#
# Serde types covered (7):
#   MayanNumeral { dots, bars, shell }   struct — shell is a bool
#   LongCount    { baktun, katun, tun, uinal, kin }  struct
#   Tzolkin      { number, day_sign }    struct — day_sign is a DaySign enum
#   Haab         { day, month }          struct — month is a HaabMonth enum
#   DaySign      enum (20 variants)      → variant-name JSON string
#   HaabMonth    enum (19 variants)      → variant-name JSON string
#   VenusPhase   enum (4 variants)       → variant-name JSON string
#
# Emit uses the sk_json_* helpers from serial_util.cyr (str_builder based); enum
# fields serialize via <Enum>_name(value). No f64 fields exist in any mayan serde
# type, so every numeric field is an int.
#
# Decoding (3.2.0): every <type>_from_json takes a bayan value node and returns a
# Result as serde_json::from_str did: Ok(value) or Err(SKE_DESERIALIZE) with serde's
# message, via the sk_de_* helpers (serial_util.cyr). Fields are checked against
# their Rust types (u8 / u32 / bool / enum variant names); unknown keys are ignored
# and no calendar validation happens (a katun of 25 decodes; long_count_new rejects it).

# ---------------------------------------------------------------------------
# Enum <-> variant-name mapping (module supplies <Enum>_name; add from_name).
# The *_from_name lookups stay public; the decoders use sk_de_variant instead.
# ---------------------------------------------------------------------------

# DaySign: map a variant-name Str back to its discriminant; -1 if unmatched.
#must_use
fn daysign_from_name(name) {
    var i = 0;
    while (i < 20) {
        if (str_eq(daysign_name(i), name) == 1) {
            return i;
        }
        i = i + 1;
    }
    return (0 - 1);
}

# HaabMonth: variant-name Str -> discriminant; -1 if unmatched.
#must_use
fn haabmonth_from_name(name) {
    var j = 0;
    while (j < 19) {
        if (str_eq(haabmonth_name(j), name) == 1) {
            return j;
        }
        j = j + 1;
    }
    return (0 - 1);
}

# VenusPhase: variant-name Str -> discriminant; -1 if unmatched.
#must_use
fn venusphase_from_name(name) {
    var k = 0;
    while (k < 4) {
        if (str_eq(venusphase_name(k), name) == 1) {
            return k;
        }
        k = k + 1;
    }
    return (0 - 1);
}

# ---------------------------------------------------------------------------
# MayanNumeral { dots, bars, shell } — shell is a JSON bool.
# ---------------------------------------------------------------------------
# Serialize a MayanNumeral to a JSON Str: {"dots":D,"bars":B,"shell":bool}.
#must_use
fn mayan_numeral_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "dots", mayan_numeral_dots(p));
    sk_json_sep(sb);
    sk_json_int(sb, "bars", mayan_numeral_bars(p));
    sk_json_sep(sb);
    sk_json_bool(sb, "shell", mayan_numeral_shell(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Deserialize a MayanNumeral from a bayan value node (an object), as serde:
# Ok(fresh, unvalidated MayanNumeral) or Err(SKE_DESERIALIZE). dots and bars are
# required u8 (0..255), shell a required JSON boolean.
#must_use
fn mayan_numeral_from_json(v) {
    var obj = sk_de_struct(v, "MayanNumeral")?;
    var dots = sk_de_int_field(obj, "dots", 0, SK_U8_MAX, "u8")?;
    var bars = sk_de_int_field(obj, "bars", 0, SK_U8_MAX, "u8")?;
    var shell = sk_de_bool_field(obj, "shell")?;
    return Ok(mayan_numeral_make(dots, bars, shell));
}
# Structural equality of two MayanNumerals (dots, bars, shell): 1 or 0.
#must_use
fn mayan_numeral_eq(a, b) {
    if (mayan_numeral_dots(a) != mayan_numeral_dots(b)) { return 0; }
    if (mayan_numeral_bars(a) != mayan_numeral_bars(b)) { return 0; }
    if (mayan_numeral_shell(a) != mayan_numeral_shell(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# LongCount { baktun, katun, tun, uinal, kin } — all integers.
# ---------------------------------------------------------------------------
# Serialize a LongCount to a JSON Str: {"baktun":..,"katun":..,"tun":..,
# "uinal":..,"kin":..}.
#must_use
fn longcount_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "baktun", lc_baktun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "katun", lc_katun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "tun", lc_tun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "uinal", lc_uinal(p));
    sk_json_sep(sb);
    sk_json_int(sb, "kin", lc_kin(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Deserialize a LongCount from a bayan value node (an object), as serde:
# Ok(fresh LongCount, no period range checks) or Err(SKE_DESERIALIZE). All five
# periods are required u32 (0..4294967295); a float or negative value is an Err.
#must_use
fn longcount_from_json(v) {
    var obj = sk_de_struct(v, "LongCount")?;
    var baktun = sk_de_int_field(obj, "baktun", 0, SK_U32_MAX, "u32")?;
    var katun = sk_de_int_field(obj, "katun", 0, SK_U32_MAX, "u32")?;
    var tun = sk_de_int_field(obj, "tun", 0, SK_U32_MAX, "u32")?;
    var uinal = sk_de_int_field(obj, "uinal", 0, SK_U32_MAX, "u32")?;
    var kin = sk_de_int_field(obj, "kin", 0, SK_U32_MAX, "u32")?;
    return Ok(longcount_make(baktun, katun, tun, uinal, kin));
}
# Structural equality of two LongCounts (all five periods): 1 or 0.
#must_use
fn longcount_eq(a, b) {
    if (lc_baktun(a) != lc_baktun(b)) { return 0; }
    if (lc_katun(a) != lc_katun(b)) { return 0; }
    if (lc_tun(a) != lc_tun(b)) { return 0; }
    if (lc_uinal(a) != lc_uinal(b)) { return 0; }
    if (lc_kin(a) != lc_kin(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# Tzolkin { number, day_sign } — day_sign is a DaySign enum (variant string).
# ---------------------------------------------------------------------------
# Serialize a Tzolkin to a JSON Str: {"number":N,"day_sign":"<DaySign>"}.
#must_use
fn tzolkin_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "number", tz_number(p));
    sk_json_sep(sb);
    sk_json_str(sb, "day_sign", daysign_name(tz_daysign(p)));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Deserialize a Tzolkin from a bayan value node (an object), as serde:
# Ok(fresh Tzolkin) or Err(SKE_DESERIALIZE). number is a required u8 and day_sign a
# required DaySign variant string.
#must_use
fn tzolkin_from_json(v) {
    var obj = sk_de_struct(v, "Tzolkin")?;
    var number = sk_de_int_field(obj, "number", 0, SK_U8_MAX, "u8")?;
    var sign = sk_de_variant_field(obj, "day_sign", all_daysign_names())?;
    return Ok(tzolkin_make(number, sign));
}
# Structural equality of two Tzolkins (number, day sign): 1 or 0.
#must_use
fn tzolkin_eq(a, b) {
    if (tz_number(a) != tz_number(b)) { return 0; }
    if (tz_daysign(a) != tz_daysign(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# Haab { day, month } — month is a HaabMonth enum (variant string).
# ---------------------------------------------------------------------------
# Serialize a Haab to a JSON Str: {"day":D,"month":"<HaabMonth>"}.
#must_use
fn haab_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "day", hb_day(p));
    sk_json_sep(sb);
    sk_json_str(sb, "month", haabmonth_name(hb_month(p)));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
# Deserialize a Haab from a bayan value node (an object), as serde: Ok(fresh Haab) or
# Err(SKE_DESERIALIZE). day is a required u8 and month a required HaabMonth variant
# string.
#must_use
fn haab_from_json(v) {
    var obj = sk_de_struct(v, "Haab")?;
    var day = sk_de_int_field(obj, "day", 0, SK_U8_MAX, "u8")?;
    var month = sk_de_variant_field(obj, "month", all_haabmonth_names())?;
    return Ok(haab_make(day, month));
}
# Structural equality of two Haabs (day, month): 1 or 0.
#must_use
fn haab_eq(a, b) {
    if (hb_day(a) != hb_day(b)) { return 0; }
    if (hb_month(a) != hb_month(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# DaySign enum — serde emits the bare variant-name JSON string, e.g. "Ahau".
# ---------------------------------------------------------------------------
# Serialize a DaySign code as a JSON string Str (its variant name, "Ahau").
#must_use
fn daysign_to_json(val) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, daysign_name(val));
    return str_builder_build(sb);
}
# Deserialize a DaySign from a bayan value node holding a JSON string, as serde:
# Ok(DS_* code), or Err(SKE_DESERIALIZE) "unknown variant" / "invalid type".
#must_use
fn daysign_from_json(v) {
    return sk_de_variant(v, all_daysign_names());
}
# Equality of two DaySign codes: 1 or 0.
#must_use
fn daysign_eq(a, b) {
    if (a != b) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# HaabMonth enum — bare variant-name JSON string, e.g. "Kumku".
