# Named astronomical cycles that can be queried and compared.
enum CycleName {
    CN_PRECESSION; CN_SOTHIC; CN_SAROS; CN_VENUS_SYNODIC;
    CN_CALENDAR_ROUND; CN_METONIC; CN_PRECESSIONAL_AGE;
}

var _cn_names_vec = 0;
var _cn_names_done = 0;
fn _build_cn_names() {
    var v = vec_new();
    vec_push(v, str_from("Precession"));
    vec_push(v, str_from("Sothic"));
    vec_push(v, str_from("Saros"));
    vec_push(v, str_from("VenusSynodic"));
    vec_push(v, str_from("CalendarRound"));
