    return sgt_new(ECIV_CHINESE, str_from("Fuxi and Nuwa"), names, texts,
        str_from("Beidou (Northern Dipper / Ursa Major)"),
        str_from("Fuxi and Nuwa survived the Great Flood; Nuwa repaired the broken sky. Yu the Great later tamed the floodwaters and founded civilization."));
}

# Build the Seven Sages traditions across all six civilizations. Returns a
# fresh vec of SagesTradition records each call.
#must_use
fn seven_sages() {
    var v = vec_new();
    vec_push(v, _st_vedic());
    vec_push(v, _st_babylonian());
    vec_push(v, _st_egyptian());
    vec_push(v, _st_mayan());
    vec_push(v, _st_greek());
    vec_push(v, _st_chinese());
    return v;
}

# Return the Seven Sages tradition for a given civilization, or 0 (None).
#must_use
fn sages_tradition(civ) {
    var v = seven_sages();
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        var p = vec_get(v, i);
        if (sgt_civ(p) == civ) { return p; }
        i = i + 1;
    }
    return 0;
}

# Return all Seven Sages traditions.
#must_use
fn all_sages_traditions() {
    return seven_sages();
}

# ---------------------------------------------------------------------------
# Time conversion utilities
# ---------------------------------------------------------------------------

# BP (Present = 1950 CE) -> JDN.
#must_use
fn bp_to_jdn(years_bp) {
    return f64_sub(BP_REFERENCE_JDN, f64_mul(years_bp, JULIAN_YEAR_DAYS));
}

# JDN -> years Before Present.
#must_use
fn jdn_to_bp(jdn) {
    return f64_div(f64_sub(BP_REFERENCE_JDN, jdn), JULIAN_YEAR_DAYS);
}

# Julian calendar year (i64; negative = BCE) -> approximate JDN (Jan 1).
#must_use
fn julian_year_to_jdn(year) {
    return f64_add(J2000_JDN, f64_mul(f64_sub(f64_from(year), f64_from(2000)), JULIAN_YEAR_DAYS));
}

# JDN -> approximate (fractional) Julian calendar year.
#must_use
fn jdn_to_julian_year(jdn) {
    return f64_add(f64_from(2000), f64_div(f64_sub(jdn, J2000_JDN), JULIAN_YEAR_DAYS));
}

# ---------------------------------------------------------------------------
# Precession calculations
# ---------------------------------------------------------------------------

# Ecliptic longitude (0..360) of the vernal-equinox point for a JDN.
# 150 deg at the Younger Dryas, drifting westward at 1 deg / 72 yr; normalized
# via ((x % 360) + 360) % 360 (floor-based f64_fmod composition, matching the
# egyptian.cyr Sothic idiom).
#must_use
fn vernal_point_longitude(jdn) {
    var years_since_yd = f64_div(f64_sub(jdn, YOUNGER_DRYAS_JDN), JULIAN_YEAR_DAYS);
    var longitude = f64_sub(f64_from(150), f64_mul(years_since_yd, PRECESSION_RATE_DEG_PER_YEAR));
    var m1 = f64_fmod(longitude, f64_from(360));
    return f64_fmod(f64_add(m1, f64_from(360)), f64_from(360));
}

# ---------------------------------------------------------------------------
# AgePosition record: { age, years_into_age: f64, fraction: f64,
#                       vernal_point_longitude: f64 } — 32 bytes.
enum ApOff { AP_AGE = 0; AP_YEARS = 8; AP_FRACTION = 16; AP_LON = 24; AP_SIZE = 32; }

#must_use
fn ap_new(age, years_into_age, fraction, lon) {
    var p = alloc(AP_SIZE);
    store64(p + AP_AGE, age);
    store64(p + AP_YEARS, years_into_age);
    store64(p + AP_FRACTION, fraction);
    store64(p + AP_LON, lon);
    return p;
}
#must_use
fn ap_age(p) { return load64(p + AP_AGE); }
#must_use
fn ap_years(p) { return load64(p + AP_YEARS); }
#must_use
fn ap_fraction(p) { return load64(p + AP_FRACTION); }
#must_use
fn ap_lon(p) { return load64(p + AP_LON); }

# Compute the precessional age + position for a JDN. Canonical 25,920-year
# period, Age of Leo beginning at the Younger Dryas.
#must_use
fn precessional_age(jdn) {
    var years_since_yd = f64_div(f64_sub(jdn, YOUNGER_DRYAS_JDN), JULIAN_YEAR_DAYS);

    # cycle_years = ((years_since_yd % GREAT_YEAR) + GREAT_YEAR) % GREAT_YEAR.
    var m1 = f64_fmod(years_since_yd, GREAT_YEAR_YEARS);
    var cycle_years = f64_fmod(f64_add(m1, GREAT_YEAR_YEARS), GREAT_YEAR_YEARS);

    # age_index = (cycle_years / 2160) as usize, clamped to <= 11.
    var age_index = f64_to(f64_div(cycle_years, PRECESSIONAL_AGE_YEARS));
    if (age_index >= 12) { age_index = 11; }

    var years_into_age = f64_sub(cycle_years, f64_mul(f64_from(age_index), PRECESSIONAL_AGE_YEARS));
    var fraction = f64_div(years_into_age, PRECESSIONAL_AGE_YEARS);
    var lon = vernal_point_longitude(jdn);

    # AGE_ORDER[i] == i, so the age discriminant is age_index directly.
    return ap_new(age_index, years_into_age, fraction, lon);
}

# JDN when a given precessional age begins (most recent occurrence relative to
# the Younger Dryas anchor). AGE_ORDER.position(age) == age.
#must_use
fn age_start_jdn(age) {
    return f64_add(YOUNGER_DRYAS_JDN, f64_mul(f64_from(age), PRECESSIONAL_AGE_DAYS));
}

# ---------------------------------------------------------------------------
# Cycle infrastructure
# ---------------------------------------------------------------------------

# Period in days for a named astronomical cycle. Pulls constants from the
# egyptian/babylonian/mayan modules (SOTHIC_CYCLE_DAYS and CALENDAR_ROUND_DAYS
# are integers cast to f64; SAROS_DAYS is babylonian's f64 global — requires
# babylonian_init(); venus_synodic_period() is mayan's f64 accessor).
#must_use
fn cycle_period(cycle) {
    if (cycle == CN_PRECESSION) { return GREAT_YEAR_DAYS; }
    if (cycle == CN_SOTHIC) { return f64_from(SOTHIC_CYCLE_DAYS); }
    if (cycle == CN_SAROS) { return SAROS_DAYS; }
    if (cycle == CN_VENUS_SYNODIC) { return venus_synodic_period(); }
    if (cycle == CN_CALENDAR_ROUND) { return f64_from(CALENDAR_ROUND_DAYS); }
    if (cycle == CN_METONIC) { return f64_mul(f64_from(19), JULIAN_YEAR_DAYS); }
    return PRECESSIONAL_AGE_DAYS;
}

# CyclesElapsed row: { cycle, complete: u64, remainder_days: f64 } — 24 bytes.
enum CeOff { CE_CYCLE = 0; CE_COMPLETE = 8; CE_REMAINDER = 16; CE_SIZE = 24; }

#must_use
fn ce_new(cycle, complete, remainder) {
    var p = alloc(CE_SIZE);
    store64(p + CE_CYCLE, cycle);
    store64(p + CE_COMPLETE, complete);
    store64(p + CE_REMAINDER, remainder);
    return p;
}
#must_use
fn ce_cycle(p) { return load64(p + CE_CYCLE); }
#must_use
fn ce_complete(p) { return load64(p + CE_COMPLETE); }
#must_use
fn ce_remainder(p) { return load64(p + CE_REMAINDER); }

# For each cycle, the number of complete cycles elapsed since a reference epoch,
# plus the remainder in days. `cycles` is a vec of CycleName ints; returns a vec
# of CeOff rows.
#must_use
fn cycles_elapsed(jdn, reference_jdn, cycles) {
    var elapsed_days = f64_sub(jdn, reference_jdn);
    var result = vec_new();
    var n = vec_len(cycles);
    var i = 0;
    while (i < n) {
        var cycle = vec_get(cycles, i);
        var period = cycle_period(cycle);
        if (f64_le(period, f64_from(0)) == 1) {
            vec_push(result, ce_new(cycle, 0, elapsed_days));
        }
        if (f64_gt(period, f64_from(0)) == 1) {
            var complete = f64_floor(f64_div(elapsed_days, period));
            var remainder = f64_sub(elapsed_days, f64_mul(complete, period));
            var complete_u64 = 0;
            if (f64_ge(complete, f64_from(0)) == 1) { complete_u64 = f64_to(complete); }
            vec_push(result, ce_new(cycle, complete_u64, remainder));
        }
        i = i + 1;
    }
    return result;
}

# CycleAlignment record: { jdn: f64, cycles: vec<CycleName>,
#                          max_residual_days: f64 } — 24 bytes.
enum CalgnOff { CALG_JDN = 0; CALG_CYCLES = 8; CALG_MAXRES = 16; CALG_SIZE = 24; }

#must_use
fn calgn_new(jdn, cycles, max_residual) {
    var p = alloc(CALG_SIZE);
    store64(p + CALG_JDN, jdn);
    store64(p + CALG_CYCLES, cycles);
    store64(p + CALG_MAXRES, max_residual);
    return p;
}
#must_use
fn calgn_jdn(p) { return load64(p + CALG_JDN); }
#must_use
fn calgn_cycles(p) { return load64(p + CALG_CYCLES); }
#must_use
fn calgn_maxres(p) { return load64(p + CALG_MAXRES); }

# Find dates when multiple cycles align within tolerance_days. Steps by the
# shortest cycle (min of the periods, at least 1 day). Returns Ok(vec of
# CycleAlignment) or Err (InvalidDate if start >= end; ComputationError if < 2
# cycles or the search exceeds 10,000,000 steps).
#must_use
fn find_cycle_alignments(cycles, start_jdn, end_jdn, tolerance_days) {
    if (f64_ge(start_jdn, end_jdn) == 1) {
        return sk_fail(SKE_INVALID_DATE, str_from("start_jdn must be before end_jdn"));
    }
    var nc = vec_len(cycles);
    if (nc < 2) {
        return sk_fail(SKE_COMPUTATION, str_from("need at least 2 cycles for alignment search"));
    }

    var periods = vec_new();
    var pi = 0;
    while (pi < nc) {
        vec_push(periods, cycle_period(vec_get(cycles, pi)));
        pi = pi + 1;
    }

    # step = min(periods).max(1.0) — fold from the first period (fold seed
    # f64::INFINITY reduces to min over the >= 2 periods).
    var minp = vec_get(periods, 0);
    var mi = 1;
    while (mi < nc) {
        var pp = vec_get(periods, mi);
        if (f64_lt(pp, minp) == 1) { minp = pp; }
        mi = mi + 1;
    }
    var step = f64_max(minp, f64_from(1));

    var num_steps = f64_to(f64_ceil(f64_div(f64_sub(end_jdn, start_jdn), step)));
    if (num_steps > 10000000) {
        var sbo = str_builder_new();
        str_builder_add_cstr(sbo, "search space too large: ");
        str_builder_add_int(sbo, num_steps);
        str_builder_add_cstr(sbo, " steps (max ");
        str_builder_add_int(sbo, 10000000);
        str_builder_add_cstr(sbo, ")");
        return sk_fail(SKE_COMPUTATION, str_builder_build(sbo));
    }

    var alignments = vec_new();
    var jdn = start_jdn;
    while (f64_lt(jdn, end_jdn) == 1) {
        var max_residual = f64_from(0);
        var all_aligned = 1;
        var k = 0;
        while (k < nc) {
            var period = vec_get(periods, k);
            var elapsed = f64_sub(jdn, start_jdn);
            var ratio = f64_div(elapsed, period);
            var residual = f64_mul(f64_abs(f64_sub(ratio, f64_round(ratio))), period);
            if (f64_gt(residual, tolerance_days) == 1) {
                all_aligned = 0;
                k = nc;
            }
            if (k < nc) {
                if (f64_gt(residual, max_residual) == 1) { max_residual = residual; }
                k = k + 1;
            }
        }
        if (all_aligned == 1) {
            var cyc_copy = vec_new();
            var ci = 0;
            while (ci < nc) {
                vec_push(cyc_copy, vec_get(cycles, ci));
                ci = ci + 1;
            }
            vec_push(alignments, calgn_new(jdn, cyc_copy, max_residual));
        }
        jdn = f64_add(jdn, step);
    }
    return Ok(alignments);
}

# ---------------------------------------------------------------------------
# Saptarishi profile pair: { name: Str, profile: ptr } — 16 bytes.
# Matches the Rust Vec<(String, avatara::ArchetypeProfile)> shape.
enum SapOff { SAP_NAME = 0; SAP_PROFILE = 8; SAP_SIZE = 16; }

#must_use
fn sap_new(name, profile) {
    var p = alloc(SAP_SIZE);
    store64(p + SAP_NAME, name);
    store64(p + SAP_PROFILE, profile);
    return p;
}
#must_use
fn sap_name(p) { return load64(p + SAP_NAME); }
#must_use
fn sap_profile(p) { return load64(p + SAP_PROFILE); }

# ---------------------------------------------------------------------------
# MultiCalendarDate record — the "Rosetta Stone" output (18 fields, 144 bytes).
# Option<T> fields (mayan_long_count / tzolkin / haab) use 0 for None.
# eras/civilizations/events are vecs of itihas record ptrs; saptarishi_profiles
# is a vec of SapOff pair records (always-on, full parity).
# ---------------------------------------------------------------------------
enum McdOff {
    MCD_JDN = 0;
    MCD_MAYAN_LC = 8;
    MCD_TZOLKIN = 16;
    MCD_HAAB = 24;
    MCD_SOTHIC = 32;
    MCD_AGE = 40;
    MCD_JULIAN_YEAR = 48;
    MCD_GREGORIAN = 56;
    MCD_COPTIC = 64;
    MCD_PERSIAN = 72;
    MCD_HEBREW = 80;
    MCD_CHINESE = 88;
    MCD_TONAL = 96;
    MCD_XIUH = 104;
    MCD_ERAS = 112;
    MCD_CIVS = 120;
    MCD_EVENTS = 128;
    MCD_SAPTARISHI = 136;
    MCD_SIZE = 144;
}

#must_use
fn mcd_jdn(p) { return load64(p + MCD_JDN); }
#must_use
fn mcd_mayan_lc(p) { return load64(p + MCD_MAYAN_LC); }
#must_use
fn mcd_tzolkin(p) { return load64(p + MCD_TZOLKIN); }
#must_use
fn mcd_haab(p) { return load64(p + MCD_HAAB); }
#must_use
fn mcd_sothic(p) { return load64(p + MCD_SOTHIC); }
#must_use
fn mcd_age(p) { return load64(p + MCD_AGE); }
#must_use
fn mcd_julian_year(p) { return load64(p + MCD_JULIAN_YEAR); }
#must_use
fn mcd_gregorian(p) { return load64(p + MCD_GREGORIAN); }
#must_use
fn mcd_coptic(p) { return load64(p + MCD_COPTIC); }
#must_use
fn mcd_persian(p) { return load64(p + MCD_PERSIAN); }
#must_use
fn mcd_hebrew(p) { return load64(p + MCD_HEBREW); }
#must_use
fn mcd_chinese(p) { return load64(p + MCD_CHINESE); }
#must_use
fn mcd_tonalpohualli(p) { return load64(p + MCD_TONAL); }
#must_use
fn mcd_xiuhpohualli(p) { return load64(p + MCD_XIUH); }
#must_use
fn mcd_eras(p) { return load64(p + MCD_ERAS); }
#must_use
fn mcd_civs(p) { return load64(p + MCD_CIVS); }
#must_use
fn mcd_events(p) { return load64(p + MCD_EVENTS); }
#must_use
fn mcd_saptarishi(p) { return load64(p + MCD_SAPTARISHI); }

# Convert a JDN to a MultiCalendarDate expressing that moment in every calendar
# sankhya knows, plus itihas historical context and avatara Saptarishi profiles.
# Returns Ok(MultiCalendarDate) or Err (Mayan Long Count overflow for extreme
# dates, re-wrapped as ComputationError to mirror the Rust map_err).
#must_use
fn correlate(jdn) {
    # tracing::debug!(jdn, "correlating JDN to multi-calendar date")
    if (SK_DEBUG <= sakshi_get_level()) {
        var _ds = str_from_int(f64_to(jdn));
        sakshi_log_kv(SK_DEBUG, "correlating JDN to multi-calendar date", 38, "jdn", 3, str_data(_ds), str_len(_ds));
    }

    # Mayan calendars (None if before the Mayan epoch).
    var mayan_epoch = f64_from(EPOCH_JDN);
    var mayan_lc = 0;
    var tzolkin = 0;
    var haab = 0;
    if (f64_ge(jdn, mayan_epoch) == 1) {
        var jdn_u64 = f64_to(jdn);
        var days = jdn_u64 - EPOCH_JDN;
        var lc_res_t, lc_res_v = long_count_from_days(days);
        if (is_ok(lc_res_t) == 0) {
            # map_err(|e| ComputationError(format!("Mayan Long Count: {e}")))
            var em = sk_err_msg(err_code_of(lc_res_t, lc_res_v));
            var sbm = str_builder_new();
            str_builder_add_cstr(sbm, "Mayan Long Count: ");
            if (em != 0) { str_builder_add(sbm, em); }
            return sk_fail(SKE_COMPUTATION, str_builder_build(sbm));
        }
        mayan_lc = result_unwrap(lc_res_t, lc_res_v);
        tzolkin = tzolkin_from_days(days);
        haab = haab_from_days(days);
    }

    # Egyptian Sothic position (record carrying cycle/year/drift).
    var sothic = sothic_position(jdn);

    # Precession.
    var age = precessional_age(jdn);

    # Approximate Julian year.
    var year = jdn_to_julian_year(jdn);

    # Historical context from itihas (always-on). approx_year = year.round() as i32.
    var approx_year = f64_to(f64_round(year));
    var eras = eras_containing(approx_year);
    var civs = civs_active_at(approx_year);
    var events = events_at_year(approx_year);

    # Saptarishi archetype profiles from avatara (always-on): each profile p
    # becomes a (prof_name(p), p) pair, mirroring Vec<(String, ArchetypeProfile)>.
    var profiles = vec_new();
    var sages = all_incarnate_sage();
    var sn = vec_len(sages);
    var si = 0;
    while (si < sn) {
        var sage = vec_get(sages, si);
        vec_push(profiles, sap_new(prof_name(sage), sage));
        si = si + 1;
    }

    var p = alloc(MCD_SIZE);
    store64(p + MCD_JDN, jdn);
    store64(p + MCD_MAYAN_LC, mayan_lc);
    store64(p + MCD_TZOLKIN, tzolkin);
    store64(p + MCD_HAAB, haab);
    store64(p + MCD_SOTHIC, sothic);
    store64(p + MCD_AGE, age);
    store64(p + MCD_JULIAN_YEAR, year);
    store64(p + MCD_GREGORIAN, jdn_to_gregorian(jdn));
    store64(p + MCD_COPTIC, jdn_to_coptic(jdn));
    store64(p + MCD_PERSIAN, jdn_to_persian(jdn));
    store64(p + MCD_HEBREW, jdn_to_hebrew(jdn));
    store64(p + MCD_CHINESE, sexagenary_from_jdn(jdn));
    store64(p + MCD_TONAL, tonalpohualli_from_jdn(jdn));
    store64(p + MCD_XIUH, xiuhpohualli_from_jdn(jdn));
    store64(p + MCD_ERAS, eras);
    store64(p + MCD_CIVS, civs);
    store64(p + MCD_EVENTS, events);
    store64(p + MCD_SAPTARISHI, profiles);
    return Ok(p);
}

# ---------------------------------------------------------------------------
# Unified calendar conversion API
# ---------------------------------------------------------------------------
# CalendarDate tagged union: { tag: CalDateTag, value } — 16 bytes. For CDT_JDN
# the value is an f64 bit pattern; otherwise it is a date-record pointer.
enum CdvOff { CDV_TAG = 0; CDV_VAL = 8; CDV_SIZE = 16; }

#must_use
fn cdv_new(tag, val) {
    var p = alloc(CDV_SIZE);
    store64(p + CDV_TAG, tag);
    store64(p + CDV_VAL, val);
    return p;
}
#must_use
fn cdv_tag(p) { return load64(p + CDV_TAG); }
#must_use
fn cdv_val(p) { return load64(p + CDV_VAL); }

# CalendarDate variant constructors.
#must_use
fn caldate_jdn(jdn) { return cdv_new(CDT_JDN, jdn); }
#must_use
fn caldate_gregorian(date) { return cdv_new(CDT_GREGORIAN, date); }
#must_use
fn caldate_coptic(date) { return cdv_new(CDT_COPTIC, date); }
#must_use
fn caldate_persian(date) { return cdv_new(CDT_PERSIAN, date); }
#must_use
fn caldate_hebrew(date) { return cdv_new(CDT_HEBREW, date); }
#must_use
fn caldate_hijri(date) { return cdv_new(CDT_HIJRI, date); }
#must_use
fn caldate_mayan_long_count(lc) { return cdv_new(CDT_MAYAN_LC, lc); }

# Convert any supported CalendarDate to its Julian Day Number. Returns Ok(f64)
# or Err (InvalidDate) for out-of-range dates. Dispatches to each sibling
# module's *_to_jdn; Jdn is direct; MayanLongCount is to_julian_day() - 0.5.
#must_use
fn calendar_to_jdn(date) {
    # tracing::debug!(?date, "converting calendar date to JDN")
    if (SK_DEBUG <= sakshi_get_level()) {
        var _dm = str_from("converting calendar date to JDN");
        sakshi_debug(str_data(_dm), str_len(_dm));
    }
    var tag = cdv_tag(date);
    var val = cdv_val(date);
    if (tag == CDT_JDN) { return Ok(val); }
    if (tag == CDT_GREGORIAN) { return gregorian_to_jdn(val); }
    if (tag == CDT_COPTIC) { return coptic_to_jdn(val); }
    if (tag == CDT_PERSIAN) { return persian_to_jdn(val); }
    if (tag == CDT_HEBREW) { return hebrew_to_jdn(val); }
    if (tag == CDT_HIJRI) { return hijri_to_jdn(val); }
    # CDT_MAYAN_LC: to_julian_day() as f64 - 0.5.
    var jd = long_count_to_julian_day(val);
    return Ok(f64_sub(f64_from(jd), F64_HALF));
}

# Unified any-to-any conversion: input -> JDN -> all systems. Returns
# Ok(MultiCalendarDate) or the propagated Err from calendar_to_jdn/correlate.
#must_use
fn convert(date) {
    # tracing::info!(?date, "unified calendar conversion")
    if (SK_INFO <= sakshi_get_level()) {
        var _im = str_from("unified calendar conversion");
        sakshi_info(str_data(_im), str_len(_im));
    }
    var jr_t, jr_v = calendar_to_jdn(date);
    if (is_ok(jr_t) == 0) { return Err(jr_v); }
    var jdn = result_unwrap(jr_t, jr_v);
    return correlate(jdn);
}

# --- serial_util.cyr ---

# serial_util.cyr — shared JSON (de)serialization helpers for the per-module
# serial_<module>.cyr files. Output matches Rust serde_json exactly.
#
# bayan (folded stdlib) provides str_builder_add_json_str (emit: adds surrounding
# quotes + RFC-8259 escaping) and bayan_json_v_* (parse into a tagged value tree).
# Helpers are sk_json_*-prefixed to avoid colliding with itihas's bundled serial.cyr
# (_json_str/_json_int/_json_sep).

# writes  "key":
fn sk_json_key(sb, key) {
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\":");
    return 0;
}

# String field  "key":"escaped"  — val is a Str.
fn sk_json_str(sb, key, val) {
    sk_json_key(sb, key);
    str_builder_add_json_str(sb, val);
    return 0;
}

# String field from a C-string literal.
fn sk_json_cstr(sb, key, cstr) {
    sk_json_key(sb, key);
    str_builder_add_json_str(sb, str_from(cstr));
    return 0;
}

# Integer field  "key":123
fn sk_json_int(sb, key, n) {
    sk_json_key(sb, key);
    str_builder_add_int(sb, n);
    return 0;
}

# Bool field  "key":true / "key":false  (JSON booleans, matching serde).
fn sk_json_bool(sb, key, b) {
    sk_json_key(sb, key);
    if (b != 0) { str_builder_add_cstr(sb, "true"); }
    else { str_builder_add_cstr(sb, "false"); }
    return 0;
}

# Field separator.
fn sk_json_sep(sb) { str_builder_add_cstr(sb, ","); return 0; }

# Parse a JSON Str into a bayan value tree (0 on error). Wrapper over bayan.
# NOTE: bayan_json_v_parse takes a Str (it does str_data/str_len internally) —
# pass the Str directly, NOT str_data(js).
#must_use
fn sk_json_parse(js) {
    return bayan_json_v_parse(js);
}

# --- serial_gregorian.cyr ---

# serial_gregorian.cyr — JSON (de)serialization for the gregorian module.
#
# Full serde ROUND-TRIP parity with the Rust derived Serialize + Deserialize on
# GregorianMonth and GregorianDate (rust-old/src/gregorian.rs). Emit format
# matches serde_json EXACTLY (compact, no spaces):
#   GregorianMonth (unit enum) -> the variant-name JSON string, e.g. "January".
#   GregorianDate  -> {"year":<i64>,"month":"<variant>","day":<u8>}
#
# SELF-CONTAINED: no include lines. Uses the sk_json_* helpers from
# src/serial_util.cyr, the bayan_json_v_* value tree, and the gregorian module's
# constructors/getters/name accessors (all resolved from the consumer bundle).

# ---------------------------------------------------------------------------
# GregorianMonth enum <-> variant-name string
# ---------------------------------------------------------------------------

# Map a serde variant-name string (a Str) back to a GregorianMonth discriminant
# (0..11). Returns (0 - 1) if no month name matches. The module already exposes
# gregorian_month_name(i); this is the inverse it lacked.
#must_use
fn gregorian_month_from_name(name) {
    var i = 0;
    while (i < 12) {
        if (str_eq(gregorian_month_name(i), name) != 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Serialize a GregorianMonth discriminant as a bare JSON string (serde emits a
# unit enum variant as its quoted name), e.g. GM_JANUARY -> "January".
#must_use
fn gregorian_month_to_json(m) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, gregorian_month_name(m));
    return str_builder_build(sb);
}

# Deserialize a GregorianMonth from a bayan value node holding a JSON string.
# Returns the discriminant, or (0 - 1) if the name is unknown.
#must_use
fn gregorian_month_from_json(v) {
    return gregorian_month_from_name(bayan_json_v_str(v));
}

# Field-by-field equality for a GregorianMonth (a plain integer discriminant).
#must_use
fn gregorian_month_eq(a, b) {
    if (a == b) { return 1; }
    return 0;
}

# ---------------------------------------------------------------------------
# GregorianDate struct <-> JSON object
# ---------------------------------------------------------------------------

# Serialize a GregorianDate pointer to {"year":..,"month":"..","day":..}.
# Field order matches the Rust struct declaration order (year, month, day).
# month is emitted as the variant-name string (NOT the integer).
#must_use
fn gregorian_date_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "year", gd_year(p));
    sk_json_sep(sb);
    sk_json_str(sb, "month", gregorian_month_name(gd_month(p)));
    sk_json_sep(sb);
    sk_json_int(sb, "day", gd_day(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a GregorianDate from a bayan value tree node (an object).
# Reads year/day as integers and month via the variant-name -> discriminant map,
# then reconstructs through the module's constructor.
#must_use
fn gregorian_date_from_json(v) {
    var year = bayan_json_v_int(bayan_json_v_obj_get(v, "year"));
    var mstr = bayan_json_v_str(bayan_json_v_obj_get(v, "month"));
    var month = gregorian_month_from_name(mstr);
    var day = bayan_json_v_int(bayan_json_v_obj_get(v, "day"));
    return gregorian_date_new(year, month, day);
}

# Field-by-field equality of two GregorianDate pointers (for the round-trip test).
#must_use
fn gregorian_date_eq(a, b) {
    if (gd_year(a) != gd_year(b)) { return 0; }
    if (gd_month(a) != gd_month(b)) { return 0; }
    if (gd_day(a) != gd_day(b)) { return 0; }
    return 1;
}

# --- serial_roman.cyr ---

# serial_roman.cyr — JSON (de)serialization for the roman module.
#
# Full serde round-trip parity with Rust's derived Serialize + Deserialize on
#   pub struct RomanNumeral { value: u32, text: String }
# serde_json emits fields in declaration order (value, then text), compact:
#   {"value":1776,"text":"MDCCLXXVI"}
#
# Self-contained (NO include lines). Relies on:
#   * serial_util.cyr — sk_json_int / sk_json_str / sk_json_sep / sk_json_parse
#   * roman.cyr       — romannum_new / romannum_value / romannum_text (RN_* offsets)
#   * bayan (folded stdlib) — bayan_json_v_obj_get / _int / _str value-tree accessors
#
# There are NO enums, floats, bools, nested structs, arrays, or Options among
# roman's serde types, so this is a plain {int, string} record.

# --- RomanNumeral ------------------------------------------------------------

# RomanNumeral → {"value":N,"text":"STR"}  (Rust field order: value, then text).
#must_use
fn romannum_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "value", romannum_value(p));
    sk_json_sep(sb);
    sk_json_str(sb, "text", romannum_text(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Reconstruct a RomanNumeral from a parsed bayan value-tree node `v`.
#must_use
fn romannum_from_json(v) {
    var value = bayan_json_v_int(bayan_json_v_obj_get(v, "value"));
    var text = bayan_json_v_str(bayan_json_v_obj_get(v, "text"));
    return romannum_new(value, text);
}

# Field-by-field equality for the round-trip test.
#must_use
fn romannum_eq(a, b) {
    if (romannum_value(a) != romannum_value(b)) { return 0; }
    if (str_eq(romannum_text(a), romannum_text(b)) == 0) { return 0; }
    return 1;
}

# --- serial_greek.cyr ---

# serial_greek.cyr — JSON (de)serialization for the greek module, matching
# Rust serde_json exactly for full round-trip parity.
#
# Self-contained: no include lines. Uses the shared sk_json_* helpers from
# src/serial_util.cyr, the bayan value-tree API (folded stdlib), and the greek
# module's anti_new/anti_* accessors.
#
# Serde types in greek:
#   AntikytheraCycle  — struct { name: &str, period_years: &str,
#                                gear_teeth: u32, description: &str }
#     serde JSON: {"name":"Metonic","period_years":"19",
#                  "gear_teeth":235,"description":"..."}
#     name/period_years/description are STRINGS (period_years holds "19", a
#     quoted string, NOT the number 19). gear_teeth is an integer. No enums,
#     no f64, no nested/array/option fields in this module.

# ---------------------------------------------------------------------------
# AntikytheraCycle
# ---------------------------------------------------------------------------

# Serialize an AntikytheraCycle record to a JSON object string, byte-for-byte
# matching serde_json (compact, no spaces, Rust field names).
#must_use
fn anti_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_str(sb, "name", anti_name(p));
    sk_json_sep(sb);
    sk_json_str(sb, "period_years", anti_period_years(p));
    sk_json_sep(sb);
    sk_json_int(sb, "gear_teeth", anti_gear_teeth(p));
    sk_json_sep(sb);
    sk_json_str(sb, "description", anti_description(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a bayan value-tree node (from sk_json_parse) back into an
# AntikytheraCycle record via anti_new. String fields via bayan_json_v_str,
# the integer field via bayan_json_v_int.
#must_use
fn anti_from_json(v) {
    var name = bayan_json_v_str(bayan_json_v_obj_get(v, "name"));
    var period = bayan_json_v_str(bayan_json_v_obj_get(v, "period_years"));
    var teeth = bayan_json_v_int(bayan_json_v_obj_get(v, "gear_teeth"));
    var desc = bayan_json_v_str(bayan_json_v_obj_get(v, "description"));
    return anti_new(name, period, teeth, desc);
}

# Field-by-field equality of two AntikytheraCycle records (for round-trip
# testing). String fields compared with str_eq, the integer field with ==.
#must_use
fn anti_eq(a, b) {
    if (str_eq(anti_name(a), anti_name(b)) == 0) {
        return 0;
    }
    if (str_eq(anti_period_years(a), anti_period_years(b)) == 0) {
        return 0;
    }
    if (anti_gear_teeth(a) != anti_gear_teeth(b)) {
        return 0;
    }
    if (str_eq(anti_description(a), anti_description(b)) == 0) {
        return 0;
    }
    return 1;
}

# --- serial_vedic.cyr ---

# serial_vedic.cyr — JSON (de)serialization for the vedic module, full serde
# round-trip parity with Rust serde_json.
#
# IMPORTANT PARITY NOTE: rust-old/src/vedic.rs derives Serialize/Deserialize on
# NO type — it declares no structs and no enums. Its only compound values are
# plain return payloads:
#   * vedic_multiply_nikhilam -> Result<(u64,u64,u64,u64,u64)>   (a 5-tuple)
#   * meru_prastara           -> Result<Vec<Vec<u64>>>            (nested vecs)
# serde_json serializes a Rust tuple as a JSON ARRAY (no field names) and a
# Vec<Vec<u64>> as an array-of-arrays. Those two array forms are therefore the
# authoritative "Rust serde format" for this module, and this file reproduces
# them exactly (compact, no spaces — matching serde_json::to_string).
#
# The Cyrius port models the 5-tuple as the NikhilamSteps record (NkOff offsets,
# nikhilam_new, nk_base/nk_da/nk_db/nk_cross/nk_product in src/vedic.cyr); we
# emit/parse it as the 5-element array serde would produce for the tuple.
#
# Self-contained: NO include lines. Resolves stdlib (str_builder_*, vec_*,
# bayan_json_v_*) and the vedic module accessors from the consumer's [deps].

# ---------------------------------------------------------------------------
# NikhilamSteps  <->  serde tuple  (u64,u64,u64,u64,u64)  ->  [b,da,db,cr,pr]
# ---------------------------------------------------------------------------

# Serialize the NikhilamSteps record as the JSON array serde_json emits for the
# tuple return of vedic_multiply_nikhilam: e.g. [100,3,4,93,9312].
#must_use
fn nikhilam_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    str_builder_add_int(sb, nk_base(p));
    str_builder_add_cstr(sb, ",");
    str_builder_add_int(sb, nk_da(p));
    str_builder_add_cstr(sb, ",");
    str_builder_add_int(sb, nk_db(p));
    str_builder_add_cstr(sb, ",");
    str_builder_add_int(sb, nk_cross(p));
    str_builder_add_cstr(sb, ",");
    str_builder_add_int(sb, nk_product(p));
    str_builder_add_cstr(sb, "]");
    return str_builder_build(sb);
}

# Reconstruct a NikhilamSteps record from a parsed bayan array node
# (v = the [b,da,db,cr,pr] array value from sk_json_parse).
#must_use
fn nikhilam_from_json(v) {
    var b = bayan_json_v_int(bayan_json_v_arr_get(v, 0));
    var da = bayan_json_v_int(bayan_json_v_arr_get(v, 1));
    var db = bayan_json_v_int(bayan_json_v_arr_get(v, 2));
    var cr = bayan_json_v_int(bayan_json_v_arr_get(v, 3));
    var pr = bayan_json_v_int(bayan_json_v_arr_get(v, 4));
    return nikhilam_new(b, da, db, cr, pr);
}

# Field-by-field equality for the round-trip test. Returns 1 if equal, else 0.
#must_use
fn nikhilam_eq(a, b) {
    if (nk_base(a) != nk_base(b)) { return 0; }
    if (nk_da(a) != nk_da(b)) { return 0; }
    if (nk_db(a) != nk_db(b)) { return 0; }
    if (nk_cross(a) != nk_cross(b)) { return 0; }
    if (nk_product(a) != nk_product(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# Meru Prastara  <->  serde Vec<Vec<u64>>  ->  array-of-arrays [[1],[1,1],...]
# ---------------------------------------------------------------------------

# Serialize a vec-of-vecs (as produced by meru_prastara) as the nested JSON
# array serde_json emits, e.g. [[1],[1,1],[1,2,1],[1,3,3,1],[1,4,6,4,1]].
#must_use
fn meru_to_json(tri) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    var n = vec_len(tri);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var row = vec_get(tri, i);
        str_builder_add_cstr(sb, "[");
        var m = vec_len(row);
        var j = 0;
        while (j < m) {
            if (j > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_int(sb, vec_get(row, j));
            j = j + 1;
        }
        str_builder_add_cstr(sb, "]");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return str_builder_build(sb);
}

# Reconstruct a vec-of-vecs from a parsed bayan array-of-arrays node.
#must_use
fn meru_from_json(v) {
    var tri = vec_new();
    var n = bayan_json_v_arr_len(v);
    var i = 0;
    while (i < n) {
        var rowv = bayan_json_v_arr_get(v, i);
        var row = vec_new();
        var m = bayan_json_v_arr_len(rowv);
        var j = 0;
        while (j < m) {
            vec_push(row, bayan_json_v_int(bayan_json_v_arr_get(rowv, j)));
            j = j + 1;
        }
        vec_push(tri, row);
        i = i + 1;
    }
    return tri;
}

# Deep equality over the vec-of-vecs. Returns 1 if equal, else 0.
#must_use
fn meru_eq(a, b) {
    var na = vec_len(a);
    var nb = vec_len(b);
    if (na != nb) { return 0; }
    var i = 0;
    while (i < na) {
        var ra = vec_get(a, i);
        var rb = vec_get(b, i);
        var ma = vec_len(ra);
        var mb = vec_len(rb);
        if (ma != mb) { return 0; }
        var j = 0;
        while (j < ma) {
            if (vec_get(ra, j) != vec_get(rb, j)) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

# --- serial_mayan.cyr ---

# serial_mayan.cyr — JSON (de)serialization for the mayan module, matching
# Rust serde_json EXACTLY (compact, no spaces; field order = Rust declaration
# order; enum variants as their identifier strings).
#
# Serde types covered (7):
#   MayanNumeral { dots, bars, shell }   struct — shell is a bool
#   LongCount    { baktun, katun, tun, uinal, kin }  struct
#   Tzolkin      { number, day_sign }    struct — day_sign is a DaySign enum
#   Haab         { day, month }          struct — month is a HaabMonth enum
#   DaySign      enum (20 variants)      → variant-name JSON string
#   HaabMonth    enum (19 variants)      → variant-name JSON string
#   VenusPhase   enum (4 variants)       → variant-name JSON string
#
# Emit uses the sk_json_* helpers from serial_util.cyr (str_builder based).
# Parse uses the bayan value tree (sk_json_parse → bayan_json_v_*). Enum fields
# serialize via <Enum>_name(value) and deserialize via <Enum>_from_name(Str).
# No f64 fields exist in any mayan serde type, so every numeric field is an int.

# ---------------------------------------------------------------------------
# Enum <-> variant-name mapping (module supplies <Enum>_name; add from_name)
# ---------------------------------------------------------------------------

# DaySign: map a variant-name Str back to its discriminant; -1 if unmatched.
#must_use
fn daysign_from_name(name) {
    var i = 0;
    while (i < 20) {
        if (str_eq(daysign_name(i), name) == 1) {
            return i;
        }
        i = i + 1;
    }
    return (0 - 1);
}

# HaabMonth: variant-name Str -> discriminant; -1 if unmatched.
#must_use
fn haabmonth_from_name(name) {
    var j = 0;
    while (j < 19) {
        if (str_eq(haabmonth_name(j), name) == 1) {
            return j;
        }
        j = j + 1;
    }
    return (0 - 1);
}

# VenusPhase: variant-name Str -> discriminant; -1 if unmatched.
#must_use
fn venusphase_from_name(name) {
    var k = 0;
    while (k < 4) {
        if (str_eq(venusphase_name(k), name) == 1) {
            return k;
        }
        k = k + 1;
    }
    return (0 - 1);
}

# ---------------------------------------------------------------------------
# MayanNumeral { dots, bars, shell } — shell is a JSON bool.
# ---------------------------------------------------------------------------
#must_use
fn mayan_numeral_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "dots", mayan_numeral_dots(p));
    sk_json_sep(sb);
    sk_json_int(sb, "bars", mayan_numeral_bars(p));
    sk_json_sep(sb);
    sk_json_bool(sb, "shell", mayan_numeral_shell(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
#must_use
fn mayan_numeral_from_json(v) {
    var dots = bayan_json_v_int(bayan_json_v_obj_get(v, "dots"));
    var bars = bayan_json_v_int(bayan_json_v_obj_get(v, "bars"));
    var shell = bayan_json_v_bool(bayan_json_v_obj_get(v, "shell"));
    return mayan_numeral_make(dots, bars, shell);
}
#must_use
fn mayan_numeral_eq(a, b) {
    if (mayan_numeral_dots(a) != mayan_numeral_dots(b)) { return 0; }
    if (mayan_numeral_bars(a) != mayan_numeral_bars(b)) { return 0; }
    if (mayan_numeral_shell(a) != mayan_numeral_shell(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# LongCount { baktun, katun, tun, uinal, kin } — all integers.
# ---------------------------------------------------------------------------
#must_use
fn longcount_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "baktun", lc_baktun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "katun", lc_katun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "tun", lc_tun(p));
    sk_json_sep(sb);
    sk_json_int(sb, "uinal", lc_uinal(p));
    sk_json_sep(sb);
    sk_json_int(sb, "kin", lc_kin(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
#must_use
fn longcount_from_json(v) {
    var baktun = bayan_json_v_int(bayan_json_v_obj_get(v, "baktun"));
    var katun = bayan_json_v_int(bayan_json_v_obj_get(v, "katun"));
    var tun = bayan_json_v_int(bayan_json_v_obj_get(v, "tun"));
    var uinal = bayan_json_v_int(bayan_json_v_obj_get(v, "uinal"));
    var kin = bayan_json_v_int(bayan_json_v_obj_get(v, "kin"));
    return longcount_make(baktun, katun, tun, uinal, kin);
}
#must_use
fn longcount_eq(a, b) {
    if (lc_baktun(a) != lc_baktun(b)) { return 0; }
    if (lc_katun(a) != lc_katun(b)) { return 0; }
    if (lc_tun(a) != lc_tun(b)) { return 0; }
    if (lc_uinal(a) != lc_uinal(b)) { return 0; }
    if (lc_kin(a) != lc_kin(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# Tzolkin { number, day_sign } — day_sign is a DaySign enum (variant string).
