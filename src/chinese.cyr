# Zodiac animal names for each branch.
var _zodiac = 0;
var _zodiac_done = 0;
fn _build_zodiac() {
    var v = vec_new();
    vec_push(v, str_from("Rat"));
    vec_push(v, str_from("Ox"));
    vec_push(v, str_from("Tiger"));
    vec_push(v, str_from("Rabbit"));
    vec_push(v, str_from("Dragon"));
    vec_push(v, str_from("Snake"));
    vec_push(v, str_from("Horse"));
