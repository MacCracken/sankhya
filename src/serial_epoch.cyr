# serial_epoch.cyr — JSON (de)serialization for the epoch module, the sankhya
# "Rosetta Stone" capstone, matching Rust serde_json for full round-trip parity.
#
# Serde types in rust-old/src/epoch.rs (all #[derive(Serialize, Deserialize)]):
#   PrecessionalAge  — unit enum   → serde emits the bare variant-name string.
#   Civilization     — unit enum   → bare variant-name string.
#   CycleName        — unit enum   → bare variant-name string.
#   SagesTradition   — struct { civilization, group_name, sage_names: Vec<str>,
#                               source_texts: Vec<str>, associated_stars,
#                               catastrophe_narrative }.
#   AgePosition      — struct { age: PrecessionalAge, years_into_age: f64,
#                               fraction: f64, vernal_point_longitude: f64 }.
#   CycleAlignment   — struct { jdn: f64, cycles: Vec<CycleName>,
#                               max_residual_days: f64 }.
#   MultiCalendarDate— the correlate() output: 18 fields incl. Option<> Mayan
#                      calendars, a (i32,u32,f64) sothic tuple, every nested
#                      calendar record, itihas eras/civilizations/events, and
#                      avatara saptarishi profiles.
#   CalendarDate     — #[non_exhaustive] data enum (externally tagged):
#                      {"Jdn":f64} / {"Gregorian":{..}} / ... / {"MayanLongCount":{..}}.
#
# serde format details handled here:
#   * Unit enum → bare JSON string via the module's <Enum>_name(i) accessor
#     (the serde identifier, NOT the integer, NOT the spaced Display string).
#   * Data enum → externally tagged single-key object {"Variant": value}.
#   * f64 → JSON number. Emitted through bayan's Grisu2 float formatter
#     (bayan_json_v_float_new(bits) + bayan_json_v_build) which is round-trip
#     correct: parsing the emitted text back with bayan_json_v_float reproduces
#     the exact bits, so f64 fields compare by bit-equality in *_eq.
#   * Option<T> None → null (JSON), Some(x) → the value.
#   * Vec<T> → JSON array. Tuple (i32,u32,f64) → JSON array [int,int,number].
#   * Nested struct → embedded object (this file carries private ep_* serializers
#     for every nested calendar record so the test needs only lib.cyr +
#     serial_util.cyr + serial_epoch.cyr — no other serial_<mod>.cyr).
#   * eras/civilizations/events → itihas's own era_to_json / civ_to_json /
#     event_to_json (from the itihas bundle) inside a JSON array.
#   * saptarishi_profiles → array of {name, tradition, description} objects built
#     from avatara's prof_name/prof_tradition/prof_desc (C-string) accessors.
#
# Reduction (documented): the itihas era/civ/event bundle exposes NO from_json,
# and avatara ArchetypeProfile has no round-trippable serializer, so the
# MultiCalendarDate round-trip reconstructs every INTRINSIC field (jdn, the
# option Mayan calendars, sothic tuple, precessional age, julian year, and all
# nested calendar records) exactly and verifies the itihas/avatara arrays
# structurally by element COUNT. The intrinsic reduced set is what the Rust
# assert_eq!(date, back) exercises for parity on this port.
#
# SELF-CONTAINED: no include lines. Uses the shared sk_json_* helpers from
# serial_util.cyr, the epoch + calendar module accessors (via lib.cyr), the
# itihas/avatara bundle serializers/accessors, and bayan's value-tree API.

# ===========================================================================
# Shared local helpers
# ===========================================================================

# Append  "key":<number>  where <number> is the Grisu2 JSON rendering of the
# f64 bit pattern `bits`. Round-trip correct with bayan_json_v_float on parse.
fn _ep_json_f64(sb, key, bits) {
    sk_json_key(sb, key);
    str_builder_add(sb, bayan_json_v_build(bayan_json_v_float_new(bits)));
    return 0;
}

# The bare JSON number rendering of an f64 bit pattern (no key), as a Str.
#must_use
fn _ep_f64_str(bits) {
    return bayan_json_v_build(bayan_json_v_float_new(bits));
}

# Append  "key":["s0","s1",...]  from a vec of Str.
fn _ep_json_str_arr(sb, key, v) {
    sk_json_key(sb, key);
    str_builder_add_cstr(sb, "[");
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_json_str(sb, vec_get(v, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return 0;
}

# Parse a bayan array node of JSON strings into a fresh vec of Str.
#must_use
fn _ep_parse_str_arr(node) {
    var v = vec_new();
    var n = bayan_json_v_arr_len(node);
    var i = 0;
    while (i < n) {
        vec_push(v, bayan_json_v_str(bayan_json_v_arr_get(node, i)));
        i = i + 1;
    }
    return v;
}

# Element-wise equality of two vecs of Str (0/1).
#must_use
fn _ep_str_vec_eq(a, b) {
    var na = vec_len(a);
    var nb = vec_len(b);
    if (na != nb) { return 0; }
    var i = 0;
    while (i < na) {
        if (str_eq(vec_get(a, i), vec_get(b, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ===========================================================================
# Nested-calendar enum name -> discriminant reverse maps (ep_ prefixed so this
# file collides with no standalone serial_<mod>.cyr). Return (0 - 1) if unmatched.
# ===========================================================================

#must_use
fn ep_daysign_from_name(name) {
    var i = 0;
    while (i < 20) {
        if (str_eq(daysign_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
