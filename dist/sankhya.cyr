    vec_push(v, str_from("Farvardin"));
    vec_push(v, str_from("Ordibehesht"));
    vec_push(v, str_from("Khordad"));
    vec_push(v, str_from("Tir"));
    vec_push(v, str_from("Mordad"));
    vec_push(v, str_from("Shahrivar"));
    vec_push(v, str_from("Mehr"));
    vec_push(v, str_from("Aban"));
    vec_push(v, str_from("Azar"));
    vec_push(v, str_from("Dey"));
    vec_push(v, str_from("Bahman"));
    vec_push(v, str_from("Esfand"));
    return v;
}
# Shared, lazily built vec of the 12 Persian month-name Strs (Farvardin .. Esfand), indexed by
# PersianMonth (0-11). Do not mutate.
#must_use
fn persian_month_names() {
    if (_pers_names_done == 0) {
        _pers_names = _build_pers_names();
        _pers_names_done = 1;
    }
    return _pers_names;
}

# serde identifier for month index i (0..11).
#must_use
fn persian_month_name(i) {
    return sk_name_at(persian_month_names(), i);
}

# Display string for a PersianMonth discriminant (impl Display for month).
#must_use
fn persian_month_to_str(m) {
    return sk_name_at(persian_month_names(), m);
}

# ---------------------------------------------------------------------------
# Date struct: { year: i64, month: PersianMonth, day: i64 } — 24 bytes
# ---------------------------------------------------------------------------

enum PersDateOff { PD_YEAR = 0; PD_MONTH = 8; PD_DAY = 16; PD_SIZE = 24; }

# Construct a PersianDate record {year (Anno Persico; 1 AP = 622 CE), month (PersianMonth
# 0-11), day (1-31)}. Stored unvalidated; persian_to_jdn checks the day.
#must_use
fn persian_date_new(year, month, day) {
    var p = alloc(PD_SIZE);
    store64(p + PD_YEAR, year);
    store64(p + PD_MONTH, month);
    store64(p + PD_DAY, day);
    return p;
}
# PersianDate field: the year (Anno Persico; year 1 = 622 CE).
#must_use
fn pd_year(p) { return load64(p + PD_YEAR); }
# PersianDate field: the month (PersianMonth index, 0 = Farvardin .. 11 = Esfand).
#must_use
fn pd_month(p) { return load64(p + PD_MONTH); }
# PersianDate field: the day of month (1-31).
#must_use
fn pd_day(p) { return load64(p + PD_DAY); }

# Display impl for PersianDate: "{day} {month} {year} AP".
#must_use
fn persian_date_to_str(p) {
    var sb = str_builder_new();
    str_builder_add_int(sb, pd_day(p));
    str_builder_add_cstr(sb, " ");
    str_builder_add(sb, persian_month_to_str(pd_month(p)));
    str_builder_add_cstr(sb, " ");
    str_builder_add_int(sb, pd_year(p));
    str_builder_add_cstr(sb, " AP");
    return str_builder_build(sb);
}

# ---------------------------------------------------------------------------
# Jalaali sub-cycle boundary array BREAKS[i64;20] (jalaali-js). Every value and
# its order is essential to leap-year correctness. Built lazily. Note BREAKS[0]
# = -61 (negative literal written as (0 - 61)).
# ---------------------------------------------------------------------------

var _pers_breaks = 0;
var _pers_breaks_done = 0;
fn _build_pers_breaks() {
    var a = alloc(20 * 8);
    store64(a + 0 * 8, 0 - 61);
    store64(a + 1 * 8, 9);
    store64(a + 2 * 8, 38);
    store64(a + 3 * 8, 199);
    store64(a + 4 * 8, 426);
    store64(a + 5 * 8, 686);
    store64(a + 6 * 8, 756);
    store64(a + 7 * 8, 818);
    store64(a + 8 * 8, 1111);
    store64(a + 9 * 8, 1181);
    store64(a + 10 * 8, 1210);
    store64(a + 11 * 8, 1635);
    store64(a + 12 * 8, 2060);
    store64(a + 13 * 8, 2097);
    store64(a + 14 * 8, 2192);
    store64(a + 15 * 8, 2262);
    store64(a + 16 * 8, 2324);
    store64(a + 17 * 8, 2394);
    store64(a + 18 * 8, 2456);
    store64(a + 19 * 8, 3178);   # jalaali-js; the Rust oracle had 2526 (ADR-008)
    return a;
}
# Shared, lazily built raw 20-slot i64 array (read with load64, not a vec) of the jalaali-js
# sub-cycle break years, -61 .. 3178, as jalaali-js has them. The Rust BREAKS const ended
# at 2526, which broke leap years from 2521 AP and year continuity from 2624 AP (ADR-008).
# The algorithm is valid for -61..3177 AP (jalaali-js rejects years outside it; sankhya
# extrapolates past both ends, as the Rust did). Do not mutate.
#must_use
fn persian_breaks() {
    if (_pers_breaks_done == 0) {
        _pers_breaks = _build_pers_breaks();
        _pers_breaks_done = 1;
    }
    return _pers_breaks;
}

# ---------------------------------------------------------------------------
# Core Jalaali calendar calculation, direct port of jalaali-js `jalCal`.
# Writes (leap, leap_j, march) through out-params. `leap` is 0 for leap years,
# 1/2/3 for years following a leap year.
#
# TRUNCATED modulo/division throughout (matches Rust/JS). The
# `((n + 1) % 33 - 1) % 4` followed by `if leap < 0 { leap + 4 }` relies on
# truncated remainders producing negatives — do NOT Euclidize.
# ---------------------------------------------------------------------------

# Core Jalaali calculation for Persian year jy (jalaali-js jalCal, via the Rust port). Writes
# leap (0 = leap year, 1-3 = years since the last leap), leap_j (Jalaali leap-year count to
# the start of jy) and march (Gregorian March day of 1 Farvardin in year jy + 621) through
# the three out-pointers. Uses truncated %// on purpose (see above). Returns 0.
fn jalaali_cal(jy, out_leap, out_leapj, out_march) {
    var breaks = persian_breaks();
    var gy = jy + 621;
    var leap_j = 0 - 14;
    var jp = load64(breaks + 0 * 8);
    var jump = 0;

    var i = 1;
    while (i < 20) {
        var jm = load64(breaks + i * 8);
        jump = jm - jp;
        if (jy < jm) {
            break;
        }
        leap_j = leap_j + (jump / 33) * 8 + (jump % 33) / 4;
        jp = jm;
        i = i + 1;
    }

    var n = jy - jp;

    # Adjust N for the 5-year gap at sub-cycle end.
    if (jump - n < 6) {
        n = n - jump + ((jump + 4) / 33) * 33;
    }

    # leap = ((n + 1) % 33 - 1) % 4, then fix a truncated-negative result.
    var t1 = (n + 1) % 33;
    var t2 = t1 - 1;
    var leap = t2 % 4;
    if (leap < 0) {
        leap = leap + 4;
    }

    # Recompute n for leap count (use original, unadjusted n).
    var n_orig = jy - jp;
    leap_j = leap_j + (n_orig / 33) * 8 + (n_orig % 33 + 3) / 4;

    if (jump % 33 == 4) {
        if (jump - n_orig == 4) {
            leap_j = leap_j + 1;
        }
    }

    # March day of Nowruz (Gregorian).
    var g1 = gy / 100;
    var g2 = (g1 + 1) * 3;
    var g3 = g2 / 4;
    var leap_g = gy / 4 - g3 - 150;
    var march = 20 + leap_j - leap_g;

    store64(out_leap, leap);
    store64(out_leapj, leap_j);
    store64(out_march, march);
    return 0;
}

# ---------------------------------------------------------------------------
# Leap year (Jalaali algorithm)
# ---------------------------------------------------------------------------

# Whether a Persian year is a leap year (jalaali_cal(year).0 == 0).
#must_use
fn persian_is_leap(year) {
    var lp = 0;
    var lj = 0;
    var mr = 0;
    jalaali_cal(year, &lp, &lj, &mr);
    if (lp == 0) {
        return 1;
    }
    return 0;
}

# Days in a Persian year (365 common, 366 leap).
#must_use
fn persian_year_days(year) {
    if (persian_is_leap(year) == 1) {
        return 366;
    }
    return 365;
}

# ---------------------------------------------------------------------------
# JDN conversions
# ---------------------------------------------------------------------------

# Get the JDN of a specific March day in a Gregorian year.
fn gregorian_march_jdn(gy, march_day) {
    var d = gregorian_date_new(gy, GM_MARCH, march_day);
    var r_t, r_v = gregorian_to_jdn(d);
    if (is_ok(r_t) == 1) {
        return result_unwrap(r_t, r_v);
    }
    # Fallback: approximate (dead path for valid march_day 19-22).
    # GREGORIAN_EPOCH_JDN + (gy as f64 * 365.25) + 78.0
    var epoch = gregorian_epoch_jdn();
    var term = f64_mul(f64_from(gy), f64_div(f64_from(1461), f64_from(4)));
    return f64_add(f64_add(epoch, term), f64_from(78));
}

# Convert a day-of-year (0-based) to (month_index, day) for the Persian calendar.
fn month_day_from_doy(doy, is_leap) {
    var d = doy;
    var i = 0;
    while (i < 12) {
        var md = persian_month_days(i);
        if (i == 11) {
            if (is_leap == 1) {
                md = 30;
            }
        }
        if (d < md) {
            return (i, d + 1);
        }
        d = d - md;
        i = i + 1;
    }
    # Fallback (shouldn't reach here for valid input).
    return (11, d + 1);
}

# Convert a Julian Day Number to a Persian (Solar Hijri) date pointer.
#must_use
fn jdn_to_persian(jdn) {
    if (SK_TRACE <= sk_log_level()) {
        var _js = str_from_int(f64_to(jdn));
        sk_log_kv(SK_TRACE, "JDN to Persian", 14, "jdn", 3, str_data(_js), str_len(_js));
    }

    var gy = jdn_to_gregorian(jdn);
    var gy_year = gd_year(gy);

    # Estimate Jalaali year.
    var jy = gy_year - 621;
    var lp = 0;
    var lj = 0;
    var march = 0;
    jalaali_cal(jy, &lp, &lj, &march);

    # JDN of 1 Farvardin of the estimated year.
    var nowruz_jdn = gregorian_march_jdn(gy_year, march);

    var day_diff = f64_to(f64_floor(f64_sub(jdn, nowruz_jdn)));

    if (day_diff < 0) {
        # Before Nowruz of this year — go back one Jalaali year.
        jy = jy - 1;
        var lp2 = 0;
        var lj2 = 0;
        var march_prev = 0;
        jalaali_cal(jy, &lp2, &lj2, &march_prev);
        var nowruz_prev = gregorian_march_jdn(gy_year - 1, march_prev);
        var doy = f64_to(f64_floor(f64_sub(jdn, nowruz_prev)));
        var mi1, day1 = month_day_from_doy(doy, persian_is_leap(jy));
        return persian_date_new(jy, mi1, day1);
    }

    var yd = persian_year_days(jy);
    if (day_diff >= yd) {
        # Past the end of this Jalaali year.
        var doy2 = day_diff - yd;
        jy = jy + 1;
        var mi2, day2 = month_day_from_doy(doy2, persian_is_leap(jy));
        return persian_date_new(jy, mi2, day2);
    }

    var mi3, day3 = month_day_from_doy(day_diff, persian_is_leap(jy));
    return persian_date_new(jy, mi3, day3);
}

# Convert a Persian (Solar Hijri) date to a Julian Day Number.
# Returns Ok(jdn_f64) or Err(InvalidDate) when day is out of range for the
# month/year. (Pattern C: real tagged Result, message preserved.)
#must_use
fn persian_to_jdn(date) {
    if (SK_TRACE <= sk_log_level()) {
        var _ys = str_from_int(pd_year(date));
        sk_log_kv(SK_TRACE, "Persian to JDN", 14, "year", 4, str_data(_ys), str_len(_ys));
    }

    # month enum discriminant IS the 0-based index (position() over the ordered
    # PERSIAN_MONTHS array == the discriminant); unwrap_or(0) never triggers.
    var month_idx = pd_month(date);
    var year = pd_year(date);
    var day = pd_day(date);

    # ADR-007: Rust's month enum and u8 day ruled these out. A month index outside 0..11
    # (an unknown JSON month name decodes to -1) or a day < 1 is an Err, not a table overrun.
    if (month_idx < 0 || month_idx > 11) {
        var sbm = str_builder_new();
        str_builder_add_cstr(sbm, "month index ");
        str_builder_add_int(sbm, month_idx);
        str_builder_add_cstr(sbm, " out of range 0..11");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sbm));
    }
    var max_day = persian_month_days(month_idx);
    if (month_idx == 11) {
        if (persian_is_leap(year) == 1) {
            max_day = 30;
        }
    }

    var bad = 0;
    if (day <= 0) { bad = 1; }
    if (day > max_day) { bad = 1; }
    if (bad == 1) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "day ");
        str_builder_add_int(sb, day);
        str_builder_add_cstr(sb, " out of range for ");
        str_builder_add(sb, persian_month_to_str(month_idx));
        str_builder_add_cstr(sb, " in year ");
        str_builder_add_int(sb, year);
        str_builder_add_cstr(sb, " AP (max ");
        str_builder_add_int(sb, max_day);
        str_builder_add_cstr(sb, ")");
        return sk_fail(SKE_INVALID_DATE, str_builder_build(sb));
    }

    var lp = 0;
    var lj = 0;
    var march = 0;
    jalaali_cal(year, &lp, &lj, &march);
    var gy = year + 621;

    # JDN of 1 Farvardin = March `march` of Gregorian year `gy`.
    var nowruz_jdn = gregorian_march_jdn(gy, march);

    # Day-of-year offset (common-year month lengths for months before month_idx).
    var day_of_year = day - 1;
    var k = 0;
    while (k < month_idx) {
        day_of_year = day_of_year + persian_month_days(k);
        k = k + 1;
    }

    return Ok(f64_add(nowruz_jdn, f64_from(day_of_year)));
}

# --- epoch.cyr ---

# epoch.cyr — cross-civilizational epoch correlation (was src/epoch.rs).
#
# The capstone / "Rosetta Stone" module. Uses the precession of the equinoxes
# (canonical ancient 25,920-year Great Year) as a master clock and the Younger
# Dryas boundary (~12,800 BP) as the anchor. Provides: precessional-age
# computation, a Seven-Sages comparative-mythology database across 6
# civilizations, BP/Julian-year/JDN time conversions, named astronomical-cycle
# periods + an alignment search, a single correlate(jdn) that expresses one JDN
# in every calendar sankhya knows, and a unified any-to-any convert() API
# pivoting through JDN.
#
# SELF-CONTAINED: no include lines (the distlib bundler strips them; stdlib +
# the foundation and calendar modules resolve at bundle-compile time). The
# itihas (eras/civilizations/events) and avatara (Saptarishi profiles) sibling
# deps are auto-included via cyrius.cyml [deps]; in the Rust these were behind
# optional features — here they are ALWAYS-ON, full-parity.
#
# NOTE: J2000_JDN and JULIAN_YEAR_DAYS are provided by src/f64_util.cyr (in Rust
# astro imported them from crate::epoch; the Cyrius port extracted them to the
# shared foundation). We REUSE those globals here rather than redefine them
# (a second `var J2000_JDN` would be a duplicate-var error). Both hold the same
# values as the Rust epoch consts (2451545.0 and 365.25). Likewise the Rust
# `SYNODIC_MONTH_DAYS` const collides with babylonian.cyr's global of the same
# name (slightly different value, 29.530594 vs 29.53058886), and is never
# referenced inside this module — we expose it via epoch_synodic_month_days()
# instead of redefining the global.

# ---------------------------------------------------------------------------
# Constants: Precession of the equinoxes (the Great Year) + reference epochs
# ---------------------------------------------------------------------------
# All are f64 bit patterns, populated by epoch_init() (non-literal initializers
# via f64 builtins; kept in an init fn like babylonian_init/hebrew_init so the
# ordering vs the f64_util globals is explicit). Callers/tests must call
# epoch_init() once after alloc_init().

# GREAT_YEAR_YEARS = 25_920.0 — canonical ancient precession period (Julian yr).
var GREAT_YEAR_YEARS = 0;
# GREAT_YEAR_DAYS = 25_920.0 * 365.25 (= 9_467_280.0, exact in f64).
var GREAT_YEAR_DAYS = 0;
# PRECESSION_RATE_DEG_PER_YEAR = 1.0 / 72.0.
var PRECESSION_RATE_DEG_PER_YEAR = 0;
# PRECESSIONAL_AGE_YEARS = 2_160.0 (one twelfth of the Great Year).
var PRECESSIONAL_AGE_YEARS = 0;
# PRECESSIONAL_AGE_DAYS = 2_160.0 * 365.25 (= 788_940.0, exact in f64).
var PRECESSIONAL_AGE_DAYS = 0;
# YOUNGER_DRYAS_JDN = 2_451_545.0 - 12_800.0 * 365.25 (= -2_223_655.0, ~10,800 BCE).
var YOUNGER_DRYAS_JDN = 0;
# YOUNGER_DRYAS_BP = 12_800.0 — the boundary in years Before Present.
var YOUNGER_DRYAS_BP = 0;
# BP_REFERENCE_JDN = 2_433_282.5 — JDN of Jan 0.5, 1950 CE (radiocarbon BP zero).
var BP_REFERENCE_JDN = 0;

var _epoch_init_done = 0;

# Populate the epoch f64 constants (Great Year, precession rate, precessional age, Younger
# Dryas JDN/BP, BP reference JDN) from f64_util's J2000_JDN / JULIAN_YEAR_DAYS. Idempotent;
# the fns that read the constants call it themselves, so calling it is optional. Returns 0.
fn epoch_init() {
    # Idempotent, and called lazily by every fn that reads these globals (3.1.3): before,
    # a consumer that skipped epoch_init got zeros, so bp_to_jdn(0) was 0 and
    # precessional_age(J2000) said Leo, silently.
    if (_epoch_init_done == 1) { return 0; }
    _epoch_init_done = 1;
    GREAT_YEAR_YEARS = f64_from(25920);
    GREAT_YEAR_DAYS = f64_mul(GREAT_YEAR_YEARS, JULIAN_YEAR_DAYS);
    PRECESSION_RATE_DEG_PER_YEAR = f64_div(f64_from(1), f64_from(72));
    PRECESSIONAL_AGE_YEARS = f64_from(2160);
    PRECESSIONAL_AGE_DAYS = f64_mul(PRECESSIONAL_AGE_YEARS, JULIAN_YEAR_DAYS);
    YOUNGER_DRYAS_JDN = f64_sub(J2000_JDN, f64_mul(f64_from(12800), JULIAN_YEAR_DAYS));
    YOUNGER_DRYAS_BP = f64_from(12800);
    BP_REFERENCE_JDN = f64_add(f64_from(2433282), F64_HALF);
    return 0;
}

# Mean synodic month in days (29.530_588_86). Documentation-only in the Rust
# epoch module (never used in any computation); exposed via an accessor to avoid
# colliding with babylonian.cyr's SYNODIC_MONTH_DAYS global. Lazy-parsed once.
var _epoch_synodic_val = 0;
var _epoch_synodic_done = 0;
# Mean synodic month in days as f64 (29.53058886), parsed on first call and then cached.
#must_use
fn epoch_synodic_month_days() {
    if (_epoch_synodic_done == 0) {
        _epoch_synodic_val = f64_parse("29.53058886");
        _epoch_synodic_done = 1;
    }
    return _epoch_synodic_val;
}

# ---------------------------------------------------------------------------
# Enums
# ---------------------------------------------------------------------------

# The twelve precessional ages (Leo anchored at the Younger Dryas). The
# discriminant IS the index into the ordered AGE_ORDER table (Leo=0 .. Virgo=11),
# so no separate order array is needed: AGE_ORDER[i] == i.
enum PrecessionalAge {
    PA_LEO; PA_CANCER; PA_GEMINI; PA_TAURUS; PA_ARIES; PA_PISCES;
    PA_AQUARIUS; PA_CAPRICORN; PA_SAGITTARIUS; PA_SCORPIO; PA_LIBRA; PA_VIRGO;
}

# serde identifier / name table for PrecessionalAge (lazy singleton).
var _pa_names_vec = 0;
var _pa_names_done = 0;
fn _build_pa_names() {
    var v = vec_new();
    vec_push(v, str_from("Leo"));
    vec_push(v, str_from("Cancer"));
    vec_push(v, str_from("Gemini"));
    vec_push(v, str_from("Taurus"));
    vec_push(v, str_from("Aries"));
    vec_push(v, str_from("Pisces"));
    vec_push(v, str_from("Aquarius"));
    vec_push(v, str_from("Capricorn"));
    vec_push(v, str_from("Sagittarius"));
    vec_push(v, str_from("Scorpio"));
    vec_push(v, str_from("Libra"));
    vec_push(v, str_from("Virgo"));
    return v;
}
# Shared, lazily built vec of the PrecessionalAge serde names indexed by PA_* (Leo..Virgo).
# Returns the same cached vec every call; do not mutate it.
#must_use
fn precessionalage_names() {
    if (_pa_names_done == 0) {
        _pa_names_vec = _build_pa_names();
        _pa_names_done = 1;
    }
    return _pa_names_vec;
}
# Serde name Str of PrecessionalAge `i` (e.g. PA_PISCES -> "Pisces"), from the shared table.
# `i` must be 0..11 (vec_get aborts out of range).
#must_use
fn precessionalage_name(i) { return sk_name_at(precessionalage_names(), i); }

# Civilizations covered by the Seven Sages tradition. (ECIV_ prefix avoids the
# itihas bundle's CIV_* offset-enum members.)
enum Civilization {
    ECIV_VEDIC; ECIV_BABYLONIAN; ECIV_EGYPTIAN; ECIV_MAYAN; ECIV_GREEK; ECIV_CHINESE;
}

var _civ_names_vec = 0;
var _civ_names_done = 0;
fn _build_civ_names() {
    var v = vec_new();
    vec_push(v, str_from("Vedic"));
    vec_push(v, str_from("Babylonian"));
    vec_push(v, str_from("Egyptian"));
    vec_push(v, str_from("Mayan"));
    vec_push(v, str_from("Greek"));
    vec_push(v, str_from("Chinese"));
    return v;
}
# Shared, lazily built vec of the Civilization serde names indexed by ECIV_* (Vedic..Chinese).
# Returns the same cached vec every call; do not mutate it.
#must_use
fn civilization_names() {
    if (_civ_names_done == 0) {
        _civ_names_vec = _build_civ_names();
        _civ_names_done = 1;
    }
    return _civ_names_vec;
}
# Serde name Str of Civilization `i` (e.g. ECIV_MAYAN -> "Mayan"), from the shared table.
# `i` must be 0..5 (vec_get aborts out of range).
#must_use
fn civilization_name(i) { return sk_name_at(civilization_names(), i); }

# Named astronomical cycles that can be queried and compared.
enum CycleName {
    CN_PRECESSION; CN_SOTHIC; CN_SAROS; CN_VENUS_SYNODIC;
    CN_CALENDAR_ROUND; CN_METONIC; CN_PRECESSIONAL_AGE;
}

var _cn_names_vec = 0;
var _cn_names_done = 0;
fn _build_cn_names() {
    var v = vec_new();
    vec_push(v, str_from("Precession"));
    vec_push(v, str_from("Sothic"));
    vec_push(v, str_from("Saros"));
    vec_push(v, str_from("VenusSynodic"));
    vec_push(v, str_from("CalendarRound"));
    vec_push(v, str_from("Metonic"));
    vec_push(v, str_from("PrecessionalAge"));
    return v;
}
# Shared, lazily built vec of the CycleName serde names indexed by CN_* (Precession..
# PrecessionalAge). Returns the same cached vec every call; do not mutate it.
#must_use
fn cyclename_names() {
    if (_cn_names_done == 0) {
        _cn_names_vec = _build_cn_names();
        _cn_names_done = 1;
    }
    return _cn_names_vec;
}
# Serde name Str of CycleName `i` (e.g. CN_VENUS_SYNODIC -> "VenusSynodic"), from the shared
# table. `i` must be 0..6 (vec_get aborts out of range).
#must_use
fn cyclename_name(i) { return sk_name_at(cyclename_names(), i); }

# Tag values for the CalendarDate tagged union (input to convert()).
enum CalDateTag {
    CDT_JDN = 0;
    CDT_GREGORIAN = 1;
    CDT_COPTIC = 2;
    CDT_PERSIAN = 3;
    CDT_HEBREW = 4;
    CDT_HIJRI = 5;
    CDT_MAYAN_LC = 6;
}

# ---------------------------------------------------------------------------
# SagesTradition record
# ---------------------------------------------------------------------------
# { civilization, group_name: Str, sage_names: vec<Str>, source_texts: vec<Str>,
#   associated_stars: Str, catastrophe_narrative: Str } — 48 bytes.
enum SgtOff {
    SGT_CIV = 0; SGT_GROUP = 8; SGT_NAMES = 16; SGT_TEXTS = 24;
    SGT_STARS = 32; SGT_NARR = 40; SGT_SIZE = 48;
}

# Construct a SagesTradition record (fresh 48-byte alloc) storing: civilization (ECIV_*),
# group_name Str, sage_names vec<Str>, source_texts vec<Str>, associated_stars Str and
# catastrophe_narrative Str. The Str/vec pointers are stored as-is, not copied.
#must_use
fn sgt_new(civ, group, names, texts, stars, narr) {
    var p = alloc(SGT_SIZE);
    store64(p + SGT_CIV, civ);
    store64(p + SGT_GROUP, group);
    store64(p + SGT_NAMES, names);
    store64(p + SGT_TEXTS, texts);
    store64(p + SGT_STARS, stars);
    store64(p + SGT_NARR, narr);
    return p;
}
# SagesTradition field: the civilization that preserves the tradition (ECIV_*).
#must_use
fn sgt_civ(p) { return load64(p + SGT_CIV); }
# SagesTradition field: name of the sage group Str (e.g. "Saptarishi", "Apkallu").
#must_use
fn sgt_group(p) { return load64(p + SGT_GROUP); }
# SagesTradition field: vec<Str> of individual sage names, where known from the texts.
#must_use
fn sgt_names(p) { return load64(p + SGT_NAMES); }
# SagesTradition field: vec<Str> of the primary source texts.
#must_use
fn sgt_texts(p) { return load64(p + SGT_TEXTS); }
# SagesTradition field: the associated star or constellation (Str).
#must_use
fn sgt_stars(p) { return load64(p + SGT_STARS); }
# SagesTradition field: brief description of the flood/catastrophe narrative (Str).
#must_use
fn sgt_narr(p) { return load64(p + SGT_NARR); }

# ---------------------------------------------------------------------------
# Static data: Seven Sages traditions (one builder per civilization; each
# returns a fresh SagesTradition record with fresh string/vec data, matching
# the Rust seven_sages() which rebuilds a Vec on every call).
# ---------------------------------------------------------------------------

fn _st_vedic() {
    var names = vec_new();
    vec_push(names, str_from("Marichi"));
    vec_push(names, str_from("Atri"));
    vec_push(names, str_from("Angiras"));
    vec_push(names, str_from("Pulastya"));
    vec_push(names, str_from("Pulaha"));
    vec_push(names, str_from("Kratu"));
    vec_push(names, str_from("Vasishtha"));
    var texts = vec_new();
    vec_push(texts, str_from("Shatapatha Brahmana"));
    vec_push(texts, str_from("Matsya Purana"));
    vec_push(texts, str_from("Vishnu Purana"));
    return sgt_new(ECIV_VEDIC, str_from("Saptarishi"), names, texts,
        str_from("Ursa Major (Saptarishi Mandala)"),
        str_cat(str_from("Survived the pralaya (great dissolution) guided by Matsya (fish avatar of Vishnu); "),
            str_from("restarted the Vedic tradition after the flood.")));
}

