# ---------------------------------------------------------------------------
# AlignmentTarget (6 unit variants + StarRising(StarName)). Because the ported
# module stores the carried StarName alongside the target code, the standalone
# (de)serializers take/return (target, starcode); starcode is -1 for unit
# variants.
# ---------------------------------------------------------------------------

#must_use
fn alignmenttarget_to_json(target, starcode) {
    var sb = str_builder_new();
    _at_emit(sb, target, starcode);
    return str_builder_build(sb);
}

# Returns (target_code, star_code). star_code is -1 for unit variants.
#must_use
fn alignmenttarget_from_json(v) {
    if (bayan_json_v_is_obj(v) == 1) {
        var svnode = bayan_json_v_obj_get(v, "StarRising");
        var scode = starname_from_name(str_cstr(bayan_json_v_str(svnode)));
        return (AT_STAR_RISING, scode);
    }
    var tcode = alignmenttarget_from_name(str_cstr(bayan_json_v_str(v)));
    return (tcode, 0 - 1);
}

#must_use
fn alignmenttarget_eq(ta, sa, tb, sb) {
    if (ta != tb) { return 0; }
    if (ta == AT_STAR_RISING) {
        if (sa != sb) { return 0; }
    }
    return 1;
}

# ---------------------------------------------------------------------------
# AlignmentResult { target: AlignmentTarget, azimuth: f64, deviation: f64 }
# ---------------------------------------------------------------------------

#must_use
fn alignment_result_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_key(sb, "target");
    _at_emit(sb, ar_target(p), ar_star(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "azimuth", ar_azimuth(p));
    sk_json_sep(sb);
    _astro_json_f64(sb, "deviation", ar_deviation(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

#must_use
fn alignment_result_from_json(v) {
    var tnode = bayan_json_v_obj_get(v, "target");
    var tcode, scode = alignmenttarget_from_json(tnode);
    var az = bayan_json_v_float(bayan_json_v_obj_get(v, "azimuth"));
    var dev = bayan_json_v_float(bayan_json_v_obj_get(v, "deviation"));
    return alignment_result_new(tcode, scode, az, dev);
}

#must_use
fn alignment_result_eq(a, b) {
    if (alignmenttarget_eq(ar_target(a), ar_star(a), ar_target(b), ar_star(b)) == 0) { return 0; }
    if (f64_eq(ar_azimuth(a), ar_azimuth(b)) == 0) { return 0; }
    if (f64_eq(ar_deviation(a), ar_deviation(b)) == 0) { return 0; }
    return 1;
}

# --- serial_chinese.cyr ---

# serial_chinese.cyr — JSON (de)serialization for the chinese module.
#
# Full serde round-trip parity with the Rust derived Serialize + Deserialize on
# chinese.rs. Output matches serde_json::to_string EXACTLY (no spaces, Rust
# field names, unit enums as their variant-identifier string).
#
# serde types in chinese.rs:
#   RodNumeral      { value: i64 }
#   HeavenlyStem    (unit enum, 10 variants)   → JSON string "Jia" .. "Gui"
#   EarthlyBranch   (unit enum, 12 variants)   → JSON string "Zi"  .. "Hai"
#   SexagenaryYear  { stem, branch, cycle_position: u8 }
#
# The module exposes the serde variant identifiers via heavenly_stem_debug(i) /
# earthly_branch_debug(i) (the Rust {:?} identifier == the serde external tag for
# unit variants), so those are the "name" accessors used here. There is no f64
# field in this module — every numeric field is integer-valued, so sk_json_int is
# faithful and no bayan value-tree float path is needed.
#
# SELF-CONTAINED: no include lines. Relies on serial_util.cyr (sk_json_*),
# chinese.cyr (constructors/getters/name accessors), bayan (folded stdlib parse
# tree), and str/vec stdlib — all resolved from the consumer's bundle.

# ---------------------------------------------------------------------------
# Enum name → discriminant reverse maps (module lacks *_from_name).
# The parsed name arrives as a Str (bayan_json_v_str), so compare with str_eq.
# Returns (0 - 1) when no variant matches.
# ---------------------------------------------------------------------------

#must_use
fn heavenly_stem_from_name(name) {
    var i = 0;
    while (i < 10) {
        if (str_eq(heavenly_stem_debug(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

#must_use
fn earthly_branch_from_name(name) {
    var i = 0;
    while (i < 12) {
        if (str_eq(earthly_branch_debug(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# ---------------------------------------------------------------------------
# RodNumeral { value: i64 }  →  {"value":N}
# ---------------------------------------------------------------------------

#must_use
fn rod_numeral_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "value", rod_value(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

#must_use
fn rod_numeral_from_json(v) {
    var val = bayan_json_v_int(bayan_json_v_obj_get(v, "value"));
    return rod_numeral_new(val);
}

#must_use
fn rod_numeral_eq(a, b) {
    if (rod_value(a) != rod_value(b)) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# HeavenlyStem (unit enum)  →  JSON string "Jia" .. "Gui"
# A standalone serde unit enum serializes to a bare JSON string.
# ---------------------------------------------------------------------------

#must_use
fn heavenly_stem_to_json(stem) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, heavenly_stem_debug(stem));
    return str_builder_build(sb);
}

#must_use
fn heavenly_stem_from_json(v) {
    return heavenly_stem_from_name(bayan_json_v_str(v));
}

#must_use
fn heavenly_stem_eq(a, b) {
    if (a != b) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# EarthlyBranch (unit enum)  →  JSON string "Zi" .. "Hai"
# ---------------------------------------------------------------------------

#must_use
fn earthly_branch_to_json(branch) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, earthly_branch_debug(branch));
    return str_builder_build(sb);
}

#must_use
fn earthly_branch_from_json(v) {
    return earthly_branch_from_name(bayan_json_v_str(v));
}

#must_use
fn earthly_branch_eq(a, b) {
    if (a != b) { return 0; }
    return 1;
}

# ---------------------------------------------------------------------------
# SexagenaryYear { stem, branch, cycle_position }
#   →  {"stem":"Jia","branch":"Chen","cycle_position":41}
# Field order matches the Rust struct declaration (serde preserves it).
# ---------------------------------------------------------------------------

#must_use
fn sexagenary_year_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_str(sb, "stem", heavenly_stem_debug(sex_stem(p)));
    sk_json_sep(sb);
    sk_json_str(sb, "branch", earthly_branch_debug(sex_branch(p)));
    sk_json_sep(sb);
    sk_json_int(sb, "cycle_position", sex_cycle_position(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

#must_use
fn sexagenary_year_from_json(v) {
    var stem_name = bayan_json_v_str(bayan_json_v_obj_get(v, "stem"));
    var stem = heavenly_stem_from_name(stem_name);
    var branch_name = bayan_json_v_str(bayan_json_v_obj_get(v, "branch"));
    var branch = earthly_branch_from_name(branch_name);
    var pos = bayan_json_v_int(bayan_json_v_obj_get(v, "cycle_position"));
    return sexagenary_year_new(stem, branch, pos);
}

#must_use
fn sexagenary_year_eq(a, b) {
    if (sex_stem(a) != sex_stem(b)) { return 0; }
    if (sex_branch(a) != sex_branch(b)) { return 0; }
    if (sex_cycle_position(a) != sex_cycle_position(b)) { return 0; }
    return 1;
}

# --- serial_persian.cyr ---

# serial_persian.cyr — JSON (de)serialization for the persian module, for full
# serde round-trip parity with Rust's derived Serialize + Deserialize.
#
# Rust serde emits:
#   PersianMonth  → the bare variant-name string, e.g. "Farvardin"
#   PersianDate   → {"year":<i64>,"month":"<Variant>","day":<u8>}  (declaration order)
#
# SELF-CONTAINED: no include lines. Uses the shared sk_json_* helpers from
# serial_util.cyr, the persian module accessors, and bayan's value-tree API.

# ---------------------------------------------------------------------------
# PersianMonth enum <-> serde variant-name string
# ---------------------------------------------------------------------------

# Map a variant-name Str back to the PersianMonth discriminant (0..11).
# Scans persian_month_name(i) for a match. Returns (0 - 1) if none matches.
#must_use
fn persian_month_from_name(name) {
    var i = 0;
    while (i < 12) {
        if (str_eq(persian_month_name(i), name) == 1) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Serialize a PersianMonth discriminant to a bare JSON string ("Farvardin").
#must_use
fn persian_month_to_json(m) {
    var sb = str_builder_new();
    str_builder_add_json_str(sb, persian_month_name(m));
    return str_builder_build(sb);
}

# Deserialize a bayan value node (a JSON string) to a PersianMonth discriminant.
#must_use
fn persian_month_from_json(v) {
    var name = bayan_json_v_str(v);
    return persian_month_from_name(name);
}

# Equality of two PersianMonth discriminants (0/1).
#must_use
fn persian_month_eq(a, b) {
    if (a == b) {
        return 1;
    }
    return 0;
}

# ---------------------------------------------------------------------------
# PersianDate struct <-> {"year":i64,"month":"<Variant>","day":u8}
# ---------------------------------------------------------------------------

# Serialize a PersianDate pointer to serde-compact JSON. Field order matches
# the Rust struct declaration: year, month, day. The month enum is emitted as
# its serde variant-name string.
#must_use
fn persian_date_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    sk_json_int(sb, "year", pd_year(p));
    sk_json_sep(sb);
    sk_json_str(sb, "month", persian_month_name(pd_month(p)));
    sk_json_sep(sb);
    sk_json_int(sb, "day", pd_day(p));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Deserialize a bayan value node (a JSON object) to a PersianDate pointer.
# The month field is read as its variant-name string and mapped back to the
# discriminant via persian_month_from_name.
#must_use
fn persian_date_from_json(v) {
    var y = bayan_json_v_int(bayan_json_v_obj_get(v, "year"));
    var mv = bayan_json_v_obj_get(v, "month");
    var mname = bayan_json_v_str(mv);
    var m = persian_month_from_name(mname);
    var d = bayan_json_v_int(bayan_json_v_obj_get(v, "day"));
    return persian_date_new(y, m, d);
}

# Field-by-field equality of two PersianDate pointers (0/1).
#must_use
fn persian_date_eq(a, b) {
    if (pd_year(a) != pd_year(b)) {
        return 0;
    }
    if (pd_month(a) != pd_month(b)) {
        return 0;
    }
    if (pd_day(a) != pd_day(b)) {
        return 0;
    }
    return 1;
}

# --- serial_epoch.cyr ---

# serial_epoch.cyr — JSON (de)serialization for the epoch module, the sankhya
# "Rosetta Stone" capstone, matching Rust serde_json for full round-trip parity.
#
# Serde types in rust-old/src/epoch.rs (all #[derive(Serialize, Deserialize)]):
#   PrecessionalAge  — unit enum   → serde emits the bare variant-name string.
#   Civilization     — unit enum   → bare variant-name string.
#   CycleName        — unit enum   → bare variant-name string.
#   SagesTradition   — struct { civilization, group_name, sage_names: Vec<str>,
#                               source_texts: Vec<str>, associated_stars,
#                               catastrophe_narrative }.
#   AgePosition      — struct { age: PrecessionalAge, years_into_age: f64,
#                               fraction: f64, vernal_point_longitude: f64 }.
#   CycleAlignment   — struct { jdn: f64, cycles: Vec<CycleName>,
#                               max_residual_days: f64 }.
#   MultiCalendarDate— the correlate() output: 18 fields incl. Option<> Mayan
#                      calendars, a (i32,u32,f64) sothic tuple, every nested
#                      calendar record, itihas eras/civilizations/events, and
#                      avatara saptarishi profiles.
#   CalendarDate     — #[non_exhaustive] data enum (externally tagged):
#                      {"Jdn":f64} / {"Gregorian":{..}} / ... / {"MayanLongCount":{..}}.
#
# serde format details handled here:
#   * Unit enum → bare JSON string via the module's <Enum>_name(i) accessor
#     (the serde identifier, NOT the integer, NOT the spaced Display string).
#   * Data enum → externally tagged single-key object {"Variant": value}.
#   * f64 → JSON number. Emitted through bayan's Grisu2 float formatter
#     (bayan_json_v_float_new(bits) + bayan_json_v_build) which is round-trip
#     correct: parsing the emitted text back with bayan_json_v_float reproduces
#     the exact bits, so f64 fields compare by bit-equality in *_eq.
#   * Option<T> None → null (JSON), Some(x) → the value.
#   * Vec<T> → JSON array. Tuple (i32,u32,f64) → JSON array [int,int,number].
#   * Nested struct → embedded object (this file carries private ep_* serializers
#     for every nested calendar record so the test needs only lib.cyr +
#     serial_util.cyr + serial_epoch.cyr — no other serial_<mod>.cyr).
#   * eras/civilizations/events → itihas's own era_to_json / civ_to_json /
#     event_to_json (from the itihas bundle) inside a JSON array.
#   * saptarishi_profiles → array of {name, tradition, description} objects built
#     from avatara's prof_name/prof_tradition/prof_desc (C-string) accessors.
#
# Reduction (documented): the itihas era/civ/event bundle exposes NO from_json,
# and avatara ArchetypeProfile has no round-trippable serializer, so the
# MultiCalendarDate round-trip reconstructs every INTRINSIC field (jdn, the
# option Mayan calendars, sothic tuple, precessional age, julian year, and all
# nested calendar records) exactly and verifies the itihas/avatara arrays
# structurally by element COUNT. The intrinsic reduced set is what the Rust
# assert_eq!(date, back) exercises for parity on this port.
#
# SELF-CONTAINED: no include lines. Uses the shared sk_json_* helpers from
# serial_util.cyr, the epoch + calendar module accessors (via lib.cyr), the
# itihas/avatara bundle serializers/accessors, and bayan's value-tree API.

# ===========================================================================
# Shared local helpers
# ===========================================================================

# Append  "key":<number>  where <number> is the Grisu2 JSON rendering of the
# f64 bit pattern `bits`. Round-trip correct with bayan_json_v_float on parse.
fn _ep_json_f64(sb, key, bits) {
    sk_json_key(sb, key);
    str_builder_add(sb, bayan_json_v_build(bayan_json_v_float_new(bits)));
    return 0;
}

# The bare JSON number rendering of an f64 bit pattern (no key), as a Str.
#must_use
fn _ep_f64_str(bits) {
    return bayan_json_v_build(bayan_json_v_float_new(bits));
}

# Append  "key":["s0","s1",...]  from a vec of Str.
fn _ep_json_str_arr(sb, key, v) {
    sk_json_key(sb, key);
    str_builder_add_cstr(sb, "[");
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_json_str(sb, vec_get(v, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return 0;
}

# Parse a bayan array node of JSON strings into a fresh vec of Str.
#must_use
fn _ep_parse_str_arr(node) {
    var v = vec_new();
    var n = bayan_json_v_arr_len(node);
    var i = 0;
    while (i < n) {
        vec_push(v, bayan_json_v_str(bayan_json_v_arr_get(node, i)));
        i = i + 1;
    }
    return v;
}

# Element-wise equality of two vecs of Str (0/1).
#must_use
fn _ep_str_vec_eq(a, b) {
    var na = vec_len(a);
    var nb = vec_len(b);
    if (na != nb) { return 0; }
    var i = 0;
    while (i < na) {
        if (str_eq(vec_get(a, i), vec_get(b, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

