# serial_roman.tcyr — serde round-trip parity for the roman module.
# Ports rust-old/src/roman.rs's #[test] fn serde_roundtrip:
#   let n = RomanNumeral::from_value(1776).unwrap();
#   let json = serde_json::to_string(&n).unwrap();
#   let back: RomanNumeral = serde_json::from_str(&json).unwrap();
#   assert_eq!(n, back);
# Additionally asserts the emitted JSON matches serde_json's exact byte shape
# (correct field names + order, integer value, string text).
include "src/error.cyr"
include "src/util.cyr"
include "src/f64_util.cyr"
include "src/logging.cyr"
include "src/serial_util.cyr"
include "src/roman.cyr"
include "src/serial_roman.cyr"

# Assert that v is non-zero (truthy), labelled name in the failure report.
fn ok(v, name) { return assert_neq(v, 0, name); }

# Decode js (a C-string) as a RomanNumeral; returns romannum_from_json's Result pair (k is
# unused: roman has one decoder).
fn de_run(k, js) {
    var n = sk_json_parse(str_from(js));
    return romannum_from_json(n);
}

# The C-string a followed by the C-string b, for expected messages too long for one line.
fn cat2(a, b) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_cstr(str_builder_build(sb));
}

# Decode js with decoder k and check it fails with SKE_DESERIALIZE and exactly the message
# want (a C-string); a mismatch prints the message it got.
fn de_err(k, js, want, label) {
    var t, v = de_run(k, js);
    assert_eq(sk_result_code(t, v), SKE_DESERIALIZE, label);
    if (is_ok(t) == 0) {
        var same = str_eq_cstr(sk_err_msg(v), want);
        if (same == 0) { str_println(sk_err_msg(v)); }
        ok(same, label);
    }
    return 0;
}

# Run every serial_roman test case and print the assert_summary; returns its exit code.
fn main() {
    alloc_init();
    println("=== sankhya serial_roman test suite ===");

    # ---- serde_roundtrip: RomanNumeral(1776) = "MDCCLXXVI" ----
    var r_t, r_v = romannum_from_value(1776);
    ok(is_ok(r_t), "from_value(1776) ok");
    var n = result_unwrap(r_t, r_v);

    var js = romannum_to_json(n);

    # serde_json compact shape: {"value":1776,"text":"MDCCLXXVI"}
    ok(str_contains_cstr(js, "\"value\":1776"), "json has value:1776");
    ok(str_contains_cstr(js, "\"text\":\"MDCCLXXVI\""), "json has text:MDCCLXXVI");
    ok(str_eq_cstr(js, "{\"value\":1776,\"text\":\"MDCCLXXVI\"}"), "json exact serde shape");

    # parse back + field-by-field compare
    var v = sk_json_parse(js);
    ok(v, "parse ok");
    var p_t, p_v = romannum_from_json(v);
    ok(is_ok(p_t), "RomanNumeral decodes");
    ok(romannum_eq(n, result_unwrap(p_t, p_v)), "RomanNumeral serde round-trip");

    # ---- a second value to exercise a different text (parse path) ----
    var r2_t, r2_v = romannum_parse(str_from("XIV"));
    ok(is_ok(r2_t), "parse(XIV) ok");
    var n2 = result_unwrap(r2_t, r2_v);
    var js2 = romannum_to_json(n2);
    ok(str_eq_cstr(js2, "{\"value\":14,\"text\":\"XIV\"}"), "XIV exact serde shape");
    var v2 = sk_json_parse(js2);
    var p2_t, p2_v = romannum_from_json(v2);
    ok(romannum_eq(n2, result_unwrap(p2_t, p2_v)), "RomanNumeral(14) round-trip");

    # ---- 3.2.0: decode errors are serde's (Err, SKE_DESERIALIZE) ----
    de_err(0, "{\"value\":14}", "missing field `text`", "missing text");
    de_err(0, "{\"text\":\"XIV\"}", "missing field `value`", "missing value");
    de_err(0, "{\"value\":-1,\"text\":\"XIV\"}", "invalid value: integer `-1`, expected u32", "negative value");
    de_err(0, "{\"value\":14,\"text\":14}", "invalid type: integer `14`, expected a string", "integer text");
    de_err(0, "{\"value\":\"XIV\",\"text\":\"XIV\"}", "invalid type: string \"XIV\", expected u32", "string value");
    de_err(0, "\"XIV\"", "invalid type: string \"XIV\", expected struct RomanNumeral", "string for struct");
    # The derive stores both fields as decoded: no 1-3999 check and no re-derived text.
    var ex_t, ex_v = de_run(0, "{\"value\":5,\"text\":\"IV\",\"x\":1}");
    ok(is_ok(ex_t), "inconsistent value/text and unknown key decode");
    if (is_ok(ex_t) == 1) {
        assert_eq(romannum_value(ex_v), 5, "value 5 kept as decoded");
        ok(str_eq_cstr(romannum_text(ex_v), "IV"), "text IV kept as decoded");
    }
    var z_t, z_v = de_run(0, "{\"value\":0,\"text\":\"\"}");
    ok(is_ok(z_t), "value 0 decodes (serde's derive does no range check)");

    return assert_summary();
}

var rc = main();
syscall(SYS_EXIT, rc);
