# ============================ Hebrew ============================

fn hebrew_rt_fail(start) {
    var fail = 0;
    var d = 0;
    while (d < 1500) {
        var jdn = f64_add(start, f64_from(d));
        var date = jdn_to_hebrew(jdn);
        var r = hebrew_to_jdn(date);
        if (is_ok(r) == 0) { fail = fail + 1; }
        else { if (f64_approx_eq(result_unwrap(r), jdn, TOL_JDN) == 0) { fail = fail + 1; } }
        d = d + 1;
    }
    return fail;
}

fn test_hebrew() {
    var start = f64_add(f64_from(2460000), F64_HALF);
    assert_eq(hebrew_rt_fail(start), 0, "hebrew JDN roundtrip 1500 days");

    # year_types_distribution: 7 leap years over Metonic cycle 5765..5784
    var y = 5765;
    var leaps = 0;
    while (y < 5784) {
        if (hebrew_is_leap(y) == 1) { leaps = leaps + 1; }
        y = y + 1;
    }
    assert_eq(leaps, 7, "7 leap years in Metonic cycle");
    return 0;
}

# ============================ Cross-calendar ============================

fn test_crosscal() {
    # Convert Jan 1 2025 through hebrew/coptic/persian and back to JDN.
    var greg = gregorian_date_new(2025, GM_JANUARY, 1);
    var rj = gregorian_to_jdn(greg);
    ok(is_ok(rj), "gregorian_to_jdn ok");
    var jdn = result_unwrap(rj);

    var hebrew = jdn_to_hebrew(jdn);
    var coptic = jdn_to_coptic(jdn);
    var persian = jdn_to_persian(jdn);

    var rh = hebrew_to_jdn(hebrew);
    ok(is_ok(rh), "hebrew_to_jdn ok");
    ok(f64_approx_eq(result_unwrap(rh), jdn, TOL_JDN), "hebrew roundtrip JDN");

    var rc = coptic_to_jdn(coptic);
    ok(is_ok(rc), "coptic_to_jdn ok");
    ok(f64_approx_eq(result_unwrap(rc), jdn, TOL_JDN), "coptic roundtrip JDN");

    var rp = persian_to_jdn(persian);
    ok(is_ok(rp), "persian_to_jdn ok");
    ok(f64_approx_eq(result_unwrap(rp), jdn, TOL_JDN), "persian roundtrip JDN");
    return 0;
}

fn test_convert_api() {
    # convert(CalendarDate::Gregorian(April 1 2025))
    var greg = gregorian_date_new(2025, GM_APRIL, 1);
    var cvt = convert(caldate_gregorian(greg));
    ok(is_ok(cvt), "convert gregorian ok");
    var result = result_unwrap(cvt);

    var rg = mcd_gregorian(result);
    assert_eq(gd_year(rg), 2025, "convert greg year 2025");
    assert_eq(gd_month(rg), GM_APRIL, "convert greg month April");
    assert_eq(gd_day(rg), 1, "convert greg day 1");

    ok(mcd_mayan_lc(result), "mayan_long_count is_some");

    # Hebrew roundtrip through convert
    var hj = calendar_to_jdn(caldate_hebrew(mcd_hebrew(result)));
    ok(is_ok(hj), "hebrew calendar_to_jdn ok");
    ok(f64_approx_eq(result_unwrap(hj), mcd_jdn(result), TOL_JDN), "convert hebrew roundtrip JDN");
    return 0;
}

# ============================ Aztec ============================

fn ton_eq(a, b) {
    if (ton_number(a) != ton_number(b)) { return 0; }
    if (ton_sign(a) != ton_sign(b)) { return 0; }
    return 1;
}
fn xiu_eq(a, b) {
    if (xiu_day(a) != xiu_day(b)) { return 0; }
    if (xiu_month(a) != xiu_month(b)) { return 0; }
    return 1;
}

fn test_aztec() {
    var base = f64_add(f64_from(2451545), F64_HALF);
    var t1, x1 = aztec_calendar_round(base);
    var t2, x2 = aztec_calendar_round(f64_add(base, f64_from(18980)));
    ok(ton_eq(t1, t2), "aztec calendar round tonal @18980");
    ok(xiu_eq(x1, x2), "aztec calendar round xiuh @18980");
    return 0;
}

# ============================ Chinese Sexagenary ============================

fn test_sexagenary() {
    var s2024 = sexagenary_from_year(2024);
    assert_eq(sex_stem(s2024), HS_JIA, "2024 stem Jia");
    assert_eq(sex_branch(s2024), EB_CHEN, "2024 branch Chen");

    var s1984 = sexagenary_from_year(1984);
    assert_eq(sex_stem(s1984), HS_JIA, "1984 stem Jia");
    assert_eq(sex_branch(s1984), EB_ZI, "1984 branch Zi (Rat)");
    return 0;
}

# ============================ Astro ============================

fn test_astro() {
    # precession_thuban_pole: dec > 85 at ~2800 BCE
    var jdn = f64_sub(J2000_JDN, f64_mul(f64_from(4800), JULIAN_YEAR_DAYS));
    var pos = star_position_at(SN_THUBAN, jdn);
    var thub = f64_gt(cc_dec_degrees(pos), f64_from(85));
    ok(thub, "Thuban dec > 85");

    # coordinate_roundtrip
    var orig = celestial_new(f64_from(12), f64_from(30));
    var ecl = equatorial_to_ecliptic(orig, J2000_JDN);
    var back = ecliptic_to_equatorial(ecl, J2000_JDN);
    ok(f64_approx_eq(cc_ra_hours(back), f64_from(12), TOL_001), "coord roundtrip RA");
    ok(f64_approx_eq(cc_dec_degrees(back), f64_from(30), TOL_001), "coord roundtrip Dec");

    # stonehenge_alignment: non-empty
    var results = monument_alignment(f64_parse("51.18"), f64_from(51), J2000_JDN, f64_from(5));
    var nonempty = vec_len(results) > 0;
    ok(nonempty, "stonehenge alignment non-empty");
    return 0;
}

