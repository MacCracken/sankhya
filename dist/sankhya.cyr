# --- error.cyr ---

# error.cyr — sankhya error codes + error record (was SankhyaError, thiserror).
#
# Parity note: the Rust `SankhyaError` enum carried a `String` message on every
# variant (e.g. format!("katun {katun} out of range 0..20")). We preserve BOTH
# the discriminant (code) AND the message by returning an `Err` whose payload is
# a small heap record { code, msg }. Callers that only care about the variant
# read sk_result_code(r); callers that want the text read sk_err_msg(...).

enum SankhyaError {
    SKE_OK = 0;
    SKE_INVALID_DATE = 1;
    SKE_INVALID_BASE = 2;
    SKE_INVALID_FRACTION = 3;
    SKE_OVERFLOW = 4;
    SKE_COMPUTATION = 5;
}

# SkErr record: { code: i64, msg: Str } — 16 bytes. msg may be 0 (no message).
enum SkErrOff { SKERR_CODE = 0; SKERR_MSG = 8; SKERR_SIZE = 16; }

#must_use
fn sk_err(code, msg) {
    var p = alloc(SKERR_SIZE);
    store64(p + SKERR_CODE, code);
    store64(p + SKERR_MSG, msg);
    return p;
}

#must_use
fn sk_err_code(e) { return load64(e + SKERR_CODE); }

#must_use
fn sk_err_msg(e) { return load64(e + SKERR_MSG); }

# Build an Err(Result) carrying a SkErr{code, msg}.
# Use as: return sk_fail(SKE_INVALID_DATE, str_from("day out of range"));
fn sk_fail(code, msg) {
    return Err(sk_err(code, msg));
}

# Read the error code out of a Result: SKE_OK if Ok, else the Err's code.
#must_use
# 6.6.0 value form: a Result is a register PAIR, so both halves must be passed —
# `var t, v = f(); sk_result_code(t, v);`. Was 1-arg over the boxed form.
# Same shape as sigil/agnodrm/kavach's `result_print_err`.
fn sk_result_code(r_tag, r) {
    if (is_ok(r_tag) == 1) { return SKE_OK; }
    return sk_err_code(err_code_of(r_tag, r));
}

# --- util.cyr ---

# util.cyr — sankhya utility helpers: Euclidean integer math, string case,
# case-insensitive compare, comparator sort. None of these are in cyrius stdlib.

# --- Euclidean integer math (CRITICAL for calendars with pre-epoch dates) ---
# Rust `%` and Cyrius `%` are both TRUNCATED (sign of dividend). Rust's
# rem_euclid/div_euclid return a non-negative remainder / floored quotient.
# Calendar arithmetic on pre-epoch JDNs (negative day counts) REQUIRES these.

# Euclidean remainder: always in [0, m) for m > 0.
#must_use
fn rem_euclid(a, m) {
    var r = a % m;
    if (r < 0) { r = r + m; }
    return r;
}

# Euclidean division: floor division toward negative infinity (for m > 0).
#must_use
fn div_euclid(a, m) {
    var q = a / m;
    var r = a % m;
    if (r < 0) { q = q - 1; }
    return q;
}

# Integer absolute value (no builtin abs for i64; f64_abs is floats only).
#must_use
fn int_abs(x) {
    if (x < 0) { return 0 - x; }
    return x;
}

# --- String case conversion (ASCII only, allocates a new Str) ---
# sk_-prefixed to avoid colliding with the identical helpers in the itihas bundle
# (which we consume as a dist dependency).

fn sk_str_lower(s) {
    var slen = str_len(s);
    var sd = str_data(s);
    var buf = alloc(slen + 1);
    var li = 0;
    while (li < slen) {
        var c = load8(sd + li);
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        store8(buf + li, c);
        li = li + 1;
    }
    store8(buf + slen, 0);
    return str_new(buf, slen);
}

fn sk_str_upper(s) {
    var slen = str_len(s);
    var sd = str_data(s);
    var buf = alloc(slen + 1);
    var ui = 0;
    while (ui < slen) {
        var c = load8(sd + ui);
        if (c >= 97) { if (c <= 122) { c = c - 32; } }
        store8(buf + ui, c);
        ui = ui + 1;
    }
    store8(buf + slen, 0);
    return str_new(buf, slen);
}

# Case-insensitive Str equality (ASCII).
fn sk_str_eq_lower(a: Str, b: Str) {
    var la = str_len(a);
    var lb = str_len(b);
    if (la != lb) { return 0; }
    var da = str_data(a);
    var db = str_data(b);
    var ei = 0;
    while (ei < la) {
        var ca = load8(da + ei);
        var cb = load8(db + ei);
        if (ca >= 65) { if (ca <= 90) { ca = ca + 32; } }
        if (cb >= 65) { if (cb <= 90) { cb = cb + 32; } }
        if (ca != cb) { return 0; }
        ei = ei + 1;
    }
    return 1;
}

# --- In-place insertion sort by comparator function pointer ---
# cmp(a, b) returns <0 if a<b, 0 if equal, >0 if a>b.
fn sk_vec_sort(v, cmp) {
    var len = vec_len(v);
    var si = 1;
    while (si < len) {
        var key = vec_get(v, si);
        var j = si - 1;
        while (j >= 0) {
            var elem = vec_get(v, j);
            if (fncall2(cmp, elem, key) <= 0) { break; }
            vec_set(v, j + 1, elem);
            j = j - 1;
        }
        vec_set(v, j + 1, key);
        si = si + 1;
    }
    return 0;
}

# --- f64_util.cyr ---

# f64_util.cyr — f64 helpers not provided by the cyrius stdlib.
#
# Base f64 ops (f64_add/sub/mul/div/sqrt/sin/cos/atan/floor/abs/neg/lt/eq...) are
# compiler builtins. Constants (F64_PI, F64_TAU, ...) and f64_parse/min/max/clamp
# come from the `math` stdlib module; the extended transcendentals
# (f64_pow/hypot/asin/acos/atan2/sinh/cosh) come from `ganita`. Only what neither
# provides lives here.

# 1e-12 as an IEEE-754 double bit pattern (a bare hex literal → no global-init
# cost, always valid). Used as the near-zero divisor guard in f64_fmod.
var EPSILON_F64 = 0x3D719799812DEA11;

# Shared astronomical constants (used by BOTH astro and epoch). Extracted here so
# astro depends only on the foundation, not on epoch (in Rust astro imported
# J2000_JDN + JULIAN_YEAR_DAYS from crate::epoch). J2000.0 = JD 2451545.0;
# Julian year = 365.25 days = 1461/4 (both exact in f64).
var J2000_JDN = f64_from(2451545);
var JULIAN_YEAR_DAYS = f64_div(f64_from(1461), f64_from(4));

# tan(x) = sin(x) / cos(x)  — neither the builtins nor ganita expose tan.
fn f64_tan(x) {
    return f64_div(f64_sin(x), f64_cos(x));
}

# fmod(x, y) via floor: x - floor(x/y)*y. Returns 0 if |y| < EPSILON.
# Note: this is floor-based (like hisab); for angle normalization the callers
# add a full turn when the result is negative, so the [0, turn) result is exact.
fn f64_fmod(x, y) {
    if (f64_lt(f64_abs(y), EPSILON_F64) == 1) { return 0; }
    var q = f64_floor(f64_div(x, y));
    return f64_sub(x, f64_mul(q, y));
}

# copysign(x, y): magnitude of x with the sign of y.
fn f64_copysign(x, y) {
    var ax = f64_abs(x);
    if (f64_lt(y, 0) == 1) { return f64_neg(ax); }
    return ax;
}

# Approximate equality within an absolute tolerance (tol is an f64 bit pattern).
fn f64_approx_eq(a, b, tol) {
    if (f64_lt(f64_abs(f64_sub(a, b)), tol) == 1) { return 1; }
    return 0;
}

# NaN detection: NaN is the only value not equal to itself.
fn f64_is_nan(x) {
    if (f64_eq(x, x) == 0) { return 1; }
    return 0;
}

# Infinity detection: mask the sign bit, compare the exponent-all-ones pattern.
fn f64_is_inf(x) {
    var ax = x & 0x7FFFFFFFFFFFFFFF;
    if (ax == 0x7FF0000000000000) { return 1; }
    return 0;
}

# --- logging.cyr ---

# logging.cyr — structured logging via sakshi (replaces Rust tracing /
# tracing-subscriber). sakshi is a folded stdlib module, so the distlib bundle
# resolves SK_INFO / sakshi_set_level from the consumer's [deps] stdlib.
#
# Per-call trace/debug sites in the calendar/astro modules use sakshi_trace /
# sakshi_debug / sakshi_log_kv directly (see the module ports). This file only
# provides the subscriber-init analog.

fn sankhya_log_init() {
    sakshi_set_level(SK_INFO);
    return 0;
}

fn sankhya_log_init_level(level) {
    sakshi_set_level(level);
    return 0;
}

# --- gregorian.cyr ---

# gregorian.cyr — proleptic Gregorian calendar (was src/gregorian.rs).
#
# Julian Day Number (JDN) conversions using the March-based computational
# calendar algorithm from Dershowitz & Reingold, Calendrical Calculations
# (4th ed., 2018) and Meeus, Astronomical Algorithms (2nd ed., 1998).
#
# Astronomical year numbering: year 0 = 1 BCE, year -1 = 2 BCE, etc.
#
# SELF-CONTAINED: no include lines (the distlib bundler strips them; stdlib +
# error/util/f64_util/logging symbols resolve from the consumer's bundle).

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

# JDN of the Gregorian epoch: January 1, 1 CE (proleptic), midnight-based (.5).
# = 1721425.5. Set by gregorian_init() (an f64 bit pattern; not a literal).
var GREGORIAN_EPOCH_JDN = 0;

# Public accessor — init-independent (functions never depend on the global).
#must_use
fn gregorian_epoch_jdn() {
    return f64_add(f64_from(1721425), f64_div(f64_from(1), f64_from(2)));
}

# Populate the exported GREGORIAN_EPOCH_JDN global. Tests call this after
# alloc_init(); consumers that read the global should call it once at startup.
fn gregorian_init() {
    GREGORIAN_EPOCH_JDN = gregorian_epoch_jdn();
    return 0;
}

# ---------------------------------------------------------------------------
# Month enum (January=0 .. December=11; the discriminant IS the month index)
# ---------------------------------------------------------------------------

enum GregorianMonth {
    GM_JANUARY;
    GM_FEBRUARY;
    GM_MARCH;
    GM_APRIL;
    GM_MAY;
    GM_JUNE;
    GM_JULY;
    GM_AUGUST;
    GM_SEPTEMBER;
    GM_OCTOBER;
    GM_NOVEMBER;
    GM_DECEMBER;
}

# Days in each month of a common (non-leap) Gregorian year, by 0-based index.
# [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]. Built lazily (§8a idiom).
var _greg_mdays = 0;
var _greg_mdays_done = 0;
fn _build_greg_mdays() {
    var a = alloc(12 * 8);
    store64(a + 0 * 8, 31);
    store64(a + 1 * 8, 28);
    store64(a + 2 * 8, 31);
    store64(a + 3 * 8, 30);
    store64(a + 4 * 8, 31);
    store64(a + 5 * 8, 30);
    store64(a + 6 * 8, 31);
    store64(a + 7 * 8, 31);
    store64(a + 8 * 8, 30);
    store64(a + 9 * 8, 31);
    store64(a + 10 * 8, 30);
    store64(a + 11 * 8, 31);
    return a;
}
#must_use
fn greg_month_length(idx) {
    if (_greg_mdays_done == 0) {
        _greg_mdays = _build_greg_mdays();
        _greg_mdays_done = 1;
    }
    return load64(_greg_mdays + idx * 8);
}

